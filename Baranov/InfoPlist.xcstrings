          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجد بارانوف راعيًا آخر يقف بجوارك - عندما تهز هواتفكما، أو عندما يشارك شخص قريب منك رمز الالتقاط - حتى يتمكن الكبش أو الرمز من الوصول إليك بدون الإنترنت."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов намира друг овчар, който стои до вас — когато и двамата разклатите телефоните си или когато някой наблизо сподели код за вземане — така че овен или код може да ви достигне без интернет."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov pronalazi drugog pastira kako stoji pored vas - kada oboje protresete telefone, ili kada neko u blizini podijeli šifru za preuzimanje - tako da ovan ili šifra mogu doći do vas bez interneta."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov troba un altre pastor al teu costat, quan tots dos sacsejades el telèfon o quan algú a prop comparteix un codi de recollida, de manera que un RAM o un codi us poden arribar sense Internet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov najde dalšího pastýře, který stojí vedle vás – když oba zatřesete telefony nebo když někdo poblíž sdělí kód vyzvednutí – takže se k vám může dostat beran nebo kód bez internetu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov finder en anden hyrde stående ved siden af ​​dig - når I begge ryster på dine telefoner, eller når nogen i nærheden deler en afhentningskode - så en ram eller en kode kan nå dig uden internet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov findet einen anderen Hirten direkt neben dir – wenn ihr beide eure Handys schüttelt oder jemand in der Nähe einen Abholcode teilt –, damit ein Widder oder ein Code dich auch ohne Internet erreicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Μπαράνοφ βρίσκει έναν άλλο βοσκό να στέκεται δίπλα σας — όταν κουνάτε και οι δύο τα τηλέφωνά σας ή όταν κάποιος κοντά μοιράζεται έναν κωδικό παραλαβής — έτσι ώστε ένας κριός ή ένας κωδικός να μπορεί να σας φτάσει χωρίς το διαδίκτυο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov finds another shepherd standing next to you — when you both shake your phones, or when someone nearby shares a pickup code — so a ram or a code can reach you without the internet."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov finds another shepherd standing next to you — when you both shake your phones, or when someone nearby shares a pickup code — so a ram or a code can reach you without the internet."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov finds another shepherd standing next to you — when you both shake your phones, or when someone nearby shares a pickup code — so a ram or a code can reach you without the internet."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov finds another shepherd standing next to you — when you both shake your phones, or when someone nearby shares a pickup code — so a ram or a code can reach you without the internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov encuentra a otro pastor cerca de ti (cuando ambos agitan sus teléfonos o alguien comparte un código) para que un carnero o código te llegue sin Internet."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov encuentra a otro pastor cerca de ti (cuando ambos agitan sus teléfonos o alguien comparte un código) para que un carnero o código te llegue sin Internet."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov leiab teie kõrval seismas teise karjase – kui te mõlemad oma telefone raputate või kui keegi läheduses jagab järelevõtmiskoodi –, et jäär või kood jõuaks teieni ilma internetita."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov-ek beste artzain bat aurkituko du zure ondoan —biek telefonoa astintzen duzunean edo gertuko norbaitek jasotzeko kode bat partekatzen duenean—, ahari bat edo kode bat zuregana iritsi daiteke Internet gabe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov löytää toisen paimenen seisovan vieressäsi – kun molemmat ravistatte puhelimianne tai kun joku lähistöllä jakaa noutokoodin – jotta pässi tai koodi voi tavoittaa sinut ilman internetiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov trouve un autre berger près de toi – quand vous secouez tous les deux vos téléphones ou que quelqu'un partage un code – pour qu'un bélier ou un code t'atteigne sans Internet."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov trouve un autre berger près de toi – quand vous secouez tous les deux vos téléphones ou que quelqu'un partage un code – pour qu'un bélier ou un code t'atteigne sans Internet."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Faigheann Baranov aoire eile ina sheasamh in aice leat - nuair a chroitheann tú do ghutháin, nó nuair a roinneann duine in aice leat cód bailithe - ionas gur féidir le reithe nó cód dul i dteagmháil leat gan an t-idirlíon."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov atopa outro pastor parado ao teu lado, cando axitas o teu teléfono ou cando alguén cerca comparte un código de recollida, para que un carneiro ou un código poida chegar a ti sen internet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברנוב מוצא רועה אחר עומד לידך - כששניכם מנערים את הטלפונים שלך, או כשמישהו בקרבת מקום חולק קוד איסוף - אז איל או קוד יכולים להגיע אלייך בלי האינטרנט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बारानोव को आपके बगल में एक और चरवाहा खड़ा मिलता है - जब आप दोनों अपने फोन हिलाते हैं, या जब आस-पास कोई व्यक्ति पिकअप कोड साझा करता है - तो एक रैम या एक कोड इंटरनेट के बिना आप तक पहुंच सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov nalazi drugog pastira kako stoji pored vas — kada oboje protresete telefone ili kada netko u blizini podijeli šifru za preuzimanje — tako da ovan ili šifra mogu doći do vas bez interneta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov egy másik pásztort talál melletted – amikor mindketten megrázzák a telefonjukat, vagy ha valaki a közelben megosztja a felvételi kódot –, így egy kos vagy egy kód internet nélkül is elérheti Önt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov menemukan penggembala lain yang berdiri di samping Anda — saat Anda berdua menggoyangkan ponsel, atau saat seseorang di sekitar membagikan kode pengambilan — sehingga ram atau kode dapat menghubungi Anda tanpa internet."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov finnur annan fjárhirði sem stendur við hliðina á þér - þegar þið hristið bæði símana eða þegar einhver í nágrenninu deilir sendikóða - svo hrútur eða kóða geti náð í þig án internetsins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov trova un altro pastore in piedi accanto a te – quando entrambi scuoti i telefoni o quando qualcuno nelle vicinanze condivide un codice di ritiro – in modo che un ariete o un codice possano raggiungerti senza Internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バラノフ氏は、二人で携帯電話を振っているときや、近くにいる誰かがピックアップ コードを共有しているときに、あなたの隣に立っている別の羊飼いを見つけます。これにより、インターネットなしでラムやコードが届くようになります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბარანოვი სხვა მწყემსს აღმოაჩენს, რომელიც შენს გვერდით დგას - როცა ორივე აკანკალებთ ტელეფონებს, ან როცა ვინმე ახლომახლო იზიარებს პიკაპის კოდს - ასე რომ, ვერძი ან კოდი ინტერნეტის გარეშე მოგაწვდიან."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов қасыңызда тұрған басқа шопан тауып алады — екеуің де телефондарыңды сілкіп тұрғанда немесе жақын жердегі біреу алып кету кодын бөліскенде — қошқар немесе код сізге интернетсіз жетеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov는 두 사람이 모두 휴대폰을 흔들거나 근처에 있는 누군가가 픽업 코드를 공유할 때 여러분 옆에 서 있는 다른 목자를 발견합니다. 따라서 인터넷 없이도 램이나 코드가 여러분에게 도달할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranovas randa šalia jūsų stovintį kitą piemenį – kai abu papurtote telefonus arba kai kas nors netoliese dalijasi paėmimo kodu – todėl avinas ar kodas gali jus pasiekti be interneto."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranovs atrod citu ganu, kas stāv jums blakus — kad jūs abi pakratat savus tālruņus vai kad kāds tuvumā dalās ar saņemšanas kodu —, lai auns vai kods varētu jūs sasniegt bez interneta."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов наоѓа друг овчар како стои до вас - кога двајцата ги тресете телефоните или кога некој во близина споделува код за пикап - за да може овен или шифра да ви стигне без интернет."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov menemui gembala lain berdiri di sebelah anda — apabila anda berdua menggoncang telefon anda, atau apabila seseorang yang berdekatan berkongsi kod pikap — supaya seekor ram atau kod boleh menghubungi anda tanpa internet."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov isib ragħaj ieħor bilwieqfa ħdejk — meta t-tnejn ħawwdu t-telefowns tiegħek, jew meta xi ħadd fil-qrib jaqsam kodiċi ta’ pickup — sabiex muntun jew kodiċi jistgħu jilħquk mingħajr l-internet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov finner en annen hyrde som står ved siden av deg - når dere begge rister telefonene, eller når noen i nærheten deler en hentekode - slik at en ram eller en kode kan nå deg uten internett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov vindt een andere herder naast je staan ​​– wanneer jullie allebei met je telefoon schudden, of wanneer iemand in de buurt een ophaalcode deelt – zodat een ram of een code je kan bereiken zonder internet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov znajduje obok ciebie innego pasterza — kiedy oboje potrząśniecie telefonami lub gdy ktoś w pobliżu udostępni kod do odbioru — aby baran lub kod mógł dotrzeć do was bez Internetu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov encontra outro pastor ao seu lado – quando vocês dois agitam seus telefones ou quando alguém próximo compartilha um código de coleta – para que um carneiro ou código possa alcançá-lo sem a internet."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov encontra outro pastor ao seu lado – quando vocês dois agitam seus telefones ou quando alguém próximo compartilha um código de coleta – para que um carneiro ou código possa alcançá-lo sem a internet."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov găsește un alt cioban care stă lângă tine – când vă scuturați amândoi telefoanele sau când cineva din apropiere împărtășește un cod de preluare – astfel încât un berbec sau un cod să vă poată ajunge fără internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov находит другого пастуха рядом с тобой — когда вы оба встряхиваете телефоны или кто-то поблизости делится кодом получения, — чтобы баран или код дошли до тебя без интернета."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov nájde iného pastiera, ktorý stojí vedľa vás – keď obaja potrasiete telefónmi alebo keď niekto nablízku zdieľa kód na vyzdvihnutie – takže baran alebo kód vás môžu zastihnúť bez internetu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov najde drugega pastirja, ki stoji zraven tebe – ko oba streseta telefona ali ko nekdo v bližini deli kodo za prevzem – tako da te lahko oven ali koda doseže brez interneta."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov gjen një bari tjetër që qëndron pranë jush - kur të dy tundni telefonat ose kur dikush afër ndan një kod marrjeje - kështu që një dash ose një kod mund t'ju arrijë pa internet."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов проналази другог пастира како стоји поред вас — када обојица тресете телефоне или када неко у близини подели шифру за преузимање — тако да ован или шифра могу да дођу до вас без интернета."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov hittar en annan herde som står bredvid dig - när ni båda skakar era telefoner, eller när någon i närheten delar en hämtkod - så att en bagge eller en kod kan nå dig utan internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov พบคนเลี้ยงแกะอีกคนหนึ่งยืนอยู่ข้างคุณ เมื่อคุณทั้งคู่เขย่าโทรศัพท์ หรือเมื่อมีคนใกล้เคียงแบ่งปันรหัสรับสินค้า เพื่อให้แกะหรือรหัสสามารถติดต่อคุณได้โดยไม่ต้องใช้อินเทอร์เน็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov, ikiniz de telefonlarınızı salladığınızda ya da yakındaki biri bir alma kodunu paylaştığında, internet olmadan da bir koç ya da kod size ulaşsın diye yanınızda duran başka bir çoban buluyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov знаходить іншого пастуха поруч із тобою — коли ви обидва струшуєте телефони або хтось поблизу ділиться кодом отримання, — щоб баран чи код дійшли до тебе без інтернету."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov tìm thấy một người chăn cừu khác đang đứng cạnh bạn — khi cả hai cùng lắc điện thoại hoặc khi ai đó ở gần chia sẻ mã nhận hàng — để ram hoặc mã có thể liên hệ với bạn mà không cần internet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "巴拉诺夫发现另一个牧羊人站在你旁边——当你们都摇动手机时，或者当附近有人分享取货代码时——这样公羊或代码就可以在没有互联网的情况下联系到你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "巴拉諾夫發現另一個牧羊人站在你旁邊——當你們都搖動手機時，或者當附近有人分享取貨代碼時——這樣公羊或代碼就可以在沒有互聯網的情況下聯繫到你。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "巴拉諾夫發現另一個牧羊人站在你旁邊——當你們都搖動手機時，或者當附近有人分享取貨代碼時——這樣公羊或代碼就可以在沒有互聯網的情況下聯繫到你。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم بارانوف موقعك الحالي لتحديد المكان الذي تبدأ فيه رحلة الرسالة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов използва вашето текущо местоположение, за да зададе откъде започва пътуването на писмото."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov koristi vašu trenutnu lokaciju da odredi gdje počinje putovanje pisma."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov utilitza la vostra ubicació actual per definir on comença el viatge d'una carta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov používá vaši aktuální polohu k nastavení, kde začíná cesta dopisu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov bruger din nuværende placering til at angive, hvor et brevs rejse starter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov verwendet deinen aktuellen Standort, um den Startpunkt der Reise eines Briefes festzulegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Baranov χρησιμοποιεί την τρέχουσα τοποθεσία σας για να ορίσει πού ξεκινά το ταξίδι ενός γράμματος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov uses your current location to set where a letter's journey starts."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov uses your current location to set where a letter's journey starts."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov uses your current location to set where a letter's journey starts."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov uses your current location to set where a letter's journey starts."
          }
        },
        "es": {
          "stringUnit": {
