        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "巴拉诺夫会查看您即将举行的活动，为您携带的信件建议空投目的地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
