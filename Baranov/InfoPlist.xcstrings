    "NSGKFriendListUsageDescription": {
      "comment": "Privacy - GameKit Friend List Usage Description",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُظهر بارانوف أصدقاءك في Game Center حتى تتمكن من تسليم كبش لأحدهم ومقارنة الطاولات معهم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov показва вашите приятели от Game Center, за да можете да подадете овен на един от тях и да сравните масите с тях."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov pokazuje svoje prijatelje iz Game Centera tako da možete jednom od njih dati ovna i uporediti tabele sa njima."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov mostra als teus amics del Game Center perquè puguis lliurar un ariet a un d'ells i comparar taules amb ells."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov ukazuje vašim přátelům v Game Center, abyste mohli jednomu z nich předat berana a porovnat s nimi stoly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov viser dine Game Center-venner, så du kan give en ram til en af ​​dem og sammenligne borde med dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov zeigt deine Game Center-Freunde an, damit du einem von ihnen einen Widder übergeben und Tabellen mit ihnen vergleichen kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Baranov δείχνει τους φίλους σας στο Game Center, ώστε να μπορείτε να δώσετε ένα κριάρι σε έναν από αυτούς και να συγκρίνετε πίνακες με αυτούς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov shows your Game Center friends so you can hand a ram to one of them and compare tables with them."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov shows your Game Center friends so you can hand a ram to one of them and compare tables with them."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov shows your Game Center friends so you can hand a ram to one of them and compare tables with them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov shows your Game Center friends so you can hand a ram to one of them and compare tables with them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov muestra a tus amigos de Game Center para que puedas pasarle un carnero a uno de ellos y comparar tablas con ellos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov muestra a tus amigos de Game Center para que puedas pasarle un carnero a uno de ellos y comparar tablas con ellos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov näitab teie Game Centeri sõpru, et saaksite ühele neist jäära ulatada ja nendega tabeleid võrrelda."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov-ek zure Game Center-eko lagunak erakusten dizkizu, haietako bati ahari bat eman diezaiozun eta haiekin mahaiak alderatu ditzazun."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov näyttää Game Center -ystävillesi, jotta voit ojentaa pässin yhdelle heistä ja vertailla pöytiä heidän kanssaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov montre tes amis Game Center afin que tu puisses confier un bélier à l'un d'eux et comparer vos classements."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov montre tes amis Game Center afin que tu puisses confier un bélier à l'un d'eux et comparer vos classements."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Taispeánann Baranov do chairde san Ionad Cluiche ionas gur féidir leat reithe a thabhairt do cheann acu agus táblaí a chur i gcomparáid leo."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov móstralles aos teus amigos do Game Center para que poidas entregarlle un carneiro a un deles e comparar táboas con eles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברנוב מראה לחברים שלך ב-Game Center כדי שתוכל למסור איל לאחד מהם ולהשוות איתם טבלאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बारानोव आपके गेम सेंटर मित्रों को दिखाता है ताकि आप उनमें से एक को एक रैम सौंप सकें और उनके साथ तालिकाओं की तुलना कर सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov pokazuje vaše prijatelje iz Game Centera tako da možete dati ovna jednom od njih i usporediti stolove s njima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov megmutatja Game Center barátaidnak, hogy átnyújthass egy kost egyiküknek, és összehasonlítsd velük az asztalokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov menunjukkan kepada teman-teman Game Center Anda sehingga Anda dapat memberikan ram kepada salah satu dari mereka dan membandingkan tabel dengan mereka."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov sýnir Game Center vinum þínum svo þú getir afhent einum þeirra hrút og borið saman borð við þá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov mostra i tuoi amici del Game Center in modo che tu possa dare un ariete a uno di loro e confrontare i tavoli con loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov は Game Center の友達を見せて、そのうちの 1 人に羊を渡してテーブルを比較できるようにします。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბარანოვი აჩვენებს თქვენს თამაშის ცენტრის მეგობრებს, ასე რომ თქვენ შეგიძლიათ გადასცეთ ვერძი ერთ-ერთ მათგანს და შეადაროთ ცხრილები მათთან."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов ойын орталығының достарын көрсетеді, сонда сіз олардың біріне қошқар беріп, олармен кестелерді салыстыра аласыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov는 Game Center 친구들에게 숫양을 건네주고 테이블을 비교할 수 있도록 보여줍니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranovas parodo jūsų žaidimų centro draugams, kad galėtumėte vienam iš jų įteikti aviną ir palyginti su jais lenteles."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranovs parāda jūsu Game Center draugus, lai jūs varētu kādam no viņiem pasniegt aunu un salīdzināt ar viņiem galdus."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов ги покажува вашите пријатели од Game Center за да можете да му дадете овен на еден од нив и да ги споредите табелите со нив."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov menunjukkan rakan Pusat Permainan anda supaya anda boleh menyerahkan seekor domba jantan kepada salah seorang daripada mereka dan membandingkan jadual dengan mereka."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov juri lill-ħbieb tiegħek taċ-Ċentru tal-Logħob sabiex tkun tista' tagħti muntun lil wieħed minnhom u tqabbel it-tabelli magħhom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov viser Game Center-vennene dine slik at du kan gi en ram til en av dem og sammenligne tabeller med dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov laat het je Game Center-vrienden zien, zodat je een ram aan een van hen kunt overhandigen en tafels met hen kunt vergelijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov pokazuje znajomym Game Center, dzięki czemu możesz podać barana jednemu z nich i porównać z nimi stoły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov mostra seus amigos do Game Center para que você possa entregar um carneiro a um deles e comparar as tabelas com eles."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov mostra seus amigos do Game Center para que você possa entregar um carneiro a um deles e comparar as tabelas com eles."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov le arată prietenilor din Game Center, astfel încât să puteți înmâna un berbec unuia dintre ei și să comparați mesele cu ei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov показывает твоих друзей в Game Center, чтобы ты мог передать барана одному из них и сравнивать результаты в таблицах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov ukáže vašim priateľom v Game Center, aby ste mohli jednému z nich podať barana a porovnať s nimi stoly."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov pokaže vaše prijatelje iz Game Center, tako da lahko enemu od njih predate ovna in z njimi primerjate mize."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov u tregon miqve tuaj të Game Center që të mund t'i dorëzoni një dash njërit prej tyre dhe të krahasoni tabelat me ta."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов показује своје пријатеље из Гаме Центер-а тако да можете једном од њих дати овна и упоредити табеле са њима."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov visar dina Game Center-vänner så att du kan ge en bagge till en av dem och jämföra bord med dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov แสดงให้เพื่อน Game Center ของคุณดู เพื่อให้คุณสามารถส่งแกะให้หนึ่งในนั้นและเปรียบเทียบตารางกับพวกเขาได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov Game Center arkadaşlarınıza gösteriyor, böylece onlardan birine koç verebilir ve onlarla masaları karşılaştırabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov показує твоїх друзів у Game Center, щоб ти міг передати барана одному з них і порівнювати результати в таблицях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov giới thiệu cho bạn bè trong Game Center của bạn để bạn có thể đưa ram cho một trong số họ và so sánh bảng với họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "巴拉诺夫向您的游戏中心朋友展示，这样您就可以将一只公羊递给其中一个并与他们比较桌子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "巴拉諾夫向您的遊戲中心朋友展示，這樣您就可以將一隻公羊遞給其中一個並與他們比較桌子。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "巴拉諾夫向您的遊戲中心朋友展示，這樣您就可以將一隻公羊遞給其中一個並與他們比較桌子。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ بارانوف عدد خطواتك، بما في ذلك الخطوات المسجلة بواسطة Apple Watch، لتوجيه الكباش الناقل الخاص بك نحو وجهاتهم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov чете броя на стъпките ви, включително стъпките, записани от вашия Apple Watch, за да преведе вашите превозни средства към техните дестинации."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov čita vaš broj koraka, uključujući korake koje je zabilježio vaš Apple Watch, kako bi vodio vaše ramove na nosaču prema njihovim odredištima."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov llegeix el vostre recompte de passos, inclosos els passos enregistrats pel vostre Apple Watch, per caminar amb el vostre operador cap a les seves destinacions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov čte váš počet kroků, včetně kroků zaznamenaných vašimi Apple Watch, aby dopravil vaše berany do jejich cílů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov læser dit skridttæller, inklusive skridt registreret af dit Apple Watch, for at gå dine bærervæddere mod deres destinationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov liest deine Schrittzahl, auch von deiner Apple Watch, um deine Boten-Widder ihrem Ziel entgegenzuführen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Baranov διαβάζει τον αριθμό των βημάτων σας, συμπεριλαμβανομένων των βημάτων που καταγράφονται από το Apple Watch σας, για να περπατήσει τους κριούς σας προς τον προορισμό τους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov reads your step count, including steps recorded by your Apple Watch, to walk your carrier rams toward their destinations."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov reads your step count, including steps recorded by your Apple Watch, to walk your carrier rams toward their destinations."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov reads your step count, including steps recorded by your Apple Watch, to walk your carrier rams toward their destinations."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov reads your step count, including steps recorded by your Apple Watch, to walk your carrier rams toward their destinations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov lee tu recuento de pasos, incluidos los de tu Apple Watch, para que tus carneros carteros avancen hacia su destino."
