    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينظر بارانوف إلى أحداثك القادمة لاقتراح وجهات AirDrop للرسائل التي تحملها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов разглежда предстоящите ви събития, за да предложи AirDrop дестинации за писмата, които носите."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov gleda na vaše predstojeće događaje kako bi predložio AirDrop destinacije za pisma koja nosite."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov analitza els vostres propers esdeveniments per suggerir destinacions d'AirDrop per a les cartes que porteu."
