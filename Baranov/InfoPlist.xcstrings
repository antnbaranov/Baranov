            "state": "translated",
            "value": "Baranov analizează evenimentele viitoare pentru a sugera destinații AirDrop pentru scrisorile pe care le transportați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov просматривает твои предстоящие события, чтобы предлагать пункты назначения AirDrop для писем, которые ты несёшь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov sa pozerá na vaše nadchádzajúce udalosti, aby navrhol destinácie AirDrop pre listy, ktoré nosíte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov si ogleda vaše prihajajoče dogodke in predlaga destinacije AirDrop za pisma, ki jih prenašate."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov shikon ngjarjet tuaja të ardhshme për të sugjeruar destinacionet AirDrop për letrat që mbani."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов гледа на ваше предстојеће догађаје да би предложио АирДроп дестинације за писма која носите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov tittar på dina kommande evenemang för att föreslå AirDrop-destinationer för brev du bär."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov ดูกิจกรรมที่กำลังจะมาถึงของคุณเพื่อแนะนำจุดหมายปลายทาง AirDrop สำหรับจดหมายที่คุณถืออยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov, taşıdığınız mektuplar için AirDrop varış noktaları önermek üzere yaklaşan etkinliklerinize bakıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov переглядає твої майбутні події, щоб пропонувати пункти призначення AirDrop для листів, які ти несеш."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov xem xét các sự kiện sắp tới của bạn để đề xuất các điểm đến AirDrop cho những bức thư bạn mang theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "巴拉诺夫会查看您即将举行的活动，为您携带的信件建议空投目的地。"
