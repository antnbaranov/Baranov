          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov đọc số bước của bạn, bao gồm các bước được Apple Watch ghi lại, để hướng dẫn nhà cung cấp dịch vụ của bạn hướng tới điểm đến của họ."
