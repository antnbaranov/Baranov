        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov-ek zure urratsen zenbaketa irakurtzen du, zure Apple Watch-ek grabatutako urratsak barne, zure garraiolarien ahariak beren helmugetara ibiltzeko."
          }
