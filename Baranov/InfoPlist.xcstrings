        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov examine tes événements à venir pour suggérer des destinations AirDrop pour les lettres que tu transportes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov examine tes événements à venir pour suggérer des destinations AirDrop pour les lettres que tu transportes."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Féachann Baranov ar na himeachtaí atá agat le teacht chun cinn scríbe AirDrop a mholadh do litreacha atá á n-iompar agat."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov analiza os teus próximos eventos para suxerir destinos de AirDrop para as cartas que levas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברנוב מסתכל על האירועים הקרובים שלך כדי להציע יעדי AirDrop למכתבים שאתה נושא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बारानोव आपके आने वाले कार्यक्रमों को देखकर आपके द्वारा ले जाने वाले पत्रों के लिए एयरड्रॉप गंतव्यों का सुझाव देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov gleda vaše nadolazeće događaje kako bi predložio AirDrop odredišta za pisma koja nosite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov megnézi a közelgő eseményeit, hogy AirDrop úti célokat javasoljon az Ön által szállított levelek számára."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov melihat acara mendatang Anda untuk menyarankan tujuan AirDrop untuk surat yang Anda bawa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov skoðar komandi viðburði þína til að stinga upp á AirDrop áfangastaði fyrir bréf sem þú ert með."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov esamina i tuoi prossimi eventi per suggerire destinazioni AirDrop per le lettere che stai trasportando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov は、今後のイベントを調べて、あなたが運ぶ手紙の AirDrop 宛先を提案します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბარანოვი ათვალიერებს თქვენს მომავალ მოვლენებს, რათა შემოგთავაზოთ AirDrop მიმართულებები იმ წერილებისთვის, რომლებიც თქვენ ატარებთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов сіз алып жүрген хаттар үшін AirDrop бағыттарын ұсыну үшін алдағы оқиғаларыңызға қарайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov는 다가오는 이벤트를 살펴보고 들고 있는 편지의 AirDrop 목적지를 제안합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranovas žiūri į jūsų būsimus įvykius, kad pasiūlytų AirDrop paskirties vietas jūsų vežamiems laiškams."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranovs aplūko jūsu gaidāmos notikumus, lai ieteiktu AirDrop galamērķus vēstulēm, kuras pārvadājat."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов ги разгледува вашите претстојни настани за да предложи AirDrop дестинации за писмата што ги носите."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov melihat acara anda yang akan datang untuk mencadangkan destinasi AirDrop untuk surat yang anda bawa."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov iħares lejn l-avvenimenti li jmiss tiegħek biex jissuġġerixxi destinazzjonijiet AirDrop għall-ittri li qed iġorr."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov ser på dine kommende arrangementer for å foreslå AirDrop-destinasjoner for brev du har med deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov kijkt naar uw aankomende evenementen om AirDrop-bestemmingen voor te stellen voor brieven die u bij u heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov przegląda nadchodzące wydarzenia, aby zasugerować miejsca docelowe AirDrop dla listów, które nosisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
