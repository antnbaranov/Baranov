        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov lit ton nombre de pas, y compris depuis ton Apple Watch, pour faire avancer tes béliers porteurs vers leur destination."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Léann Baranov do chomhaireamh céimeanna, lena n-áirítear céimeanna arna dtaifeadadh ag do Apple Watch, chun do reithí iompróra a shiúl i dtreo a gceann scríbe."
