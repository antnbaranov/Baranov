        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov le o teu reconto de pasos, incluídos os pasos rexistrados polo teu Apple Watch, para camiñar ao teu operador cara aos seus destinos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בראנוב קורא את ספירת הצעדים שלך, כולל צעדים שנרשמו על ידי Apple Watch שלך, כדי ללכת עם האילים המובילים שלך לעבר היעדים שלהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बारानोव आपके वाहक मेम्स को उनके गंतव्य की ओर ले जाने के लिए, आपके ऐप्पल वॉच द्वारा रिकॉर्ड किए गए कदमों सहित, आपके कदमों की गिनती पढ़ता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov očitava vaš broj koraka, uključujući korake koje je zabilježio vaš Apple Watch, kako bi vodio vaše nosače prema njihovim odredištima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov beolvassa az Ön lépésszámát, beleértve az Apple Watch által rögzített lépéseket is, hogy a szolgáltató kosait úti céljuk felé irányítsa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov membaca jumlah langkah Anda, termasuk langkah yang dicatat oleh Apple Watch Anda, untuk memandu operator Anda menuju tujuannya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov les skrefatöluna þína, þar á meðal skref skráð af Apple Watch, til að ganga með hrútana þína í átt að áfangastaðnum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov legge il conteggio dei tuoi passi, compresi i passi registrati dal tuo Apple Watch, per accompagnare il tuo operatore verso le loro destinazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov は、Apple Watch によって記録された歩数を含むあなたの歩数を読み取り、キャリアラムを目的地に向かって歩きます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბარანოვი კითხულობს თქვენი ნაბიჯების რაოდენობას, მათ შორის, თქვენი Apple Watch-ის მიერ ჩაწერილი ნაბიჯების ჩათვლით, რათა თქვენი გადამზიდავი ვერძები დანიშნულების ადგილამდე მიაცილონ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов сіздің қадамдарыңызды, соның ішінде Apple Watch арқылы жазылған қадамдарды оқиды, тасымалдаушы қошқарларды межелі жерлеріне қарай жүреді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov는 Apple Watch에 기록된 걸음 수를 포함하여 걸음 수를 판독하여 캐리어 램을 목적지로 안내합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranovas nuskaito jūsų žingsnių skaičių, įskaitant žingsnius, kuriuos užfiksavo jūsų „Apple Watch“, kad nuves jūsų vežėjo avinus link kelionės tikslo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranovs nolasa jūsu soļu skaitu, tostarp soļus, kas reģistrēti jūsu Apple Watch, lai virzītu jūsu mobilo sakaru operatoru uz galamērķi."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов го чита вашиот број на чекори, вклучително и чекорите снимени од вашиот Apple Watch, за да ги одиме вашите овни-превозници кон нивните дестинации."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov membaca kiraan langkah anda, termasuk langkah-langkah yang direkodkan oleh Apple Watch anda, untuk membawa ram pembawa anda ke destinasi mereka."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov jaqra l-għadd tal-passi tiegħek, inklużi l-passi rreġistrati mill-Apple Watch tiegħek, biex jimxi l-imtaten trasportatur tiegħek lejn id-destinazzjonijiet tagħhom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov leser skritttellingen din, inkludert skritt registrert av Apple Watch, for å gå bærerammene dine mot deres destinasjoner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov leest uw stappentelling, inclusief de stappen die door uw Apple Watch zijn geregistreerd, om uw koerierrammen naar hun bestemming te leiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov odczytuje liczbę kroków, w tym kroki zarejestrowane na zegarku Apple Watch, aby poprowadzić siłowniki nośne w stronę miejsca docelowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov lê sua contagem de passos, incluindo passos registrados pelo seu Apple Watch, para levar seus aríetes até seus destinos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
