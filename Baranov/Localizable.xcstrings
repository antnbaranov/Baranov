    "\"Baranov\" is the maker's surname — it means rams." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"بارانوف\" هو لقب الصانع، ويعني الكباش."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Баранов\" е фамилията на производителя - означава овни."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Baranov\" je prezime proizvođača — znači ovnovi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Baranov\" és el cognom del fabricant; vol dir moltons."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Baranov\" je příjmení výrobce - znamená berani."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Baranov\" er producentens efternavn - det betyder væddere."
          }
        },
