    "It'll carry your letters for as long as you keep Baranov.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird deine Briefe tragen, solange du Baranov nutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It'll carry your letters for as long as you keep Baranov."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevará tus cartas mientras conserves Baranov."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il transportera vos lettres aussi longtemps que vous garderez Baranov."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porterà le tue lettere finché userai Baranov."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたがBaranovを使い続ける限り、この羊が手紙を運びます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он будет доставлять ваши письма всё время, пока с вами Baranov."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要你使用Baranov，它就会一直为你送信。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще носи писмата ви, докато държите Баранов."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Portarà les teves cartes mentre mantinguis Baranov."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosit će vaša pisma sve dok čuvate Baranova."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف تحمل رسائلك طالما أنك تحتفظ ببارانوف."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det vil bære dine breve, så længe du beholder Baranov."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponese vaše dopisy tak dlouho, dokud si necháte Baranova."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "It'll carry your letters for as long as you keep Baranov."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "It'll carry your letters for as long as you keep Baranov."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It'll carry your letters for as long as you keep Baranov."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα κουβαλάει τα γράμματά σου όσο κρατάς τον Μπαράνοφ."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevará tus cartas mientras te quedes con Baranov."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See kannab teie kirju nii kaua, kuni hoiate Baranovit."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zure gutunak eramango ditu Baranov mantentzen duzun bitartean."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il transportera vos lettres aussi longtemps que vous garderez Baranov."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se kantaa kirjeitäsi niin kauan kuin pidät Baranovia."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Iompróidh sé do litreacha chomh fada agus a choimeádfaidh tú Baranova."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Levará as túas cartas mentres conserves a Baranov."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה ישא את המכתבים שלך כל עוד אתה שומר על ברנוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप बारानोव को रखेंगे, यह आपके पत्रों को ले जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosit će vaša pisma sve dok budete držali Baranova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Addig hordozza a leveleit, amíg Baranovot megtartja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu akan membawa surat-suratmu selama kamu menyimpan Baranov."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það mun bera bréfin þín eins lengi og þú heldur Baranov."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ის ატარებს თქვენს წერილებს მანამ, სანამ ბარანოვს შეინახავთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барановты ұстағанша ол сіздің хаттарыңызды алып жүреді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov를 보관하는 한 편지를 가지고 다닐 것입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jame jūsų laiškai bus nešioti tol, kol laikysite Baranovą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas nesīs jūsu vēstules tik ilgi, kamēr jūs paturēsit Baranovu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ќе ги носи твоите писма се додека го чуваш Баранов."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia akan membawa surat anda selagi anda menyimpan Baranov."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se jġorr l-ittri tiegħek sakemm iżżomm lil Baranov."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det vil bære brevene dine så lenge du beholder Baranov."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bewaart je brieven zolang je Baranov houdt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Będzie nosić twoje listy tak długo, jak będziesz zatrzymywał Baranowa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele carregará suas cartas enquanto você mantiver Baranov."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele carregará suas cartas enquanto você mantiver Baranov."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți va purta scrisorile atâta timp cât îl ții pe Baranov."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponesie vaše listy tak dlho, ako si necháte Baranova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosil bo tvoja pisma, dokler imaš Baranova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Do të mbajë letrat tuaja për aq kohë sa ju mbani Baranov."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Носиће ваша писма све док чувате Баранова."
