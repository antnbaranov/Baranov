    "An estimate at %@ steps a day. Every step you take moves %@ one metre closer.": {
      "comment": "A footnote that provides a rough estimate of how far the seal is from being opened.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An estimate at %1$@ steps a day. Every step you take moves %2$@ one metre closer."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una estimació de %@ passos al dia. Cada pas que fas s'apropa %@ un metre."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Приблизително %@ стъпки на ден. Всяка ваша стъпка приближава %@ един метър по-близо."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدير بـ %@ خطوة في اليوم. كل خطوة تخطوها تقترب %@ من مسافة متر واحد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Procjena na %@ koraka dnevno. Svaki vaš korak približava se %@ za jedan metar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
