    "Name changes are locked for 24 hours after receiving a letter to prevent delivery spoofing." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم قفل تغييرات الاسم لمدة 24 ساعة بعد تلقي خطاب لمنع انتحال التسليم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промените в името се заключват за 24 часа след получаване на писмо, за да се предотврати фалшифициране на доставката."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promjene imena su zaključane 24 sata nakon prijema pisma kako bi se spriječilo lažiranje isporuke."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
