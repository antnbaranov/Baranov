    "Far, far up the Sea to Sky. Keep trotting." : {
      "comment" : "Text for the \"Whistler\" feat.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعيدًا، بعيدًا عن البحر إلى السماء. استمر في الهرولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далеч, далеч нагоре в морето до небето. Продължавайте да тръсате."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daleko, daleko od mora do neba. Nastavite kasati."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lluny, molt amunt del mar al cel. Segueix trotant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daleko, daleko po moři do nebe. Klusejte dál."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langt, langt op af havet til himlen. Fortsæt med at trave."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weit, weit das Meer hinauf zum Himmel. Trab weiter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μακριά, μακριά από τη θάλασσα στον ουρανό. Συνέχισε να τρέξεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Far, far up the Sea to Sky. Keep trotting."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Far, far up the Sea to Sky. Keep trotting."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Far, far up the Sea to Sky. Keep trotting."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Far, far up the Sea to Sky. Keep trotting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lejos, muy lejos del Mar al Cielo. Sigue trotando."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lejos, muy lejos del Mar al Cielo. Sigue trotando."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaugel, kaugel üle mere taevani. Jätka traavi."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urrun, oso urrun Itsasotik Zerura. Jarraitu trostan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kauas, kauas ylös mereltä taivaalle. Jatka ravia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loin, très loin dans la mer vers le ciel. Continuez à trotter."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loin, très loin dans la mer vers le ciel. Continuez à trotter."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I bhfad suas an fharraige go dtí an spéir saor in aisce,. Coinnigh trotting."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lonxe, moi lonxe do mar ao ceo. Sigue trotando."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רחוק, רחוק במעלה הים עד השמיים. תמשיך לטוס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत दूर, समुद्र से आकाश तक। टहलते रहो."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daleko, daleko od mora do neba. Nastavi kasati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messze, messze fel a tengeren az égig. Ügesse tovább."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jauh, jauh dari Laut ke Langit. Teruslah berlari."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langt, langt upp í sjó til himins. Haltu áfram að brokka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lontano, lontano, dal mare al cielo. Continua a trottare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はるか遠く、海から空まで。小走りを続けてください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შორს, შორს ზღვიდან ცამდე. გააგრძელე ტრიალი."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Алыс, теңізден аспанға дейін. Жүре бер."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "멀리, 멀리 바다에서 하늘까지. 계속해서 뛸 것."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toli, toli nuo jūros iki dangaus. Tęsk ristą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tālu, tālu augšup pa jūru līdz debesīm. Turpini rikšot."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далеку, далеку од морето до небото. Продолжете да трчате."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jauh, jauh dari Laut ke Langit. Terus berlari."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bogħod, 'il bogħod mill-Baħar għal Sema. Żomm it-trott."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langt, langt opp i havet til himmelen. Fortsett å trave."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ver, ver de zee naar de hemel. Blijf draven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daleko, daleko od morza do nieba. Kłusuj dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longe, muito alto, do Mar ao Céu. Continue trotando."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longe, muito alto, do Mar ao Céu. Continue trotando."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Departe, departe de la mare la cer. Continuă să trapească."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далеко-далеко от моря до неба. Продолжайте рысью."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ďaleko, ďaleko po mori až po oblohu. Pokračujte v kluse."
