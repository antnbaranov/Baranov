    "The reel keeps rendering. Its card in the passport shows when it is ready." : {
      "comment" : "A hint for the user that the reel is still rendering.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستمر البكرة في العرض. تظهر بطاقتها في جواز السفر عندما تكون جاهزة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Макарата продължава да се изобразява. Картата му в паспорта показва кога е готов."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolut nastavlja da se renderuje. Njegova kartica u pasošu pokazuje kada je spremna."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rodet continua representant-se. La seva targeta al passaport indica quan està llest."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cívka pokračuje ve vykreslování. Jeho karta v pasu ukazuje, kdy je připraven."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spolen bliver ved med at rendere. Dens kort i passet viser, hvornår den er klar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Rolle rendert weiter. Seine Karte im Reisepass zeigt an, wann es fertig ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κύλινδρος συνεχίζει να αποδίδει. Η κάρτα του στο διαβατήριο δείχνει πότε είναι έτοιμο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reel keeps rendering. Its card in the passport shows when it is ready."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reel keeps rendering. Its card in the passport shows when it is ready."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reel keeps rendering. Its card in the passport shows when it is ready."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reel keeps rendering. Its card in the passport shows when it is ready."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El carrete sigue renderizándose. Su tarjeta en el pasaporte muestra cuando está listo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El carrete sigue renderizándose. Su tarjeta en el pasaporte muestra cuando está listo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rull jätkab renderdamist. Selle kaart passis näitab, kui see on valmis."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bobina errendatzen jarraitzen du. Pasaportean duen txartelak prest dagoenean erakusten du."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kela jatkaa renderöintiä. Sen passissa oleva kortti näyttää, kun se on valmis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bobine continue de s'afficher. Sa carte dans le passeport indique quand il est prêt."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bobine continue de s'afficher. Sa carte dans le passeport indique quand il est prêt."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coinníonn an ríl ag rindreáil. Léiríonn a chárta sa phas nuair a bhíonn sé réidh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O carrete segue renderizado. A súa tarxeta no pasaporte indica cando está listo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסליל ממשיך להופיע. הכרטיס שלו בדרכון מראה מתי הוא מוכן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रील प्रस्तुत करती रहती है। पासपोर्ट में इसका कार्ड दिखाता है कि यह कब तैयार है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolut se nastavlja renderirati. Njegova kartica u putovnici pokazuje kada je spreman."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tekercs folyamatosan renderel. Az útlevélben lévő kártyája mutatja, ha készen van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reel terus dirender. Kartunya di paspor menunjukkan kapan sudah siap."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vindan heldur áfram að gefa sig. Kort þess í vegabréfinu sýnir hvenær það er tilbúið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bobina continua a essere riprodotta. La sua carta nel passaporto mostra quando è pronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リールはレンダリングを続けます。パスポートのカードにいつ準備ができているかが表示されます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "რგოლი აგრძელებს რენდერირებას. მისი ბარათი პასპორტში გვიჩვენებს, როდის არის მზად."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ролик көрсетуді жалғастырады. Төлқұжаттағы картасы оның қашан дайын екенін көрсетеді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "릴이 계속 렌더링됩니다. 여권에 있는 카드가 준비되면 표시됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritė vis atvaizduojama. Jo kortelė pase rodo, kada ji paruošta."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rullītis turpina renderēt. Tās karte pasē parāda, kad tā ir gatava."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ролната продолжува да се рендерира. Нејзината картичка во пасошот покажува кога е подготвена."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kekili itu terus rendering. Kadnya dalam pasport menunjukkan apabila ia sudah siap."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ir-rukkell ikompli jirrendi. Il-karta tagħha fil-passaport turi meta tkun lesta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spolen fortsetter å gjengi. Kortet i passet viser når det er klart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De haspel blijft renderen. Op de kaart in het paspoort staat wanneer hij klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bęben kontynuuje renderowanie. Jego karta w paszporcie pokazuje, kiedy jest gotowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O rolo continua sendo renderizado. Seu cartão no passaporte mostra quando está pronto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O rolo continua sendo renderizado. Seu cartão no passaporte mostra quando está pronto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamburul continuă să se redeze. Cardul său din pașaport arată când este gata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ролик продолжает рендеринг. Его карточка в паспорте показывает, когда он готов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cievka pokračuje vo vykresľovaní. Jeho karta v pase ukazuje, kedy je pripravený."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolut se še naprej upodablja. Njegova kartica v potnem listu pokaže, kdaj je pripravljen."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bobina vazhdon të jepet. Karta e saj në pasaportë tregon se kur është gati."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колут наставља да се приказује. Његова картица у пасошу показује када је спремна."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rullen fortsätter att rendera. Dess kort i passet visar när den är klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รีลยังคงเรนเดอร์อยู่ บัตรที่อยู่ในหนังสือเดินทางจะแสดงเมื่อพร้อม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makara görüntülenmeye devam ediyor. Pasaporttaki kartı hazır olduğunu gösteriyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Котушка продовжує рендеритися. Його картка в паспорті показує, коли він готовий."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn phim tiếp tục hiển thị. Thẻ của nó trong hộ chiếu hiển thị khi nào nó đã sẵn sàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卷轴持续渲染。准备好后，护照上的卡就会显示出来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
