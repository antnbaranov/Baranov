    "%@ to go, or tap when it happens.": {
      "comment": "A label displaying the distance to the next goal. The argument is the distance to the goal.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per anar-hi, o toqueu quan passi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ للانتقال، أو اضغط عند حدوث ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ da idete ili dodirnite kada se to dogodi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, за да отидете, или докоснете, когато се случи."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ for at gå, eller tryk, når det sker."
          }
