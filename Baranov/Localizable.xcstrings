        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vozi se v vaši poštni torbi in se premika z vašimi koraki, ne da bi vzel peresnik na vaš pašnik. Pošiljatelj ga lahko kadar koli zahteva nazaj."
