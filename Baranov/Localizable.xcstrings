    "%@ isn't reachable by road from %@ either. Try a different handoff city.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist von %2$@ aus ebenfalls nicht auf der Straße erreichbar. Wähle eine andere Übergabestadt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ isn't reachable by road from %2$@ either. Try a different handoff city."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampoco se puede llegar por carretera a %1$@ desde %2$@. Prueba con otra ciudad de relevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ n'est pas non plus accessible par la route depuis %2$@. Essayez une autre ville de relais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche %1$@ non è raggiungibile via strada da %2$@. Prova un'altra città di transito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@へも%2$@から道路で到達できません。別の中継都市をお試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В город %1$@ тоже нельзя добраться по дороге из %2$@. Попробуйте другой город пересадки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从%2$@也无法走公路到达%1$@。请尝试另一个中转城市。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampoc es pot arribar a %@ per carretera des de %@. Proveu una ciutat de traspàs diferent."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ също не е достъпен по шосе от %@. Опитайте с различен град за предаване."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ također nije dostupan cestom od %@. Isprobajte drugi handoff grad."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ není dostupné ani po silnici z %@. Zkuste jiné předávací město."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لا يمكن الوصول إليه عن طريق البر من %@ أيضًا. جرب مدينة تسليم مختلفة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er heller ikke tilgængelig ad vej fra %@. Prøv en anden overdragelsesby."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ δεν είναι προσβάσιμο ούτε οδικώς από %@. Δοκιμάστε μια διαφορετική πόλη παράδοσης."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't reachable by road from %@ either. Try a different handoff city."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't reachable by road from %@ either. Try a different handoff city."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't reachable by road from %@ either. Try a different handoff city."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tampoco es accesible por carretera desde %@. Pruebe con una ciudad de transferencia diferente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei pääse ka maanteelt asukohast %@. Proovige teist üleandmislinna."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ere ezin da errepidez irits %@tik. Saiatu beste hiri batean."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei ole tavoitettavissa maanteitse myöskään paikasta %@. Kokeile toista vaihtokaupunkia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est pas non plus accessible par la route depuis %@. Essayez une autre ville de transfert."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ní féidir teacht air de bhóthar ó %@ ach an oiread. Bain triail as cathair handoff eile."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampouco se pode acceder a %@ por estrada desde %@. Proba unha cidade de transferencia diferente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לא נגיש בכביש גם מ-%@. נסה עיר מסירה אחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ से सड़क मार्ग द्वारा भी नहीं पहुंचा जा सकता। एक अलग हैंडऑफ़ शहर का प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Do %@ se također ne može doći cestom iz %@. Pokušajte s drugim gradom primopredaje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sem érhető el közúton innen: %@. Próbáljon ki egy másik átadási várost."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ juga tidak dapat dijangkau melalui jalan darat dari %@. Coba kota serah terima yang lain."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki er heldur hægt að ná til %@ á vegum frá %@. Prófaðu aðra handoff borg."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ასევე მიუწვდომელია საგზაო გზით %@-დან. სცადეთ სხვა გადაცემის ქალაქი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ жерінен %@ жолға да жету мүмкін емес. Басқа қаланы таңдап көріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서도 %@까지 도로로 접근할 수 없습니다. 다른 핸드오프 도시를 시도해 보세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ taip pat nepasiekiamas keliu iš %@. Išbandykite kitą perdavimo miestą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nav sasniedzams arī no %@ pa ceļu. Izmēģiniet citu nodošanas pilsētu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не е достапно по пат ниту од %@. Обидете се со поинаков град за предавање."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ juga tidak boleh dihubungi melalui jalan raya dari %@. Cuba bandar lepasan yang berbeza."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lanqas ma tintlaħaq bit-triq minn %@. Ipprova belt ta' trasferiment differenti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er heller ikke tilgjengelig med bil fra %@. Prøv en annen overleveringsby."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is ook niet over de weg bereikbaar vanaf %@. Probeer een andere overdrachtsstad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do %@ również nie można dojechać samochodem z %@. Wypróbuj inne miasto przekazania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ também não é acessível por estrada a partir de %@. Experimente uma cidade de transferência diferente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ também não é acessível por estrada a partir de %@. Experimente uma cidade de transferência diferente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nici %@ nu este accesibil rutier din %@. Încercați un alt oraș de transfer."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie je dostupné ani po ceste z %@. Skúste iné odovzdacie mesto."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tudi ni dosegljiv po cesti iz %@. Poskusite z drugim mestom predaje."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nuk arrihet as me rrugë nga %@. Provoni një qytet tjetër të dorëzimit."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ није доступан ни путем од %@. Пробајте у другом граду за предају."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan inte nås på väg från %@ heller. Prova en annan överlämningsstad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ไม่สามารถเข้าถึงได้ทางถนนจาก %@ เช่นกัน ลองเมืองแฮนด์ออฟอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'a da %@ adresinden karayoluyla ulaşılamıyor. Farklı bir aktarma şehri deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До %@ також не можна дістатися дорогою з %@. Спробуйте інше місто передачі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cũng không thể đến được bằng đường bộ từ %@. Hãy thử một thành phố bàn giao khác."
          }
        },
        "zh-HK": {
          "stringUnit": {
