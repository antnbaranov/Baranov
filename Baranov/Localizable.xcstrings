    "Ready to set out. Allow location so it knows where your gate is." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على استعداد للانطلاق. السماح بالموقع حتى يعرف مكان بوابتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готов за тръгване. Разрешете местоположението, за да знае къде е портата ви."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spreman za polazak. Dozvolite lokaciju tako da zna gdje se nalazi vaša kapija."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A punt per sortir. Permet la ubicació perquè sàpiga on és la teva porta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připraveni vyrazit. Povolte polohu, aby věděl, kde je vaše brána."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klar til at tage afsted. Tillad placering, så den ved, hvor din gate er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereit zum Aufbruch. Erlaube den Standortzugriff, damit er weiß, wo dein Tor ist."
