        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫양 다섯 마리, 모든 밀랍. 느린 포스팅을 살려주셔서 감사합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Penki avinai, kiekvienas vaškas. Dėkojame, kad palaikote lėtą įrašą."
