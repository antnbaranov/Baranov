    "“%@”" : {
      "comment" : "A label that reads \"A saying of the day\".",
      "isCommentAutoGenerated" : true
    },
    "\"Baranov\" is the maker's surname — it means rams." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Baranov“ ist der Nachname des Schöpfers – es bedeutet Widder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Baranov\" is the maker's surname — it means rams."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Baranov» es el apellido del creador, significa carneros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Baranov » est le nom du créateur — cela signifie béliers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Baranov» è il cognome del creatore — significa arieti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Baranov」は作者の苗字で、「牡羊」を意味します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Баранов» — фамилия автора, что буквально означает «бараны»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Baranov”是创作者的姓氏——意思是公羊。"
          }
        }
      }
    },
