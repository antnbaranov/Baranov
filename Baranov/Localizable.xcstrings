    "Not one step yet. The grass here is apparently excellent.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Още нито една крачка. Тревата тук очевидно е отлична."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni un pas encara. L'herba aquí sembla excel·lent."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Još ni jedan korak. Trava je ovdje očito odlična."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
