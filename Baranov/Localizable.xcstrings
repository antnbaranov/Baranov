        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aur, pădure, bleumarin, prune, cerneală — destinatarul rupe cel pe care l-ați ales."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Золотой, лесной, морской, сливовый, чернильный — получатель сломает именно тот, что вы выбрали."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gold, forest, navy, plum, ink — the recipient breaks the one you chose."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Złoty, leśny, granatowy, śliwkowy, atramentowy — odbiorca przełamie wybrany przez Ciebie kolor."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ari, pylli, marina, kumbulla, bojë - marrësi thyen atë që keni zgjedhur."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Злато, шума, морнарица, шљива, мастило — прималац ломи ону коју сте изабрали."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gold, Waldgrün, Marine, Pflaume, Tinte — der Empfänger bricht die von dir gewählte Farbe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทอง ป่า น้ำเงิน พลัม หมึก ผู้รับจะทำลายสิ่งที่คุณเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gold, Waldgrün, Marine, Pflaume, Tinte — der Empfänger bricht die von dir gewählte Farbe."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Золотий, лісовий, морський, сливовий, чорнильний — одержувач зламає саме той, який ви обрали."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gold, forest, navy, plum, ink — the recipient breaks the one you chose."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流金、苍翠、藏青、郁李、墨黑——收信人将亲手拆开你挑选的火漆印。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "流金、蒼翠、藏青、郁李、墨黑——收信人將親手拆開你挑選的火漆印。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "流金、蒼翠、藏青、郁李、墨黑——收信人將親手拆開你挑選的火漆印。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ოქრო, ტყე, საზღვაო, ქლიავი, მელანი - მიმღები არღვევს თქვენს მიერ არჩეულს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алтын, орман, теңіз, қара өрік, сия - алушы сіз таңдағанды ​​бұзады."
          }
        }
      }
    },
