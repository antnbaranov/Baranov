        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bélier se dirige vers un port et embarque sur un paquet – il traverse tout seul. Secouez les téléphones avec quelqu'un qui traverse plus tôt et il saute sur son téléphone à la place."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oinas kävelee satamaan ja astuu paketille – se ylittää itsekseen. Ravista puhelimia, jos joku ylittää aikaisemmin, ja se hyppää sen sijaan hänen puhelimeensa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Siúlann do reithe go calafort agus bord ar phaicéad - trasnaíonn sé leis féin. Croith gutháin le duine ag trasnú níos luaithe agus téann sé chuig a ghuthán ina ionad sin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu carneiro vai a un porto e aborda un paquete; cruza por si só. Axita os teléfonos con alguén cruzando antes e saltará ao seu teléfono."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האיל שלך הולך לנמל ועולה על חבילה - הוא חוצה בעצמו. נער טלפונים עם מישהו שחוצה מוקדם יותר וזה קופץ לטלפון שלו במקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका राम एक बंदरगाह पर जाता है और एक पैकेट पर चढ़ जाता है - यह अपने आप पार हो जाता है। यदि कोई व्यक्ति जल्दी आ जाता है तो उससे फोन मिलाएँ और फोन उसके फोन पर चला जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš ovan odšeta do luke i ukrca se na paket — sam prelazi. Protresite telefone s nekim prije prijelaza i umjesto toga preskoči na njihov telefon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kos elsétál egy kikötőhöz, és felszáll egy csomagra – az magától átmegy. Rázza meg a telefont, ha valaki hamarabb átmegy, és az inkább a telefonjára ugrik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
