    "Hold a letter for a future date, or lock it to a real spot on the ground." : {
      "comment" : "Tooltip for a lock.clock.fill symbol.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ برسالة لتاريخ مستقبلي، أو قم بتثبيتها في مكان حقيقي على الأرض."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задръжте писмо за бъдеща дата или го заключете на реално място на земята."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadržite pismo za budući datum ili ga zaključajte na stvarno mjesto na tlu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardeu una carta per a una data futura o tanqueu-la en un lloc real a terra."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte dopis pro budoucí schůzku nebo jej uzamkněte na skutečném místě na zemi."
