            "state": "translated",
            "value": "Hrútar sem þegar eru að ganga klára ferð sína á hvorn veginn sem er."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli arieti già in cammino completeranno comunque il loro viaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに歩き始めている牡羊は、そのまま旅を完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 걷고 있는 숫양은 어떤 경우에도 여정을 끝까지 마칩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jau einantys avinai baigia savo kelionę į abi puses."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Auni, kas jau staigā, pabeidz savu ceļojumu jebkurā virzienā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
