        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vozí sa vo vašej poštovej taške a pohybuje sa vašimi krokmi, bez toho, aby vám na pastvine bral pero. Odosielateľ ho môže kedykoľvek požiadať späť."
