    "Letters heading somewhere near your destination can be handed to you.": {
      "comment": "A description of the functionality of the \"Add a Trip\" screen.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Могат да ви бъдат предадени писма, насочени някъде близо до вашата дестинация."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es poden lliurar cartes que es dirigeixen a un lloc proper a la vostra destinació."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisma koja idu negdje blizu vašeg odredišta mogu vam biti uručena."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تسليم الرسائل الموجهة إلى مكان ما بالقرب من وجهتك إليك."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Breve på vej til et sted i nærheden af din destination kan afleveres til dig."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopisy směřující někam blízko vašeho cíle vám mohou být předány."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Letters heading somewhere near your destination can be handed to you."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Letters heading somewhere near your destination can be handed to you."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Letters heading somewhere near your destination can be handed to you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefe, die in die Nähe Ihres Zielortes gehen, können Ihnen ausgehändigt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιστολές που κατευθύνονται κάπου κοντά στον προορισμό σας μπορούν να σας παραδοθούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se le pueden entregar cartas que se dirijan a algún lugar cercano a su destino."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se le pueden entregar cartas que se dirijan a algún lugar cercano a su destino."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zure helmugatik gertu doazen gutunak helarazi dizkizuke."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulle saab kätte anda kirjad, mis suunduvad kuhugi sihtkoha lähedale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lettres se dirigeant quelque part près de votre destination peuvent vous être remises."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lettres se dirigeant quelque part près de votre destination peuvent vous être remises."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjeet, jotka suuntautuvat lähelle määränpäätä, voidaan luovuttaa sinulle."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is féidir litreacha atá in aice le do cheann scríbe a thabhairt duit."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes entregarche cartas que se dirixan a algún lugar próximo ao teu destino."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן למסור לך מכתבים הפונים למקום קרוב ליעד שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके गंतव्य के निकट कहीं जाने वाले पत्र आपको सौंपे जा सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisma koja idu negdje blizu vašeg odredišta mogu vam biti uručena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azok a levelek, amelyek valahol az úti cél közelében vannak, átadhatók Önnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Surat yang menuju ke suatu tempat di dekat tujuan Anda dapat diserahkan kepada Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lettere dirette da qualche parte vicino alla tua destinazione possono esserti consegnate."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hægt er að afhenda þér bréf sem stefna einhvers staðar nálægt áfangastað þínum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目的地の近くに向かう手紙を手渡しできます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წერილები, რომლებიც მიემართება თქვენს დანიშნულების ადგილთან ახლოს, შეგიძლიათ გადმოგცეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баратын жеріңізге жақын жерде жазылған хаттар сізге берілуі мүмкін."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목적지 근처로 향하는 편지를 전달할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jums gali būti įteikti laiškai, nukreipti kažkur netoli jūsų tikslo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēstules, kas virzās kaut kur netālu no jūsu galamērķa, var tikt nodotas jums."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Може да ви бидат предадени писма кои се упатуваат некаде во близина на вашата дестинација."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Surat yang menuju ke suatu tempat berhampiran destinasi anda boleh diserahkan kepada anda."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-ittri li jsegwu x'imkien qrib id-destinazzjoni tiegħek jistgħu jingħatawlek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
