    "Allow Baranov to see your Game Center friends in Settings to compare tables." : {
      "comment" : "A description of how to enable Game Center friends.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Baranov برؤية أصدقائك في Game Center في الإعدادات لمقارنة الجداول."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволете на Baranov да вижда вашите приятели в Game Center в Настройки, за да сравнявате маси."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dozvolite Baranovu da vidi vaše prijatelje iz Game Center-a u Postavkama da uporedi tabele."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet que Baranov vegi els teus amics de Game Center a Configuració per comparar taules."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožněte Baranovovi vidět vaše přátele Game Center v Nastavení a porovnat stoly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
