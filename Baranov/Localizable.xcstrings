    "Set out from %@ with the letter tucked safely in my bag.": {
      "comment": "A travel note. The argument is a place.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тръгнах от %@ с писмото, прибрано безопасно в чантата ми."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiu des de %@ amb la carta guardada a la bossa."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Krenuo iz %@ sa pismom bezbedno ušuškanim u moju torbu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انطلق من %@ والرسالة موضوعة بأمان في حقيبتي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag afsted fra %@ med brevet gemt sikkert i min taske."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vydejte se z %@ s dopisem bezpečně zastrčeným v mé tašce."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Set out from %@ with the letter tucked safely in my bag."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Set out from %@ with the letter tucked safely in my bag."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Set out from %@ with the letter tucked safely in my bag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Machen Sie sich von %@ auf den Weg, den Brief sicher in meiner Tasche verstaut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκίνησα από το %@ με το γράμμα κουμπωμένο με ασφάλεια στην τσάντα μου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salgo de %@ con la carta guardada de forma segura en mi bolso."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Salgo de %@ con la carta guardada de forma segura en mi bolso."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Abiarazi %@tik gutuna poltsan seguru gordeta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Asusin teele %@-st, kiri turvaliselt minu kotti poogitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je suis parti de %@ avec la lettre bien rangée dans mon sac."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Je suis parti de %@ avec la lettre bien rangée dans mon sac."
          }
        },
        "fi": {
