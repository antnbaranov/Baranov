        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוד לא צעד אחד. הדשא כאן כנראה מצוין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी एक कदम भी नहीं. यहाँ की घास स्पष्टतः उत्कृष्ट है।"
