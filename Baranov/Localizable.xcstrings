    "%lld %@ stamped. Tap a stamp to look closer.": {
      "comment": "A footer that shows the number of places the pet has passed.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld %2$@ stamped. Tap a stamp to look closer."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %@ segellat. Toca un segell per mirar-lo més a prop."
          }
        },
