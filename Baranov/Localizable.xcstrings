        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ļaujiet Baranovam redzēt savus Game Center draugus sadaļā Iestatījumi, lai salīdzinātu tabulas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволете Баранов да ги гледа вашите пријатели од Game Center во Поставки за да ги споредува табелите."
