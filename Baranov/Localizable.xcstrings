    "Long live the ram. Long live the post.": {
      "comment": "Text of a medieval herald announcing news to the whole kingdom.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Да живее овенът. Да живее поста."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Visca el carnero. Visca el post."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Živeo ovan. Živjela objava."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاش الكبش. يحيا المنشور ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Længe leve vædderen. Længe leve posten."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ať žije beran. Ať žije příspěvek."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Long live the ram. Long live the post."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Long live the ram. Long live the post."
          }
        },
