    "At the pace you were walking, %@ should be there about now. Open Baranov to count the last steps." : {
      "comment" : "Notification body for the estimated arrival. The argument is the ram's name.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالوتيرة التي كنت تسير بها، من المفترض أن يكون %@ موجودًا هناك الآن. افتح بارانوف لحساب الخطوات الأخيرة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С темпото, с което вървяхте, %@ би трябвало да е там горе-долу сега. Отворете Baranov, за да преброите последните стъпки."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempom kojim ste hodali, %@ bi sada trebao biti tamo. Otvorite Baranov da izbrojite posljednje korake."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al ritme que caminaves, %@ hauria d'estar-hi ara. Obriu Baranov per comptar els últims passos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempem, kterým jste šli, by tam teď měl být %@. Otevřete Baranov, abyste spočítali poslední kroky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I det tempo, du gik, burde %@ være der omkring nu. Åbn Baranov for at tælle de sidste trin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei deinem Tempo sollte %@ jetzt ungefähr dort sein. Öffne Baranov, um die letzten Schritte zu zählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με τον ρυθμό που περπατούσατε, ο %@ θα πρέπει να είναι εκεί περίπου τώρα. Ανοίξτε τον Baranov για να μετρήσετε τα τελευταία βήματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the pace you were walking, %@ should be there about now. Open Baranov to count the last steps."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the pace you were walking, %@ should be there about now. Open Baranov to count the last steps."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the pace you were walking, %@ should be there about now. Open Baranov to count the last steps."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the pace you were walking, %@ should be there about now. Open Baranov to count the last steps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al ritmo al que caminabas, %@ debería estar ahí ahora. Abre Baranov para contar los últimos pasos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al ritmo al que caminabas, %@ debería estar ahí ahora. Abre Baranov para contar los últimos pasos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie kõndimistempo juures peaks %@ praegu kohal olema. Avage Baranov, et lugeda viimased sammud."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibiltzen ari zinen erritmoan, %@-k han egon beharko luke orain. Ireki Baranov azken pausoak zenbatzeko."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samalla vauhdilla, jolla kävelit, %@:n pitäisi olla paikalla juuri nyt. Avaa Baranov laskeaksesi viimeiset askeleet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au rythme où tu marchais, %@ devrait être arrivé. Ouvre Baranov pour compter les derniers pas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au rythme où tu marchais, %@ devrait être arrivé. Ouvre Baranov pour compter les derniers pas."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar an luas a raibh tú ag siúl, ba cheart go mbeadh %@ ann faoi láthair. Oscail Baranov chun na céimeanna deiridh a chomhaireamh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao ritmo que andabas, %@ debería estar alí agora. Abre Baranov para contar os últimos pasos."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בקצב שהלכת, %@ אמור להיות שם בערך עכשיו. פתח את ברנוב כדי לספור את הצעדים האחרונים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिस गति से आप चल रहे थे, %@ लगभग अब वहीं होना चाहिए। अंतिम चरण गिनने के लिए बारानोव खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempom kojim ste hodali, %@ bi trebao biti tamo otprilike sada. Otvorite Baranov za brojanje zadnjih koraka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abban a tempóban, ahogy sétáltál, %@-nek most már ott kell lennie. Nyissa meg a Baranovot, hogy megszámolja az utolsó lépéseket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuai dengan kecepatan Anda berjalan, %@ seharusnya sudah berada di sana saat ini. Buka Baranov untuk menghitung langkah terakhir."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Á þeim hraða sem þú varst að ganga ætti %@ að vera þarna um það bil núna. Opnaðu Baranov til að telja síðustu skrefin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al ritmo con cui camminavi, %@ dovrebbe essere lì in questo momento. Apri Baranov per contare gli ultimi passi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの歩いているペースでは、%@ はもうすぐそこに着くはずです。 Baranov を開いて最後の歩数を数えます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "იმ ტემპით, რომელსაც თქვენ სეირნობდით, %@ ახლა იქ უნდა იყოს. გახსენით ბარანოვი ბოლო ნაბიჯების დასათვლელად."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сіз жүрген қарқынмен %@ қазір сол жерде болуы керек. Соңғы қадамдарды санау үшін Барановты ашыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걷는 속도로 지금쯤 %@이(가) 거기에 있을 것입니다. Baranov를 열어 마지막 단계를 계산하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokiu tempu, kuriuo ėjote, %@ dabar turėtų būti ten. Atidarykite Baranovą, kad suskaičiuotumėte paskutinius žingsnius."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tādā tempā, kādu staigājāt, %@ vajadzētu būt tur apmēram tagad. Atveriet Baranovu, lai saskaitītu pēdējos soļus."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Со темпото со кое одевте, %@ треба да биде таму сега. Отворете го Баранов да ги изброите последните чекори."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada kadar yang anda berjalan, %@ sepatutnya berada di sana kira-kira sekarang. Buka Baranov untuk mengira langkah terakhir."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bil-pass li kont miexi, %@ għandu jkun hemm madwar issa. Iftaħ Baranov biex tgħodd l-aħħar passi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I det tempoet du gikk, burde %@ være der omtrent nå. Åpne Baranov for å telle de siste trinnene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In het tempo waarin je liep, zou %@ er nu ongeveer moeten zijn. Open Baranov om de laatste stappen te tellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy tempie, w jakim szedłeś, %@ powinno być już na miejscu. Otwórz Baranowa, aby policzyć ostatnie kroki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No ritmo em que você estava andando, %@ deveria estar aí agora. Abra Baranov para contar os últimos passos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No ritmo em que você estava andando, %@ deveria estar aí agora. Abra Baranov para contar os últimos passos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În ritmul în care mergeai, %@ ar trebui să fie acolo cam acum. Deschideți Baranov pentru a număra ultimii pași."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если ты шли в том же темпе, %@ должен быть уже на месте. Открой Baranov, чтобы засчитать последние шаги."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempom, ktorým ste kráčali, by tam teraz mala byť %@. Otvorte Baranov, aby ste spočítali posledné kroky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S hitrostjo, s katero ste hodili, bi moral biti %@ zdaj približno tam. Odprite Baranov, da preštejete zadnje korake."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me ritmin që po ecnit, %@ duhet të jetë aty për momentin. Hap Baranov për të numëruar hapat e fundit."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Темпом којим сте ходали, %@ би сада требало да буде тамо. Отворите Баранов да пребројите последње кораке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I den takt du gick borde %@ vara där ungefär nu. Öppna Baranov för att räkna de sista stegen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตามจังหวะที่คุณกำลังเดิน %@ น่าจะถึงจุดนั้นแล้ว เปิด Baranov เพื่อนับขั้นตอนสุดท้าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yürüdüğünüz hızda %@ şu anda orada olmalı. Son adımları saymak için Baranov'u açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З тією швидкістю, якою ти йшли, %@ мав би бути там приблизно зараз. Відкрий Баранова, щоб порахувати останні кроки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với tốc độ bạn đang đi, %@ sẽ ở đó vào lúc này. Mở Baranov để đếm những bước cuối cùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按照你走路的速度，%@现在应该就在那里。打开 Baranov 来计算最后的步数。"
          }
        },
        "zh-Hant" : {
