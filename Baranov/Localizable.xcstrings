        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva com suas próprias palavras. Quando isso acontecer, toque em “Aconteceu!” no cartão, e o rolo conta a história."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva com suas próprias palavras. Quando isso acontecer, toque em “Aconteceu!” no cartão, e o rolo conta a história."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrie-o cu propriile tale cuvinte. Când se întâmplă, atingeți „S-a întâmplat!” pe card, iar tamburul spune povestea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напишите это своими словами. Когда это произойдет, нажми «Это случилось!» на карточке, и ролик рассказывает историю."
