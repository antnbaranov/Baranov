        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karmazyn jest własnością każdego pasterza. Stuknij inny wosk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carmesim é de todo pastor. Toque em outra cera."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Carmesim é de todo pastor. Toque em outra cera."
          }
        },
        "ro": {
