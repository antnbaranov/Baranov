        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūs turite atidaryti laišką, adresuotą bet kuriam iš šių vardų. Keičiant arba pašalinant vardą naudojamas vienas iš jūsų %1$@ pakeitimų; tuščios vietos užpildymas nemokamas.  %2$@ liko."
