        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受け渡しを待っている手紙は、目的地が一致するか、実際の目的地から 800 km 以内にいる人であれば誰にでも直接 AirDrop することができます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "წერილი, რომელიც ელოდება გადაცემას, შეიძლება პირდაპირ AirDrop-ში გადაეცეს ნებისმიერს აქ, ვისი დანიშნულების ადგილი ემთხვევა, ან მდებარეობს 800 კმ-ში, სადაც ის რეალურად მიდის."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тасымалдауды күтіп тұрған хатты AirDropped тікелей тағайындалған жері сәйкес келетін немесе нақты баратын жерге 800 км қашықтықта орналасқан кез келген адамға жіберуге болады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전달을 기다리는 편지는 목적지가 일치하거나 실제로 가는 곳에서 800km 이내에 있는 사람에게 바로 AirDrop될 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laiškas, laukiantis perdavimo, gali būti „AirDropped“ tiesiai visiems čia esantiems, kurių kelionės tikslas sutampa arba yra 800 km atstumu nuo to, kur jis iš tikrųjų eina."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vēstuli, kas gaida nodošanu, AirDropped var nosūtīt tieši ikvienam šeit esošajam, kura galamērķis sakrīt vai atrodas 800 km attālumā no tā, kur tā faktiski nonāk."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Писмото што чека за предавање може да биде AirDropped директно до секој овде чија дестинација се совпаѓа или е на 800 километри од каде што всушност оди."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surat menunggu penyerahan boleh dihantar terus ke AirDropped kepada sesiapa sahaja di sini yang destinasinya sepadan, atau berada dalam jarak 800 km, ke mana ia sebenarnya pergi."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ittra ta' stennija għal handoff tista' tiġi AirDropped direttament lil kull min hawn li d-destinazzjoni tiegħu taqbel, jew tkun f'800 km minn fejn fil-fatt sejra."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et brev som venter på en overlevering kan AirDropped direkte til alle her hvis destinasjon samsvarer med, eller er innenfor 800 km fra, dit det faktisk går."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een brief die wacht op overdracht kan rechtstreeks via AirDrop worden verzonden naar iedereen hier wiens bestemming overeenkomt met, of zich binnen een straal van 800 km bevindt van, waar de brief daadwerkelijk naartoe gaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "List oczekujący na przekazanie może zostać zrzucony drogą powietrzną bezpośrednio do dowolnej osoby, której miejsce docelowe jest zgodne z miejscem docelowym lub znajduje się w promieniu 800 km od tego, dokąd faktycznie zmierza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma carta aguardando uma transferência pode ser enviada por AirDropped diretamente para qualquer pessoa aqui cujo destino corresponda, ou esteja a 800 km de onde realmente está indo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma carta aguardando uma transferência pode ser enviada por AirDropped diretamente para qualquer pessoa aqui cujo destino corresponda, ou esteja a 800 km de onde realmente está indo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O scrisoare care așteaptă o predare poate fi trimisă prin AirDropped direct oricărei persoane de aici a cărei destinație se potrivește sau se află la o rază de 800 km de locul unde se duce efectiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Письмо, ожидающее переправки, можно передать по AirDrop любому курьеру из этого списка, чей пункт назначения совпадает или находится в пределах 800 км."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "List čakajúci na odovzdanie môže byť AirDropped priamo tu komukoľvek, ktorého cieľová destinácia sa zhoduje alebo je v okruhu 800 km od toho, kam skutočne smeruje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pismo, ki čaka na predajo, je mogoče poslati AirDropped naravnost vsem tukaj, katerih cilj se ujema ali je znotraj 800 km od mesta, kamor dejansko gre."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një letër që pret për dorëzim mund t'i dërgohet drejtpërdrejt kujtdo këtu, destinacioni i të cilit përputhet, ose është brenda 800 km nga vendi ku po shkon në të vërtetë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Писмо које чека на примопредају може се АирДроппед директно свакоме овде чија се дестинација поклапа, или је унутар 800 км од места где заправо иде."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett brev som väntar på en handoff kan AirDropped direkt till alla här vars destination matchar, eller är inom 800 km från, dit det faktiskt går."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จดหมายที่รอการส่งมอบสามารถส่งผ่าน AirDropped ได้โดยตรงถึงใครก็ตามที่มีจุดหมายปลายทางตรงกัน หรืออยู่ในรัศมี 800 กม. จากที่ที่กำลังมุ่งหน้าไปจริงๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teslim edilmeyi bekleyen bir mektup, varış yeri gerçekte gittiği yerle eşleşen veya bu yere 800 km mesafede olan herkese AirDrop ile doğrudan gönderilebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лист, який очікує на передачу, можна надіслати через AirDrop будь-якому кур'єру зі списку, чий пункт призначення збігається або розташований у межах 800 км."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một lá thư đang chờ chuyển giao có thể được AirDropped thẳng tới bất kỳ ai ở đây có điểm đến phù hợp hoặc nằm trong phạm vi 800 km tính từ nơi nó thực sự đến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待移交的信件可以直接通过 AirDropped 发送给目的地与实际目的地相匹配或距离实际目的地 800 公里以内的任何人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待移交的信件可以直接透過 AirDropped 發送給目的地與實際目的地相符或距離實際目的地 800 公里以內的任何人。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待移交的信件可以直接透過 AirDropped 發送給目的地與實際目的地相符或距離實際目的地 800 公里以內的任何人。"
          }
        }
      }
    },
