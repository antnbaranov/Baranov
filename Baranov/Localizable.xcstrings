        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne verrez plus %@ comme messager enregistré. Leur note de voyage et les détails de leur première rencontre les accompagnent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et enää näe %@ tallennettuna kuriirina. Heidän matkamuistionsa ja ensitapaamisen yksityiskohdat kulkevat heidän mukanaan."
