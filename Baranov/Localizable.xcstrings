        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Баранов не му е дозволено да испраќа известувања. Вклучете ги во Поставки ако се предомислите."
          }
        },
        "ms" : {
          "stringUnit" : {
