        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hoda do vrata %@ na tvojim stepenicama. Slijeće u njihovu poštansku torbu kad tamo stigne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ az Ön lépcsőjén sétál %@ kapujához. Amikor megérkezik, a postatáskájukban landol."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ berjalan ke gerbang %@ dengan langkah Anda. Itu mendarat di kantong surat mereka ketika sampai di sana."
