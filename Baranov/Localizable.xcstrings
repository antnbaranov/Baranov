    "Left %@ at a steady trot. The road is long, and I am ready." : {
      "comment" : "A travel note. The argument is the name of the place.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اليسار %@ في هرولة ثابتة. الطريق طويل وأنا جاهز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наляво %@ в равномерен тръс. Пътят е дълъг и аз съм готов."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lijevo %@ ujednačenim kasom. Put je dug, a ja sam spreman."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esquerra %@ al trot constant. El camí és llarg, i estic preparat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlevo %@ ve stabilním klusu. Cesta je dlouhá a já jsem připraven."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venstre %@ i jævnt trav. Vejen er lang, og jeg er klar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verließ %@ im gleichmäßigen Trab. Der Weg ist lang und ich bin bereit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αριστερά %@ με σταθερό τράβηγμα. Ο δρόμος είναι μακρύς και είμαι έτοιμος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left %@ at a steady trot. The road is long, and I am ready."
