    "Encrypted for the whole journey. %@ opens it at the gate with the receiving code." : {
      "comment" : "A description of the security of the letter's encryption.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشفرة للرحلة بأكملها.  %@ يفتحه عند البوابة برمز الاستلام."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Криптиран за цялото пътуване.  %@ го отваря на портата с кода за получаване."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šifrirano za cijelo putovanje.  %@ ga otvara na kapiji sa kodom za prijem."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encriptat per a tot el viatge.  %@ l'obre a la porta amb el codi de recepció."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zašifrováno po celou dobu cesty.  %@ jej otevře u brány s přijímacím kódem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krypteret for hele rejsen.  %@ åbner den ved porten med modtagekoden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die gesamte Reise verschlüsselt. %@ öffnet es am Tor mit dem Empfangscode."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρυπτογραφημένο για όλο το ταξίδι.  Το %@ το ανοίγει στην πύλη με τον κωδικό λήψης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encrypted for the whole journey. %@ opens it at the gate with the receiving code."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
