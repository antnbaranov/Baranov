    "Three different places stamped. Bought no souvenirs.": {
      "comment": "Text displayed in a notification when a user has visited three different places.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Щамповани три различни места. Не купих сувенири."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres llocs diferents estampats. No he comprat cap record."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označena tri različita mjesta. Nisu kupili suvenire."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثلاثة أماكن مختلفة مختومة. لم يشتروا أي هدايا تذكارية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre forskellige steder stemplet. Købte ingen souvenirs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyražena tři různá místa. Nekoupil žádné suvenýry."
          }
        },
