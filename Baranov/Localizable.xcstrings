    "%@ earns a stamp for every named place walked past — a river crossed, a town passed through, a gate reached." : {
      "comment" : "A description of how a ram earns stamps.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
