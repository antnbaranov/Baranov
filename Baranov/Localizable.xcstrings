        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore un pas. L'herbe ici est apparemment excellente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä askeltakaan. Ruoho on täällä ilmeisesti erinomaista."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní céim amháin fós. Is cosúil go bhfuil an féar anseo ar fheabhas."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aínda non hai un paso. A herba aquí parece excelente."
