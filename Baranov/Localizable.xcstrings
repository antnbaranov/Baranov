        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A postatáskában utazik, és a lépéseivel együtt mozog, anélkül, hogy tollat ​​venne a legelőre. A feladó bármikor visszakérheti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia masuk ke dalam kantong surat Anda dan bergerak mengikuti langkah Anda, tanpa mengambil pena di padang rumput Anda. Pengirim dapat memintanya kembali kapan saja."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Það ríður í póstpokanum þínum og hreyfist með skrefum þínum, án þess að taka penna í haga þínum. Sendandi getur beðið um það til baka hvenær sem er."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cavalca nel tuo sacco della posta e si muove con i tuoi passi, senza prendere una penna nel tuo pascolo. Il mittente può richiederlo indietro in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "郵便袋に入れて、牧草地の中でペンを持ち歩かなくても、足取りに合わせて動きます。送信者はいつでも返送を要求できます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ის მიდის თქვენს საფოსტო ჩანთაში და მოძრაობს თქვენი ნაბიჯებით, თქვენს საძოვარზე კალმის აღების გარეშე. გამომგზავნს შეუძლია მისი დაბრუნება ნებისმიერ დროს მოითხოვოს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почта сөмкеңе мініп, жайлауыңда қалам алмай, қадамыңмен жылжиды. Жіберуші оны кез келген уақытта қайтаруды сұрай алады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그것은 당신의 목초지에 펜을 가져가지 않고도 당신의 우편가방에 싣고 당신의 발걸음에 따라 움직입니다. 보낸 사람은 언제든지 다시 요청할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jis sėdi jūsų pašto krepšyje ir juda jūsų žingsniais, neimdamas rašiklio į ganyklą. Siuntėjas gali bet kada paprašyti jį grąžinti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas brauc jūsu pasta somā un pārvietojas ar jūsu soļiem, neņemot pildspalvu ganībās. Sūtītājs jebkurā laikā var pieprasīt to atpakaļ."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Се вози во вашата поштенска торба и се движи со вашите чекори, без да земете пенкало на вашето пасиште. Испраќачот може да го побара назад во секое време."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia masuk ke dalam beg mel anda dan bergerak dengan langkah anda, tanpa mengambil pen di padang rumput anda. Pengirim boleh memintanya kembali pada bila-bila masa."
