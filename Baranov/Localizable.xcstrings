    "Baranov isn't allowed to send notifications. Turn them on in Settings if you change your mind.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُسمح لبارانوف بإرسال إشعارات. قم بتشغيلها في الإعدادات إذا غيرت رأيك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов няма право да изпраща известия. Включете ги в Настройки, ако промените решението си."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov ne smije slati obavještenja. Uključite ih u Postavkama ako se predomislite."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov no té permís per enviar notificacions. Activa'ls a Configuració si canvies d'opinió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov nemá povoleno posílat upozornění. Pokud si to rozmyslíte, zapněte je v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov må ikke sende meddelelser. Slå dem til i Indstillinger, hvis du ombestemmer dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov darf keine Benachrichtigungen versenden. Aktivieren Sie sie in den Einstellungen, wenn Sie Ihre Meinung ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Baranov δεν επιτρέπεται να στέλνει ειδοποιήσεις. Ενεργοποιήστε τα στις Ρυθμίσεις εάν αλλάξετε γνώμη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov isn't allowed to send notifications. Turn them on in Settings if you change your mind."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov isn't allowed to send notifications. Turn them on in Settings if you change your mind."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov isn't allowed to send notifications. Turn them on in Settings if you change your mind."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov isn't allowed to send notifications. Turn them on in Settings if you change your mind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov no puede enviar notificaciones. Actívalos en Configuración si cambias de opinión."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov no puede enviar notificaciones. Actívalos en Configuración si cambias de opinión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov ei tohi teateid saata. Kui muudate meelt, lülitage need seadetes sisse."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov-ek ezin du jakinarazpenak bidaltzeko. Iritziz aldatzen bazara, aktibatu Ezarpenak atalean."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov ei saa lähettää ilmoituksia. Ota ne käyttöön asetuksista, jos muutat mieltäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov n'est pas autorisé à envoyer des notifications. Activez-les dans Paramètres si vous changez d'avis."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov n'est pas autorisé à envoyer des notifications. Activez-les dans Paramètres si vous changez d'avis."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl cead ag Baranov fógraí a sheoladh. Cuir ar siúl iad sna Socruithe má athraíonn tú d'intinn."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov non ten permiso para enviar notificacións. Actívaos en Configuración se cambias de opinión."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לברנוב אסור לשלוח הודעות. הפעל אותם בהגדרות אם תשנה את דעתך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बारानोव को सूचनाएं भेजने की अनुमति नहीं है. यदि आप अपना मन बदलते हैं तो उन्हें सेटिंग्स में चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov ne smije slati obavijesti. Uključite ih u postavkama ako se predomislite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov nem küldhet értesítéseket. Ha meggondolja magát, kapcsolja be őket a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov tidak diperbolehkan mengirim notifikasi. Aktifkan di Pengaturan jika Anda berubah pikiran."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov má ekki senda tilkynningar. Kveiktu á þeim í stillingum ef þú skiptir um skoðun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov non è autorizzato a inviare notifiche. Attivali nelle Impostazioni se cambi idea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov は通知を送信することを許可されていません。気が変わったら、設定でそれらをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov는 알림을 보낼 수 없습니다. 마음이 바뀌면 설정에서 기능을 켜세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranovui neleidžiama siųsti pranešimų. Jei apsigalvosite, įjunkite juos nustatymuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranovam nav atļauts sūtīt paziņojumus. Ja pārdomājat, ieslēdziet tos sadaļā Iestatījumi."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "На Баранов не му е дозволено да испраќа известувања. Вклучете ги во Поставки ако се предомислите."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov tidak dibenarkan menghantar pemberitahuan. Hidupkannya dalam Tetapan jika anda berubah fikiran."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov mhux permess li jibgħat notifiki. Ixgħelhom fis-Settings jekk tibdel fehmtek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov har ikke lov til å sende varsler. Slå dem på i Innstillinger hvis du ombestemmer deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov mag geen meldingen verzenden. Schakel ze in via Instellingen als u van gedachten verandert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranow nie może wysyłać powiadomień. Jeśli zmienisz zdanie, włącz je w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov não tem permissão para enviar notificações. Ative-os em Configurações se mudar de ideia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov não tem permissão para enviar notificações. Ative-os em Configurações se mudar de ideia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov nu are voie să trimită notificări. Activați-le în Setări dacă vă răzgândiți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранову не разрешено отправлять уведомления. Включите их в настройках, если передумаете."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov nemá povolené posielať upozornenia. Ak si to rozmyslíte, zapnite ich v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov ne sme pošiljati obvestil. Vklopite jih v nastavitvah, če si premislite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov nuk lejohet të dërgojë njoftime. Aktivizoji ato te \"Cilësimet\" nëse ndryshon mendje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов не сме да шаље обавештења. Укључите их у подешавањима ако се предомислите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov får inte skicka meddelanden. Slå på dem i Inställningar om du ändrar dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov ไม่ได้รับอนุญาตให้ส่งการแจ้งเตือน เปิดใช้งานได้ในการตั้งค่าหากคุณเปลี่ยนใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov'un bildirim göndermesine izin verilmiyor. Fikrinizi değiştirirseniz bunları Ayarlar'dan açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранову заборонено надсилати повідомлення. Увімкніть їх у налаштуваннях, якщо передумаєте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov không được phép gửi thông báo. Hãy bật chúng trong Cài đặt nếu bạn đổi ý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "巴拉诺夫无权发送通知。如果您改变主意，请在“设置”中将其打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov isn't allowed to send notifications. Turn them on in Settings if you change your mind."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov isn't allowed to send notifications. Turn them on in Settings if you change your mind."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბარანოვს არ აქვს შეტყობინებების გაგზავნის უფლება. თუ გადაიფიქრებთ, ჩართეთ ისინი პარამეტრებში."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барановқа хабарлама жіберуге рұқсат етілмейді. Ойыңызды өзгертсеңіз, оларды \"Параметрлер\" бөлімінен қосыңыз."
          }
        }
      }
