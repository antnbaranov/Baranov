        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전달을 기다리는 편지는 목적지가 일치하거나 실제로 가는 곳으로부터 %@km 이내에 있는 사람에게 바로 AirDrop될 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
