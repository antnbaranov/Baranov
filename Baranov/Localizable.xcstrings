    "Crimson is every shepherd's. Tap another wax.": {
      "comment": "A description of the waxes, including the",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القرمزي هو كل راعي. اضغط على الشمع آخر."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пурпурно е на всеки овчар. Докоснете друг восък."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Grimizni je svaki pastir. Dodirnite drugi vosak."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El carmesí és de tots els pastors. Toqueu una altra cera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson patří každému pastýři. Naklepejte další vosk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson er enhver hyrdes. Tryk på en anden voks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson gehört jedem Hirten. Tippen Sie auf ein anderes Wachs."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το βυσσινί είναι του κάθε βοσκού. Χτυπήστε ένα άλλο κερί."
