        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Maloniai risnokite toliau. Pagarbiai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lūdzu, turpiniet rikšot. Ar cieņu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ве молиме продолжете да трчате. Со почит."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila terus berlari. salam hormat."
