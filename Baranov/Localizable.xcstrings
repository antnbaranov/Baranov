    "This one travelled open, as a postcard — no seal, no code. Just lift it out.": {
      "comment": "A note describing a postcard-style letter.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سافرت هذه البطاقة مفتوحة، كبطاقة بريدية - بلا ختم ولا رمز. فقط ارفعه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази пътуваше отворена като пощенска картичка — без печат, без код. Просто го вдигнете."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova je putovala otvorena, kao razglednica - bez pečata, bez šifre. Samo ga izvadi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest viatjava obert, com una postal: sense segell, sense codi. Només traieu-lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento cestoval otevřený jako pohlednice – bez pečeti, bez kódu. Prostě to zvedni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne rejste åben som et postkort - ingen segl, ingen kode. Bare løft den ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese reiste offen wie eine Postkarte – kein Siegel, kein Code. Heben Sie es einfach heraus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό ταξίδεψε ανοιχτό, σαν καρτ ποστάλ — χωρίς σφραγίδα, χωρίς κωδικό. Απλώς σήκωσέ το."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This one travelled open, as a postcard — no seal, no code. Just lift it out."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This one travelled open, as a postcard — no seal, no code. Just lift it out."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "This one travelled open, as a postcard — no seal, no code. Just lift it out."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This one travelled open, as a postcard — no seal, no code. Just lift it out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Éste viajaba abierto, como una postal, sin sello ni código. Simplemente sáquelo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Éste viajaba abierto, como una postal, sin sello ni código. Simplemente sáquelo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See rändas lahtiselt, postkaardina – ei pitsatit ega koodi. Tõstke see lihtsalt välja."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Honek irekita bidaiatu zuen, postal gisa: ez zigilurik, ez koderik. Besterik gabe, altxa ezazu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kulki avoimena, postikorttina – ei sinettiä, ei koodia. Nosta se vain ulos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui-ci a voyagé ouvert, comme une carte postale – sans sceau, ni code. Retirez-le simplement."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui-ci a voyagé ouvert, comme une carte postale – sans sceau, ni code. Retirez-le simplement."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Thaistil an ceann seo oscailte, mar chárta poist - gan séala, gan cód. Just a thógann sé amach."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Este viaxou aberto, como unha postal: sen selo, sen código. Só levántao."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה נסע פתוח, כמו גלויה - בלי חותם, בלי קוד. פשוט תרים אותו החוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एक पोस्टकार्ड की तरह खुला हुआ था - कोई मुहर नहीं, कोई कोड नहीं। बस इसे बाहर उठाओ."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova je putovala otvorena, kao razglednica - bez pečata, bez šifre. Samo ga podignite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nyitott, képeslapként utazott – se pecsét, se kód. Csak emeld ki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang ini dibawa dalam keadaan terbuka, seperti kartu pos - tanpa segel, tanpa kode. Angkat saja."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi ferðaðist opinn, sem póstkort - ekkert innsigli, enginn kóða. Lyftu því bara út."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa viaggiava aperta, come una cartolina: senza sigillo, senza codice. Basta sollevarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは、シールもコードも入っていない、ポストカードのような状態で開封された状態で送られてきました。持ち上げるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 엽서처럼 열려서 여행했습니다. 봉인도 없고 코드도 없습니다. 그냥 들어 올리세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis keliavo atviras, kaip atvirukas – be antspaudo, be kodo. Tiesiog iškelk."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī ceļoja atvērta, kā pastkarte — bez zīmoga, bez koda. Vienkārši izceliet to."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овој патуваше отворено, како разгледница - без печат, без код. Само подигнете го."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang ini mengembara terbuka, sebagai poskad — tiada meterai, tiada kod. Angkat sahaja."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan ivvjaġġa miftuħ, bħala kartolina — l-ebda siġill, l-ebda kodiċi. Just lift out."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne reiste åpen, som et postkort - ingen segl, ingen kode. Bare løft den ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze reisde open, als een ansichtkaart – geen zegel, geen code. Til het er gewoon uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten był otwarty, jak pocztówka – bez pieczęci i bez kodu. Po prostu go podnieś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este viajou aberto, como um cartão postal – sem selo, sem código. Basta retirá-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este viajou aberto, como um cartão postal – sem selo, sem código. Basta retirá-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta a călătorit deschis, ca o carte poștală — fără sigiliu, fără cod. Doar ridică-l afară."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ехала открытой, как открытка — ни печати, ни кода. Просто поднимите его."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento putoval otvorený ako pohľadnica – bez pečate, bez kódu. Len to zdvihnite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta je potovala odprta, kot razglednica - brez pečata, brez kode. Samo dvigni ga."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky udhëtoi hapur, si një kartolinë - pa vulë, pa kod. Thjesht ngrije atë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова је путовала отворена, као разгледница - без печата, без шифре. Само га извади."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här reste öppen, som ett vykort - inget sigill, ingen kod. Lyft bara ut den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อันนี้เปิดออกมาเป็นโปสการ์ด — ไม่มีตราประทับ ไม่มีรหัส แค่ยกมันออกมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir kartpostal gibi açık olarak seyahat ediyordu; mühür yok, kod yok. Sadece kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей подорожував відкритим, як листівка — ні печатки, ні коду. Просто підніміть його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cái này được mở, như một tấm bưu thiếp - không có con dấu, không có mật mã. Chỉ cần nhấc nó ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一张是打开的，就像一张明信片一样——没有封条，没有密码。只需将其取出即可。"
