    "Allow Baranov to see your Game Center friends in Settings to compare tables.": {
      "comment": "A description of how to enable Game Center friends.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet que Baranov vegi els teus amics de Game Center a Configuració per comparar taules."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволете на Baranov да вижда вашите приятели в Game Center в Настройки, за да сравнявате маси."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite Baranovu da vidi vaše prijatelje iz Game Center-a u Postavkama da uporedi tabele."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ Baranov برؤية أصدقائك في Game Center في الإعدادات لمقارنة الجداول."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Baranov to see your Game Center friends in Settings to compare tables."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožněte Baranovovi vidět vaše přátele Game Center v Nastavení a porovnat stoly."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Baranov to see your Game Center friends in Settings to compare tables."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Baranov to see your Game Center friends in Settings to compare tables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglichen Sie Baranov, Ihre Game Center-Freunde in den Einstellungen zu sehen, um Tabellen zu vergleichen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Baranov to see your Game Center friends in Settings to compare tables."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε στον Baranov να βλέπει τους φίλους σας στο Game Center στις Ρυθμίσεις για να συγκρίνει πίνακες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que Baranov vea a sus amigos de Game Center en Configuración para comparar tablas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que Baranov vea a sus amigos de Game Center en Configuración para comparar tablas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lubage Baranovil näha oma Game Centeri sõpru menüüs Seaded, et tabeleid võrrelda."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baimendu Baranov-i zure Game Center-eko lagunak Ezarpenetan ikustea taulak alderatzeko."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Baranov à voir vos amis Game Center dans Paramètres pour comparer les tableaux."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli Baranovin nähdä Game Center -ystäväsi asetuksissa ja vertailla pöytiä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Baranov à voir vos amis Game Center dans Paramètres pour comparer les tableaux."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Lig do Baranov do chairde Ionad Cluiche a fheiceáil i Socruithe chun táblaí a chur i gcomparáid."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Baranov vexa aos teus amigos do Game Center en Configuración para comparar táboas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לבארנוב לראות את החברים שלך ב-Game Center בהגדרות כדי להשוות טבלאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तालिकाओं की तुलना करने के लिए बारानोव को सेटिंग्स में अपने गेम सेंटर मित्रों को देखने की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite Baranovu da vidi vaše prijatelje iz Game Centera u Postavkama radi usporedbe stolova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze Baranov számára, hogy lássa Game Center-barátait a Beállításokban, hogy összehasonlíthassa az asztalokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Baranov melihat teman Game Center Anda di Pengaturan untuk membandingkan tabel."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Leyfðu Baranov að sjá Game Center vini þína í stillingum til að bera saman töflur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Baranov di vedere i tuoi amici di Game Center nelle Impostazioni per confrontare i tavoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov が設定で Game Center の友達を参照してテーブルを比較できるようにします。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ნება მიეცით ბარანოვს ნახოს თქვენი თამაშის ცენტრის მეგობრები პარამეტრებიდან ცხრილების შესადარებლად."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барановқа кестелерді салыстыру үшін Параметрлерде ойын орталығының достарын көруге рұқсат беріңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov가 설정에서 Game Center 친구들을 확인하여 테이블을 비교할 수 있도록 허용하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leiskite Baranovui matyti jūsų žaidimų centro draugus nustatymuose, kad jie galėtų palyginti lenteles."
