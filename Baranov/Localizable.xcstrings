        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დგას ჭიშკართან %@-ში, ყურები მაღლა. მიწოდებული."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 의 게이트에 서서 귀를 기울이세요. 배달되었습니다."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ қақпасында тұрып, құлақтары жоғары. жеткізілді."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Stovi prie vartų %@ , ausis aukštyn. Pristatyta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stāv pie vārtiem %@ , ausis augšā. Piegādāts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоејќи на портата во %@, ушите горе. Доставено."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdiri di pintu pagar dalam %@ , angkat telinga. Dihantar."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Weqfin mal-bieb fi %@ , widnejn ’il fuq. Mogħtija."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stående ved porten i %@ , ører opp. Levert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staande bij de poort in %@ , oren omhoog. Afgeleverd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parado no portão em %@ , orelhas levantadas. Entregue."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoję przy bramie w %@ , uszy do góry. Dostarczony."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parado no portão em %@ , orelhas levantadas. Entregue."
          }
        },
        "ru": {
          "stringUnit": {
