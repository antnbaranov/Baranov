          "stringUnit" : {
            "state" : "translated",
            "value" : "ოქრო, ტყე, საზღვაო, ქლიავი, მელანი - მიმღები არღვევს თქვენს მიერ არჩეულს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Алтын, орман, теңіз, қара өрік, сия - алушы сіз таңдағанды ​​бұзады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "골드, 포레스트, 네이비, 플럼, 잉크 — 수신인이 당신이 고른 색상의 봉인을 풉니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auksas, miškas, laivynas, slyva, rašalas – gavėjas sulaužo tą, kurį pasirinkote."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zelts, mežs, flote, plūme, tinte — saņēmējs sabojā to, kuru izvēlējāties."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Злато, шума, морнарица, слива, мастило - примачот го крши оној што сте го избрале."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emas, hutan, tentera laut, plum, dakwat — penerima melanggar yang anda pilih."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deheb, foresta, navy, għanbaqar, linka — ir-riċevitur ikisser dak li għażilt."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gull, skog, marine, plomme, blekk – mottakeren bryter den du valgte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goud, bos, marineblauw, pruim, inkt: de ontvanger maakt degene kapot die jij hebt gekozen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Złoty, leśny, granatowy, śliwkowy, atramentowy — odbiorca przełamie wybrany przez Ciebie kolor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouro, floresta, marinho, ameixa, tinta — a pessoa rompe a cor que você escolheu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouro, floresta, marinho, ameixa, tinta — a pessoa rompe a cor que você escolheu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aur, pădure, bleumarin, prune, cerneală — destinatarul rupe cel pe care l-ați ales."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Золотой, лесной, морской, сливовый, чернильный — получатель сломает именно тот, что ты выбрал."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zlato, les, námorníctvo, slivka, atrament – príjemca rozbije ten, ktorý ste si vybrali."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zlata, gozdna, mornarska, sliva, črnilo — prejemnik pokvari tisto, ki ste jo izbrali."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ari, pylli, marina, kumbulla, bojë - marrësi thyen atë që keni zgjedhur."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Злато, шума, морнарица, шљива, мастило — прималац ломи ону коју сте изабрали."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guld, skog, marin, plommon, bläck — mottagaren bryter den du valt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทอง ป่า น้ำเงิน พลัม หมึก ผู้รับจะทำลายสิ่งที่คุณเลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altın, orman, lacivert, erik, mürekkep; alıcı seçtiğinizi kırar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Золотий, лісовий, морський, сливовий, чорнильний — одержувач зламає саме той, який ти обрав."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vàng, rừng, hải quân, mận, mực - người nhận bẻ cái bạn đã chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流金、苍翠、藏青、郁李、墨黑——收信人将亲手拆开你挑选的火漆印。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "流金、蒼翠、藏青、郁李、墨黑——收信人將親手拆開你挑選的火漆印。"
          }
        },
        "zh-HK" : {
