        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bidaia osorako zifratua.  %@-k atean irekitzen du hartzailearen kodearekin."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
