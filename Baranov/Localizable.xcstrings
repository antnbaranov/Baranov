    "%@ will walk to this city and look for a crossing from there — a scheduled packet, or anyone heading onward.": {
      "comment": "A description of the handoff plan when a city is selected. The argument is the name of the ram.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ سوف يسير إلى هذه المدينة ويبحث عن معبر من هناك - حزمة مجدولة، أو أي شخص يتجه للأمام."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ще отиде пеша до този град и ще потърси пресичане оттам – планиран пакет или някой, който се насочва нататък."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ će prošetati do ovog grada i tražiti prijelaz odatle - zakazani paket ili bilo koga tko ide dalje."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ caminarà fins a aquesta ciutat i buscarà una travessa des d'allà: un paquet programat o qualsevol persona que vagi endavant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ půjde do tohoto města a bude hledat cestu odtud – naplánovaný paket nebo kohokoli, kdo míří dál."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vil gå til denne by og lede efter en overgang derfra - en planlagt pakke eller nogen, der er på vej videre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird zu dieser Stadt laufen und von dort aus nach einer Überfahrt suchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο %@ θα περπατήσει σε αυτήν την πόλη και θα αναζητήσει μια διέλευση από εκεί — ένα προγραμματισμένο πακέτο ή οποιονδήποτε κατευθύνεται προς τα εμπρός."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will walk to this city and look for a crossing from there — a scheduled packet, or anyone heading onward."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will walk to this city and look for a crossing from there — a scheduled packet, or anyone heading onward."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will walk to this city and look for a crossing from there — a scheduled packet, or anyone heading onward."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will walk to this city and look for a crossing from there — a scheduled packet, or anyone heading onward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ caminará hasta esta ciudad y buscará un cruce desde allí."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ caminará hasta esta ciudad y buscará un cruce desde allí: un paquete programado o cualquiera que se dirija hacia adelante."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kõnnib sellesse linna ja otsib sealt ülekäigurada – plaanitud paketti või kedagi, kes liigub edasi."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hiri honetara oinez joango da eta handik igarobide bat bilatuko du — programatutako pakete bat edo aurrera doan edonor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kävelee tähän kaupunkiin ja etsii sieltä ylityspaikkaa – aikataulun mukaista pakettia tai ketään eteenpäin suuntautuvaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ marchera jusqu'à cette ville et y cherchera une traversée."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ marchera jusqu'à cette ville et cherchera un passage à partir de là – un paquet programmé ou toute personne se dirigeant vers l'autre."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Siúlfaidh %@ go dtí an chathair seo agus lorgóidh sé trasbhealach as sin - paicéad sceidealta, nó aon duine a bheidh ag dul ar aghaidh."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ camiñará ata esta cidade e buscará unha travesía desde alí: un paquete programado ou calquera persoa que vaia adiante."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ילך לעיר הזו ויחפש מעבר חצייה משם - חבילה מתוכננת, או כל מי שימשיך הלאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ इस शहर तक चलेंगे और वहां से एक क्रॉसिंग की तलाश करेंगे - एक निर्धारित पैकेट, या आगे की ओर जाने वाला कोई भी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ će prošetati do ovog grada i potražiti prijelaz odande — planirani paket ili bilo koga tko ide dalje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ elsétál ebbe a városba, és onnan keres átkelőhelyet – ütemezett csomagot vagy bárkit, aki továbbmegy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan berjalan ke kota ini dan mencari penyeberangan dari sana — paket terjadwal, atau siapa pun yang melanjutkan perjalanan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mun ganga til þessarar borgar og leita að yfirferð þaðan — áætlunarpakka, eða einhver sem heldur áfram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ camminerà fino a questa città e cercherà una traversata da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はこの都市まで歩いて、そこからの交差点、つまり予定されているパケット、または先に向かう誰かを探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이 도시까지 걸어가서 거기에서 교차로(예정된 패킷 또는 앞으로 향하는 사람)를 찾습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eis į šį miestą ir ieškos perėjos iš ten – suplanuoto paketo arba bet kurio, einančio toliau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dosies uz šo pilsētu un meklēs pāreju no turienes — ieplānoto sūtījumu vai ikvienu, kas dodas tālāk."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ќе пешачи до овој град и ќе бара премин оттаму - закажан пакет или некој што оди понатаму."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akan berjalan kaki ke bandar ini dan mencari persimpangan dari sana — paket berjadual atau sesiapa sahaja yang menuju ke hadapan."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se jimxu lejn din il-belt u jfittex qsim minn hemm — pakkett skedat, jew xi ħadd li sejjer 'il quddiem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vil gå til denne byen og se etter et kryss derfra – en planlagt pakke, eller noen som skal videre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zal naar deze stad lopen en vanaf daar zoeken naar een oversteekplaats – een gepland pakketje, of iemand anders die verder gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pójdzie do tego miasta i będzie tam szukać przejścia — zaplanowanego pakietu lub kogokolwiek jadącego dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ caminhará até esta cidade e procurará uma travessia a partir daí - um pacote programado ou qualquer pessoa seguindo em frente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ caminhará até esta cidade e procurará uma travessia a partir daí - um pacote programado ou qualquer pessoa seguindo em frente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ va merge până în acest oraș și va căuta o trecere de acolo — un pachet programat sau oricine se va îndrepta mai departe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ дойдёт до этого города и будет искать переправу оттуда — рейсовый корабль или попутчика."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pôjde do tohto mesta a bude hľadať cestu odtiaľ – plánovaný paket alebo kohokoľvek, kto smeruje ďalej."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se bo sprehodil do tega mesta in poiskal prehod od tam – načrtovan paket ali kogar koli, ki gre naprej."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ do të ecë në këtë qytet dhe do të kërkojë një vendkalim prej andej - një paketë të planifikuar ose këdo që shkon përpara."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ће прошетати до овог града и тражити прелаз одатле — заказани пакет или било кога ко иде даље."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kommer att gå till den här staden och leta efter en korsning därifrån - ett schemalagt paket, eller någon på väg vidare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ จะเดินไปที่เมืองนี้แล้วมองหาทางแยกจากที่นั่น - แพ็คเก็ตที่กำหนดหรือใครก็ตามที่มุ่งหน้าไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu şehre yürüyecek ve oradan bir geçiş yolu arayacak - planlanmış bir paket veya ileriye doğru giden herhangi biri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ дійде до цього міста і шукатиме переправу звідти — рейсовий корабель або попутника."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sẽ đi bộ đến thành phố này và tìm kiếm đường giao nhau từ đó - một gói hàng đã lên lịch hoặc bất kỳ ai đang đi tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将步行到这座城市并寻找从那里出发的交叉路口 - 预定的包裹或任何继续前进的人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將步行到這座城市並尋找從那裡出發的交叉路口 - 預定的包裹或任何繼續前進的人。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將步行到這座城市並尋找從那裡出發的交叉路口 - 預定的包裹或任何繼續前進的人。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
