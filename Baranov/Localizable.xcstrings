    "Only the recipient's code breaks it. Hold the seal to try." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Code des Empfängers bricht es. Halte das Siegel zum Ausprobieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the recipient's code breaks it. Hold the seal to try."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo el código del destinatario rompe el sello. Mantén pulsado el sello para probarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le code du destinataire brise le sceau. Maintenez le sceau pour essayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo il codice del destinatario rompe il sigillo. Tieni premuto per provare."
