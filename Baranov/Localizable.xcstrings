    "Hand a ram to someone at a coast or border." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتسليم الكبش لشخص ما على الساحل أو الحدود."
