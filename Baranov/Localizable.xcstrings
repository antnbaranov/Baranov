    "Walk to the nearest bakery. For the letter, obviously.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разходете се до най-близката пекарна. За писмото, разбира се."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Camineu fins a la fleca més propera. Per la carta, evidentment."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المشي إلى أقرب مخبز. بالنسبة للرسالة، من الواضح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prošećite do najbliže pekare. Za pismo, očigledno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå til nærmeste bageri. For brevet, selvfølgelig."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jděte do nejbližší pekárny. Pro ten dopis, samozřejmě."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk to the nearest bakery. For the letter, obviously."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk to the nearest bakery. For the letter, obviously."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk to the nearest bakery. For the letter, obviously."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie zu Fuß zur nächsten Bäckerei. Für den Brief natürlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Camine hasta la panadería más cercana. Por la carta, obviamente."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Camine hasta la panadería más cercana. Por la carta, obviamente."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περπατήστε στο πλησιέστερο αρτοποιείο. Για την επιστολή, προφανώς."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oinez hurbilen dagoen okindegira. Gutunerako, jakina."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalutage lähima pagariäri juurde. Ilmselgelt kirja jaoks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchez jusqu'à la boulangerie la plus proche. Pour la lettre, évidemment."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchez jusqu'à la boulangerie la plus proche. Pour la lettre, évidemment."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kävele lähimpään leipomoon. Ilmeisesti kirjeelle."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Siúil go dtí an bácús is gaire. Don litir, ar ndóigh."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Camiña ata a panadería máis próxima. Para a carta, obviamente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ללכת למאפייה הקרובה. למכתב, ברור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निकटतम बेकरी तक चलें। पत्र के लिए, जाहिर है."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prošećite do najbliže pekare. Za pismo, očito."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sétáljon a legközelebbi pékséghez. Nyilvánvalóan a levél miatt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalanlah ke toko roti terdekat. Tentu saja untuk suratnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cammina fino al panificio più vicino. Per la lettera, ovviamente."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gengið í næsta bakarí. Fyrir bréfið, augljóslega."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのパン屋さんまで歩いて行きます。もちろん手紙の場合です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იარეთ უახლოეს თონემდე. წერილისთვის, ცხადია."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 가까운 빵집으로 걸어가세요. 분명히 편지 때문입니다."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ең жақын наубайханаға барыңыз. Хат үшін, анық."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eikite į artimiausią kepyklėlę. Dėl laiško, aišku."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejiet uz tuvāko maiznīcu. Par vēstuli, protams."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прошетка до најблиската пекара. За писмото, очигледно."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan ke kedai roti terdekat. Untuk surat itu, jelas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imxi lejn l-eqreb forn. Għall-ittra, ovvjament."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå til nærmeste bakeri. For brevet, åpenbart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop naar de dichtstbijzijnde bakker. Voor de brief uiteraard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Idź do najbliższej piekarni. Oczywiście za list."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminhe até a padaria mais próxima. Para a carta, obviamente."
