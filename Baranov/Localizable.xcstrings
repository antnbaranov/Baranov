    "Standing at the gate in %@, ears up. Delivered.": {
      "comment": "The last sentence of the last stamp.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Стои на портата в %@ с вдигнати уши. Доставено."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Dempeus a la porta a %@ , orelles aixecades. Lliurat."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stojim na kapiji u %@ , gore uši. Isporučeno."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوقوف عند البوابة في %@ ، آذان مرفوعة. تم التوصيل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stående ved porten i %@ , ører op. Leveret."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stojím u brány v %@ , uši nahoře. Doručeno."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing at the gate in %@, ears up. Delivered."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing at the gate in %@, ears up. Delivered."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing at the gate in %@, ears up. Delivered."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@ mit erhobenen Ohren am Tor stehen. Geliefert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στέκεται στην πύλη στο %@ , τα αυτιά ψηλά. Παραδόθηκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie en la puerta en %@, con las orejas en alto. Entregado."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "De pie en la puerta en %@, con las orejas en alto. Entregado."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ko atean zutik, belarriak gora. Entregatua."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seisan %@ väravas, kõrvad püsti. Tarnitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout à la porte de %@ , les oreilles levées. Livré."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Debout à la porte de %@ , les oreilles levées. Livré."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Portilla seisomassa %@ , korvat pystyssä. Toimitettu."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ina sheasamh ag an ngeata i %@ , cluasa suas. Seachadadh."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "De pé na porta en %@ , orellas arriba. Entregado."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עומד בשער ב-%@ , אוזניים למעלה. נמסר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में गेट पर कान ऊपर करके खड़े हैं। पहुंचा दिया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stojim na vratima u %@, s podignutim ušima. Isporučeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ban a kapuban állva, fülekkel. Szállítva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdiri di gerbang di %@ , angkat telinga. Terkirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In piedi al cancello in %@ , orecchie alzate. Consegnato."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Standandi við hliðið í %@ , eyru upp. Afhent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のゲートに立って耳を澄ます。納品されました。"
