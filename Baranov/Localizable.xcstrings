    "Fills in their name — you still pick where they're headed.": {
      "comment": "A description of how the \"From Game Center\" section works.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بملء أسمائهم - لا يزال بإمكانك اختيار المكان الذي يتجهون إليه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Попълва името им - все пак вие избирате накъде са се запътили."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Popunite njihovo ime - i dalje birate kuda idu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Empleneu el seu nom; encara trieu cap a on es dirigeixen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyplní jejich jméno – stále si vyberete, kam mají namířeno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udfylder deres navn - du vælger stadig, hvor de er på vej hen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt den Namen aus — das Reiseziel wählst du."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συμπληρώνει το όνομά τους — εξακολουθείτε να επιλέγετε πού θα κατευθυνθούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fills in their name — you still pick where they're headed."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Fills in their name — you still pick where they're headed."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Fills in their name — you still pick where they're headed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Fills in their name — you still pick where they're headed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena su nombre: tú sigues eligiendo adónde van."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete su nombre; aún puede elegir hacia dónde se dirigen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Täidab nende nime – valite ikkagi, kuhu nad lähevad."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Idatzi haien izena; zuk hautatzen duzu oraindik nora doazen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täyttää heidän nimensä – voit silti valita, minne he ovat menossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplit leur nom — vous choisissez toujours leur destination."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplit leur nom – vous choisissez toujours où ils vont."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Líonann tú a n-ainm - roghnaíonn tú fós an áit a bhfuil siad i gceannas."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Encha o seu nome; aínda elixes cara a onde van."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממלא את שמם - אתה עדיין בוחר לאן פניהם מועדות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उनका नाम भरें - आप अभी भी चुनें कि वे कहाँ जा रहे हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispunite njihovo ime - i dalje birate kamo su krenuli."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiírja a nevüket – továbbra is Ön választja ki, merre tartanak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isikan namanya — Anda tetap dapat memilih tujuan mereka."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyllir út nafn þeirra - þú velur samt hvert þeir stefna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisce il loro nome: scegli tu dove sono diretti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "彼らの名前を入力しても、彼らがどこに向かっているのかを選択することができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 입력합니다. 어디로 향할지 선택하면 됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Užpildo savo vardą – jūs vis tiek pasirenkate, kur jie eina."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aizpilda viņu vārdu — jūs joprojām izvēlaties, kur viņi dodas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Го пополнува нивното име - сепак избирате каде одат."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Isikan nama mereka — anda masih memilih ke mana arah tuju mereka."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imla isimhom — xorta tagħżel fejn sejrin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyller inn navnet deres – du velger fortsatt hvor de er på vei."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vult hun naam in - jij kiest nog steeds waar ze naartoe gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypełnia ich imię i nazwisko — nadal wybierasz, dokąd zmierzają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencha o nome deles - você ainda escolhe para onde eles estão indo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencha o nome deles - você ainda escolhe para onde eles estão indo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Completați numele lor - încă alegeți încotro se îndreaptă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполняет их имя — город назначения вы выбираете сами."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyplní ich meno – stále si vyberiete, kam majú namierené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izpolnite njihovo ime - še vedno izberete, kam so namenjeni."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Plotëson emrin e tyre - ju ende zgjidhni se ku po shkojnë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Попуните њихово име - и даље бирате куда иду."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyller i deras namn – du väljer fortfarande vart de är på väg."
