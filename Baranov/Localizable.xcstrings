    "That letter was declined. It has reached its gate, but this phone doesn't have its code, so it can't be opened here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم رفض تلك الرسالة. لقد وصل إلى بوابته، لكن هذا الهاتف ليس لديه رمزه، لذا لا يمكن فتحه هنا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това писмо беше отхвърлено. Стигна до портата си, но този телефон няма кода си, така че не може да се отвори тук."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To pismo je odbijeno. Stigao je do kapije, ali ovaj telefon nema svoj kod, tako da se ne može otvoriti ovdje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta carta va ser rebutjada. Ha arribat a la seva porta, però aquest telèfon no té el seu codi, així que no es pot obrir aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten dopis byl odmítnut. Dosáhl své brány, ale tento telefon nemá svůj kód, takže ho zde nelze otevřít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det brev blev afvist. Den har nået sin port, men denne telefon har ikke sin kode, så den kan ikke åbnes her."
