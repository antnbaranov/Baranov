    "More rams out at once, and every colour of wax to seal them with.": {
      "comment": "A description of the benefits of expanding the pasture.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيخرج المزيد من الكباش مرة واحدة، وكل لون من الشمع لختمها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Повече овни наведнъж и всеки цвят восък, с който да ги запечатате."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Više ovnova odjednom, i sve boje voska da ih zapečatite."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Més ariets alhora, i tots els colors de cera per segellar-los."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Více beranů najednou a všechny barvy vosku, kterými je zapečeťte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere væddere ud på én gang, og hver farve voks at forsegle dem med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr Widder auf einmal und Wachs in allen Farben, um sie zu versiegeln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περισσότερα κριάρια έξω με τη μία, και κάθε χρώμα κεριού για να τα σφραγίσετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More rams out at once, and every colour of wax to seal them with."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "More rams out at once, and every colour of wax to seal them with."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "More rams out at once, and every colour of wax to seal them with."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "More rams out at once, and every colour of wax to seal them with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salen más arietes a la vez y cera de todos los colores para sellarlos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Salen más arietes a la vez y cera de todos los colores para sellarlos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rohkem jäärasid korraga välja ja igat värvi vaha, millega need pitseerida."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahari gehiago aldi berean, eta argizari kolore guztiak zigilatzeko."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Enemmän pässiä kerralla ja jokaisen värin vahaa niiden sulkemiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'autres béliers sortent à la fois, et toutes les couleurs de cire pour les sceller."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "D'autres béliers sortent à la fois, et toutes les couleurs de cire pour les sceller."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuilleadh reithí amach láithreach, agus gach dath céir chun iad a shéalú."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Máis carneiros á vez, e cada cor de cera para selalos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוד זזים בבת אחת, וכל צבע שעווה לאטום אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही बार में अधिक मेढ़े, और उन्हें सील करने के लिए हर रंग का मोम।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Više ovnova odjednom, i sve boje voska za zatvaranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyszerre több kos, és minden színű viasz, amivel lezárható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih banyak domba jantan keluar sekaligus, dan setiap warna lilin digunakan untuk menutupnya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fleiri hrútar út í einu, og hver litur af vax til að innsigla þá með."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più montoni uscirono contemporaneamente, e ogni colore di cera per sigillarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より多くのラムを一度に取り出し、各色のワックスで封印します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 더 많은 양의 숫양을 꺼내고, 이를 봉인하기 위해 모든 색상의 왁스를 사용합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Daugiau avinų iš karto ir kiekvienos spalvos vaško juos užklijuoti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vairāk aunu uzreiz un katra vaska krāsa, ar ko tos aizzīmogot."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повеќе овни одеднаш, и секоја боја на восок за нивно запечатување."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih banyak domba jantan keluar sekaligus, dan setiap warna lilin untuk mengelaknya."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktar imtaten barra f'daqqa, u kull kulur ta 'xama' biex tissiġillahom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere rams ut på en gang, og hver farge av voks å forsegle dem med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er komen meer rammen tegelijk uit, en elke kleur was om ze mee te verzegelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Więcej baranów na raz i każdy kolor wosku do ich zapieczętowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais carneiros de uma vez e cera de todas as cores para selá-los."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais carneiros de uma vez e cera de todas as cores para selá-los."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai mulți berbeci deodată și fiecare culoare de ceară cu care să-i sigileze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу же вышло еще больше таранов, и их запечатали воском всех цветов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Viac baranov naraz a všetky farby vosku na ich zapečatenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Več ovnov naenkrat in vse barve voska, s katerimi jih zapremo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Më shumë desh dalin menjëherë dhe çdo ngjyrë dylli për t'i vulosur."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Више овнова одједном, и свака боја воска да их запечати."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fler rams ut på en gång och varje färg av vax att försegla dem med."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แกะออกมาอีกจำนวนมากในคราวเดียว และขี้ผึ้งทุกสีเพื่อปิดผนึกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı anda daha fazla koç dışarı çıkıyor ve onları mühürlemek için her renkteki balmumu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більше баранів відразу, і всі кольори воску, щоб запечатати їх."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiều thanh ram hơn cùng một lúc và dùng mọi màu sáp để dán chúng lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即取出更多的公羊，并用各种颜色的蜡来密封它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即取出更多的公羊，並用各種顏色的蠟來密封它們。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "More rams out at once, and every colour of wax to seal them with."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მეტი ვერძი ერთდროულად და ყველა ფერის ცვილი, რომ დალუქოს ისინი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірден көбірек қошқарлар және оларды тығыздау үшін балауыздың әр түсі."
          }
        }
      }
    },
