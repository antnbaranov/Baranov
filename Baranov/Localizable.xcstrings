          "stringUnit": {
            "state": "translated",
            "value": "يرجى الاستمرار في الهرولة. أطيب التحيات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt gerne med trav. Venlig hilsen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klusejte laskavě dál. S pozdravem"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Kindly keep trotting. Best regards."
          }
