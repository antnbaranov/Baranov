        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया भ्रमण करते रहें। साभार।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljubazno nastavite kasati. Srdačan pozdrav."
