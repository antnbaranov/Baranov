        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "List jak zwykle dociera pieszo — po prostu nie da się go odszyfrować wcześniej, nawet z prawym kolczykiem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
