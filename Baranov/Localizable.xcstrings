    "Opens only at the place you choose, when the reader is really there." : {
      "comment" : "Text describing the Geo-lock feature, describing the conditions under which the lock opens.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح فقط في المكان الذي تختاره، عندما يكون القارئ هناك بالفعل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отваря се само на избраното от вас място, когато читателят наистина е там."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvara se samo na mestu koje izaberete, kada je čitalac zaista tu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'obre només al lloc que trieu, quan el lector hi és realment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevírá se pouze na vámi zvoleném místě, když tam čtečka skutečně je."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner kun det sted, du vælger, når læseren virkelig er der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet sich nur an dem Ort, den du wählst, wenn der Leser wirklich dort ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίγει μόνο στο μέρος που επιλέγετε, όταν ο αναγνώστης είναι πραγματικά εκεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens only at the place you choose, when the reader is really there."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens only at the place you choose, when the reader is really there."
          }
        },
