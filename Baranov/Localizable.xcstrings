    "Tap when it happens. The ram will be insufferable.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете, когато се случи. Овенът ще бъде непоносим."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toqueu quan passi. El moltó serà insuportable."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط عندما يحدث ذلك. الكبش سيكون لا يطاق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite kada se to dogodi. Ovan će biti nepodnošljiv."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på, når det sker. Vædderen vil være utålelig."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte, až se to stane. Beran bude nesnesitelný."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap when it happens. The ram will be insufferable."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap when it happens. The ram will be insufferable."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap when it happens. The ram will be insufferable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie darauf, wenn es passiert. Der Widder wird unerträglich sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε όταν συμβεί. Το κριάρι θα είναι ανυπόφορο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cuando suceda. El carnero será insoportable."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cuando suceda. El carnero será insoportable."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakatu gertatzen denean. Aharia jasanezina izango da."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puudutage, kui see juhtub. Jäär on väljakannatamatu."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez lorsque cela se produit. Le bélier sera insupportable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez lorsque cela se produit. Le bélier sera insupportable."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta, kun se tapahtuu. Oinasta tulee kärsimätön."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Beartaíonn nuair a tharlaíonn sé. Beidh an reithe dofhulaingthe."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cando ocorra. O carneiro será insufrible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש כשזה קורה. האיל יהיה בלתי נסבל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसा होने पर टैप करें. राम असहनीय होगा."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite kada se dogodi. Ovan će biti nepodnošljiv."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Érintse meg, amikor megtörténik. A kos elviselhetetlen lesz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk saat itu terjadi. Domba jantan itu tidak akan tertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca quando succede. L'ariete sarà insopportabile."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikkaðu á þegar það gerist. Hrúturinn verður óþolandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それが起こったらタップします。雄羊は耐えられないでしょう。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეეხეთ, როცა ეს მოხდება. ვერძი აუტანელი იქნება."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그런 일이 발생하면 탭하세요. 숫양은 참을 수 없을 것입니다."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл орын алған кезде түртіңіз. Қошқар шыдамсыз болады."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėkite, kai tai atsitiks. Avinas bus nepakenčiamas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieskarieties, kad tas notiek. Auns būs neciešams."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допрете кога ќе се случи. Овенот ќе биде неиздржлив."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik apabila ia berlaku. Domba jantan akan menjadi tidak tahan."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tektek meta jiġri. Il-muntun se jkun insofferabbli."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk når det skjer. Væren vil være uutholdelig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op wanneer het gebeurt. De ram zal onuitstaanbaar zijn."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque quando isso acontecer. O carneiro será insuportável."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij, kiedy to się stanie. Baran będzie nie do zniesienia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque quando isso acontecer. O carneiro será insuportável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, когда это произойдет. Баран будет невыносим."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingeți când se întâmplă. Berbecul va fi insuportabil."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite, ko se zgodi. Oven bo nevzdržen."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnite, keď sa to stane. Baran bude neznesiteľný."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekni kur të ndodhë. Dashi do të jetë i padurueshëm."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Додирните када се то догоди. Ован ће бити неподношљив."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเมื่อมันเกิดขึ้น แรมจะทนไม่ไหว"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på när det händer. Baggen kommer att vara olidlig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gerçekleştiğinde dokunun. Koç dayanılmaz olacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть, коли це станеться. Баран буде нестерпний."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发生时点击。公羊将难以忍受。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào khi nó xảy ra. Ram sẽ không thể chịu nổi."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "發生時點選。公羊將難以忍受。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生時點選。公羊將難以忍受。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap when it happens. The ram will be insufferable."
          }
        }
      }
    },
