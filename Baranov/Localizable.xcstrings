        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gengur að hliði %@ á tröppunum þínum. Það lendir í póstpokanum þeirra þegar það kemur þangað."
          }
        },
        "it" : {
          "stringUnit" : {
