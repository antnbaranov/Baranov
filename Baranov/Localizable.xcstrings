          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não criptografado. Qualquer pessoa que carregue o carneiro pode lê-lo e %@ não precisa de código no portão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não criptografado. Qualquer pessoa que carregue o carneiro pode lê-lo e %@ não precisa de código no portão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu este criptat. Oricine poartă berbecul îl poate citi, iar %@ nu are nevoie de cod la poartă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без шифрования. Любой, кто несёт барана, может прочесть письмо, а %@ не потребуется код у ворот."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie je zašifrované. Každý, kto nosí baranidlo, ho môže prečítať a %@ nepotrebuje žiadny kód na bráne."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni šifrirano. Vsakdo, ki nosi ovna, ga lahko prebere in %@ ne potrebuje kode pri vratih."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jo i koduar. Kushdo që mban dashin mund ta lexojë dhe %@ nuk ka nevojë për kod në portë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Није шифровано. Свако ко носи овна може да га прочита, а %@ не треба код на капији."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte krypterad. Alla som bär baggen kan läsa den, och %@ behöver ingen kod vid grinden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ได้เข้ารหัส ใครก็ตามที่ถือแกะตัวนั้นสามารถอ่านได้ และ %@ ไม่จำเป็นต้องใช้รหัสที่ประตู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şifrelenmemiş. Koçu taşıyan herkes onu okuyabilir ve %@'ın kapıda herhangi bir koda ihtiyacı yoktur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не зашифровано. Кожен, хто носить барана, може прочитати його, і %@ не потребує коду біля воріт."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không được mã hóa. Bất cứ ai mang ram đều có thể đọc được và %@ không cần mã ở cổng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未加密。任何帮带公羊的人都可以阅读，%@在城门处无需密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
