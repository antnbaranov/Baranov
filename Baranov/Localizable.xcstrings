    "Just circling back on %@'s performance.": {
      "comment": "A passive-aggressive HR email that is secretly very proud.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Просто се връщам към представянето на %@."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només tornem al rendiment de %@."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo se vraćam na performanse %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما عليك سوى العودة إلى أداء %@ ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare cirkulerer tilbage på %@ 's præstation."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen kroužím zpět na výkon %@."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Just circling back on %@'s performance."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Just circling back on %@'s performance."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Just circling back on %@'s performance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich komme nur noch einmal auf die Leistung von %@ zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απλώς επανέρχομαι στην απόδοση του %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simplemente volviendo a la actuación de %@."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Simplemente volviendo a la actuación de %@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihtsalt tiirleme tagasi kasutaja %@ esinemisele."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ren errendimenduari buelta eman besterik ez dago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reviens juste sur la performance de %@ ."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reviens juste sur la performance de %@ ."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierrän vain takaisin %@:n suoritukseen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl ort ach ciorcal timpeall ar ais ar fheidhmíocht %@."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Só voltando sobre o rendemento de %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק חוזר על הביצועים של %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बस %@ के प्रदर्शन पर वापस घूम रहा हूँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo zaokruživanje na izvedbu %@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak körbejárom %@ teljesítményét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya memutar kembali penampilan %@ ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torniamo solo alla performance di %@ ."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara að hringja til baka um frammistöðu %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のパフォーマンスを振り返ってみます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უბრალოდ შემოვბრუნდი %@-ის შესრულებაზე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек %@ өнімділігін айналдыру."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 의 성능을 다시 살펴보겠습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiesiog apžvelgiu %@ pasirodymą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vienkārši pagriežos atpakaļ par %@ sniegumu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Само заокружувајќи се на изведбата на %@."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya berputar kembali pada persembahan %@."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Biss iddur lura fuq il-prestazzjoni ta' %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare sirkler tilbake på %@ sin opptreden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Even terugblikken op de prestaties van %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wracam tylko do występu %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas voltando ao desempenho de %@."
          }
        },
        "pt-PT": {
