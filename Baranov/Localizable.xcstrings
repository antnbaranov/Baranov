          "stringUnit" : {
            "state" : "translated",
            "value" : "ნება მიეცით ბარანოვს ნახოს თქვენი თამაშის ცენტრის მეგობრები პარამეტრებიდან ცხრილების შესადარებლად."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Барановқа кестелерді салыстыру үшін Параметрлерде ойын орталығының достарын көруге рұқсат беріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baranov가 설정에서 Game Center 친구들을 확인하여 테이블을 비교할 수 있도록 허용하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leiskite Baranovui matyti jūsų žaidimų centro draugus nustatymuose, kad jie galėtų palyginti lenteles."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ļaujiet Baranovam redzēt savus Game Center draugus sadaļā Iestatījumi, lai salīdzinātu tabulas."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволете Баранов да ги гледа вашите пријатели од Game Center во Поставки за да ги споредува табелите."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan Baranov melihat rakan Pusat Permainan anda dalam Tetapan untuk membandingkan jadual."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ħalli lil Baranov jara l-ħbieb tiegħek taċ-Ċentru tal-Logħob fis-Settings biex iqabbel it-tabelli."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillat Baranov å se Game Center-vennene dine i Innstillinger for å sammenligne tabeller."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Baranov toe om uw Game Center-vrienden te zien in Instellingen om tabellen te vergelijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól Baranovowi widzieć znajomych z Game Center w Ustawieniach i porównywać stoły."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que Baranov veja seus amigos do Game Center em Configurações para comparar tabelas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que Baranov veja seus amigos do Game Center em Configurações para comparar tabelas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite lui Baranov să-ți vadă prietenii din Game Center în Setări pentru a compara tabele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разреши Баранову видеть твоих друзей в Game Center в настройках, чтобы сравнивать таблицы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umožnite Baranovovi vidieť vašich priateľov Game Center v Nastaveniach a porovnať stoly."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dovolite Baranov, da vidi vaše prijatelje iz Game Center v nastavitvah za primerjavo tabel."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lejo Baranov të shohë miqtë tuaj të Game Center te Cilësimet për të krahasuar tabelat."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволите Баранову да види ваше пријатеље из Гаме Центер-а у подешавањима да упореди табеле."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt Baranov att se dina Game Center-vänner i Inställningar för att jämföra tabeller."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตให้ Baranov เห็นเพื่อน Game Center ของคุณในการตั้งค่าเพื่อเปรียบเทียบตาราง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabloları karşılaştırmak için Baranov'un Ayarlar'da Game Center arkadaşlarınızı görmesine izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволь Баранову бачити твоїх друзів Game Center у налаштуваннях, щоб порівнювати таблиці."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép Baranov xem bạn bè trong Game Center của bạn trong Cài đặt để so sánh các bảng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许巴拉诺夫在“设置”中查看您的 Game Center 好友以比较表格。"
          }
        },
        "zh-Hant" : {
