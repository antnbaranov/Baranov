        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvara %@ pasoš, spreman za prvi pečat"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obre el passaport de %@, preparat per al seu primer segell"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevře cestovní pas %@, připraven na první razítko"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner %@s pas, klar til dets første stempel"
