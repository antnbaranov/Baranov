            "value": "Au-dessus de %@ , le bélier se déplace avec un objectif silencieux."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yli %@ pässi liikkuu hiljaisella tarkoituksella."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Thar %@ , bogann an reithe go ciúin."
