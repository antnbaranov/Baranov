        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სად ელაპარაკე, რას ატარებენ, რაც ღირს დასამახსოვრებლად"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신이 어디서 이야기했는지, 그들이 무엇을 갖고 있는지, 기억할 만한 것은 무엇이든"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сіз қайда сөйлестіңіз, олар не алып жүр, есте сақтауға тұрарлық нәрсе"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur kalbėjote, ką jie nešiojasi, ką verta prisiminti"
