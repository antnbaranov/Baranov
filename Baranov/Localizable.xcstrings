    "Move the map — the pin stays in the middle. Only you see this spot.": {
      "comment": "A description of the map picker.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преместете картата — щифтът остава в средата. Само вие виждате това място."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mou el mapa: el marcador es queda al mig. Només tu veus aquest lloc."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomjerite mapu — igla ostaje u sredini. Samo vi vidite ovo mesto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرك الخريطة — يبقى الدبوس في المنتصف. أنت فقط ترى هذا المكان."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt kortet — nålen bliver i midten. Kun du ser dette sted."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte mapu — špendlík zůstane uprostřed. Toto místo vidíte jen vy."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the map — the pin stays in the middle. Only you see this spot."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the map — the pin stays in the middle. Only you see this spot."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the map — the pin stays in the middle. Only you see this spot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschieben Sie die Karte – die Stecknadel bleibt in der Mitte. Nur Sie sehen diesen Ort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακινήστε τον χάρτη — η καρφίτσα παραμένει στη μέση. Μόνο εσείς βλέπετε αυτό το σημείο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el mapa: el marcador permanece en el medio. Sólo tú ves este lugar."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el mapa: el marcador permanece en el medio. Sólo tú ves este lugar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Liigutage kaarti – nööpnõel jääb keskele. Ainult teie näete seda kohta."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mugitu mapa — pina erdian geratzen da. Zuk bakarrik ikusten duzu leku hau."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez la carte – l’épingle reste au milieu. Vous seul voyez cet endroit."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez la carte – l’épingle reste au milieu. Vous seul voyez cet endroit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä karttaa – merkki pysyy keskellä. Vain sinä näet tämän paikan."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Bog an léarscáil - fanann an bioráin sa lár. Ní fheiceann tú ach an láthair seo."
