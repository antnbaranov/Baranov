    "A note when a ram arrives or goes quiet. The morning note comes once a day, at the time you choose, and only while a ram is walking." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظة عند وصول كبش أو هدوءه. تأتي النوتة الصباحية مرة واحدة يوميًا، في الوقت الذي تختاره، وفقط أثناء سير الكبش."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бележка, когато овен пристигне или утихне. Сутрешната бележка идва веднъж на ден, в избраното от вас време и само докато овен ходи."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napomena kada ovan dođe ili utihne. Jutarnja nota dolazi jednom dnevno, u vrijeme koje odaberete, i samo dok ovan hoda."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota quan arriba un ariet o es queda callat. La nota del matí arriba un cop al dia, a l'hora que trieu, i només mentre camina un moltó."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámka, když beran dorazí nebo ztichne. Ranní tón přichází jednou denně, v čase, který si zvolíte, a pouze během chůze berana."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En seddel, når en vædder ankommer eller bliver stille. Morgennoten kommer en gang om dagen, på det tidspunkt, du vælger, og kun mens en vædder går."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Notiz, wenn ein Widder ankommt oder verstummt. Die Morgennachricht kommt einmal am Tag, zu deiner gewählten Zeit und nur, während ein Widder läuft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια σημείωση όταν ένας κριός φτάνει ή σιωπά. Η πρωινή νότα έρχεται μια φορά την ημέρα, την ώρα που επιλέγετε, και μόνο όταν περπατάει ένα κριάρι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A note when a ram arrives or goes quiet. The morning note comes once a day, at the time you choose, and only while a ram is walking."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A note when a ram arrives or goes quiet. The morning note comes once a day, at the time you choose, and only while a ram is walking."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A note when a ram arrives or goes quiet. The morning note comes once a day, at the time you choose, and only while a ram is walking."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A note when a ram arrives or goes quiet. The morning note comes once a day, at the time you choose, and only while a ram is walking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota cuando llega un carnero o se queda en silencio. La nota de la mañana llega una vez al día, a la hora que elijas, y sólo mientras camina un carnero."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota cuando llega un carnero o se queda en silencio. La nota de la mañana llega una vez al día, a la hora que elijas, y sólo mientras camina un carnero."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Märkus, kui jäär saabub või vaikseks jääb. Hommikune noot tuleb kord päevas, teie valitud ajal ja ainult jäära kõndimise ajal."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohar bat ahari bat iristen edo isiltzen denean. Goizeko oharra egunean behin dator, zuk aukeratzen duzun orduan, eta ahari bat oinez doan bitartean bakarrik."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huomautus, kun pässi saapuu tai vaikenee. Aamulappu tulee kerran päivässä valitsemaasi aikaan ja vain oinaan kävellessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une note lorsqu'un bélier arrive ou se tait. La note du matin arrive une fois par jour, à l'heure que tu choisis, et seulement pendant qu'un bélier marche."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une note lorsqu'un bélier arrive ou se tait. La note du matin arrive une fois par jour, à l'heure que tu choisis, et seulement pendant qu'un bélier marche."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nóta nuair a thagann reithe nó nuair a théann sé ciúin. Tagann an nóta maidin uair amháin sa lá, ag an am a roghnaíonn tú, agus gan ach cé go bhfuil reithe ag siúl."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unha nota cando chega ou cala un carneiro. A nota da mañá chega unha vez ao día, á hora que escollas, e só mentres un carneiro está camiñando."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הערה כאשר איל מגיע או משתתק. פתק הבוקר מגיע פעם ביום, בזמן שאתה בוחר, ורק בזמן שאיל הולך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक नोट जब कोई मेढ़ा आता है या चुपचाप चला जाता है। सुबह का नोट दिन में एक बार आता है, आपके द्वारा चुने गए समय पर, और केवल तब जब कोई मेढ़ा चल रहा हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napomena kada ovan stigne ili utihne. Jutarnja poruka dolazi jednom dnevno, u vrijeme koje vi odaberete i samo dok ovan hoda."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megjegyzés, ha egy kos érkezik vagy elhallgat. A reggeli jegyzet naponta egyszer jön, a választott időpontban, és csak akkor, amikor egy kos sétál."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan ketika seekor domba jantan datang atau pergi diam. Catatan pagi datang sekali sehari, pada waktu yang Anda pilih, dan hanya saat seekor domba jantan sedang berjalan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Athugasemd þegar hrútur kemur eða þegir. Morgunblaðið kemur einu sinni á dag, á þeim tíma sem þú velur, og aðeins á meðan hrútur gengur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota quando arriva o si zittisce un ariete. La nota mattutina arriva una volta al giorno, all'ora che preferisci, e solo mentre l'ariete sta camminando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雄羊が到着したとき、または静かになったときのメモ。朝の手紙は、1 日 1 回、選択した時間に、雄羊が歩いている間だけ届きます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შენიშვნა, როდესაც ვერძი ჩამოდის ან ჩუმდება. დილის ნოტა მოდის დღეში ერთხელ, თქვენს მიერ არჩეულ დროს და მხოლოდ მაშინ, როცა ვერძი დადის."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қошқар келген немесе тыныштық кеткен кездегі ескерту. Таңертеңгілік жазба күніне бір рет, сіз таңдаған уақытта және тек қошқар жүргенде келеді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숫양이 도착하거나 조용해질 때의 메모입니다. 아침 메모는 하루에 한 번, 원하는 시간에, 숫양이 걷고 있는 동안에만 옵니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastaba, kai avinas ateina arba nutyla. Rytinis užrašas ateina kartą per dieną, pasirinktu laiku ir tik avinui vaikštant."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piezīme, kad pienāk auns vai klusē. Rīta piezīme nāk vienu reizi dienā, jūsu izvēlētajā laikā un tikai tad, kad auns staigā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забелешка кога ќе пристигне овен или кога ќе молчи. Утринската нота доаѓа еднаш дневно, во времето што ќе го изберете и само додека оди овен."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota apabila seekor domba jantan tiba atau senyap. Nota pagi datang sekali sehari, pada masa yang anda pilih, dan hanya semasa seekor domba jantan sedang berjalan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota meta muntun jasal jew imur kwiet. In-nota ta’ filgħodu tiġi darba kuljum, fil-ħin li tagħżel, u biss waqt li muntun ikun miexi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lapp når en vær kommer eller blir stille. Morgenlappen kommer en gang om dagen, på det tidspunktet du velger, og kun mens en vær går."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een briefje wanneer een ram arriveert of stil wordt. Het ochtendbriefje komt één keer per dag, op het door u gekozen tijdstip, en alleen terwijl er een ram loopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notatka, gdy baran przybywa lub milknie. Notatka poranna przychodzi raz dziennie, o wybranej przez Ciebie porze i tylko wtedy, gdy baran idzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma nota quando um carneiro chega ou fica quieto. A nota matinal vem uma vez por dia, no horário que você escolher, e somente enquanto um carneiro estiver caminhando."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma nota quando um carneiro chega ou fica quieto. A nota matinal vem uma vez por dia, no horário que você escolher, e somente enquanto um carneiro estiver caminhando."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O notă când sosește sau tace un berbec. Nota de dimineață vine o dată pe zi, la ora pe care o alegeți și numai în timp ce un berbec merge."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заметка, когда баран приходит или замолкает. Утренняя записка приходит один раз в день, в выбранное тобой время и только пока баран гуляет."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poznámka, keď baran prichádza alebo stíchne. Ranná nota prichádza raz denne, v čase, ktorý si zvolíte, a iba počas chôdze barana."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opomba, ko oven pride ali utihne. Jutranja nota pride enkrat na dan, ob uri, ki jo izberete, in samo ko oven hodi."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Një shënim kur një dash mbërrin ose shkon i qetë. Nota e mëngjesit vjen një herë në ditë, në kohën që ju zgjidhni dhe vetëm kur një dash është duke ecur."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Порука када ован дође или утихне. Јутарња нота долази једном дневно, у време које изаберете, и само док ован хода."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lapp när en bagge kommer eller tystnar. Morgonlappen kommer en gång om dagen, vid den tid du väljer, och bara när en bagge går."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแจ้งเตือนเมื่อแกะมาถึงหรือเงียบไป ข้อความตอนเช้าจะมาวันละครั้งตามเวลาที่คุณเลือก และเฉพาะในขณะที่แกะกำลังเดินเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir koç geldiğinde veya sustuğunda bir not. Sabah notu günde bir kez, seçtiğiniz saatte ve yalnızca koç yürürken gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замітка, коли баран прилітає або затихає. Ранкова записка приходить раз на день, у обраний тобою час, і тільки коли баран гуляє."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một lưu ý khi ram đến hoặc im lặng. Lời nhắn buổi sáng đến mỗi ngày một lần, vào thời điểm bạn chọn và chỉ khi con cừu đực đang đi bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当公羊到达或安静时的注释。早晨的音符每天发出一次，在你选择的时间发出，而且只有在公羊行走时发出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當公羊到達或安靜時的註釋。早晨的音符每天發出一次，在你選擇的時間發出，而且只有在公羊行走時發出。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當公羊到達或安靜時的註釋。早晨的音符每天發出一次，在你選擇的時間發出，而且只有在公羊行走時發出。"
          }
        }
      }
    },
    "A ram can be days from the gate. We tap you when it gets there, or when a letter arrives for you. Never for promotions. Ever." : {
      "comment" : "Text describing the benefits of receiving arrival alerts.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن يكون الكبش أيامًا من البوابة. نقوم بالنقر عليك عندما تصل إلى هناك، أو عندما تصل إليك رسالة. أبدا للترقيات. أبدًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Овен може да бъде дни от портата. Ние ви подслушваме, когато пристигне там или когато пристигне писмо за вас. Никога за промоции. някога."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovan može biti danima od kapije. Prisluškujemo vas kada stigne, ili kada stigne pismo za vas. Nikad za promocije. Ikad."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ariet pot estar dies des de la porta. Et toquem quan arriba o quan arriba una carta per tu. Mai per promocions. Mai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beran může být několik dní od brány. Zaklepeme na vás, až tam dorazí, nebo když vám přijde dopis. Nikdy ne kvůli propagaci. Vůbec."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vædder kan være dage fra porten. Vi trykker på dig, når den når frem, eller når der kommer et brev til dig. Aldrig til kampagner. Nogensinde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Widder kann Tage vom Tor entfernt sein. Wir tippen dich an, wenn er ankommt oder ein Brief für dich eintrifft. Niemals für Werbung. Niemals."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα κριάρι μπορεί να απέχει μέρες από την πύλη. Σας χτυπάμε όταν φτάσει εκεί ή όταν φτάσει ένα γράμμα για εσάς. Ποτέ για προαγωγές. Πάντα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ram can be days from the gate. We tap you when it gets there, or when a letter arrives for you. Never for promotions. Ever."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ram can be days from the gate. We tap you when it gets there, or when a letter arrives for you. Never for promotions. Ever."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ram can be days from the gate. We tap you when it gets there, or when a letter arrives for you. Never for promotions. Ever."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ram can be days from the gate. We tap you when it gets there, or when a letter arrives for you. Never for promotions. Ever."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un carnero puede estar a días de la puerta. Te avisamos cuando llegue allí o cuando te llegue una carta. Nunca para promociones. Jamás."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un carnero puede estar a días de la puerta. Te avisamos cuando llegue allí o cuando te llegue una carta. Nunca para promociones. Jamás."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jäär võib olla päevade kaugusel väravast. Puudutame teid, kui see kohale jõuab või kui teile saabub kiri. Mitte kunagi reklaamide jaoks. Kunagi."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahari bat atetik egun batzuetara egon daiteke. Hara iristen denean edo gutun bat iristen zaizunean ukitzen zaitugu. Inoiz ez promozioetarako. Inoiz."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oinas voi olla päiviä portista. Napautamme sinua, kun se saapuu perille tai kun sinulle saapuu kirje. Ei koskaan promootioihin. Koskaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bélier peut être à plusieurs jours de marche. On te prévient quand il arrive ou quand une lettre t'attend. Jamais de pub. Jamais."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bélier peut être à plusieurs jours de marche. On te prévient quand il arrive ou quand une lettre t'attend. Jamais de pub. Jamais."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is féidir le reithe laethanta ón ngeata. Beartaíonn muid tú nuair a thagann sé ann, nó nuair a thagann litir chugat. Ná le haghaidh ardú céime. Riamh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un carneiro pode estar a días da porta. Tocámosche cando chegue alí ou cando chegue unha carta. Nunca por promocións. Sempre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איל יכול להיות ימים מהשער. אנו מקישים עליך כאשר הוא מגיע לשם, או כאשר מכתב מגיע עבורך. לעולם לא למבצעים. אֵיִ פַּעַם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक राम गेट से कुछ दिन दूर रह सकता है। जब वह वहां पहुंचता है, या जब आपके लिए कोई पत्र आता है तो हम आपको टैप करते हैं। प्रमोशन के लिए कभी नहीं. कभी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovan može biti danima od vrata. Javljamo vam se kada stigne ili kada vam stigne pismo. Nikad za promaknuća. Ikad."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kos napokra lehet a kaputól. Megérintjük, amikor megérkezik, vagy ha levél érkezik hozzád. Promócióra soha. Valaha."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seekor domba jantan bisa berhari-hari dari gerbang. Kami menghubungi Anda saat surat itu sampai di sana, atau saat ada surat yang tiba untuk Anda. Tidak pernah untuk promosi. Pernah."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hrútur getur verið dagar frá hliðinu. Við pikkum á þig þegar það kemur þangað eða þegar bréf berst til þín. Aldrei fyrir kynningar. Alltaf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ariete può essere a giorni dal cancello. Ti contattiamo quando arriva lì, o quando arriva una lettera per te. Mai per promozioni. Mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雄羊は門から数日かかることもあります。それが到着したとき、または手紙が届いたときに、私たちはあなたをタップします。決してプロモーションのためではありません。これまで。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ვერძი შეიძლება იყოს რამდენიმე დღე კარიბჭედან. ჩვენ დაგირეკავთ, როცა ის იქ მოხვდება, ან როცა წერილი მოგივა. არასოდეს აქციებისთვის. ოდესმე."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қошқар қақпадан бірнеше күн болуы мүмкін. Ол жерге жеткенде немесе сізге хат келгенде біз сізді түртеміз. Ешқашан акциялар үшін емес. Ешқашан."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숫양은 문에서 며칠이 걸릴 수 있습니다. 편지가 도착하거나 편지가 도착하면 탭해 드립니다. 프로모션용은 절대 아닙니다. 항상."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avinas gali būti kelias dienas nuo vartų. Paliečiame jus, kai jis pasiekia arba kai gaunate laišką. Niekada dėl akcijų. Kada nors."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auns var būt dienas no vārtiem. Mēs pieskaramies jums, kad tā nonāk tur vai kad jums pienāk vēstule. Nekad par akcijām. Kādreiz."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Овен може да биде неколку дена од портата. Ве допираме кога ќе стигне таму или кога ќе ви пристигне писмо. Никогаш за промоции. Некогаш."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seekor domba jantan boleh beberapa hari dari pintu gerbang. Kami mengetik anda apabila ia sampai di sana, atau apabila surat tiba untuk anda. Tidak pernah untuk promosi. Pernah."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A muntun jista 'jkun jiem mill-bieb. Nitektek meta tasal hemm, jew meta tasal ittra għalik. Qatt għall-promozzjonijiet. Ever."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vær kan være dager fra porten. Vi tapper deg når den kommer dit, eller når et brev kommer til deg. Aldri for kampanjer. Stadig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een ram kan dagen verwijderd zijn van de poort. We tikken je af als het aankomt, of als er een brief voor je aankomt. Nooit voor promoties. Ooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baran może być kilka dni od bramy. Dotykamy Cię, gdy dotrze na miejsce lub gdy dotrze do Ciebie list. Nigdy dla awansów. Kiedykolwiek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um carneiro pode estar a dias do portão. Nós tocamos em você quando chega lá ou quando chega uma carta para você. Nunca para promoções. Sempre."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um carneiro pode estar a dias do portão. Nós tocamos em você quando chega lá ou quando chega uma carta para você. Nunca para promoções. Sempre."
