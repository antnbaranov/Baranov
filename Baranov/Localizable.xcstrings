          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Călărește în geanta de poștă și se mișcă cu pașii tăi, fără să ia un condei în pășune. Expeditorul poate solicita oricând înapoi."
