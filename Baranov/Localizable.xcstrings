    "Letters heading somewhere near your destination can be handed to you." : {
      "comment" : "A description of the functionality of the \"Add a Trip\" screen.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن تسليم الرسائل الموجهة إلى مكان ما بالقرب من وجهتك إليك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Могат да ви бъдат предадени писма, насочени някъде близо до вашата дестинация."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisma koja idu negdje blizu vašeg odredišta mogu vam biti uručena."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es poden lliurar cartes que es dirigeixen a un lloc proper a la vostra destinació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopisy směřující někam blízko vašeho cíle vám mohou být předány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breve på vej til et sted i nærheden af din destination kan afleveres til dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Briefe, die in die Richtung deines Reiseziels unterwegs sind, können dir übergeben werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιστολές που κατευθύνονται κάπου κοντά στον προορισμό σας μπορούν να σας παραδοθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letters heading somewhere near your destination can be handed to you."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letters heading somewhere near your destination can be handed to you."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letters heading somewhere near your destination can be handed to you."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
