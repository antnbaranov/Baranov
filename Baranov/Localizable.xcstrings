          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять баранов, каждый воск. Спасибо, что поддерживаете медленный пост."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Päť baranov, každý vosk. Ďakujem, že udržiavate pomalý príspevok pri živote."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pet ovnov, vsak vosek. Hvala, ker ohranjate počasno objavo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesë desh, çdo dyll. Faleminderit që mbajtët gjallë një postim të ngadaltë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Пет овнова, сваки восак. Хвала вам што одржавате спори пост живим."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fem baggar, varje vax. Tack för att du håller ett långsamt inlägg vid liv."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แกะผู้ห้าตัว ขี้ผึ้งทุกตัว ขอบคุณสำหรับการโพสต์ช้ามีชีวิตอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş koç, her biri balmumu. Yavaş bir gönderiyi canlı tuttuğunuz için teşekkür ederiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "П'ять баранів, кожен віск. Дякую, що підтримуєте повільний допис."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Năm con cừu đực, mỗi con sáp. Cảm ơn bạn đã giữ một bài viết chậm còn sống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Five rams, every wax.感谢您让缓慢的帖子保持活力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五隻公羊，每隻蠟。感謝您讓緩慢的帖子保持活力。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "五隻公羊，每隻蠟。感謝您讓緩慢的帖子保持活力。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხუთი ვერძი, ყოველი ცვილი. გმადლობთ, რომ ნელი პოსტი შეინარჩუნეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бес қошқар, әр балауыз. Баяу постты сақтап қалғаныңыз үшін рахмет."
          }
        }
      }
    },
