        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Багровый цвет есть у каждого пастыря. Tap another wax."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Karmínová patrí každému pastierovi. Naklepte ďalší vosk."
