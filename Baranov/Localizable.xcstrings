        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "წერილი, რომელიც ელოდება გადაცემას, შეიძლება პირდაპირ AirDrop-ში გადაეცეს ნებისმიერს აქ, ვისი დანიშნულების ადგილი ემთხვევა, ან მდებარეობს %@ კმ-ში, სადაც ის რეალურად მიდის."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
