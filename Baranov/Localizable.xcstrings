            "value" : "Sälen väntar. Dela öronmärket och låt dem bryta det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตราประทับกำลังรออยู่ แบ่งปันแท็กหูและปล่อยให้มันหัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mühür bekliyor. Kulak küpesini paylaşın ve kırmalarına izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Печатка чекає. Поділися вушною биркою, і дозволь їм зламати її."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con dấu đang chờ đợi. Chia sẻ thẻ tai và để họ phá vỡ nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封印正在等待。分享耳标并让他们打破它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封印正在等待。分享耳標並讓他們打破它。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "封印正在等待。分享耳標並讓他們打破它。"
          }
        }
