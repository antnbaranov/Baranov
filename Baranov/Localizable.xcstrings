        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 한 걸음도 안 남았습니다. 이곳의 잔디는 분명히 훌륭합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar nė žingsnio. Žolė čia, matyt, puiki."
