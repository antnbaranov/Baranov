        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès que le téléphone de %@ indique où se trouve leur portail, %@ s'y rend sur tes pas."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chomh luath agus a deir fón %@ 's cá bhfuil an geata, %@ siúl ann ar do chéimeanna."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En canto o teléfono de %@ indica onde está a súa porta, %@ camiña ata alí nos teus pasos."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ברגע שהטלפון של %@ אומר איפה השער שלהם, %@ הולך לשם על המדרגות שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जैसे ही %@ का फ़ोन बताता है कि उनका गेट कहाँ है, %@ आपके कदमों में वहाँ चल देता है।"
