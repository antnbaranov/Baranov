          "stringUnit": {
            "state": "translated",
            "value": "Meja itu kosong — jadilah gembala pertama di atasnya."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-mejda hija vojta — kun l-ewwel ragħaj fuqha."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bordet er tomt - vær den første hyrden på det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tafel is leeg – wees de eerste herder erop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stół jest pusty — bądź na nim pierwszym pasterzem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesa está vazia – seja o primeiro pastor nela."
