    "Passed %@ and got another stamp. Chest out.": {
      "comment": "A travel note.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Премина %@ и получи още един печат. Гърди навън."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Va superar %@ i vaig obtenir un altre segell. El pit fora."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prošao %@ i dobio još jedan pečat. Grudi van."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نجحت %@ وحصلت على ختم آخر. خارج الصدر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestod %@ og fik endnu et stempel. Bryst ud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Složil %@ a získal další razítko. Hruď ven."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Passed %@ and got another stamp. Chest out."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Passed %@ and got another stamp. Chest out."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Passed %@ and got another stamp. Chest out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bestanden und einen weiteren Stempel erhalten. Brust raus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πέρασε το %@ και πήρε άλλο γραμματόσημο. Το στήθος έξω."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasó %@ y obtuvo otro sello. Saca pecho."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasó %@ y obtuvo otro sello. Saca pecho."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Läbis %@ ja sai uue templi. Rind välja."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gainditu eta beste zigilu bat lortu. Bularra kanpora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai réussi %@ et j'ai obtenu un autre tampon. Poitrine dehors."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai réussi %@ et j'ai obtenu un autre tampon. Poitrine dehors."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Läpäisi %@ ja sai uuden leiman. Rinta ulos."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Passed %@ agus fuair stampa eile. Cófra amach."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasou %@ e conseguiu outro selo. O peito fóra."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עבר %@ וקיבל חותמת נוספת. חזה החוצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ उत्तीर्ण किया और एक और मोहर प्राप्त की। छाती बाहर."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Položio %@ i dobio drugu markicu. Prsa van."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikerült %@ és újabb bélyeget kapott. Mellkas ki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lulus %@ dan mendapat stempel lainnya. Dada keluar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha superato %@ e ha ottenuto un altro timbro. Petto in fuori."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Stóðst %@ og fékk annan stimpil. Brjóstið út."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を通過し、別のスタンプを獲得しました。胸が出ます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გაიარა %@ და მიიღო კიდევ ერთი ბეჭედი. მკერდი გარეთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ тапсырып, тағы бір мөр алды. Кеуде сырты."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 통과하고 또 다른 스탬프를 받았습니다. 가슴을 내밀어라."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išlaikė %@ ir gavo dar vieną antspaudą. Iš krūtinės."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nokārtoja %@ un ieguva vēl vienu zīmogu. Krūtis ārā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помина %@ и доби уште еден печат. Градите надвор."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lulus %@ dan mendapat setem lagi. Keluarkan dada."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għadda %@ u ħadt timbru ieħor. Sider barra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestod %@ og fikk et nytt stempel. Bryst ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geslaagd voor %@ en weer een stempel gekregen. Borst uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdany %@ i dostałem kolejny znaczek. Wypnij klatkę piersiową."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passou %@ e recebeu outro carimbo. Peito para fora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Passou %@ e recebeu outro carimbo. Peito para fora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сдал %@ и получил еще одну печать. Вынуть грудь."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am trecut de %@ și am primit o altă ștampilă. Pieptul afară."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prešiel %@ a získal ďalšiu pečiatku. Hruď von."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravil %@ in dobil še en žig. Prsni koš ven."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaloi %@ dhe mori një pullë tjetër. Gjoksi jashtë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Прошао %@ и добио још један печат. Груди ван."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผ่าน %@ และได้ประทับตราอีก อกออก"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klarade %@ och fick ytterligare en stämpel. Bröstet ut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'ı geçtim ve başka bir damga aldım. Göğüs dışarı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройшов %@ і отримав ще одну печатку. Витяг грудей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过%@并获得另一枚印章。挺胸。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã vượt qua %@ và nhận được một con tem khác. Hở ngực."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "通過%@並獲得另一枚印章。挺胸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通過%@並獲得另一枚印章。挺胸。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passed %@ and got another stamp. Chest out."
          }
        }
