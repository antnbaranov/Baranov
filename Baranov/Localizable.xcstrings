        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco carneiros, cada cera. Grazas por manter viva unha publicación lenta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חמישה איילים, כל שעווה. תודה על שמירה על פוסט איטי בחיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाँच मेढ़े, प्रत्येक मोम। धीमी पोस्ट को जीवित रखने के लिए धन्यवाद."
