        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As soon as %@'s phone says where their gate is, %@ walks there on your steps."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As soon as %@'s phone says where their gate is, %@ walks there on your steps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tan pronto como el teléfono de %@ indica dónde está su puerta, %@ camina hacia allí siguiendo sus pasos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tan pronto como el teléfono de %@ indica dónde está su puerta, %@ camina hacia allí siguiendo sus pasos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niipea kui %@ telefon ütleb, kus on tema värav, kõnnib %@ teie treppidel sinna."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-ren telefonoak bere atea non dagoen dioen bezain laster, %@ hara joango da zure urratsetan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heti kun %@:n puhelin sanoo, missä heidän porttinsa on, %@ kävelee sinne portaillasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
