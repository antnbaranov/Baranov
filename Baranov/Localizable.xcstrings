    "You won't see %@ as a saved courier anymore. Their trip note and first-met details go with them." : {
      "comment" : "A confirmation alert message that lets the user remove a saved courier from their list. The argument is the name of the courier to be removed.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن ترى %@ كساعي محفوظ بعد الآن. مذكرة رحلتهم وتفاصيل اللقاء الأول تذهب معهم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повече няма да виждате %@ като запазен куриер. Бележката им от пътуването и подробностите за първата среща вървят с тях."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Više nećete vidjeti %@ kao sačuvanog kurira. Njihova bilješka s putovanja i detalji o prvom susretu idu uz njih."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja no veuràs %@ com a missatger desat. La seva nota de viatge i els detalls de la primera trobada van amb ells."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Již neuvidíte %@ jako uloženého kurýra. S nimi jdou i jejich poznámky z cesty a podrobnosti o prvním setkání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du vil ikke længere se %@ som en gemt kurer. Deres rejseseddel og førstegangsoplysninger følger med dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird dir nicht mehr als gespeicherter Kurier angezeigt. Seine Reisenotiz und Treffpunkt-Details gehen mit ihm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν θα βλέπετε πλέον τον %@ ως αποθηκευμένο κούριερ. Το ταξιδιωτικό τους σημείωμα και οι λεπτομέρειες της πρώτης συνάντησης τους συνοδεύουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You won't see %@ as a saved courier anymore. Their trip note and first-met details go with them."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You won't see %@ as a saved courier anymore. Their trip note and first-met details go with them."
          }
        },
        "en-CA" : {
