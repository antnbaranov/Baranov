    "Search for the town letters to you should walk to. Only the town is shared." : {
      "comment" : "A description of the search field.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث عن رسائل المدينة التي يجب عليك المشي إليها. المدينة فقط مشتركة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потърсете градските писма, до които трябва да отидете. Само градът е споделен."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potražite gradska pisma do kojih biste trebali prošetati. Samo grad se dijeli."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busqueu les cartes de la ciutat a les quals hauríeu de caminar. Només es comparteix el poble."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hledejte písmena města, kam byste měli dojít. Sdílí se pouze město."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søg efter de bybogstaver, du skal gå til. Kun byen er delt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche den Ort, zu dem Briefe an dich laufen sollen. Nur der Ort wird geteilt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναζητήστε τα γράμματα της πόλης προς τα οποία πρέπει να περπατήσετε. Μόνο η πόλη μοιράζεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search for the town letters to you should walk to. Only the town is shared."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search for the town letters to you should walk to. Only the town is shared."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search for the town letters to you should walk to. Only the town is shared."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search for the town letters to you should walk to. Only the town is shared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busque las letras de la ciudad a la que debe caminar. Sólo se comparte el pueblo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busque las letras de la ciudad a la que debe caminar. Sólo se comparte el pueblo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otsige linna kirju, kuhu peaksite kõndima. Jagatakse ainult linna."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilatu oinez joan behar dituzun herri gutunak. Herria bakarrik partekatzen da."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsi kaupungin kirjeet, joihin sinun pitäisi kävellä. Vain kaupunki on jaettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche la ville vers laquelle tes lettres doivent marcher. Seule la ville est partagée."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche la ville vers laquelle tes lettres doivent marcher. Seule la ville est partagée."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuardaigh na litreacha baile ar chóir duit siúl chucu. Níl ach an baile roinnte."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca as letras da cidade ás que debes camiñar. Só se comparte a cidade."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חפש את האותיות של העיר שאליהן אתה צריך ללכת. רק העיירה משותפת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस शहर के पत्र खोजें जहाँ आपको जाना चाहिए। केवल शहर साझा है."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potražite gradska pisma do kojih biste trebali prošetati. Samo se grad dijeli."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keresse meg azokat a városi leveleket, amelyekhez sétálnia kell. Csak a város közös."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cari surat kota yang harus Anda datangi. Hanya kota yang dibagikan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leitaðu að bæjarstöfunum sem þú ættir að ganga til. Aðeins bærinn er sameiginlegur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca le lettere della città che dovresti raggiungere. Si condivide solo la città."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩いて向かうべき町の文字を探してください。街だけが共有される。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოძებნეთ ქალაქის ასოები, რომლებშიც უნდა იაროთ. მხოლოდ ქალაქია საერთო."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сізге жаяу бару керек қала хаттарын іздеңіз. Тек қала ортақ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걸어가야 할 마을 편지를 검색해 보세요. 마을만 공유됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieškokite miesto laiškų, į kuriuos turėtumėte nueiti. Tik miestelis yra bendras."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meklējiet pilsētas vēstules, uz kurām jums vajadzētu aiziet. Kopīga ir tikai pilsēta."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пребарајте ги градските букви до кои треба да одите. Само градот е заеднички."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cari surat bandar kepada anda harus berjalan ke. Hanya bandar yang dikongsi."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fittex għall-ittri tal-belt li għandek timxi lejhom. Il-belt biss hija maqsuma."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søk etter byens bokstaver til du bør gå til. Bare byen er delt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek naar de stadsletters waar je naartoe moet lopen. Alleen de stad wordt gedeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukaj litery miasta, do którego powinieneś dojść. Wspólne jest tylko miasto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procure as letras da cidade para onde você deve caminhar. Apenas a cidade é compartilhada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procure as letras da cidade para onde você deve caminhar. Apenas a cidade é compartilhada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Căutați scrisorile orașului către care ar trebui să mergeți. Doar orașul este împărțit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдите город, к которому должны идти письма для тебя. Передаётся только город."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhľadajte písmená mesta, do ktorého by ste mali ísť. Zdieľa sa iba mesto."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poiščite mestna pisma, do katerih bi morali hoditi. Samo mesto je skupno."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kërkoni për letrat e qytetit për të cilat duhet të ecni. Vetëm qyteti është i përbashkët."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потражите градска писма до којих би требало да прошетате. Само град се дели."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
