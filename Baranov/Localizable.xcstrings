    "Not encrypted. Anyone who carries the ram can read it, and %@ needs no code at the gate." : {
      "comment" : "A description of a postcard-style letter, which is not encrypted and can be read by anyone who carries it.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير مشفرة. يمكن لأي شخص يحمل الكبش قراءته، ولا يحتاج %@ إلى رمز عند البوابة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не е шифровано. Всеки, който носи овена, може да го прочете и %@ няма нужда от код на портата."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije šifrirano. Svako ko nosi ovna može ga pročitati, a %@ ne treba kod na kapiji."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encriptat. Qualsevol que porti el RAM pot llegir-lo i %@ no necessita cap codi a la porta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Není zašifrováno. Každý, kdo nese beranidlo, ho může přečíst a %@ nepotřebuje žádný kód u brány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke krypteret. Enhver, der bærer vædderen, kan læse den, og %@ behøver ingen kode ved porten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht verschlüsselt. Jeder, der den Widder trägt, kann ihn lesen, und %@ benötigt am Tor keinen Code."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν είναι κρυπτογραφημένο. Όποιος κουβαλάει το κριάρι μπορεί να το διαβάσει και ο %@ δεν χρειάζεται κωδικό στην πύλη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not encrypted. Anyone who carries the ram can read it, and %@ needs no code at the gate."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not encrypted. Anyone who carries the ram can read it, and %@ needs no code at the gate."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not encrypted. Anyone who carries the ram can read it, and %@ needs no code at the gate."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not encrypted. Anyone who carries the ram can read it, and %@ needs no code at the gate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cifrar. Cualquiera que lleve el carnero puede leerla y %@ no necesitará código en la puerta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No cifrado. Cualquiera que lleve el carnero puede leerlo y %@ no necesita ningún código en la puerta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pole krüpteeritud. Igaüks, kes rammi kannab, saab seda lugeda ja %@ ei vaja koodi väravas."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez dago zifratuta. Aharia daraman edonork irakur dezake, eta %@-k ez du koderik behar atean."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei salattu. Jokainen, joka kantaa pässiä, voi lukea sen, eikä %@ tarvitse koodia portilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non chiffré. Quiconque transporte le bélier peut la lire, et %@ n'a pas besoin de code à la porte."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non crypté. Quiconque porte le bélier peut le lire, et %@ n'a besoin d'aucun code à la porte."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gan criptithe. Is féidir le duine ar bith a iompraíonn an reithe é a léamh, agus %@ níl aon chód ag teastáil uaidh ag an ngeata."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non cifrado. Calquera persoa que leve o carneiro pode lelo e %@ non necesita ningún código na porta."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא מוצפן. כל מי שנושא את האיל יכול לקרוא אותו, ו%@ לא צריך שום קוד בשער."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एन्क्रिप्टेड नहीं. जो कोई भी मेढ़ा ले जाता है वह इसे पढ़ सकता है, और %@ को गेट पर किसी कोड की आवश्यकता नहीं है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije kriptirano. Svatko tko nosi ovna može ga pročitati, a %@ ne treba kod na vratima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs titkosítva. Bárki, aki hordozza a kost, el tudja olvasni, és %@-nak nincs szüksége kódra a kapunál."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dienkripsi. Siapa pun yang membawa ram dapat membacanya, dan %@ tidak memerlukan kode di gerbang."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki dulkóðuð. Allir sem bera hrútinn geta lesið hann og %@ þarf engan kóða við hliðið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non crittografato. Chiunque trasporti l'ariete può leggerlo e %@ non ha bisogno di un codice al cancello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化されていません。羊を運ぶ人なら誰でも読め、%@は門でコードを必要としません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "არ არის დაშიფრული. ნებისმიერს, ვინც ატარებს ვერძს, შეუძლია მისი წაკითხვა და %@ არ სჭირდება კოდი კარიბჭესთან."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шифрланбаған. Қошқарды алып жүрген кез келген адам оны оқи алады және %@ қақпасында кодты қажет етпейді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화되지 않았습니다. 숫양을 운반하는 사람은 누구나 읽을 수 있으며 %@ 게이트에서 코드가 필요하지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nešifruota. Kiekvienas, turintis aviną, gali jį perskaityti, o %@ nereikia kodo prie vartų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nav šifrēts. Ikviens, kurš nēsā aunu, var to izlasīt, un %@ nav nepieciešams kods pie vārtiem."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не е шифрирана. Секој што го носи овенот може да го прочита и на %@ не му треба код на портата."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak disulitkan. Sesiapa sahaja yang membawa domba jantan itu boleh membacanya dan %@ tidak memerlukan kod di pintu pagar."
