        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruzé el agua de todos modos. Tiene opiniones al respecto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Igatahes ületas vett. Omab arvamusi selle kohta."
