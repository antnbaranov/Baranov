    "Anyone nearby who is listening can pick it up for the next minute or so." : {
      "comment" : "A description of the sharing process.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لأي شخص قريب يستمع إليه التقاطه في الدقيقة التالية أو نحو ذلك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всеки наблизо, който слуша, може да го вземе за следващата минута или така."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svako u blizini koji sluša može ga uzeti u sljedeći minut ili tako nešto."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualsevol persona a prop que estigui escoltant el pot recollir durant el minut següent o més."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdokoli v okolí, kdo poslouchá, to může na další minutu vyzvednout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhver i nærheden, der lytter, kan hente den i det næste minut eller deromkring."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder in der Nähe, der zuhört, kann es für die nächste Minute oder so aufnehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οποιοσδήποτε κοντά σας ακούει μπορεί να το πάρει για το επόμενο λεπτό περίπου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone nearby who is listening can pick it up for the next minute or so."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone nearby who is listening can pick it up for the next minute or so."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone nearby who is listening can pick it up for the next minute or so."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone nearby who is listening can pick it up for the next minute or so."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que esté cerca y esté escuchando podrá escucharlo durante aproximadamente el siguiente minuto."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que esté cerca y esté escuchando podrá escucharlo durante aproximadamente el siguiente minuto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik läheduses olevad inimesed, kes kuulavad, saavad selle järgmise minuti jooksul üles võtta."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entzuten ari den gertuko edonork har dezake hurrengo minuturako edo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuka tahansa lähellä oleva, joka kuuntelee, voi poimia sen seuraavan minuutin ajan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne à proximité qui écoute peut le capter pendant environ une minute."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne à proximité qui écoute peut le capter pendant environ une minute."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is féidir le haon duine in aice láimhe atá ag éisteacht é a phiocadh suas don chéad nóiméad eile nó mar sin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calquera persoa próxima que estea escoitando pode recollelo durante un minuto máis ou menos."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל מי שנמצא בקרבת מקום שמאזין יכול להרים אותו לדקה הבאה בערך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आस-पास कोई भी व्यक्ति जो सुन रहा है वह इसे अगले एक मिनट तक सुन सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svatko u blizini tko sluša može ga podići sljedećih minutu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bárki a közelben, aki hallgatja, a következő percben felveheti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapa pun di sekitar yang mendengarkan dapat mendengarkannya sekitar satu menit berikutnya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allir í nágrenninu sem hlusta geta tekið það upp næstu mínútu eða svo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque sia in ascolto nelle vicinanze può riprenderlo per il prossimo minuto circa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くで聞いている人は、次の 1 分間ほどそれを拾うことができます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ნებისმიერ ახლომახლო, ვინც უსმენს, შეუძლია აიღოს ის მომდევნო წუთში."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жақын жерде тыңдап отырған кез келген адам оны келесі минутқа дейін ала алады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "근처에 있는 사람이라면 누구든지 다음 1분 동안 그 내용을 들을 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visi netoliese esantys, kurie klausosi, gali jį pasiimti kitą minutę."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikviens tuvumā esošais, kurš klausās, var to paņemt apmēram nākamajā minūtē."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Секој во близина кој слуша може да го земе во следната минута или нешто повеќе."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiapa yang berdekatan yang mendengar boleh mengambilnya untuk beberapa minit seterusnya."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kull min ikun fil-qrib li jkun qed jisma’ jista’ jiġborha għall-minuta ta’ wara jew hekk."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle i nærheten som lytter kan plukke den opp i neste minutt eller så."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen die in de buurt luistert, kan het ongeveer een minuutje oppikken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy, kto słucha w pobliżu, może go odebrać przez mniej więcej następną minutę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa próxima que esteja ouvindo pode atendê-lo no próximo minuto ou mais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa próxima que esteja ouvindo pode atendê-lo no próximo minuto ou mais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oricine din apropiere care ascultă îl poate ridica în următorul minut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой, кто слушает поблизости, может услышать его в течение следующей минуты или около того."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ktokoľvek v okolí, kto počúva, si ho môže zobrať na ďalšiu minútu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdorkoli v bližini, ki posluša, ga lahko sprejme v naslednji minuti."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kushdo që është afër që po dëgjon mund ta marrë atë për minutën tjetër ose më shumë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свако ко слуша у близини може да га подигне следећи минут."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla i närheten som lyssnar kan plocka upp den under nästa minut eller så."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใครก็ตามที่อยู่ใกล้ๆ ที่กำลังฟังอยู่สามารถรับฟังได้ในนาทีถัดไป"
