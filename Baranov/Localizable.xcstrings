    "Delivers after dark. Sleeps on the job, never.": {
      "comment": "Tagline for the \"Night Owl\" ram reel personality.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrega després de la foscor. Dorm a la feina, mai."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Доставя след тъмно. Спи на работа, никога."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Isporučuje se nakon mraka. Spava na poslu, nikad."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسلم بعد حلول الظلام. ينام في العمل، أبدا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Leveres efter mørkets frembrud. Sover på jobbet, aldrig."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodává se po setmění. Spí v práci, nikdy."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivers after dark. Sleeps on the job, never."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivers after dark. Sleeps on the job, never."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivers after dark. Sleeps on the job, never."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liefert nach Einbruch der Dunkelheit. Schläft bei der Arbeit, nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παραδίδεται μετά το σκοτάδι. Κοιμάται στη δουλειά, ποτέ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrega después del anochecer. Duerme en el trabajo, nunca."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrega después del anochecer. Duerme en el trabajo, nunca."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarnib pärast pimedat. Magab tööl, mitte kunagi."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Iluntzean ematen du. Lanean lo egiten du, inoiz ez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Livré après la tombée de la nuit. Il dort au travail, jamais."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Livré après la tombée de la nuit. Il dort au travail, jamais."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toimitetaan pimeän jälkeen. Nukkuu töissä, ei koskaan."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Seachadann tar éis dorcha. Codlaíonn sé ar an bpost, riamh."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrega ao anoitecer. Durme no traballo, nunca."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משלוחים לאחר רדת החשיכה. ישן בעבודה, אף פעם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंधेरा होने के बाद डिलीवरी होती है. काम पर सोते हैं, कभी नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostavlja nakon što padne mrak. Spava na poslu, nikad."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sötétedés után szállítják. Alszik a munkahelyén, soha."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikirim setelah gelap. Tidur saat bekerja, tidak pernah."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Afhendir eftir myrkur. Sefur í vinnunni, aldrei."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consegna dopo il tramonto. Dorme sul lavoro, mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗くなってからの配達となります。仕事中に寝ることは決してありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიწოდება დაბნელების შემდეგ. სამსახურში სძინავს, არასდროს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қараңғыдан кейін жеткізіледі. Жұмыста ұйықтайды, ешқашан."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어두워진 후에 배달됩니다. 직장에서 잠을 자지 마십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristato sutemus. Miega darbe, niekada."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piegādā pēc tumsas. Darba laikā guļ, nekad."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Се испорачува по стемнување. Спие на работа, никогаш."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihantar selepas gelap. Tidur di tempat kerja, tidak pernah."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Twassil wara d-dlam. Irqad fuq ix-xogħol, qatt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leveres etter mørkets frembrudd. Sover på jobb, aldri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezorgt in het donker. Slaapt tijdens het werk, nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostarcza po zmroku. Nigdy nie śpi w pracy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrega depois de escurecer. Dorme no trabalho, nunca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrega depois de escurecer. Dorme no trabalho, nunca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доставка после наступления темноты. Спит на работе, никогда."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Livrează după întuneric. Doarme la serviciu, niciodată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodáva sa po zotmení. Spí v práci, nikdy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostava po temi. Spi v službi, nikoli."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorëzimi pas errësirës. Fle në punë, kurrë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Испоручује се након мрака. Спава на послу, никад."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Levereras efter mörkrets inbrott. Sover på jobbet, aldrig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งมอบหลังมืด นอนทำงานไม่เคยเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava karardıktan sonra teslimat yapar. İş yerinde uyur, asla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доставляється після настання темряви. Спить на роботі, ніколи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao hàng sau khi trời tối. Ngủ trong lúc làm việc, không bao giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "天黑后送达。工作时睡觉，从不。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "天黑後送達。工作時睡覺，從不。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "天黑後送達。工作時睡覺，從不。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivers after dark. Sleeps on the job, never."
          }
        }
