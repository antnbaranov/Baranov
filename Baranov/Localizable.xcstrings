    "Pick one. Baranov is built around getting a real letter to them.": {
      "comment": "Text describing the onboarding page that asks the user to pick a person they miss.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете един. Баранов е изграден около получаването на истинско писмо до тях."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Trieu-ne un. Baranov es basa en rebre una carta real per a ells."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Izaberi jednu. Baranov je izgrađen na tome da im dobije pravo pismo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر واحدة. تم تصميم بارانوف حول إرسال رسالة حقيقية إليهم."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en. Baranov er bygget op omkring at få et rigtigt brev til dem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si jednu. Baranov je postaven na tom, aby jim dostal skutečný dopis."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one. Baranov is built around getting a real letter to them."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one. Baranov is built around getting a real letter to them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one. Baranov is built around getting a real letter to them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine aus. Bei Baranov geht es darum, einen echten Brief an sie zu bekommen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε ένα. Ο Baranov έχει χτιστεί γύρω από το να τους πάρει ένα πραγματικό γράμμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige uno. Baranov se basa en enviarles una carta real."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige uno. Baranov se basa en enviarles una carta real."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Valige üks. Baranov on üles ehitatud sellele, et saada neile päris kiri."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aukeratu bat. Baranov haiei benetako gutun bat jasotzearen inguruan eraikia dago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez-en un. Baranov est construit autour de la réception d'une vraie lettre."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez-en un. Baranov est construit autour de la réception d'une vraie lettre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse yksi. Baranov perustuu oikean kirjeen saamiseen heille."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh ceann amháin. Tá Baranov tógtha timpeall ar litir cheart a fháil chucu."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolle un. Baranov está construído para recibir unha carta real para eles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר אחד. ברנוב בנוי סביב קבלת מכתב אמיתי אליהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक चुनें. बारानोव का निर्माण उन्हें एक वास्तविक पत्र प्राप्त करने के लिए किया गया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite jedan. Baranov je izgrađen oko toga da im pošalje pravo pismo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz egyet. Baranov arra épül, hogy valódi levelet kapjanak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih satu. Baranov dibangun untuk memberikan surat nyata kepada mereka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegline uno. Baranov si basa sul ricevere loro una vera lettera."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu einn. Baranov byggist upp á því að fá alvöru bréf til þeirra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つ選んでください。 Baranov は、彼らに本物の手紙を届けることを中心に構築されています。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიე ერთი. ბარანოვი აგებულია მათთვის ნამდვილი წერილის მიღების გარშემო."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біреуін таңдаңыз. Баранов оларға нақты хат алу үшін құрылған."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나를 선택하세요. Baranov는 그들에게 실제 편지를 받는 것을 중심으로 만들어졌습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite vieną. Baranovas yra sukurtas taip, kad gautų jiems tikrą laišką."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlieties vienu. Baranovs ir veidots tā, lai saņemtu viņiem īstu vēstuli."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете еден. Баранов е изграден околу добивањето вистинско писмо до нив."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih satu. Baranov dibina untuk mendapatkan surat sebenar kepada mereka."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħżel wieħed. Baranov huwa mibni madwar li tikseb ittra reali lilhom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en. Baranov er bygget rundt å få et ekte brev til dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies er één. Baranov is erop gericht een echte brief aan hen te sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz jeden. Baranowowi zależy na tym, żeby dostać do nich prawdziwy list."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um. Baranov foi criado para enviar uma carta real para eles."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um. Baranov foi criado para enviar uma carta real para eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите один. Баранов построен на том, чтобы получить им настоящее письмо."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege unul. Baranov este construit pentru a primi o scrisoare adevărată către ei."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si jednu. Baranov je postavený na tom, aby im dostal skutočný list."
