        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üleandmist ootava kirja saab AirDroppiga saata otse igaühele siin, kelle sihtkoht vastab tegelikule kohale või on sellest 800 km raadiuses."
