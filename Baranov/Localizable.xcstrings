    "No journeys yet. Send a letter and %@'s route will be drawn here." : {
      "comment" : "A message that appears when a user has not yet drawn any routes.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد رحلات بعد. أرسل خطابًا وسيتم رسم طريق %@ هنا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все още няма пътувания. Изпратете писмо и маршрутът на %@ ще бъде начертан тук."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još nema putovanja. Pošaljite pismo i ruta %@ će biti nacrtana ovdje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara no hi ha viatges. Envieu una carta i aquí es dibuixarà la ruta de %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím žádné cesty. Pošlete dopis a zde bude nakreslena trasa %@ ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen rejser endnu. Send et brev og %@ 's rute vil blive tegnet her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Reisen. Verschicke einen Brief und die Route von %@ wird hier gezeichnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχουν ακόμη ταξίδια. Στείλτε ένα γράμμα και η διαδρομή του %@ θα σχεδιαστεί εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No journeys yet. Send a letter and %@'s route will be drawn here."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No journeys yet. Send a letter and %@'s route will be drawn here."
