          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš ovan ga vodi do %@ . Jedan od tvojih pravih koraka primakne ga jedan metar bliže."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teu RAM el porta fins a %@ . Un dels vostres passos reals l'apropa un metre."
          }
        },
        "cs" : {
