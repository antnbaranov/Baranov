    "\"Baranov\" is the maker's surname — it means rams.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Baranov“ ist der Nachname des Schöpfers – es bedeutet Widder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" is the maker's surname — it means rams."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Baranov» es el apellido del creador, significa carneros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Baranov » est le nom du créateur — cela signifie béliers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Baranov» è il cognome del creatore — significa arieti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Baranov」は作者の苗字で、「牡羊」を意味します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Баранов» — фамилия автора, что буквально означает «бараны»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“Baranov”是创作者的姓氏——意思是公羊。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" és el cognom del fabricant; vol dir moltons."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Баранов\" е фамилията на производителя - означава овни."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" je prezime proizvođača — znači ovnovi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" je příjmení výrobce - znamená berani."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"بارانوف\" هو لقب الصانع، ويعني الكباش."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" er producentens efternavn - det betyder væddere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "«Μπαράνοφ» είναι το επώνυμο του κατασκευαστή — σημαίνει κριοί."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" is the maker's surname — it means rams."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" is the maker's surname — it means rams."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" is the maker's surname — it means rams."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" es el apellido del fabricante y significa carneros."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" on tegija perekonnanimi - see tähendab jääraid."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" egilearen abizena da - ahariak esan nahi du."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" on valmistajan sukunimi - se tarkoittaa pässiä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" est le nom de famille du fabricant, cela signifie béliers."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is é \"Baranov\" sloinne an déantóra - ciallaíonn sé reithí."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" é o apelido do fabricante; significa carneiros."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ברנוב\" הוא שם המשפחה של היצרן - זה אומר אילים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"बारानोव\" निर्माता का उपनाम है - इसका अर्थ है मेढ़े।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov je prezime proizvođača — znači ovnovi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A „Baranov” a készítő vezetékneve – jelentése kos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" adalah nama belakang pembuatnya — artinya domba jantan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" er eftirnafn framleiðandans - það þýðir hrútar."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ბარანოვი\" მწარმოებლის გვარია - ვერძს ნიშნავს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Баранов» - жасаушының тегі — қошқар дегенді білдіреді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\"는 제작자의 성이며 숫양을 의미합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Baranovas“ yra gamintojo pavardė – tai reiškia avinus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" ir izgatavotāja uzvārds - tas nozīmē auni."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "„Баранов“ е презимето на творецот - значи овни."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" ialah nama keluarga pembuatnya — ia bermaksud domba jantan."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" huwa l-kunjom ta' min għamel - ifisser imtaten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" er produsentens etternavn - det betyr værer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" is de achternaam van de maker, het betekent rammen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Baranov” to nazwisko twórcy – oznacza barany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Baranov” é o sobrenome do fabricante – significa carneiros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“Baranov” é o sobrenome do fabricante – significa carneiros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Baranov” este numele de familie al producătorului - înseamnă berbeci."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" je priezvisko výrobcu - znamená barany."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" je priimek izdelovalca - pomeni ovne."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" është mbiemri i prodhuesit - do të thotë desh."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Баранов“ је презиме творца — значи овнови."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" är tillverkarens efternamn - det betyder baggar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" เป็นนามสกุลของผู้สร้าง - แปลว่าแกะผู้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" yapımcının soyadıdır; koç anlamına gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Баранов» — прізвище виробника — це означає барани."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Baranov\" là họ của người sản xuất - có nghĩa là ram."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「巴拉諾夫」是製造商的姓氏－意思是公羊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「巴拉諾夫」是製造商的姓氏－意思是公羊。"
          }
        }
      }
    },
