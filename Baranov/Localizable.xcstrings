    "The post office couldn't accept that. Try again.": {
      "comment": "Error message when the post office rejects a letter.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пощата не можеше да приеме това. Опитайте отново."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'oficina de correus no podia acceptar això. Torna-ho a provar."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošta to nije mogla prihvatiti. Pokušajte ponovo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكتب البريد لا يمكن أن يقبل ذلك. حاول ثانية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kunne posthuset ikke acceptere. Prøv igen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To pošta nemohla přijmout. Zkuste to znovu."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The post office couldn't accept that. Try again."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The post office couldn't accept that. Try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The post office couldn't accept that. Try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das konnte die Post nicht akzeptieren. Versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La oficina de correos no pudo aceptar eso. Intentar otra vez."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La oficina de correos no pudo aceptar eso. Intentar otra vez."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ταχυδρομείο δεν μπορούσε να το δεχτεί αυτό. Προσπαθήστε ξανά."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Postkontor ei saanud sellega nõustuda. Proovi uuesti."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Posta bulegoak ezin zuen hori onartu. Saiatu berriro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La poste ne pouvait pas accepter cela. Essayer à nouveau."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La poste ne pouvait pas accepter cela. Essayer à nouveau."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Posti ei voinut hyväksyä sitä. Yritä uudelleen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní raibh oifig an phoist in ann glacadh leis sin. Bain triail eile as."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "A oficina de correos non podía aceptalo. Téntao de novo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדואר לא יכול היה לקבל את זה. נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाकघर इसे स्वीकार नहीं कर सका। पुनः प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošta to nije mogla prihvatiti. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A posta ezt nem tudta elfogadni. Próbáld újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kantor pos tidak dapat menerima hal itu. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ufficio postale non poteva accettarlo. Riprova."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Pósthúsið gat ekki sætt sig við það. Reyndu aftur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "郵便局はそれを受け入れることができませんでした。もう一度やり直してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ფოსტამ ვერ მიიღო ეს. სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우체국에서는 이를 받아들일 수 없었습니다. 다시 시도해 보세요."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошта оны қабылдай алмады. Қайтадан байқап көріңіз."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Paštas negalėjo to priimti. Bandykite dar kartą."
