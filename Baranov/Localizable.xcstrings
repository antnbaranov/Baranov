        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pismo je ostavljeno na kapiji. Samo primalac ga može prikupiti — tako što će zaista hodati tamo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brevet blev efterladt ved porten. Kun modtageren kan samle det - ved virkelig at gå der."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopis zůstal u brány. Může si to vyzvednout pouze příjemce – tím, že tam skutečně dojde."
