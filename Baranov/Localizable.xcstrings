        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jekk jogħġbok ibqa' bit-trott. L-aħjar tislijiet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett gjerne å trave. Med vennlig hilsen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf alstublieft draven. Hartelijke groeten."
