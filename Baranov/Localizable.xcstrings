    "%@ was wider than it looked, but we made it over.": {
      "comment": "A sentence describing crossing a waterway.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ era més ample del que semblava, però l'hem superat."
