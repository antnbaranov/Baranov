        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres días tranquilos. La carta se mantiene; el carnero espera.  %@ se fue cuando estés."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolm rahulikku päeva. Kiri hoiab; jäär ootab.  %@ jääb alati, kui olete."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiru egun lasai. Gutunak mantentzen du; aharia zain dago.  %@ geratzen zara zaudenean."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolme hiljaista päivää. Kirje säilyy; pässi odottaa.  %@ jäljellä aina kun olet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois jours tranquilles. La lettre reste ; le bélier attend. Encore %@ quand tu seras prêt."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois jours tranquilles. La lettre reste ; le bélier attend. Encore %@ quand tu seras prêt."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trí lá ciúin. Coinníonn an litir; fanann an reithe.  %@ fágtha aon uair a bhfuil tú."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres días tranquilos. A carta mantén; o carneiro agarda.  %@ quedou sempre que esteas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלושה ימים שקטים. המכתב שומר; האיל מחכה.  %@ נשאר בכל פעם שאתה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तीन शांत दिन. पत्र रहता है; राम इंतज़ार करता है.  जब भी आप हों तो %@ छोड़ दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tri mirna dana. Pismo čuva; ovan čeka.  %@ otišao kad god si ti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Három nyugodt nap. A levél megtartja; a kos vár.  %@ marad, amikor csak van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiga hari yang tenang. Surat itu disimpan; domba jantan itu menunggu.  %@ tersisa kapan pun Anda berada."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þrír rólegir dagar. Bréfið heldur; hrúturinn bíður.  %@ eftir hvenær sem þú ert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre giorni tranquilli. La lettera continua; l'ariete aspetta.  %@ lasciato ogni volta che vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静かな三日間。手紙は保管されています。雄羊が待っています。  %@はいつでも残してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სამი მშვიდი დღე. წერილი ინახება; ვერძი ელოდება.  %@ დარჩა, როცა ხარ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Үш тыныш күн. Хат сақталады; қошқар күтеді.  %@ сіз болған кезде қалды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조용한 3일. 편지는 계속됩니다. 숫양이 기다립니다.  언제든지 %@ 남았습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trys ramios dienos. Laiškas saugomas; avinas laukia.  %@ liko bet kada."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trīs klusas dienas. Vēstule saglabājas; auns gaida.  %@ atlicis jebkurā laikā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три мирни денови. Писмото чува; овенот чека.  %@ останува секогаш кога сте."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiga hari yang tenang. Surat itu menyimpan; ram menunggu.  %@ ditinggalkan pada bila-bila masa anda berada."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlett ijiem kwieti. L-ittra żżomm; il-muntun jistenna.  %@ telaq kull meta tkun."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre rolige dager. Brevet holder; væren venter.  %@ igjen når du er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drie rustige dagen. De brief blijft; de ram wacht.  %@ vertrekt wanneer u maar wilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzy spokojne dni. List zachowuje; baran czeka.  %@ opuścił, kiedy tylko jesteś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Três dias tranquilos. A carta continua; o carneiro espera.  %@ saiu quando você estiver."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Três dias tranquilos. A carta continua; o carneiro espera.  %@ saiu quando você estiver."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trei zile liniștite. Scrisoarea păstrează; berbecul așteaptă.  %@ a plecat oricând ești."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три тихих дня. Письмо сохраняется; баран ждет.  %@ ушел, когда бы ты ни были."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tri pokojné dni. List zachováva; baran čaká.  Zostáva %@, kedykoľvek ste."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trije mirni dnevi. Pismo hrani; oven čaka.  %@ je odšel, ko ste vi."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre ditë të qeta. Letra mban; dashi pret.  %@ lihet sa herë që të jeni."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три мирна дана. Писмо чува; ован чека.  %@ је остало кад год сте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre lugna dagar. Brevet håller; baggen väntar.  %@ kvar när du än är."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สามวันอันเงียบสงบ จดหมายเก็บไว้; แกะรออยู่  %@ จะออกไปเมื่อใดก็ตามที่คุณอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üç sakin gün. Mektup şöyle devam ediyor; koç bekler.  %@ ne zaman istersen oradan ayrılırsın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три тихих дні. Лист зберігає; баран чекає.  %@ залишився, коли ти."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba ngày yên tĩnh. Bức thư giữ; ram chờ đợi.  %@ còn lại bất cứ khi nào bạn muốn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安静的三天。信保留；公羊等待着。  %@ 随时离开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
