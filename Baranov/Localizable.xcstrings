        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er under Innkommende. Den lander i postsekken din når væren når porten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
