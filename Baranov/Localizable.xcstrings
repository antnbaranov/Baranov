    "Three quiet days. The letter keeps; the ram waits. %@ left whenever you are." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثلاثة أيام هادئة. الرسالة تبقي؛ الكبش ينتظر.  %@ غادر كلما كنت."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три тихи дни. Писмото пази; овенът чака.  %@ напусна, когато и ти."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tri mirna dana. Pismo se čuva; ovan čeka.  %@ je ostalo kad god ste."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres dies tranquils. La carta guarda; l'ariet espera.  %@ queda sempre que siguis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tři klidné dny. Dopis zachovává; beran čeká.  Zbývá %@, ať jste kdekoli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre stille dage. Brevet holder; vædderen venter.  %@ tilbage, når som helst du er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei ruhige Tage. Der Brief bleibt erhalten; der Widder wartet. Noch %@, sobald du bereit bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τρεις μέρες ησυχίας. Η επιστολή κρατά? το κριάρι περιμένει.  %@ έφυγε όποτε είσαι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three quiet days. The letter keeps; the ram waits. %@ left whenever you are."
          }
        },
