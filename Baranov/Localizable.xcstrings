    "Crossed %@ with great care. The letter stayed dry.": {
      "comment": "A travel note for a water crossing.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Creuat %@ amb molta cura. La carta es va quedar seca."
