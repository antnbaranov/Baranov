    "The ram carried only ciphertext. The ear tag you were given is the key.": {
      "comment": "A description of how the seal is cracked.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Овенът носеше само шифрован текст. Ключът е ушната марка, която ви е дадена."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El RAM només portava text xifrat. L'etiqueta a l'orella que us van donar és la clau."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovan je nosio samo šifrirani tekst. Ušna markica koju ste dobili je ključ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان الكبش يحمل النص المشفر فقط. علامة الأذن التي أعطيت لك هي المفتاح."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vædderen bar kun chiffertekst. Det øremærke, du fik, er nøglen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Beran nesl pouze šifrovaný text. Klíčem je ušní známka, kterou jste dostali."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The ram carried only ciphertext. The ear tag you were given is the key."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The ram carried only ciphertext. The ear tag you were given is the key."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The ram carried only ciphertext. The ear tag you were given is the key."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Widder transportierte nur Geheimtext. Die Ohrmarke, die Sie erhalten haben, ist der Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El carnero sólo llevaba texto cifrado. La etiqueta en la oreja que le dieron es la clave."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El carnero sólo llevaba texto cifrado. La etiqueta en la oreja que le dieron es la clave."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κριός μετέφερε μόνο κρυπτογραφημένο κείμενο. Το ακουστικό που σας δόθηκε είναι το κλειδί."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jäär kandis ainult šifreeritud teksti. Võti on kõrvamärk, mis teile anti."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahariak testu zifratua bakarrik zeraman. Emandako belarriko marka da gakoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bélier ne transportait que du texte chiffré. L'étiquette auriculaire qui vous a été remise est la clé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bélier ne transportait que du texte chiffré. L'étiquette auriculaire qui vous a été remise est la clé."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oinas kantoi vain salatekstiä. Korvamerkki, jonka sinulle annettiin, on avain."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní raibh ag an reithe ach ciphertext. Is í an chlib cluaise a tugadh duit an eochair."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O carneiro só levaba texto cifrado. A marca de oído que che deron é a clave."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האיל נשא רק טקסט צופן. תג האוזן שקיבלת הוא המפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राम केवल सिफरटेक्स्ट ले गया। आपको जो ईयर टैग दिया गया था वह कुंजी है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovan je nosio samo šifrirani tekst. Ušna markica koju ste dobili je ključ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kos csak titkosított szöveget hordozott. A füljelző, amit kaptál, a kulcs."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ram hanya membawa ciphertext. Tag telinga yang diberikan kepada Anda adalah kuncinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ariete trasportava solo testo cifrato. Il marchio auricolare che ti è stato dato è la chiave."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hrúturinn bar aðeins dulmálstexta. Eyrnamerkið sem þú fékkst er lykillinn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RAM には暗号文のみが含まれていました。渡された耳札が鍵です。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერძს მხოლოდ შიფრული ტექსტი ატარებდა. ყურის ნიშანი, რომელიც მოგცეს, არის გასაღები."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "램에는 암호문만 들어 있었습니다. 당신이 받은 귀표가 열쇠입니다."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қошқар тек шифрлы мәтінді тасымалдады. Сізге берілген құлақша - кілт."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Avinas nešė tik šifruotą tekstą. Ausų įsagas, kuris jums buvo duotas, yra raktas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Auns nesa tikai šifrētu tekstu. Krotālija, kas jums tika piešķirta, ir atslēga."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овенот носел само шифриран текст. Увото означе што ви го дадоа е клучот."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Domba jantan itu hanya membawa teks sifir. Tanda telinga yang diberikan kepada anda adalah kuncinya."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-muntun kellu biss ċifrat. It-tikketta tal-widna li ngħatajt hija ċ-ċavetta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Væren bar bare chiffertekst. Øremerket du fikk er nøkkelen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ram droeg alleen cijfertekst. Het oormerk dat je hebt gekregen is de sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baran miał tylko zaszyfrowany tekst. Kluczem jest kolczyk, który otrzymałeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O carneiro carregava apenas texto cifrado. A marca auricular que você recebeu é a chave."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O carneiro carregava apenas texto cifrado. A marca auricular que você recebeu é a chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баран нес только зашифрованный текст. Ушная бирка, которую вам дали, является ключом."
          }
        },
        "ro": {
