        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pismo i dalje stiže pješice kao i obično — samo se neće dešifrirati prije ovog trenutka, čak ni s desnom ušnom markicom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A levél a szokásos módon továbbra is gyalog érkezik – csak ez a pillanat előtt nem oldja meg a titkosítást, még a jobb füljelzővel sem."
