        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה למיקום כבויה, כך שעדיין אין עיר התחלה - הקש כדי להפעיל אותה בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान पहुंच बंद है, इसलिए अभी तक कोई प्रारंभिक शहर नहीं है - सेटिंग्स में इसे चालू करने के लिए टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristup lokaciji je isključen, tako da još nema početnog grada — dodirnite da biste ga uključili u Postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helymeghatározás ki van kapcsolva, így még nincs kezdőváros – koppintson a bekapcsoláshoz a Beállításokban."
