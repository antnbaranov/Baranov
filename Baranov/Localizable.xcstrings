    "Want it back? Meet the carrier and ask them to hand it over." : {
      "comment" : "Ram's bag — how to get a handed-on letter back without a server.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تريد استعادته؟ قابل الناقل واطلب منه تسليمه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Искаш ли си го обратно? Срещнете се с превозвача и ги помолете да ви го предадат."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoćeš nazad? Upoznajte prevoznika i zamolite ih da vam ga predaju."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vols tornar? Trobeu-vos amb el transportista i demaneu-los que l'entreguin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete to zpět? Seznamte se s dopravcem a požádejte ho o předání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du have den tilbage? Mød transportøren og bed dem om at aflevere den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willst du ihn zurück? Triff den Kurier und bitte ihn, ihn dir zu geben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θέλετε πίσω; Γνωρίστε τον μεταφορέα και ζητήστε του να το παραδώσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Want it back? Meet the carrier and ask them to hand it over."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Want it back? Meet the carrier and ask them to hand it over."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Want it back? Meet the carrier and ask them to hand it over."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Want it back? Meet the carrier and ask them to hand it over."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Lo quieres de vuelta? Conozca al transportista y pídale que se lo entregue."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Lo quieres de vuelta? Conozca al transportista y pídale que se lo entregue."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahad seda tagasi? Tutvuge vedajaga ja paluge tal see üle anda."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itzuli nahi? Ezagutu garraiolariarekin eta eska iezaiozu entregatzeko."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluatko sen takaisin? Tapaa kuljettaja ja pyydä häntä luovuttamaan se."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu veux le récupérer ? Rencontrez le transporteur et demande-lui de le remettre."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu veux le récupérer ? Rencontrez le transporteur et demande-lui de le remettre."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Want sé ar ais? Buail leis an iompróir agus iarr orthu é a thabhairt ar láimh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queres de volta? Coñece o transportista e pídelle que o entreguen."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רוצה את זה בחזרה? פגשו את המוביל ובקשו שימסור אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे वापस चाहते हैं? वाहक से मिलें और उन्हें इसे सौंपने के लिए कहें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Želite li ga natrag? Upoznajte prijevoznika i zamolite ga da vam ga preda."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vissza akarod kapni? Találkozzon a szállítóval, és kérje meg, hogy adják át."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingin kembali? Temui operatornya dan minta mereka untuk menyerahkannya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viltu það aftur? Hittu burðarmanninn og biddu þá að afhenda hann."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo vuoi indietro? Incontra il corriere e chiedigli di consegnarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返してほしいですか？運送業者に会って、引き渡しを依頼してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დაბრუნება გინდა? შეხვდით გადამზიდველს და სთხოვეთ გადასცეს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оны қайтарғыңыз келе ме? Тасымалдаушымен кездесіп, оны тапсыруын сұраңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "돌려받고 싶나요? 운송업체를 만나서 넘겨달라고 요청하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nori susigrąžinti? Susipažinkite su vežėju ir paprašykite jį perduoti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai vēlaties to atpakaļ? Iepazīstieties ar pārvadātāju un lūdziet to nodot."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сакате назад? Запознајте го превозникот и побарајте од нив да го предадат."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahukan ia kembali? Temui pembawa dan minta mereka menyerahkannya."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tridha lura? Iltaqa' mat-trasportatur u staqsihom biex jgħadduh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du ha den tilbake? Møt transportøren og be dem om å overlevere den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je het terug? Maak kennis met de vervoerder en vraag hem om het te overhandigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcesz to z powrotem? Spotkaj się z przewoźnikiem i poproś o jego przekazanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quer de volta? Conheça a transportadora e peça que entregue."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quer de volta? Conheça a transportadora e peça que entregue."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îl vrei înapoi? Faceți cunoștință cu transportatorul și rugați-i să-l predea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хотите вернуть? Встретьтесь с курьером и попросите передать его тебе."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete to späť? Zoznámte sa s dopravcom a požiadajte ho o odovzdanie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hočeš nazaj? Spoznajte prevoznika in ga prosite, naj vam ga preda."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dëshironi të kthehet? Takoni transportuesin dhe kërkoni që ta dorëzojnë atë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хоћеш назад? Упознајте превозника и замолите их да вам га предају."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vill du ha tillbaka den? Möt transportören och be dem lämna över den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องการมันกลับ? พบกับผู้ขนส่งและขอให้พวกเขาส่งมอบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri ister misin? Taşıyıcıyla tanışın ve teslim etmesini isteyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хочете його повернути? Зустрітися з перевізником і попросити його передати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muốn nó trở lại? Gặp người vận chuyển và yêu cầu họ bàn giao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想要回来吗？与承运人会面并要求他们将其移交。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想要回來嗎？與承運人會面並要求他們將其移交。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想要回來嗎？與承運人會面並要求他們將其移交。"
          }
        }
      }
