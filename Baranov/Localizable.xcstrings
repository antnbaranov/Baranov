    "Left %@ at a steady trot. The road is long, and I am ready.": {
      "comment": "A travel note. The argument is the name of the place.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Наляво %@ в равномерен тръс. Пътят е дълъг и аз съм готов."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquerra %@ al trot constant. El camí és llarg, i estic preparat."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lijevo %@ ujednačenim kasom. Put je dug, a ja sam spreman."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليسار %@ في هرولة ثابتة. الطريق طويل وأنا جاهز."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venstre %@ i jævnt trav. Vejen er lang, og jeg er klar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlevo %@ ve stabilním klusu. Cesta je dlouhá a já jsem připraven."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Left %@ at a steady trot. The road is long, and I am ready."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Left %@ at a steady trot. The road is long, and I am ready."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Left %@ at a steady trot. The road is long, and I am ready."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verließ %@ im gleichmäßigen Trab. Der Weg ist lang und ich bin bereit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αριστερά %@ με σταθερό τράβηγμα. Ο δρόμος είναι μακρύς και είμαι έτοιμος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salió de %@ a un trote constante. El camino es largo y estoy preparado."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Salió de %@ a un trote constante. El camino es largo y estoy preparado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahkus %@ ühtlasel traavil. Tee on pikk ja ma olen valmis."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezker %@ trosta etengabean. Bidea luzea da, eta prest nago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À gauche %@ au trot régulier. La route est longue et je suis prêt."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "À gauche %@ au trot régulier. La route est longue et je suis prêt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistui %@ tasaisella ravilla. Tie on pitkä, ja olen valmis."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar chlé %@ ag trot seasta. Tá an bóthar fada, agus táim réidh."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
