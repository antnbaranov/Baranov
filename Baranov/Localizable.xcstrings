        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen vei når %@ herfra, og ingen av de nærliggende havnene kunne nås med bil heller. Nevn en by %@ kan gå til; den vil se etter en overgang derfra, eller vente på en transportør på vei videre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanaf hier bereikt geen enkele weg %@, en ook geen van de nabijgelegen havens was over de weg bereikbaar. Noem een ​​stad waar %@ naartoe kan lopen; Van daaruit zal het zoeken naar een oversteek, of wachten op een vervoerder die verder gaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
