    "%@ is busy now. Expand the Pasture and up to %@ rams can walk at once — one for each person you keep meaning to write to." : {
      "comment" : "A description of the expansion option for the first ram. The argument is the name of the ram.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ مشغول الآن. قم بتوسيع المرعى ويمكن لعدد يصل إلى %2$@ من الكباش المشي في وقت واحد - واحد لكل شخص تحتفظ به لتكتب إليه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ е зает в момента. Разширете пасището и до %2$@ овни могат да ходят наведнъж — по един за всеки човек, на когото възнамерявате да пишете."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ je trenutno zauzet. Proširite pašnjak i do %2$@ ovnova može hodati odjednom — po jedan za svaku osobu kojoj namjeravate pisati."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ està ocupat ara. Amplieu la pastura i fins a %2$@ ariets poden caminar alhora, un per cada persona a qui vulgueu escriure."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ je nyní zaneprázdněn. Rozbalte Pastvinu a až %2$@ beranů může chodit najednou – jeden pro každého, komu chcete psát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ er optaget nu. Udvid græsgangen, og op til %2$@ væddere kan gå på én gang - en for hver person, du bliver ved med at mene at skrive til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist gerade beschäftigt. Erweitere die Weide, und bis zu %2$@ Widder können gleichzeitig laufen – einer für jede Person, der du schreiben möchtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο %1$@ είναι απασχολημένος τώρα. Επεκτείνετε το Βοσκότοπο και έως και %2$@ κριάρια μπορούν να περπατήσουν ταυτόχρονα — ένα για κάθε άτομο στο οποίο συνεχίζετε να θέλετε να γράψετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is busy now. Expand the Pasture and up to %2$@ rams can walk at once — one for each person you keep meaning to write to."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is busy now. Expand the Pasture and up to %2$@ rams can walk at once — one for each person you keep meaning to write to."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is busy now. Expand the Pasture and up to %2$@ rams can walk at once — one for each person you keep meaning to write to."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is busy now. Expand the Pasture and up to %2$@ rams can walk at once — one for each person you keep meaning to write to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está ocupado ahora. Amplía el pastizal y hasta %2$@ carneros podrán caminar a la vez: uno por cada persona a la que quieras escribir."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está ocupado ahora. Amplía el pastizal y hasta %2$@ carneros podrán caminar a la vez: uno por cada persona a la que quieras escribir."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ on praegu hõivatud. Laiendage karjamaad ja kuni %2$@ jäära saab korraga kõndida – üks iga inimese kohta, kellele soovite kirjutada."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ okupatuta dago orain. Zabaldu Larrea eta gehienez %2$@ ahari ibil daitezke aldi berean — idatzi nahi duzun pertsona bakoitzeko bat."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ on nyt kiireinen. Laajenna laidunta, niin jopa %2$@ pässiä voi kävellä kerralla – yksi jokaiselle henkilölle, jolle aiot kirjoittaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est occupé actuellement. Agrandis le pâturage et jusqu'à %2$@ béliers pourront marcher en même temps — un pour chaque personne à qui tu veux écrire."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est occupé actuellement. Agrandis le pâturage et jusqu'à %2$@ béliers pourront marcher en même temps — un pour chaque personne à qui tu veux écrire."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá %1$@ gnóthach anois. Leathnaigh an Féarach agus is féidir suas le %2$@ reithí siúl láithreach — ceann do gach duine a bhfuil ciall agat scríobh chuige."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está ocupado agora. Expande o Pasto e ata %2$@ carneiros poden camiñar á vez, un por cada persoa á que queres escribir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ עסוק כעת. הרחב את המרעה ועד %2$@ אילים יכולים ללכת בבת אחת - אחד לכל אדם שאתה ממשיך לכתוב אליו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ अभी व्यस्त है। चरागाह का विस्तार करें और %2$@ तक मेढ़े एक बार में चल सकते हैं - प्रत्येक व्यक्ति के लिए एक जिसे आप लिखना चाहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ je trenutno zauzet. Proširite pašnjak i do %2$@ ovnova može hodati odjednom — po jedan za svaku osobu kojoj namjeravate pisati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ jelenleg elfoglalt. Bővítsd ki a legelőt, és akár %2$@ kos is sétálhat egyszerre – egyet minden olyan személy számára, akinek írni akarsz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sedang sibuk sekarang. Perluas Padang Rumput dan hingga %2$@ domba jantan dapat berjalan sekaligus — satu ekor untuk setiap orang yang ingin Anda kirimi surat."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ er upptekinn núna. Stækkaðu hagann og allt að %2$@ hrútar geta gengið í einu — einn fyrir hverja manneskju sem þú heldur áfram að skrifa til."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è occupato adesso. Espandi il pascolo e fino a %2$@ arieti potranno camminare contemporaneamente, uno per ogni persona a cui continui a voler scrivere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は現在ビジーです。牧草地を拡張すると、最大 %2$@ 頭の雄羊が同時に歩くことができます。手紙を書きたい人ごとに 1 頭ずつです。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ახლა დაკავებულია. გააფართოვეთ საძოვარი და %2$@-მდე ვერძს შეუძლია ერთდროულად სიარული - თითო თითოეული ადამიანისთვის, ვისაც აგრძელებთ დაწერას."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ қазір бос емес. Жайылымды кеңейтіңіз және %2$@-ге дейін қошқар бірден жүре алады — сіз жазуды қалаған әрбір адамға бір-бірден."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 지금 바빠요. 목초지를 확장하면 최대 %2$@마리의 숫양이 한 번에 걸을 수 있습니다. 편지를 쓰려는 사람당 하나씩."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ dabar užsiėmęs. Išplėskite Ganyklą ir vienu metu galės vaikščioti iki %2$@ avinų – po vieną kiekvienam asmeniui, kuriam vis dar norite rašyti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ šobrīd ir aizņemts. Paplašiniet ganības, un līdz %2$@ auni var staigāt vienlaikus — viens katram cilvēkam, kuram vēlaties rakstīt."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ е зафатен сега. Проширете го пасиштето и до %2$@ овни можат да одат одеднаш - по еден за секоја личност на која сакате да му пишувате."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sibuk sekarang. Kembangkan Padang Rumput dan sehingga %2$@ domba jantan boleh berjalan sekali gus — seekor untuk setiap orang yang ingin anda tulis."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ huwa okkupat issa. Espandi l-Mgħajra u sa %2$@ imtaten jistgħu jimxu f'daqqa — wieħed għal kull persuna li inti żżomm tifsira li tikteb lilha."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ er opptatt nå. Utvid beitet og opptil %2$@ værer kan gå på en gang – en for hver person du stadig mener å skrive til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is nu bezig. Breid de weide uit en er kunnen maximaal %2$@ rammen tegelijk lopen – één voor elke persoon naar wie je wilt schrijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ jest teraz zajęty. Rozbuduj pastwisko, a aż do %2$@ baranów będzie mogło chodzić naraz — po jednym na każdą osobę, do której chcesz napisać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está ocupado agora. Expanda o pasto e até %2$@ carneiros poderão caminhar ao mesmo tempo - um para cada pessoa para quem você pretende escrever."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está ocupado agora. Expanda o pasto e até %2$@ carneiros poderão caminhar ao mesmo tempo - um para cada pessoa para quem você pretende escrever."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ este ocupat acum. Extindeți Pășunea și până la %2$@ berbeci pot merge simultan - câte unul pentru fiecare persoană căreia vreți să-i scrieți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ сейчас занят. Расширь пастбище, и до %2$@ баранов смогут идти одновременно — по одному на каждого человека, которому ты хочешь написать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ je momentálne zaneprázdnený. Rozšírte Pastvinu a až %2$@ baranov môže chodiť naraz – jeden pre každého, komu chcete písať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ je trenutno zaseden. Razširite pašnik in do %2$@ ovnov lahko hodi hkrati — po eden za vsako osebo, ki ji nameravate pisati."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ është i zënë tani. Zgjero Kullotën dhe deri në %2$@ desh mund të ecin menjëherë - një për secilin person të cilit nuk ke ndërmend t'i shkruash."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ је тренутно заузет. Проширите пашњак и до %2$@ овнова може ходати одједном — по један за сваку особу којој желите да пишете."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ är upptagen nu. Expandera betesmarken och upp till %2$@ baggar kan gå på en gång – en för varje person du fortfarande menar att skriva till."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ขณะนี้ไม่ว่าง ขยายทุ่งหญ้าและสามารถเดินแกะได้มากถึง %2$@ ตัว - หนึ่งตัวสำหรับแต่ละบุคคลที่คุณตั้งใจจะเขียนถึง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ şu anda meşgul. Çayırı genişletin ve aynı anda %2$@ adede kadar koç yürüyebilir - yazmaya devam ettiğiniz her kişi için bir tane."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ зараз зайнятий. Розшир пасовище, і до %2$@ баранів зможуть іти одночасно — по одному для кожного, кому ти хочеш написати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hiện đang bận. Mở rộng Đồng cỏ và tối đa %2$@ ram có thể đi bộ cùng một lúc - một con cho mỗi người mà bạn muốn viết thư."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 现在正忙。扩大牧场，最多 %2$@ 只公羊可以同时行走——每只你想要写信的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 現在正忙。擴大牧場，最多 %2$@ 隻公羊可以同時行走－每隻你想寫信的人。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 現在正忙。擴大牧場，最多 %2$@ 隻公羊可以同時行走－每隻你想寫信的人。"
          }
        }
      }
    },
