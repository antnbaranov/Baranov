    "Couldn't find your starting location yet — tap to try again.": {
      "comment": "A label that appears when the user can't find their location.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر العثور على موقع البداية بعد — انقر للمحاولة مرة أخرى."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още не можете да намерите началното си местоположение — докоснете, за да опитате отново."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Još uvijek nisam mogao pronaći vašu početnu lokaciju — dodirnite da pokušate ponovo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no s'ha pogut trobar la teva ubicació inicial: toca per tornar-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši výchozí polohu se zatím nepodařilo najít – klepnutím to zkuste znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke finde din startplacering endnu – tryk for at prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startort konnte noch nicht gefunden werden – tippe, um es erneut zu versuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η εύρεση ακόμα της αρχικής τοποθεσίας σας — πατήστε για να προσπαθήσετε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't find your starting location yet — tap to try again."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't find your starting location yet — tap to try again."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't find your starting location yet — tap to try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't find your starting location yet — tap to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se pudo encontrar tu ubicación de inicio: toca para intentarlo de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se pudo encontrar tu ubicación inicial; toca para intentarlo nuevamente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei leitud veel oma alguskohta – puudutage uuesti proovimiseks."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezin izan da aurkitu hasierako kokapena oraindik. Sakatu berriro saiatzeko."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloituspaikkaasi ei vielä löytynyt – yritä uudelleen napauttamalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de trouver votre position de départ — touchez pour réessayer."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez pas encore trouvé votre position de départ : appuyez pour réessayer."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir do shuíomh tosaigh a aimsiú go fóill - tapáil chun triail eile a bhaint as."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aínda non se puido atopar a túa localización de inicio. Toca para tentalo de novo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא ניתן למצוא את מיקום ההתחלה שלך - הקש כדי לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक आपका आरंभिक स्थान नहीं मिल सका — पुनः प्रयास करने के लिए टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još ne možete pronaći svoju početnu lokaciju — dodirnite za ponovni pokušaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem található a kiindulási hely – koppintson az újrapróbálkozáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dapat menemukan lokasi awal Anda — ketuk untuk mencoba lagi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að finna upphafsstaðsetninguna þína ennþá — pikkaðu á til að reyna aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trovare la posizione di partenza: tocca per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出発地がまだ見つかりません。タップして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 출발 위치를 찾을 수 없습니다. 다시 시도하려면 탭하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar nepavyko rasti pradžios vietos – palieskite ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēl nevarēja atrast sākuma atrašanās vietu — pieskarieties, lai mēģinātu vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сè уште не може да ја најдам вашата почетна локација - допрете за да се обидете повторно."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dapat mencari lokasi permulaan anda lagi — ketik untuk mencuba lagi."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "S'issa ma setgħetx issib il-post tal-bidu tiegħek — tektek biex terġa' tipprova."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke finne startposisjonen din ennå – trykk for å prøve på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon uw startlocatie nog niet vinden. Tik om het opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się jeszcze znaleźć lokalizacji początkowej — kliknij, aby spróbować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foi possível encontrar seu local de partida. Toque para tentar novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foi possível encontrar seu local de partida. Toque para tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut găsi încă locația de pornire — atingeți pentru a încerca din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить местоположение — нажмите, чтобы повторить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ sa nepodarilo nájsť vašu počiatočnú polohu – klepnutím to skúste znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začetne lokacije še ni bilo mogoče najti — tapnite, če želite poskusiti znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuk mund ta gjenim ende vendndodhjen tuaj fillestare - trokitni lehtë për të provuar përsëri."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Још увек нисмо могли да пронађемо вашу почетну локацију — додирните да бисте покушали поново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att hitta din startplats ännu – tryck för att försöka igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่พบตำแหน่งเริ่มต้นของคุณ - แตะเพื่อลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz başlangıç konumunuz bulunamadı; tekrar denemek için dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
