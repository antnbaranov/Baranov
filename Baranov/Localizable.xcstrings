          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿No es uno de tus nombres? El código del crotal aún puede abrirla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿No es uno de tus nombres? El código del crotal aún puede abrirla."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitte ükski sinu nimedest? Kõrvamärgi kood avab selle ikka."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zure izenetako bat ez? Belarritako etiketa-kodeak oraindik irekitzen du."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eikö yksikään nimistäsi? Korvamerkkikoodi avaa sen edelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n'est pas l'un de tes noms ? Le code de la boucle l'ouvre quand même."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n'est pas l'un de tes noms ? Le code de la boucle l'ouvre quand même."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gan ceann de do chuid ainmneacha? Osclaíonn an cód clib chluas é fós."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nin un dos teus nomes? O código da etiqueta do oído aínda o abre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא אחד מהשמות שלך? קוד תג האוזן עדיין פותח אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका कोई नाम नहीं? ईयर टैग कोड अभी भी इसे खोलता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije jedno od vaših imena? Šifra ušne markice ga i dalje otvara."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem az ön nevei közül? A füljelző kódja továbbra is megnyitja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bukan salah satu namamu? Kode tag telinga masih membukanya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki eitt af nöfnunum þínum? Kóðinn fyrir eyrnamerkið opnar það samt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno dei tuoi nomi? Il codice del marchio auricolare lo apre ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの名前はありませんか？耳タグのコードはまだ開いています。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "არც ერთი შენი სახელი არ არის? ყურის ნიშნის კოდი კვლავ ხსნის მას."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сіздің атыңыздың бірі емес пе? Құлақ белгісінің коды оны әлі де ашады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신 이름이 하나도 없나요? 귀 태그 코드가 여전히 열립니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne vienas iš tavo vardų? Ausų įsago kodas vis tiek jį atidaro."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nav neviena no jūsu vārdiem? Krotālijas kods joprojām to atver."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ниту едно од вашите имиња? Кодот на увото ознака сè уште го отвора."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bukan satu pun nama awak? Kod tag telinga masih membukanya."
          }
        },
