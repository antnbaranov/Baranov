    "Handed over mid-journey. Passed the baton, kept the dignity.": {
      "comment": "Text displayed in a feat when the user has handed over a stamp mid-journey.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Предаден по средата на пътуването. Предаде щафетата, запази достойнството."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Entregat a mig camí. Va passar el relleu, va mantenir la dignitat."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Predano usred putovanja. Prenio štafetu, zadržao dostojanstvo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سلمت في منتصف الرحلة. مررت العصا، وحافظت على الكرامة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afleveret midt på rejsen. Sendte stafetten, beholdt værdigheden."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předáno uprostřed cesty. Předal štafetu, zachoval si důstojnost."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Handed over mid-journey. Passed the baton, kept the dignity."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Handed over mid-journey. Passed the baton, kept the dignity."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Handed over mid-journey. Passed the baton, kept the dignity."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitte der Fahrt übergeben. Den Staffelstab übergeben, die Würde behalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παραδόθηκε στα μέσα του ταξιδιού. Πέρασε τη σκυτάλη, κράτησε την αξιοπρέπεια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entregado a mitad de viaje. Pasó el testigo, mantuvo la dignidad."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Entregado a mitad de viaje. Pasó el testigo, mantuvo la dignidad."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üle antud keset reisi. Andis teatepulga edasi, hoidis väärikust."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bidaiaren erdialdean entregatua. Lekua pasa, duintasuna mantendu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remis à mi-parcours. J'ai passé le relais, j'ai gardé la dignité."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Remis à mi-parcours. J'ai passé le relais, j'ai gardé la dignité."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luovutettiin matkan puolivälissä. Välitti viestikapula, säilytti arvokkuuden."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Láimh lár an turais. Rith an bata, choinnigh an dínit."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Entregado a metade do traxecto. Pasou a batuta, mantivo a dignidade."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נמסר באמצע המסע. העביר את השרביט, שמר על הכבוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बीच यात्रा में सौंप दिया गया. लाठी चलायी, मर्यादा रखी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Predano usred putovanja. Prenio štafetu, zadržao dostojanstvo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az út közepén adták át. Átadta a stafétabotot, megőrizte méltóságát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diserahkan di tengah perjalanan. Melewati tongkat estafet, menjaga martabat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consegnato a metà viaggio. Ha passato il testimone, ha mantenuto la dignità."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Afhent um miðja ferð. Stóðst í takt, hélt reisninni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅の途中で引き渡されました。品格を保ってバトンを渡した。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადასცა შუა მოგზაურობა. ჩააბარა ხელკეტი, შეინარჩუნა ღირსება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жолдың ортасында тапсырылды. Эстафетаны тапсырды, абыройын сақтады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행 중간에 넘겨졌습니다. 바통을 넘기고 품위를 지켰다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perduotas įpusėjus kelionei. Perdavė estafetę, išlaikė orumą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodots brauciena vidū. Nodeva stafeti, saglabāja cieņu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Предаден на средината на патувањето. Ја положи диригентската палка, го задржа достоинството."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diserahkan pertengahan perjalanan. Lulus baton, jaga maruah."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogħti f'nofs il-vjaġġ. Għadda l-baton, żamm id-dinjità."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlevert midt på reisen. Sendte stafettpinnen, beholdt verdigheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Halverwege de reis overgedragen. Het stokje doorgegeven, de waardigheid behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekazany w połowie podróży. Przekazał pałeczkę, zachował godność."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Entregue no meio da viagem. Passei o bastão, mantive a dignidade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entregue no meio da viagem. Passei o bastão, mantive a dignidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сдали в середине пути. Эстафету передал, достоинство сохранил."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Predată la jumătatea călătoriei. A dat ștafeta, și-a păstrat demnitatea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odovzdané uprostred cesty. Odovzdal štafetu, zachoval si dôstojnosť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predano na sredini poti. Predal štafeto, ohranil dostojanstvo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorëzuar në mes të udhëtimit. Kaloi stafetën, ruajti dinjitetin."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Предао усред путовања. Пренео штафету, задржао достојанство."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งมอบระหว่างการเดินทาง ผ่านกระบองรักษาศักดิ์ศรี"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Överlämnad mitt på resan. Klarade stafettpinnen, behöll värdigheten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yolculuğun ortasında teslim edildi. Bayrağı geçti, itibarını korudu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Здано в середині дороги. Передав естафету, зберіг гідність."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Handed over mid-journey.传递接力棒，保持尊严。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bàn giao giữa cuộc hành trình. Trao dùi cui, giữ phẩm giá."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "中途交出。傳遞接力棒，保持尊嚴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中途交出。傳遞接力棒，保持尊嚴。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handed over mid-journey. Passed the baton, kept the dignity."
          }
        }
      }
    },
