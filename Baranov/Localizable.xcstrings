    "Over %@, the ram moves with quiet purpose.": {
      "comment": "A distance in metres, in the plural form, in the UK.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Над %@ овенът се движи с тиха цел."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Més de %@ , l'ariet es mou amb un propòsit silenciós."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Preko %@, ovan se kreće sa tihim ciljem."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فوق %@ ، يتحرك الكبش بهدف هادئ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Over %@ bevæger vædderen sig med et roligt formål."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přes %@ se beran pohybuje tiše."
          }
        },
        "en-AU": {
