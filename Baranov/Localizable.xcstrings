    "Nearby senders see your name and first trip while the profile is open.": {
      "comment": "A description of how nearby senders see your name and first trip while the profile is open.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Подателите наблизо виждат вашето име и първото пътуване, докато профилът е отворен."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els remitents propers veuen el teu nom i el teu primer viatge mentre el perfil està obert."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošiljaoci u blizini vide vaše ime i prvo putovanje dok je profil otvoren."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرى المرسلون القريبون اسمك ورحلتك الأولى أثناء فتح الملف الشخصي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afsendere i nærheden ser dit navn og første tur, mens profilen er åben."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesílatelé v okolí uvidí vaše jméno a první cestu, když je profil otevřený."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby senders see your name and first trip while the profile is open."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby senders see your name and first trip while the profile is open."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby senders see your name and first trip while the profile is open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absender in der Nähe sehen Ihren Namen und Ihre erste Reise, während das Profil geöffnet ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κοντινοί αποστολείς βλέπουν το όνομά σας και το πρώτο σας ταξίδι ενώ το προφίλ είναι ανοιχτό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los remitentes cercanos ven su nombre y su primer viaje mientras el perfil está abierto."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los remitentes cercanos ven su nombre y su primer viaje mientras el perfil está abierto."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Inguruko igorleek zure izena eta lehen bidaia ikusten dituzte profila irekita dagoen bitartean."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Läheduses olevad saatjad näevad teie nime ja esimest reisi, kui profiil on avatud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les expéditeurs à proximité voient votre nom et votre premier voyage lorsque le profil est ouvert."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les expéditeurs à proximité voient votre nom et votre premier voyage lorsque le profil est ouvert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Läheiset lähettäjät näkevät nimesi ja ensimmäisen matkasi profiilin ollessa auki."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Feiceann seoltóirí in aice láimhe d'ainm agus do chéad turas agus an phróifíl oscailte."
          }
        },
        "gl": {
          "stringUnit": {
