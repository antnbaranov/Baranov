            "value": "%@ teenib margi iga nimelise koha eest, millest mööda jalutatakse – ületatud jõgi, läbitud linn, värav."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-k zigilu bat irabazten du igarotako leku bakoitzeko: ibai bat zeharkatu, herri bat igaro, ate bat iritsi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ansaitsee leiman jokaisesta nimetystä paikasta, jonka ohi kuljet – ylitetty joki, läpi kuljettu kaupunki, saavutettu portti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gagne un tampon pour chaque lieu nommé traversé : une rivière traversée, une ville traversée, une porte atteinte."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gagne un tampon pour chaque lieu nommé traversé : une rivière traversée, une ville traversée, une porte atteinte."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuilleann %@ stampa le haghaidh gach áit ainmnithe a shiúiltar thart - trasna abhainn, chuaigh baile trí, shroich geata."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gaña un selo por cada lugar nomeado que pasou: un río atravesado, unha cidade atravesada, unha porta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ זוכה בחותמת על כל מקום ששם עבר עליו - נהר נחצה, עיירה עברה, שער הגיע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ प्रत्येक नामित स्थान के लिए एक टिकट अर्जित करता है - एक नदी पार की गई, एक शहर गुजरा, एक द्वार पहुंचा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zarađuje pečat za svako imenovano mjesto pored kojeg se prođe — prijeđena rijeka, prolaz kroz grad, dosegnuta vrata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bélyeget kap minden megnevezett helyért, amely mellett elhaladt – átkelt folyón, áthaladt városon, elért kapun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mendapatkan stempel untuk setiap nama tempat yang dilewati — sungai yang dilintasi, kota yang dilewati, gerbang yang dicapai."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fær stimpil fyrir hvern nafngreindan stað sem gengið er framhjá - á sem farið er yfir, bær farið í gegnum, hlið náð."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ guadagna un timbro per ogni luogo con nome attraversato: un fiume attraversato, una città attraversata, un cancello raggiunto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は、川を渡ったり、町を通過したり、門に到達したりするなど、名前付きの場所を通過するたびにスタンプを獲得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은 강을 건너고, 마을을 통과하고, 문에 도달하는 등 이름이 지정된 모든 장소를 지나갈 때마다 스탬프를 얻습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uždirba antspaudą už kiekvieną įvardytą vietą, kurią praeisite – perplauktą upę, pervažiuotą miestelį, pasiektus vartus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nopelna zīmogu par katru nosaukto vietu, kurai iet garām — šķērsota upe, cauri izieta pilsēta, sasniegti vārti."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ заработува печат за секое именувано место поминато - помината река, минат град, стигна до порта."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ memperoleh setem untuk setiap tempat bernama yang dilalui — sungai menyeberangi, sebuah bandar dilalui, sebuah pintu masuk dicapai."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jaqla’ bolla għal kull post imsemmi li għadda minnu — xmara qasmet, belt li għaddiet, bieb milħuq."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ får et stempel for hvert navngitt sted som gikk forbi - en elv krysset, en by passert, en port nådd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verdient een stempel voor elke benoemde plaats waar je langs loopt: een rivier die je oversteekt, een stad die je passeert, een poort die je bereikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ otrzymuje pieczątkę za każde mijane nazwane miejsce — przekroczenie rzeki, przebycie miasta, dotarcie do bramy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ganha um selo para cada lugar nomeado por onde passou - um rio atravessado, uma cidade atravessada, um portão alcançado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ganha um selo para cada lugar nomeado por onde passou - um rio atravessado, uma cidade atravessada, um portão alcançado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ câștigă o ștampilă pentru fiecare loc numit pe lângă care a trecut - un râu traversat, un oraș trecut, o poartă atinsă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ получает штамп за каждое пройденное названное место — перейденную реку, пройденный город, достигнутые ворота."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ získava pečiatku za každé menované miesto, okolo ktorého sa prechádza – prekročená rieka, prejdené mesto, dosiahnutá brána."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si prisluži žig za vsako imenovano mesto, ki ga prehodite mimo – prečkanje reke, prehod skozi mesto, dosežena vrata."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fiton një vulë për çdo vend të emërtuar që ka kaluar - një lumë i kaluar, një qytet i kaluar, një portë që arrihet."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ зарађује печат за свако именовано место које се прође — реку која се пређе, град кроз који се прође, дође до капије."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ får en stämpel för varje namngiven plats som gick förbi - en flod som korsades, en stad passerade, en port nåddes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ได้รับตราประทับสำหรับทุกสถานที่ที่มีชื่อที่เดินผ่านไป - มีแม่น้ำข้าม เมืองที่ผ่านไป ประตูถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, yanından geçilen her yer için bir pul kazanır - geçilen bir nehir, geçilen bir kasaba, ulaşılan bir kapı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отримує штамп за кожне назване місце, пройдене повз нього — перетнуту річку, пройдене місто, досягнуту браму."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kiếm được một con dấu cho mỗi địa điểm được đặt tên đi qua — một con sông băng qua, một thị trấn đi qua, một cánh cổng đã tới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会为走过的每一个指定地点赢得一枚印章——穿过河流、经过城镇、到达大门。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將為走過的每一個指定地點贏得一枚印章－穿過河流、經過城鎮、到達大門。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將為走過的每一個指定地點贏得一枚印章－穿過河流、經過城鎮、到達大門。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ იძენს ბეჭედს ყველა დასახელებული ადგილისთვის, რომელიც გაიარა - მდინარე გადაკვეთა, ქალაქი გაიარა, კარიბჭემდე მიაღწია."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ өткен әрбір аталған жер — өзеннен өткен, қала өткен, жеткен қақпа үшін мөр алады."
          }
        }
      }
    },
