    "Get a stamp in the rain and refuse to complain": {
      "comment": "A goal to get a stamp in the rain and refuse to complain.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вземете печат в дъжда и откажете да се оплаквате"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aconsegueix un segell sota la pluja i negues a queixar-te"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzmite markicu na kiši i odbijte da se žalite"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على ختم في المطر وارفض الشكوى"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få et stempel i regnen og nægt at klage"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Získejte razítko v dešti a odmítněte si stěžovat"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a stamp in the rain and refuse to complain"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a stamp in the rain and refuse to complain"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a stamp in the rain and refuse to complain"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Holen Sie sich im Regen einen Stempel und weigern Sie sich, sich zu beschweren"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάρτε ένα γραμματόσημο στη βροχή και αρνηθείτε να παραπονεθείτε"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigue un sello bajo la lluvia y niégate a quejarte"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigue un sello bajo la lluvia y niégate a quejarte"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võtke vihmaga tempel ja keelduge kaebamast"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lortu zigilu bat euripean eta uko egin kexatzeari"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez un tampon sous la pluie et refusez de vous plaindre"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez un tampon sous la pluie et refusez de vous plaindre"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanki leima sateessa ja kieltäydy valittamasta"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Faigh stampa sa bháisteach agus diúltaigh gearán a dhéanamh"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén un selo baixo a choiva e négase a queixarse"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבל בול בגשם ומסרב להתלונן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बारिश में स्टांप प्राप्त करें और शिकायत करने से इंकार कर दें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobijte markicu na kiši i odbijte se žaliti"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerezzen bélyeget az esőben, és ne panaszkodjon"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan cap di tengah hujan dan tolak mengeluh"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni un timbro sotto la pioggia e rifiutati di lamentarti"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fáðu stimpil í rigningunni og neita að kvarta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雨の中でもスタンプを押して文句を言わない"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიიღეთ ბეჭედი წვიმაში და უარი თქვით ჩივილზე"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңбырда мөртабан алыңыз және шағымданудан бас тартыңыз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비 속에서도 스탬프를 받고 불평을 거부하세요"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gauk antspaudą lyjant ir atsisakyk skųstis"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saņemiet zīmogu lietū un atsakieties sūdzēties"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Земете печат на дождот и одбијте да се жалите"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan setem dalam hujan dan enggan mengadu"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikseb timbru fix-xita u tirrifjuta li tilmenta"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få et stempel i regnet og nekter å klage"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal een stempel in de regen en weiger te klagen"
