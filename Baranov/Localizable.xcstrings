        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ वहां एक पैकेट पर चढ़ जाता है - या जल्दी पार करने वाले किसी भी व्यक्ति के साथ चला जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tamo ukrca paket — ili ide s bilo kim tko prije prijeđe."
