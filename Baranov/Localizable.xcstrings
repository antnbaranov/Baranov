        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es lebe der Widder. Es lebe der Beitrag."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζήτω ο κριός. Ζήτω η ανάρτηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Viva el carnero! Viva el post."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Viva el carnero! Viva el post."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Elagu jäär. Elagu postitus."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bizi aharia. Bizi ezazu mezua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vive le bélier. Vive le poste."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vive le bélier. Vive le poste."
