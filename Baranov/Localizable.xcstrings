          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no ha ido a ninguna parte. Sospechosamente relajado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no ha ido a ninguna parte. Sospechosamente relajado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pole veel kuhugi läinud. Kahtlaselt lõdvestunud."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oraindik ez da inora joan. Susmagarri erlaxatuta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei ole mennyt vielä minnekään. Epäilyttävän rento."
