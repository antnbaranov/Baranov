    "Rams already walking finish their journey either way." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكباش تمشي بالفعل وتنهي رحلتها في كلتا الحالتين."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Овните, които вече вървят, завършват пътуването си така или иначе."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovnovi koji već hodaju završavaju svoje putovanje na bilo koji način."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els carneros que ja caminaven acaben el seu viatge en qualsevol sentit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berani, kteří již jdou, svou cestu dokončí v obou směrech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Væddre, der allerede går, afslutter deres rejse begge veje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits wandernde Widder beenden ihre Reise in jedem Fall."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κριάρια που ήδη περπατούν ολοκληρώνουν το ταξίδι τους με κάθε τρόπο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rams already walking finish their journey either way."
          }
        },
        "en-AU" : {
          "stringUnit" : {
