    "Lands in %@'s mailbag when %@ arrives." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تهبط في حقيبة بريد %@ عند وصول %@."
