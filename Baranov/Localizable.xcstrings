        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "უკვე ფეხით მოსიარულე ვერძები ასრულებენ მოგზაურობას ორივე გზით."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жаяу жүрген қошқарлар сапарын кез келген жолмен аяқтайды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 걷고 있는 숫양은 어떤 경우에도 여정을 끝까지 마칩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jau einantys avinai baigia savo kelionę į abi puses."
