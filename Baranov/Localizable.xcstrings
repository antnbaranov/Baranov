    "Location access is off, so there's no starting city yet — tap to turn it on in Settings." : {
      "comment" : "A message that explains why the starting city can't be determined.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إيقاف الوصول إلى الموقع، لذا لا توجد مدينة بداية حتى الآن — انقر لتشغيلها في الإعدادات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достъпът до местоположението е изключен, така че все още няма начален град — докоснете, за да го включите в Настройки."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristup lokaciji je isključen, tako da još nema početni grad — dodirnite da ga uključite u Postavkama."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accés a la ubicació està desactivat, de manera que encara no hi ha cap ciutat d'inici: toqueu-lo per activar-lo a Configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup k poloze je vypnutý, takže zatím není žádné počáteční město – klepnutím jej zapnete v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placeringsadgang er slået fra, så der er ingen startby endnu – tryk for at slå det til i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortzugriff ist deaktiviert, daher gibt es noch keinen Startort – tippe hier, um ihn in den Einstellungen zu aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόσβαση στην τοποθεσία είναι απενεργοποιημένη, επομένως δεν υπάρχει ακόμη πόλη εκκίνησης — πατήστε για να την ενεργοποιήσετε στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is off, so there's no starting city yet — tap to turn it on in Settings."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is off, so there's no starting city yet — tap to turn it on in Settings."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is off, so there's no starting city yet — tap to turn it on in Settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is off, so there's no starting city yet — tap to turn it on in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la ubicación está desactivado, por lo que aún no hay ciudad de inicio: toca para activarlo en Ajustes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la ubicación está desactivado, por lo que aún no hay una ciudad de inicio; toca para activarlo en Configuración."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juurdepääs asukohale on välja lülitatud, seega pole veel alguslinna – puudutage, et see seadetes sisse lülitada."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokapenerako sarbidea desaktibatuta dago, beraz, oraindik ez dago hasierako hiririk. Sakatu Ezarpenak atalean aktibatzeko."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sijainnin käyttöoikeus on pois päältä, joten aloituskaupunkia ei vielä ole – ota se käyttöön asetuksista napauttamalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la localisation est désactivé, il n'y a donc pas encore de ville de départ — touche pour l'activer dans Réglages."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la localisation est désactivé, il n'y a donc pas encore de ville de départ : appuie pour l'activer dans Paramètres."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá rochtain suímh múchta, mar sin níl aon chathair tosaigh ann fós - tapáil chun é a chur ar siúl sna Socruithe."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acceso á localización está desactivado, polo que aínda non hai cidade de inicio. Toca para activalo en Configuración."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגישה למיקום כבויה, כך שעדיין אין עיר התחלה - הקש כדי להפעיל אותה בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थान पहुंच बंद है, इसलिए अभी तक कोई प्रारंभिक शहर नहीं है - सेटिंग्स में इसे चालू करने के लिए टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristup lokaciji je isključen, tako da još nema početnog grada — dodirnite da biste ga uključili u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A helymeghatározás ki van kapcsolva, így még nincs kezdőváros – koppintson a bekapcsoláshoz a Beállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses lokasi nonaktif, jadi belum ada kota awal — ketuk untuk mengaktifkannya di Setelan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slökkt er á staðsetningaraðgangi, svo það er engin upphafsborg ennþá — pikkaðu á til að kveikja á honum í stillingum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso alla posizione è disattivato, quindi non c'è ancora una città di partenza: tocca per attivarlo in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報アクセスがオフのため出発都市が未定です。タップして設定でオンにしてください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მდებარეობაზე წვდომა გამორთულია, ამიტომ საწყისი ქალაქი ჯერ არ არის — შეეხეთ მის ჩასართავად პარამეტრებში."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Орынға қол жеткізу өшірулі, сондықтан әлі басталатын қала жоқ — оны \"Параметрлер\" бөлімінен қосу үшін түртіңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 액세스가 꺼져 있으므로 아직 시작 도시가 없습니다. 탭하여 설정에서 켜세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prieiga prie vietos išjungta, todėl dar nėra pradžios miesto – palieskite, kad įjungtumėte ją nustatymuose."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piekļuve atrašanās vietai ir izslēgta, tāpēc vēl nav sākuma pilsētas — pieskarieties, lai to ieslēgtu sadaļā Iestatījumi."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пристапот до локацијата е исклучен, така што сè уште нема почетен град - допрете за да го вклучите во Поставки."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses lokasi dimatikan, jadi belum ada bandar permulaan lagi — ketik untuk menghidupkannya dalam Tetapan."
          }
        },
        "mt" : {
          "stringUnit" : {
