    "%@ hasn't set out on a journey yet. Add the people you know who travel — their trips become shortcuts for your letters.": {
      "comment": "A message that appears when a user has not selected a ram.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لم ينطلق في رحلة بعد. أضف الأشخاص الذين تعرفهم والذين يسافرون - تصبح رحلاتهم اختصارات لرسائلك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ все още не е тръгнал на пътешествие. Добавете хората, които познавате, които пътуват - техните пътувания стават преки пътища за вашите писма."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ još nije krenuo na put. Dodajte ljude koje znate koji putuju – njihova putovanja postaju prečice za vaša pisma."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ encara no ha començat cap viatge. Afegeix les persones que coneixes que viatgen; els seus viatges es converteixen en dreceres per a les teves cartes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ještě nevydal na cestu. Přidejte lidi, které znáte a kteří cestují – jejich cesty se stanou zkratkami pro vaše dopisy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ikke begivet sig ud på en rejse endnu. Tilføj de personer, du kender, som rejser - deres rejser bliver genveje til dine breve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat sich noch nicht auf die Reise begeben. Fügen Sie die Menschen hinzu, die Sie kennen und die reisen – ihre Reisen werden zu Abkürzungen für Ihre Briefe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο %@ δεν έχει ξεκινήσει ακόμα ένα ταξίδι. Προσθέστε τα άτομα που γνωρίζετε που ταξιδεύουν — τα ταξίδια τους γίνονται συντομεύσεις για τα γράμματά σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hasn't set out on a journey yet. Add the people you know who travel — their trips become shortcuts for your letters."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hasn't set out on a journey yet. Add the people you know who travel — their trips become shortcuts for your letters."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hasn't set out on a journey yet. Add the people you know who travel — their trips become shortcuts for your letters."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hasn't set out on a journey yet. Add the people you know who travel — their trips become shortcuts for your letters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aún no ha emprendido un viaje. Añade a las personas que conoces que viajan; sus viajes se convierten en atajos para tus cartas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aún no ha emprendido un viaje. Añade a las personas que conoces que viajan; sus viajes se convierten en atajos para tus cartas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pole veel reisile asunud. Lisage reisivad inimesed, keda teate – nende reisidest saavad teie kirjade otseteed."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ez da bidaiarik hasi oraindik. Gehitu ezagutzen dituzun pertsonak bidaiatzen dutenak; haien bidaiak zure gutunetarako lasterbide bihurtzen dira."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei ole vielä lähtenyt matkalle. Lisää tuntemasi ihmiset, jotka matkustavat – heidän matkoistaan ​​tulee kirjeidesi oikoteitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas encore entrepris de voyage. Ajoutez les personnes que vous connaissez qui voyagent : leurs voyages deviennent des raccourcis pour vos lettres."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas encore entrepris de voyage. Ajoutez les personnes que vous connaissez qui voyagent : leurs voyages deviennent des raccourcis pour vos lettres."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl %@ tosaithe ar thuras go fóill. Cuir leis na daoine a bhfuil aithne agat orthu a thaistealaíonn — is aicearraí iad a dturas do do litreacha."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aínda non partiu de viaxe. Engade as persoas que coñeces que viaxan; as súas viaxes convértense en atallos para as túas cartas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ עדיין לא יצא למסע. הוסף את האנשים שאתה מכיר שנוסעים - הנסיעות שלהם הופכות לקיצורי דרך למכתבים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अभी तक किसी यात्रा पर नहीं निकला है। उन लोगों को जोड़ें जिन्हें आप जानते हैं जो यात्रा करते हैं - उनकी यात्राएँ आपके पत्रों के लिए शॉर्टकट बन जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ još nije krenuo na put. Dodajte ljude koje znate koji putuju — njihova putovanja postaju prečaci za vaša pisma."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ még nem indult útnak. Adja hozzá azokat az embereket, akiket ismer, akik utaznak – utazásaik parancsikonokká válnak a leveleihez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belum memulai perjalanan. Tambahkan orang-orang yang Anda kenal yang bepergian — perjalanan mereka menjadi jalan pintas untuk surat Anda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hefur ekki lagt af stað í ferðalag ennþá. Bættu við fólkinu sem þú þekkir sem ferðast - ferðir þeirra verða flýtileiðir fyrir bréfin þín."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è ancora partito per un viaggio. Aggiungi le persone che conosci che viaggiano: i loro viaggi diventeranno scorciatoie per le tue lettere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はまだ旅に出ていません。旅行に行く知り合いを加えてください。彼らの旅が手紙の近道になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님은 아직 여행을 떠나지 않았습니다. 여행하는 지인을 추가하세요. 그들의 여행은 편지의 바로가기가 됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dar neišvyko į kelionę. Pridėkite pažįstamų žmonių, kurie keliauja – jų kelionės taps jūsų laiškų nuorodomis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vēl nav devies ceļojumā. Pievienojiet sev zināmos cilvēkus, kuri ceļo — viņu ceļojumi kļūst par īsceļiem jūsu vēstulēm."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ сè уште не тргнал на патување. Додајте ги луѓето што ги познавате кои патуваат - нивните патувања стануваат кратенки за вашите писма."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belum memulakan perjalanan lagi. Tambahkan orang yang anda kenali mengembara — perjalanan mereka menjadi pintasan untuk surat anda."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ għadha ma bdietx vjaġġ. Żid in-nies li taf li jivvjaġġaw — il-vjaġġi tagħhom isiru shortcuts għall-ittri tiegħek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ikke lagt ut på en reise ennå. Legg til folk du kjenner som reiser – turene deres blir snarveier for brevene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is nog niet op reis gegaan. Voeg de mensen toe die u kent en die reizen; hun reizen worden snelkoppelingen voor uw brieven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie wyruszył jeszcze w podróż. Dodaj znajomych, którzy podróżują — ich podróże staną się skrótami do Twoich listów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ainda não iniciou uma viagem. Adicione as pessoas que você conhece que viajam – as viagens delas se tornam atalhos para suas cartas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ainda não iniciou uma viagem. Adicione as pessoas que você conhece que viajam – as viagens delas se tornam atalhos para suas cartas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu a pornit încă într-o călătorie. Adăugați oamenii pe care îi cunoașteți care călătoresc - călătoriile lor devin scurtături pentru scrisorile dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ еще не отправился в путешествие. Добавьте людей, которых вы знаете, которые путешествуют — их поездки станут ярлыками для ваших писем."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sa ešte nevydal na cestu. Pridajte ľudí, ktorých poznáte a ktorí cestujú – ich cesty sa stanú skratkami pre vaše listy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se še ni odpravil na pot. Dodajte ljudi, ki jih poznate in potujejo – njihova potovanja postanejo bližnjice za vaša pisma."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nuk është nisur ende për një udhëtim. Shtoni njerëzit që njihni që udhëtojnë - udhëtimet e tyre bëhen shkurtore për letrat tuaja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ још није кренуо на пут. Додајте људе које знате који путују — њихова путовања постају пречице за ваша писма."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har inte gett sig ut på en resa än. Lägg till de personer du känner som reser – deras resor blir genvägar till dina brev."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ยังไม่ได้ออกเดินทาง เพิ่มคนที่คุณรู้จักที่เดินทาง การเดินทางของพวกเขากลายเป็นทางลัดสำหรับจดหมายของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ henüz bir yolculuğa çıkmadı. Seyahat ettiğini bildiğiniz kişileri ekleyin; onların gezileri mektuplarınız için kısayol haline gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ще не вирушив у подорож. Додайте людей, яких ви знаєте, які подорожують — їхні поїздки стануть ярликами для ваших листів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chưa bắt đầu cuộc hành trình nào. Thêm những người bạn biết đang đi du lịch — chuyến đi của họ trở thành lối tắt cho những bức thư của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 尚未出发。添加你认识的旅行的人——他们的旅行成为你信件的捷径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 尚未出發。加上你認識的旅行的人－他們的旅行成為你信件的捷徑。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 尚未出發。加上你認識的旅行的人－他們的旅行成為你信件的捷徑。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ჯერ არ წასულა სამოგზაუროდ. დაამატეთ ადამიანები, რომლებსაც იცნობთ, რომლებიც მოგზაურობენ — მათი მოგზაურობები ხდება თქვენი წერილების მალსახმობები."
          }
        },
        "kk": {
