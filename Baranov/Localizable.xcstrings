        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màu đỏ thẫm là của mọi người chăn cừu. Nhấn vào một loại sáp khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深红色是每个牧羊人的。敲击另一块蜡。"
