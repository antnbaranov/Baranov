    "Subscriptions renew automatically unless cancelled at least 24 hours before the period ends. Manage or cancel in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تجديد الاشتراكات تلقائيًا ما لم يتم إلغاؤها قبل 24 ساعة على الأقل من انتهاء الفترة. إدارة أو إلغاء في الإعدادات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Абонаментите се подновяват автоматично, освен ако не бъдат анулирани поне 24 часа преди края на периода. Управлявайте или анулирайте в Настройки."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretplate se automatski obnavljaju osim ako se ne otkaže najmanje 24 sata prije isteka perioda. Upravljajte ili otkažite u Postavkama."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les subscripcions es renoven automàticament tret que es cancel·lin almenys 24 hores abans que finalitzi el període. Gestiona o cancel·la a Configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předplatné se automaticky obnovuje, pokud není zrušeno alespoň 24 hodin před koncem období. Spravujte nebo zrušte v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementer fornyes automatisk, medmindre de opsiges mindst 24 timer før perioden udløber. Administrer eller annuller i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnements verlängern sich automatisch, sofern sie nicht mindestens 24 Stunden vor Ablauf des Zeitraums gekündigt werden. In den Einstellungen verwalten oder kündigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συνδρομές ανανεώνονται αυτόματα εκτός εάν ακυρωθούν τουλάχιστον 24 ώρες πριν από τη λήξη της περιόδου. Διαχείριση ή ακύρωση στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions renew automatically unless cancelled at least 24 hours before the period ends. Manage or cancel in Settings."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions renew automatically unless cancelled at least 24 hours before the period ends. Manage or cancel in Settings."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions renew automatically unless cancelled at least 24 hours before the period ends. Manage or cancel in Settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions renew automatically unless cancelled at least 24 hours before the period ends. Manage or cancel in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones se renuevan automáticamente a menos que se cancelen al menos 24 horas antes de que finalice el período. Administrar o cancelar en Configuración."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones se renuevan automáticamente a menos que se cancelen al menos 24 horas antes de que finalice el período. Administrar o cancelar en Configuración."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tellimused uuenevad automaatselt, kui neid ei tühistata vähemalt 24 tundi enne perioodi lõppu. Hallake või tühistage menüüs Seaded."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harpidetzak automatikoki berritzen dira, epea amaitu baino gutxienez 24 ordu lehenago bertan behera uzten ez badira. Kudeatu edo bertan behera utzi Ezarpenak atalean."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilaukset uusiutuvat automaattisesti, ellei niitä peruuteta vähintään 24 tuntia ennen jakson päättymistä. Hallinnoi tai peruuta asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements se renouvellent automatiquement sauf annulation au moins 24 heures avant la fin de la période. Gérer ou annuler dans Paramètres."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements se renouvellent automatiquement sauf annulation au moins 24 heures avant la fin de la période. Gérer ou annuler dans Paramètres."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Athnuachan síntiúis go huathoibríoch mura gcuirtear ar ceal iad 24 uair ar a laghad roimh dheireadh na tréimhse. Bainistigh nó cealaigh sna Socruithe."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As subscricións renóvanse automaticamente a menos que se cancelen polo menos 24 horas antes de que remate o período. Xestiona ou cancela en Configuración."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המנויים מתחדשים אוטומטית אלא אם בוטלו לפחות 24 שעות לפני סיום התקופה. נהל או בטל בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अवधि समाप्त होने से कम से कम 24 घंटे पहले रद्द न होने तक सदस्यताएँ स्वचालित रूप से नवीनीकृत हो जाती हैं। सेटिंग्स में प्रबंधित करें या रद्द करें."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pretplate se automatski obnavljaju osim ako se ne otkažu najmanje 24 sata prije završetka razdoblja. Upravljajte ili otkažite u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az előfizetések automatikusan megújulnak, hacsak nem mondják le legalább 24 órával az időszak vége előtt. Manage or cancel in Settings."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langganan diperpanjang secara otomatis kecuali dibatalkan setidaknya 24 jam sebelum periode berakhir. Kelola atau batalkan di Pengaturan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áskrift endurnýjast sjálfkrafa nema þeim sé sagt upp a.m.k. 24 klukkustundum áður en tímabilinu lýkur. Stjórna eða hætta við í stillingum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli abbonamenti si rinnovano automaticamente a meno che non vengano annullati almeno 24 ore prima della fine del periodo. Gestisci o annulla in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期間が終了する少なくとも 24 時間前にキャンセルしない限り、サブスクリプションは自動的に更新されます。設定で管理またはキャンセルします。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გამოწერები ავტომატურად განახლდება, თუ არ გაუქმდება პერიოდის დასრულებამდე მინიმუმ 24 საათით ადრე. მართეთ ან გააუქმეთ პარამეტრებიდან."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мерзімнің аяқталуына кемінде 24 сағат қалғанда бас тартылмаса, жазылымдар автоматты түрде жаңартылады. Параметрлерде басқарыңыз немесе бас тартыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기간이 종료되기 최소 24시간 전에 취소하지 않으면 구독이 자동으로 갱신됩니다. 설정에서 관리하거나 취소하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenumeratos atnaujinamos automatiškai, nebent jos atšauktos likus bent 24 valandoms iki laikotarpio pabaigos. Tvarkykite arba atšaukite nustatymuose."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonementi tiek automātiski atjaunoti, ja vien tie netiek atcelti vismaz 24 stundas pirms perioda beigām. Pārvaldiet vai atceliet iestatījumus."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Претплатите се обновуваат автоматски освен ако не се откажат најмалку 24 часа пред истекот на периодот. Управувајте или откажете во Поставки."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langganan diperbaharui secara automatik melainkan dibatalkan sekurang-kurangnya 24 jam sebelum tempoh tamat. Urus atau batalkan dalam Tetapan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-abbonamenti jġeddu awtomatikament sakemm ma jiġux ikkanċellati mill-inqas 24 siegħa qabel jintemm il-perjodu. Immaniġġja jew tikkanċella fis-Settings."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementer fornyes automatisk med mindre de kanselleres minst 24 timer før perioden slutter. Administrer eller avbryt i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementen worden automatisch verlengd, tenzij ze ten minste 24 uur vóór het einde van de periode worden opgezegd. Beheer of annuleer in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskrypcje odnawiają się automatycznie, chyba że zostaną anulowane co najmniej 24 godziny przed końcem okresu. Zarządzaj lub anuluj w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas são renovadas automaticamente, a menos que sejam canceladas pelo menos 24 horas antes do término do período. Gerencie ou cancele em Configurações."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas são renovadas automaticamente, a menos que sejam canceladas pelo menos 24 horas antes do término do período. Gerencie ou cancele em Configurações."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonamentele se reînnoiesc automat, cu excepția cazului în care sunt anulate cu cel puțin 24 de ore înainte de încheierea perioadei. Gestionați sau anulați în Setări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписки продлеваются автоматически, если они не отменены по крайней мере за 24 часа до окончания периода. Управляйте или отменяйте в настройках."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predplatné sa obnovuje automaticky, pokiaľ nie je zrušené aspoň 24 hodín pred koncom obdobia. Spravujte alebo zrušte v Nastaveniach."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naročnine se samodejno obnovijo, razen če jih prekličete vsaj 24 ur pred koncem obdobja. Upravljajte ali prekličite v nastavitvah."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonimet rinovohen automatikisht nëse nuk anulohen të paktën 24 orë përpara përfundimit të periudhës. Menaxho ose anuloje te \"Cilësimet\"."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Претплате се аутоматски обнављају осим ако се не откаже најмање 24 сата пре истека периода. Управљајте или откажите у подешавањима."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenumerationer förnyas automatiskt om de inte avbryts minst 24 timmar innan perioden slutar. Hantera eller avbryt i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสมัครสมาชิกจะต่ออายุโดยอัตโนมัติเว้นแต่จะยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุดระยะเวลา จัดการหรือยกเลิกในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonelikler, sürenin bitiminden en az 24 saat önce iptal edilmediği sürece otomatik olarak yenilenir. Ayarlar'da yönetin veya iptal edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підписки поновлюються автоматично, якщо їх не скасовувати принаймні за 24 години до закінчення періоду. Керуйте або скасуйте в налаштуваннях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng ký tự động gia hạn trừ khi bị hủy ít nhất 24 giờ trước khi thời gian kết thúc. Quản lý hoặc hủy trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅会自动续订，除非在订阅期结束前至少 24 小时取消。在“设置”中管理或取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訂閱會自動續訂，除非在訂閱期結束前至少 24 小時取消。在“設定”中管理或取消。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅会自动续订，除非在订阅期结束前至少 24 小时取消。在“設定”中管理或取消。"
