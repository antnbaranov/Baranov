    "As soon as %@'s phone says where their gate is, %@ walks there on your steps." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بمجرد أن يخبرك هاتف %@ بمكان البوابة، فإن %@ يسير هناك على خطواتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Веднага щом телефонът на %@ каже къде е портата им, %@ стъпва там по вашите стъпала."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čim telefon %@ kaže gdje je njihova kapija, %@ hoda tamo na vašim stepenicama."
