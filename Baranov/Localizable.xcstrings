    "Standing at the gate in %@, ears up. Delivered." : {
      "comment" : "The last sentence of the last stamp.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوقوف عند البوابة في %@ ، آذان مرفوعة. تم التوصيل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стои на портата в %@ с вдигнати уши. Доставено."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stojim na kapiji u %@ , gore uši. Isporučeno."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dempeus a la porta a %@ , orelles aixecades. Lliurat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stojím u brány v %@ , uši nahoře. Doručeno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stående ved porten i %@ , ører op. Leveret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@ mit erhobenen Ohren am Tor stehen. Geliefert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στέκεται στην πύλη στο %@ , τα αυτιά ψηλά. Παραδόθηκε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standing at the gate in %@, ears up. Delivered."
          }
