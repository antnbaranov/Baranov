          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上では、羊は静かな目的を持って動きます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ზე მეტი ვერძი მოძრაობს მშვიდი მიზნით."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ кезінде қошқар тыныш мақсатпен қозғалады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 이상에서는 램이 조용한 목적으로 움직입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per %@ avinas juda tyliai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vairāk nekā %@ auns pārvietojas klusi."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Над %@, овенот се движи со тивка цел."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih %@ , ram bergerak dengan tujuan yang senyap."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktar minn %@ , il-muntun jiċċaqlaq bi skop kwiet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Over %@ beveger væren seg med en rolig hensikt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boven %@ beweegt de ram met rustige bedoelingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powyżej %@ baran porusza się cicho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais de %@ , o carneiro se move com propósito silencioso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais de %@ , o carneiro se move com propósito silencioso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Над %@ баран движется бесшумно."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Peste %@ , berbecul se mișcă cu un scop liniștit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad %@ sa baranidlo pohybuje ticho."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad %@ se oven premika tiho."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mbi %@ , dashi lëviz me qëllim të qetë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Преко %@, ован се креће тихо."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหนือ %@ แกะจะเคลื่อนที่อย่างเงียบๆ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Över %@ rör sig baggen med tyst syfte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ üzerinde koç sessiz bir amaçla hareket eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Понад %@ баран рухається тихо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
