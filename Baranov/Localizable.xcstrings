    "Will only walk if someone else takes the next leg.": {
      "comment": "The name of the relay driver.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще върви само ако някой друг поеме следващия крак."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només caminarà si algú altre agafa la següent etapa."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodat će samo ako neko drugi uzme sljedeću nogu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يمشي إلا إذا أخذ شخص آخر الساق التالية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Går kun, hvis en anden tager det næste ben."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Půjde jen tehdy, když další nohu vezme někdo jiný."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Will only walk if someone else takes the next leg."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Will only walk if someone else takes the next leg."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Will only walk if someone else takes the next leg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geht nur, wenn jemand anderes die nächste Etappe übernimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo caminará si alguien más toma el siguiente tramo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo caminará si alguien más toma el siguiente tramo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα περπατήσει μόνο αν κάποιος άλλος κάνει το επόμενο πόδι."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõnnib ainult siis, kui keegi teine ​​võtab järgmise jala."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beste norbaitek hurrengo hanka hartzen badu bakarrik ibiliko da."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne marchera que si quelqu'un d'autre prend l'étape suivante."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne marchera que si quelqu'un d'autre prend l'étape suivante."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kävelee vain, jos joku muu ottaa seuraavan jalan."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní shiúlfaidh sé ach amháin má thógann duine eile an chéad chos eile."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Só camiñará se outra persoa leva a seguinte etapa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ילך רק אם מישהו אחר ייקח את הרגל הבאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तभी चलूँगा जब अगला पैर कोई और उठाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodat će samo ako netko drugi prijeđe sljedeću nogu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak akkor fog járni, ha valaki más veszi át a következő lábát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya akan berjalan jika ada orang lain yang mengambil kaki berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Camminerà solo se qualcun altro prende la gamba successiva."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Mun bara ganga ef einhver annar tekur næsta legg."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かが次の足をとった場合にのみ歩きます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ივლის მხოლოდ იმ შემთხვევაში, თუ სხვა ფეხს აიღებს."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람이 다음 다리를 가져가는 경우에만 걸을 것입니다."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Келесі аяқты басқа біреу алған жағдайда ғана жүреді."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eis tik tuo atveju, jei kitą koją ims kas nors kitas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastaigāsies tikai tad, ja kāds cits paņems nākamo kāju."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ќе оди само ако некој друг ја преземе следната нога."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya akan berjalan jika orang lain mengambil kaki seterusnya."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se jimxi biss jekk xi ħadd ieħor jieħu s-sieq li jmiss."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil bare gå hvis noen andre tar neste etappe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zal alleen lopen als iemand anders het volgende been neemt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só andará se outra pessoa fizer a próxima etapa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pójdzie tylko wtedy, gdy ktoś inny zrobi następną nogę."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só andará se outra pessoa fizer a próxima etapa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет идти только в том случае, если следующий этап пройдет кто-то другой."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Va merge doar dacă altcineva ia următorul pas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bude chodiť len vtedy, ak niekto iný prejde na ďalšiu nohu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodil bo le, če bo nekdo drug stopil po naslednji nogi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Do të ecë vetëm nëse dikush tjetër merr këmbën tjetër."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ходаће само ако неко други узме следећу ногу."
