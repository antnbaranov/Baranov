        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάνω από το %@ , ο κριός κινείται με αθόρυβο σκοπό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre %@ , el ariete se mueve con un propósito silencioso."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre %@ , el ariete se mueve con un propósito silencioso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Üle %@ liigub jäär vaikse sihiga."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ baino gehiago, aharia helburu lasaiarekin mugitzen da."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-dessus de %@ , le bélier se déplace avec un objectif silencieux."
