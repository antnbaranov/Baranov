    "The sender has to send the ram first. Or be the receiver instead: add the sender's ID as a code in the letter sheet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب على المرسل أن يرسل الكبش أولاً. أو كن المستلم بدلاً من ذلك: أضف معرف المرسل كرمز في ورقة الرسالة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подателят трябва първо да изпрати овена. Или вместо това бъдете получател: добавете ID на изпращача като код в листа с писма."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošiljalac mora prvo poslati ovna. Ili umjesto toga budite primalac: dodajte ID pošiljaoca kao kod na listu sa pismom."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El remitent ha d'enviar primer la RAM. O sigueu el receptor: afegiu l'identificador del remitent com a codi al full de cartes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odesílatel musí nejprve odeslat berana. Nebo buďte místo toho příjemcem: přidejte ID odesílatele jako kód do listu dopisu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afsenderen skal sende vædderen først. Eller vær modtager i stedet: Tilføj afsenderens ID som en kode i brevarket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuerst muss der Absender das Schaf losschicken. Oder werde selbst Empfänger: Füge die ID des Absenders als Code im Briefblatt ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο αποστολέας πρέπει να στείλει πρώτα το κριάρι. Εναλλακτικά, γίνετε ο παραλήπτης: προσθέστε το αναγνωριστικό του αποστολέα ως κωδικό στο φύλλο επιστολής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sender has to send the ram first. Or be the receiver instead: add the sender's ID as a code in the letter sheet."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sender has to send the ram first. Or be the receiver instead: add the sender's ID as a code in the letter sheet."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sender has to send the ram first. Or be the receiver instead: add the sender's ID as a code in the letter sheet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sender has to send the ram first. Or be the receiver instead: add the sender's ID as a code in the letter sheet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El remitente tiene que enviar el carnero primero. O sé tú el receptor: añade el ID del remitente como código en la hoja de la carta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El remitente tiene que enviar el carnero primero. O sé tú el receptor: añade el ID del remitente como código en la hoja de la carta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saatja peab esmalt jäära saatma. Või ole hoopis vastuvõtja: lisa kirjalehele koodina saatja ID."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bidaltzaileak aharia bidali behar du lehenik. Edo hartzailea izan ordez: gehitu igorlearen ID kode gisa gutun-orrian."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähettäjän on ensin lähetettävä ram. Tai ole sen sijaan vastaanottaja: lisää lähettäjän tunnus koodina kirjelomakkeeseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'expéditeur doit d'abord envoyer le bélier. Ou deviens le destinataire : ajoute l'identifiant de l'expéditeur sous forme de code dans la feuille de lettre."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'expéditeur doit d'abord envoyer le bélier. Ou deviens le destinataire : ajoute l'identifiant de l'expéditeur sous forme de code dans la feuille de lettre."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caithfidh an seoltóir an reithe a sheoladh ar dtús. Nó bí i do ghlacadóir ina ionad sin: cuir ID an tseoltóra mar chód ar bhileog na litreach."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O remitente ten que enviar primeiro o RAM. Ou sexa o receptor: engade o ID do remitente como código na folla de cartas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השולח צריך לשלוח את הכבש תחילה. או להיות המקבל במקום זאת: הוסף את תעודת הזהות של השולח כקוד בגיליון המכתבים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रेषक को पहले ram भेजना होगा. या इसके बजाय प्राप्तकर्ता बनें: पत्र पत्रक में एक कोड के रूप में प्रेषक की आईडी जोड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošiljatelj mora prvo poslati ovna. Ili umjesto toga budite primatelj: dodajte ID pošiljatelja kao kod na list s pismom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A feladónak először el kell küldenie a ramot. Vagy inkább legyen a címzett: adja meg a feladó azonosítóját kódként a levéllapon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengirim harus mengirimkan ramnya terlebih dahulu. Atau jadilah penerima: tambahkan ID pengirim sebagai kode di lembar surat."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendandi þarf að senda hrútinn fyrst. Eða vertu viðtakandi í staðinn: bættu auðkenni sendanda sem kóða á bréfablaðið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mittente deve prima inviare la ram. Oppure sii tu il destinatario: aggiungi l'ID del mittente come codice nel foglio della lettera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信者は最初に RAM を送信する必要があります。または、代わりに受信者になります。送信者の ID をコードとしてレターシートに追加します。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გამგზავნმა ჯერ ვერძი უნდა გამოაგზავნოს. ან იყავით მიმღები: დაამატეთ გამგზავნის ID, როგორც კოდი ასოს ფურცელში."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жіберуші алдымен қошқарды жіберуі керек. Немесе оның орнына қабылдаушы болыңыз: хат парағына жіберушінің идентификаторын код ретінде қосыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보내는 사람이 먼저 램을 보내야 합니다. 아니면 대신 수신자가 되어 보세요. 발송인의 ID를 편지 시트에 코드로 추가하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siuntėjas pirmiausia turi išsiųsti aviną. Arba vietoj to būkite gavėjas: pridėkite siuntėjo ID kaip kodą laiško lape."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sūtītājam vispirms ir jānosūta auns. Vai arī esiet saņēmējs: pievienojiet sūtītāja ID kā kodu vēstules lapā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Испраќачот треба прво да го испрати овенот. Или, наместо тоа, бидете примач: додадете го ID на испраќачот како шифра во листот со букви."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengirim perlu menghantar ram terlebih dahulu. Atau sebaliknya jadi penerima: tambahkan ID pengirim sebagai kod dalam helaian surat."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min jibgħat irid jibgħat il-muntun l-ewwel. Jew kun ir-riċevitur minflok: żid l-ID tal-mittent bħala kodiċi fil-folja tal-ittri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsenderen må sende ram først. Eller vær mottaker i stedet: legg til avsenderens ID som en kode i brevarket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De afzender moet eerst de ram verzenden. Of wees de ontvanger: voeg de ID van de afzender als code toe op het briefvel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadawca musi najpierw wysłać barana. Możesz też zostać odbiorcą: dodaj identyfikator nadawcy jako kod na arkuszu listu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O remetente deve enviar o RAM primeiro. Ou seja o destinatário: adicione o ID do remetente como um código na folha de cartas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O remetente deve enviar o RAM primeiro. Ou seja o destinatário: adicione o ID do remetente como um código na folha de cartas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expeditorul trebuie să trimită mai întâi berbecul. Sau fiți destinatarul: adăugați ID-ul expeditorului ca cod în foaia de scrisori."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала отправитель должен отправить барана. Или стань получателем: добавь ID отправителя как код в листе письма."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odosielateľ musí najprv poslať barana. Alebo buďte namiesto toho príjemcom: pridajte ID odosielateľa ako kód do listu s listami."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošiljatelj mora najprej poslati ovna. Ali pa bodite namesto tega prejemnik: dodajte ID pošiljatelja kot kodo na list s pismom."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dërguesi duhet të dërgojë më parë dashin. Ose bëhu marrësi: shtoni ID-në e dërguesit si kod në fletën e shkronjave."
