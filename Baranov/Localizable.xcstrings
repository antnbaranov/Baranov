        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चारागाह के साथ आता है. प्राप्तकर्ता आपके द्वारा चुने गए रंग को तोड़ देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolazi s pašnjakom. Primatelj razbija boju koju ste odabrali."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jön a legelővel. A címzett megtöri az Ön által választott színt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilengkapi dengan padang rumput. Penerima memecah warna yang Anda pilih."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemur með haganum. Viðtakandinn brýtur litinn sem þú valdir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene fornito con il pascolo. Il destinatario rompe il colore che hai scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "牧草も付いてきます。受信者はあなたが選択した色を壊します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목초지와 함께 제공됩니다. 수신자가 선택한 색상을 깨뜨립니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ateina su ganykla. Gavėjas sulaužo jūsų pasirinktą spalvą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nāk ar ganībām. Adresāts pārtrauc jūsu izvēlēto krāsu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доаѓа со пасиштето. Примачот ја крши бојата што сте ја избрале."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Datang dengan padang rumput. Penerima memecahkan warna yang anda pilih."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiġi mal-mergħa. Ir-riċevitur ikisser il-kulur li għażilt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommer med beitet. Mottakeren bryter fargen du valgte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt geleverd met het weiland. De ontvanger breekt de door jou gekozen kleur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W zestawie z pastwiskiem. Odbiorca złamie wybrany przez Ciebie kolor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vem com o pasto. O destinatário quebra a cor que você escolheu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vem com o pasto. O destinatário quebra a cor que você escolheu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vine cu pășunea. Destinatarul rupe culoarea pe care ați ales-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Comes with the pasture. Получатель нарушает выбранный вами цвет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prichádza s pastvinou. Príjemca poruší farbu, ktorú ste si vybrali."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihaja s pašo. Prejemnik pokvari barvo, ki ste jo izbrali."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Vjen me kullotën. Marrësi thyen ngjyrën që keni zgjedhur."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Долази са пашњаком. Прималац разбија боју коју сте изабрали."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommer med hagen. Mottagaren bryter färgen du valt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มาพร้อมกับทุ่งหญ้า ผู้รับแบ่งสีที่คุณเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mera ile birlikte gelir. Alıcı seçtiğiniz rengi kırar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надходить з пасовищем. Одержувач порушує обраний вами колір."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đi kèm với đồng cỏ. Người nhận phá vỡ màu sắc bạn đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附带牧场。收件人破坏了您选择的颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附帶牧場。收件人破壞了您選擇的顏色。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "附帶牧場。收件人破壞了您選擇的顏色。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოყვება საძოვარი. მიმღები არღვევს თქვენს მიერ არჩეულ ფერს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жайылыммен келеді. Алушы сіз таңдаған түсті бұзады."
          }
        }
      }
