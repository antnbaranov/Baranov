          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se valmistuu itsestään, kun vaiheet lasketaan yhteen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Críochnaíonn sé é féin nuair a thagann na céimeanna suas."
