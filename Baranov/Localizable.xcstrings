    "%@ is %@ and ready for a first letter — send one from the Journey screen." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ هو %@ وجاهز لإرسال الحرف الأول — أرسل واحدًا من شاشة الرحلة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ е %@ и е готов за първа буква — изпратете такава от екрана на пътуването."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je %@ i spreman je za prvo slovo — pošaljite ga sa ekrana Putovanje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ és %@ i llest per a una primera carta: envieu-ne una des de la pantalla de Viatge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je %@ a je připraveno pro první písmeno – odešlete jej z obrazovky Journey."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er %@ og klar til et første bogstav — send et fra rejseskærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist %2$@ und bereit für den ersten Brief — sende einen vom Reise-Bildschirm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ είναι %@ και έτοιμο για ένα πρώτο γράμμα — στείλτε ένα από την οθόνη Ταξίδι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is %@ and ready for a first letter — send one from the Journey screen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is %@ and ready for a first letter — send one from the Journey screen."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is %@ and ready for a first letter — send one from the Journey screen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is %@ and ready for a first letter — send one from the Journey screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tiene %2$@ y está listo para su primera carta; envía una desde la pantalla de Viaje."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tiene %2$@ y está listo para su primera carta; envía una desde la pantalla de Viaje."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on %@ ja valmis esimeseks kirjaks – saatke see teekonnaekraanilt."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ da eta lehen gutun bat jasotzeko prest: bidali bat Bidaia pantailatik."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on %@ ja valmis ensimmäiseen kirjaimeen – lähetä kirjain Matka-näytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a %2$@ et est prêt pour une première lettre — envoie-en une depuis l'écran Voyage."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a %2$@ et est prêt pour une première lettre — envoie-en une depuis l'écran Voyage."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá %@ %@ agus réidh don chéad litir — seol ceann ón scáileán Journey."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é %@ e listo para recibir unha primeira carta: envía unha desde a pantalla de Viaxe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ הוא %@ ומוכן לאות ראשונה - שלח אחת ממסך המסע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ है और पहले पत्र के लिए तैयार है - जर्नी स्क्रीन से एक पत्र भेजें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je %@ i spreman je za prvo slovo — pošaljite jedno sa zaslona Putovanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ a %@, és készen áll az első levélre – küldjön egyet az Utazás képernyőről."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adalah %@ dan siap untuk surat pertama — kirim satu dari layar Perjalanan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er %@ og tilbúið fyrir fyrsta staf — sendu einn af ferðaskjánum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha %2$@ ed è pronto per la prima lettera: inviane una dalla schermata Viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）は最初の手紙を運ぶ準備ができています。「旅路」画面から手紙を送りましょう。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ არის %@ და მზად არის პირველი წერილისთვის - გაგზავნეთ ერთი მოგზაურობის ეკრანიდან."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@ және бірінші әріпке дайын — Сапар экранынан біреуін жіберіңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) %2$@이며 첫 편지를 전할 준비가 되었습니다. 여정 화면에서 편지를 보내보세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yra %@ ir paruoštas pirmajai raidei – išsiųskite ją iš kelionės ekrano."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ir %@ un gatavs pirmajai vēstulei — nosūtiet to no ceļojuma ekrāna."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ е %@ и е подготвен за првата буква - испратете ја од екранот на Патување."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ialah %@ dan sedia untuk surat pertama — hantar satu daripada skrin Perjalanan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hija %@ u lesta għall-ewwel ittra — ibgħat waħda mill-iskrin tal-Vjaġġ."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er %@ og klar for en første bokstav – send en fra Journey-skjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is %@ en klaar voor een eerste brief: stuur er een vanuit het Journey-scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ma %2$@ i jest gotowy na pierwszy list — wyślij go z ekranu Podróż."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tem %2$@ e está pronto para a primeira carta — envie uma pela tela Jornada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tem %2$@ e está pronto para a primeira carta — envie uma pela tela Jornada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha %2$@ ed è pronto per la prima lettera: inviane una dalla schermata Viaggio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) готов к первому письму — отправь его с экрана «Путешествие»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je %@ a je pripravené na zadanie prvého písmena – pošlite ho z obrazovky Journey."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je %@ in pripravljen za prvo črko – pošljite jo z zaslona Potovanje."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ është %@ dhe gati për një shkronjë të parë — dërgojeni një nga ekrani i Udhëtimit."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ је %@ и спреман је за прво писмо — пошаљите га са екрана Путовање."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ är %@ och redo för en första bokstav — skicka en från skärmen Journey."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ คือ %@ และพร้อมสำหรับจดหมายฉบับแรก — ส่งหนึ่งฉบับจากหน้าจอการเดินทาง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@'dir ve ilk harfe hazırdır; Yolculuk ekranından bir tane gönderin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@) готовий до першого листа — надішли його з екрана «Подорож»."
          }
        },
        "vi" : {
