    "Letters sent to your Shepherd ID walk here, on the sender's steps. Only the town is shared." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرسائل المرسلة إلى معرف الراعي الخاص بك تسير هنا، على خطوات المرسل. المدينة فقط مشتركة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Писмата, изпратени до вашия Shepherd ID, вървят тук, по стълбите на подателя. Само градът е споделен."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisma poslana vašoj Shepherd ID hodaju ovdje, na stepenicama pošiljaoca. Samo grad se dijeli."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes enviades al vostre pas d'identificació passen aquí, pels passos del remitent. Només es comparteix el poble."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopisy zaslané vašemu Shepherd ID chodí sem, po schodech odesílatele. Sdílí se pouze město."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breve sendt til dit hyrde-id går her, på afsenderens trin. Kun byen er delt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Briefe an deine Hirten-ID laufen hierher, auf den Schritten des Absenders. Geteilt wird nur der Ort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι επιστολές που αποστέλλονται στο Shepherd ID σας περπατούν εδώ, στα σκαλιά του αποστολέα. Μόνο η πόλη μοιράζεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letters sent to your Shepherd ID walk here, on the sender's steps. Only the town is shared."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letters sent to your Shepherd ID walk here, on the sender's steps. Only the town is shared."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letters sent to your Shepherd ID walk here, on the sender's steps. Only the town is shared."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letters sent to your Shepherd ID walk here, on the sender's steps. Only the town is shared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cartas enviadas a su ID de Pastor caminan aquí, por las escaleras del remitente. Sólo se comparte el pueblo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cartas enviadas a su ID de Pastor caminan aquí, por las escaleras del remitente. Sólo se comparte el pueblo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie Shepherd ID-le saadetud kirjad jõuavad siia saatja sammudel. Jagatakse ainult linna."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zure Artzain IDari bidalitako gutunak hemen doaz, igorlearen urratsetan. Herria bakarrik partekatzen da."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paimentunnuksellesi lähetetyt kirjeet kulkevat täällä, lähettäjän portailla. Vain kaupunki on jaettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lettres envoyées à ton berger ID marchent ici, sur les marches de l'expéditeur. Seule la ville est partagée."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lettres envoyées à ton berger ID marchent ici, sur les marches de l'expéditeur. Seule la ville est partagée."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seoltar litreacha chuig do Shepherd ID ag siúl anseo, ar chéimeanna an tseoltóra. Níl ach an baile roinnte."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cartas enviadas ao teu Shepherd ID andan aquí, nas escaleiras do remitente. Só se comparte a cidade."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מכתבים שנשלחו לזיהוי הרועים שלך הולכים כאן, על מדרגות השולח. רק העיירה משותפת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके शेफर्ड आईडी पर भेजे गए पत्र प्रेषक के कदमों पर यहां चलते हैं। केवल शहर साझा है."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisma poslana na vaš Shepherd ID hodaju ovdje, na stepenicama pošiljatelja. Samo se grad dijeli."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Shepherd ID-jára küldött levelek itt, a feladó lépcsőjén sétálnak. Csak a város közös."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surat yang dikirim ke ID Gembala Anda berjalan di sini, mengikuti langkah pengirim. Hanya kota yang dibagikan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bréf send til Shepherd ID ganga hér, á tröppum sendandans. Aðeins bærinn er sameiginlegur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lettere inviate al tuo ID pastore camminano qui, sui gradini del mittente. Si condivide solo la città."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのシェパード ID に送られた手紙は、差出人の足跡をたどり、ここを歩きます。街だけが共有される。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თქვენი Shepherd ID-ისთვის გაგზავნილი წერილები აქ, გამგზავნის კიბეებზე დადის. მხოლოდ ქალაქია საერთო."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шопан куәлігіне жіберілген хаттар жіберушінің баспалдағымен осында жүреді. Тек қала ортақ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셰퍼드 ID로 보낸 편지는 보낸 사람의 계단을 따라 여기로 이동합니다. 마을만 공유됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laiškai, išsiųsti jūsų Shepherd ID, eina čia, ant siuntėjo laiptų. Tik miestelis yra bendras."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uz jūsu Shepherd ID nosūtītās vēstules staigā šeit, pa sūtītāja kāpnēm. Kopīga ir tikai pilsēta."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Писмата испратени до вашиот Shepherd ID одат овде, по скалите на испраќачот. Само градот е заеднички."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surat yang dihantar ke ID Gembala anda berjalan di sini, di tangga pengirim. Hanya bandar yang dikongsi."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ittri mibgħuta lil Shepherd ID tiegħek jimxu hawn, fuq il-passi ta' min jibgħat. Il-belt biss hija maqsuma."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brev sendt til din Shepherd ID går her, på avsenderens trinn. Bare byen er delt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brieven die naar uw Shepherd-ID zijn verzonden, lopen hierheen, op de trappen van de afzender. Alleen de stad wordt gedeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
