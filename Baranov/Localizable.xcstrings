    "Let people nearby hand you their ram, and let senders see roughly where a ram you carry is.": {
      "comment": "A description of the benefits of enabling the sharing feature.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволете на хората наблизо да ви подадат техния овен и нека подателите да видят приблизително къде е овенът, който носите."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa que les persones properes t'entreguin el seu ariet i que els remitents vegin aproximadament on és un ariet que portes."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neka vam ljudi u blizini predaju svog ovna i neka pošiljaoci otprilike vide gdje je ovan kojeg nosite."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح للأشخاص القريبين منك بتسليم الكبش الخاص بهم، ودع المرسلين يرون بشكل تقريبي مكان الكبش الذي تحمله."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad folk i nærheden give dig deres vædder, og lad afsendere se nogenlunde, hvor en vædder du bærer er."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte lidi poblíž, aby vám předali berana, a nechte odesílatele vidět, kde zhruba je beran, který nesete."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Let people nearby hand you their ram, and let senders see roughly where a ram you carry is."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Let people nearby hand you their ram, and let senders see roughly where a ram you carry is."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Let people nearby hand you their ram, and let senders see roughly where a ram you carry is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie sich von Leuten in der Nähe ihren Widder geben, und lassen Sie die Absender ungefähr sehen, wo sich ein Widder befindet, den Sie tragen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε τους ανθρώπους που βρίσκονται κοντά σας να σας παραδώσουν το κριάρι τους και αφήστε τους αποστολείς να δουν κατά προσέγγιση πού βρίσκεται ένα κριάρι που μεταφέρετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deje que las personas cercanas le entreguen su carnero y que los remitentes vean aproximadamente dónde está el carnero que lleva."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Deje que las personas cercanas le entreguen su carnero y que los remitentes vean aproximadamente dónde está el carnero que lleva."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Laske lähedalasuvatel inimestel oma jäära teile ulatada ja saatjatel näha, kus teie kaasas olev jäär on."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Utzi hurbileko jendeak bere aharia ematen dizu, eta igorleek gutxi gorabehera non dagoen dakarren aharia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez les gens à proximité vous remettre leur bélier et laissez les expéditeurs voir à peu près où se trouve le bélier que vous transportez."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez les gens à proximité vous remettre leur bélier et laissez les expéditeurs voir à peu près où se trouve le bélier que vous transportez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna lähellä olevien ihmisten ojentaa sinulle oinaansa ja lähettäjien nähdä suunnilleen missä kantamasi pässi on."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Lig do dhaoine in aice láimhe a reithe a thabhairt duit, agus féach ar na seoltóirí go garbh cá bhfuil an reithe a iompraíonn tú."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa que as persoas próximas che entreguen o seu carneiro e que os remitentes vexan aproximadamente onde está o carneiro que levas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תן לאנשים בקרבת מקום למסור לך את האיל שלהם, ואפשר לשולחים לראות בערך היכן נמצא איל שאתה נושא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आस-पास के लोगों को अपना मेढ़ा आपको सौंपने दें, और भेजने वालों को यह देखने दें कि आप जो मेढ़ा ले जा रहे हैं वह कहां है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neka vam ljudi u blizini predaju svog ovna, a pošiljatelji neka otprilike vide gdje se nalazi ovan koji nosite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyja, hogy a közelben lévő emberek átadják Önnek a kosukat, és a küldők nagyjából lássák, hol van az Ön által szállított kos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan orang-orang terdekat memberikan Anda ramnya, dan biarkan pengirim melihat secara kasar di mana ram yang Anda bawa berada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia che le persone nelle vicinanze ti consegnino il loro ariete e lascia che i mittenti vedano approssimativamente dove si trova l'ariete che porti."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Láttu fólk í nágrenninu afhenda þér hrútinn sinn og láttu sendendur sjá nokkurn veginn hvar hrúturinn sem þú berð er."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くにいる人に羊を渡してもらい、送り主にあなたが運んでいる羊がどこにあるかを大まかに知らせてください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიეცით საშუალება ახლომახლო ხალხმა გადმოგცეთ ვერძი და მიეცით საშუალება გამომგზავნოებს ნახონ, თუ სად არის ვერძი, რომელსაც თქვენ ატარებთ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Маңайдағы адамдарға қошқарларын беруге рұқсат етіңіз, ал жіберушілер сіздің алып жүрген қошқарыңыздың қайда екенін шамамен көрсін."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근처에 있는 사람들이 당신에게 숫양을 건네주고, 보낸 사람에게는 당신이 들고 있는 숫양이 대략 어디에 있는지 알 수 있게 하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegul netoliese esantys žmonės perduoda jums savo aviną, o siuntėjai apytiksliai mato, kur yra jūsų nešiojamas avinas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ļaujiet tuvumā esošajiem cilvēkiem nodot jums savu aunu un ļaujiet sūtītājiem aptuveni redzēt, kur atrodas jūsu nēsātais auns."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволете им на луѓето во близина да ви го предадат својот овен и дозволете им на испраќачите да видат приближно каде е овенот што го носите."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan orang yang berdekatan menyerahkan domba jantan mereka kepada anda, dan biarkan penghantar melihat secara kasar di mana seekor domba jantan yang anda bawa."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ħalli n-nies fil-viċin jagħtuk il-muntun tagħhom, u ħalli lil min jibgħathom jaraw bejn wieħed u ieħor fejn hu muntun li ġġorr."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La folk i nærheten gi deg væren sin, og la avsendere se omtrent hvor en vær du bærer er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat mensen in de buurt je hun ram overhandigen, en laat de afzenders ongeveer zien waar een ram die je draagt zich bevindt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól osobom w pobliżu wręczyć ci barana, a nadawcy zobacz mniej więcej, gdzie znajduje się baran, który niesiesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe que as pessoas próximas lhe entreguem seu carneiro e deixe que os remetentes vejam aproximadamente onde está o carneiro que você carrega."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe que as pessoas próximas lhe entreguem seu carneiro e deixe que os remetentes vejam aproximadamente onde está o carneiro que você carrega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пусть люди поблизости протянут вам свой баран, а отправители пусть примерно видят, где находится баран, который вы несете."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lăsați-i pe cei din apropiere să vă înmâneze berbecul și lăsați-i expeditorilor să vadă aproximativ unde este un berbec pe care îl transportați."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechajte ľudí nablízku, aby vám odovzdali barana, a nechajte odosielateľov, aby približne videli, kde sa baran, ktorý nosíte, nachádza."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naj vam ljudje v bližini predajo svojega ovna, pošiljatelji pa naj približno vidijo, kje je oven, ki ga nosite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lërini njerëzit aty pranë t'ju japin dashin e tyre dhe lërini dërguesit të shohin afërsisht se ku është një dash që mbani."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Нека вам људи у близини дају свог овна и нека пошиљаоци отприлике виде где је ован којег носите."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้คนที่อยู่ใกล้ๆ มอบแกะให้กับคุณ และให้ผู้ส่งดูว่าแกะที่คุณบรรทุกอยู่ที่ไหน"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt personer i närheten ge dig sin bagge och låt avsändare se ungefär var en bagge du bär är."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınınızdaki kişilerin koçlarını size vermelerine izin verin ve gönderenlerin, taşıdığınız koçun kabaca nerede olduğunu görmelerine izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нехай люди, які знаходяться поблизу, простягають вам свого барана, а відправники нехай приблизно бачать, де знаходиться баран, який ви несете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让附近的人将他们的公羊交给您，并让发送者大致了解您携带的公羊的位置。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy để những người ở gần đưa cho bạn ram của họ và cho người gửi biết đại khái ram mà bạn mang theo ở đâu."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "讓附近的人將他們的公羊交給您，並讓發送者大致了解您攜帶的公羊的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Let people nearby hand you their ram, and let senders see roughly where a ram you carry is."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let people nearby hand you their ram, and let senders see roughly where a ram you carry is."
          }
        }
      }
    },
