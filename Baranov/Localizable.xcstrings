        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ أرسل لك رسالة عبر بارانوف. في التطبيق، افتح حقيبة البريد واكتب علامة الأذن هذه: %@ . نفس علامة الأذن تفتح الختم عند وصول الكبش."
