        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ צועד אל השער של %@ במדרגות שלך. זה נוחת בשקית הדואר שלהם כשהוא מגיע לשם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ आपके कदमों पर %@ के गेट तक चलता है। वहां पहुंचने पर यह उनके मेलबैग में पहुंच जाता है।"
