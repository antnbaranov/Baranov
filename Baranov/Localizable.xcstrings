        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum selangkah lagi. Rumput di sini nampaknya sangat baik."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għadu mhux pass wieħed. Il-ħaxix hawn jidher li huwa eċċellenti."
