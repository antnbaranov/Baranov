        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წერილი კვლავ მოდის ფეხით, როგორც ყოველთვის - ის უბრალოდ არ გაშიფრავს ამ მომენტამდე, თუნდაც მარჯვენა ყურის ნიშნით."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편지는 여전히 평소처럼 도보로 도착합니다. 오른쪽 귀 태그를 사용해도 이 순간 이전에는 해독되지 않습니다."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хат әдеттегідей жаяу келеді — ол осы уақытқа дейін, тіпті оң жақ құлақшамен де шифрын ашпайды."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laiškas vis tiek atkeliauja pėsčiomis, kaip įprasta – jis tiesiog nebus iššifruotas iki šios akimirkos, net ir su dešiniuoju ausies įsagu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēstule joprojām tiek saņemta kājām, kā parasti — tā vienkārši netiks atšifrēta pirms šī brīža, pat ar labo krotāli."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Писмото сепак пристигнува пешки како и обично - едноставно нема да се дешифрира пред овој момент, дури и со десното уво."
          }
        },
        "ms": {
