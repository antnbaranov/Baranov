    "Out after dark. Spooky. Fluffy. Still on time.": {
      "comment": "A description of a feat when the user has done it.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Навън след свечеряване. Призрачен. Пухкав. Все още навреме."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortir després de fosc. Esgarrifós. Esponjosa. Encara a temps."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napolju nakon mraka. Sablasno. Fluffy. Još uvek na vreme."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخروج بعد حلول الظلام. مجفل. رقيق. لا يزال في الوقت المحدد."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ud efter mørkets frembrud. Uhyggeligt. Fluffy. Stadig til tiden."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ven po setmění. Strašidelný. Načechraný. Stále včas."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Out after dark. Spooky. Fluffy. Still on time."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Out after dark. Spooky. Fluffy. Still on time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Out after dark. Spooky. Fluffy. Still on time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Raus nach Einbruch der Dunkelheit. Gruselig. Flaumig. Immer noch pünktlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έξω μετά το σκοτάδι. Στοιχειωμένος. Χνουδωτός. Ακόμα στην ώρα τους."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera después del anochecer. Escalofriante. Esponjoso. Aún a tiempo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera después del anochecer. Escalofriante. Esponjoso. Aún a tiempo."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Iluntzean atera. Beldurra. Fluffy. Oraindik garaiz."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väljas peale pimedat. Õudne. Kohev. Ikka õigel ajal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortir après la tombée de la nuit. Fantasmagorique. Duveteux. Toujours à l'heure."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortir après la tombée de la nuit. Fantasmagorique. Duveteux. Toujours à l'heure."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulkona pimeän jälkeen. Pelottava. Pörröinen. Edelleen ajoissa."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Amach tar éis dorcha. Spooky. Clúmhach. Fós ar an am."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fóra despois do anoitecer. Asustado. Fluffy. Aínda a tempo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לצאת אחרי רדת החשיכה. מַפְחִיד. מוֹכִי. עדיין בזמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंधेरा होने के बाद बाहर. डरावना. रोएँदार। अभी भी समय पर है."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vani nakon mraka. Sablastan. Paperjast. Još na vrijeme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sötétedés után kint. Kísérteties. Bolyhos. Még időben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar setelah gelap. Seram. Empuk. Masih tepat waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuori dopo il tramonto. Sinistro. Soffice. Ancora in tempo."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Út eftir myrkur. Skelfilegt. Dúnkenndur. Enn á réttum tíma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗くなってから外出。不気味な。ふわふわ。まだ間に合います。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გარეთ დაბნელების შემდეგ. საშინელი. ფუმფულა. ჯერ კიდევ დროზე."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қараңғыдан кейін. Қорқынышты. Үлпілдек. Әлі уақытында."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어두워진 후에 나가세요. 유령 같은. 솜털 같은. 아직 제 시간에 맞춰요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išeina sutemus. Baisu. Pūkuotas. Vis tiek laiku."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ārā pēc tumsas. Spokains. Pūkains. Joprojām laikā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Излезе по стемнување. Застрашувачки. Меки. Сè уште на време."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar selepas gelap. Seram. gebu. Masih menepati masa."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Barra wara d-dlam. Spooky. Fluffy. Għadu fil-ħin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ut etter mørkets frembrudd. Spooky. Fluffy. Fremdeles i tide."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buiten in het donker. Spookachtig. Pluizig. Nog steeds op tijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyjście po zmroku. Upiorny. Puszyste. Wciąż na czas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair depois de escurecer. Assustador. Fofinho. Ainda na hora certa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair depois de escurecer. Assustador. Fofinho. Ainda na hora certa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выходим после наступления темноты. Жуткий. Пушистый. Все еще вовремя."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afară după întuneric. Înfricoșător. Pufos. Încă la timp."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zotmení von. Strašidelné. Načechraný. Stále načas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ven po temi. Strašljivo. Puhasto. Še pravočasno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Jashtë pas errësirës. E frikshme. Me gëzof. Ende në kohë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Напољу после мрака. Сабласно. Флуффи. Још увек на време."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกหลังมืด. น่ากลัว ปุย. ยังทันอยู่ครับ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ut efter mörkrets inbrott. Spöklik. Fluffig. Fortfarande i tid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava karardıktan sonra dışarıda. Hayalet gibi. Kabarık. Hala zamanında."
