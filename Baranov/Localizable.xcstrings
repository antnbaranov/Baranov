            "value" : "Вашите овни са изминали %@ досега."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaši ovnovi su hodali %@ do sada."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els teus ariets han caminat %@ fins ara."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaši berani zatím chodili %@."
          }
        },
        "da" : {
          "stringUnit" : {
