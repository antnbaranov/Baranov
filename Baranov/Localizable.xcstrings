    "Crossed water anyway. Has opinions about it.": {
      "comment": "A description of a feat that is unlocked when the user has crossed a body of water.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aigua creuada de totes maneres. Té opinions al respecte."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все пак пресечена вода. Има мнения за това."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U svakom slučaju prešao vodu. Ima mišljenja o tome."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عبرت المياه على أي حال. لديه آراء حول هذا الموضوع."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Krydsede vand alligevel. har meninger om det."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každopádně přes vodu. Má na to názory."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Crossed water anyway. Has opinions about it."
          }
        },
        "en-CA": {
