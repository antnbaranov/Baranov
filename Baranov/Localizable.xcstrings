    "Nothing on the way to you. Shake phones with a sender, or enter a code.": {
      "extractionState": "stale",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не идёт к вам. Встряхните телефоны с отправителем или введите код."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не йде до вас. Струсніть телефони з відправником або введіть код."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо по пътя към теб. Свържете се с подателя или въведете код."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Res de camí cap a tu. Sacseja els telèfons amb un remitent o introdueix un codi."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa na putu do tebe. Protresite telefone sa pošiljaocem ili unesite kod."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء في الطريق إليك هز الهواتف مع المرسل، أو أدخل الرمز."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet på vej til dig. Ryst telefoner med en afsender, eller indtast en kode."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic na cestě k vám. Zatřeste telefonem s odesílatelem nebo zadejte kód."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing on the way to you. Shake phones with a sender, or enter a code."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing on the way to you. Shake phones with a sender, or enter a code."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing on the way to you. Shake phones with a sender, or enter a code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts auf dem Weg zu Ihnen. Schütteln Sie die Telefone mit einem Absender oder geben Sie einen Code ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα στο δρόμο προς εσάς. Ανακινήστε τα τηλέφωνα με έναν αποστολέα ή πληκτρολογήστε έναν κωδικό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada en camino hacia ti. Agite los teléfonos con un remitente o ingrese un código."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada en camino hacia ti. Agite los teléfonos con un remitente o ingrese un código."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezer ez zure bidean. Astindu telefonoak igorle batekin edo sartu kode bat."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitte midagi ei ole teie poole teel. Raputage telefone saatjaga või sisestage kood."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien sur le chemin vers toi. Secouez les téléphones avec un expéditeur ou entrez un code."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien sur le chemin vers toi. Secouez les téléphones avec un expéditeur ou entrez un code."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei mitään matkalla luoksesi. Ravista puhelimia lähettäjän kanssa tai anna koodi."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní dhéanfaidh aon ní ar an mbealach chun tú. Croith fóin le seoltóir, nó cuir isteach cód."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada camiño de ti. Axita os teléfonos cun remitente ou introduce un código."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא בדרך אליך. נער טלפונים עם שולח, או הזן קוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके रास्ते में कुछ भी नहीं. प्रेषक से फ़ोन मिलाएँ, या एक कोड दर्ज करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa na putu do tebe. Razgovarajte s pošiljateljem ili unesite kod."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi az úton hozzád. Rázza fel a telefont a feladóval, vagy írjon be egy kódot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada apa pun dalam perjalanan menuju Anda. Goyangkan ponsel dengan pengirim, atau masukkan kode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente sulla strada per te. Scuoti i telefoni con un mittente o inserisci un codice."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert á leiðinni til þín. Hristu síma með sendanda eða sláðu inn kóða."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたに向かう途中には何もありません。送信者と電話を振るか、コードを入力します。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენსკენ მიმავალ გზაზე არაფერია. შეანჯღრიეთ ტელეფონები გამგზავნთან ან შეიყვანეთ კოდი."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сізге баратын жолда ештеңе жоқ. Жіберушімен телефондарды шайқаңыз немесе кодты енгізіңіз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신에게 가는 길에는 아무것도 없습니다. 발신자와 전화를 흔들거나 코드를 입력하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieko pakeliui pas tave. Pakratykite telefonus su siuntėju arba įveskite kodą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekas pa ceļam pie tevis. Kratiet tālruņus ar sūtītāju vai ievadiet kodu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ништо на патот до тебе. Протресете ги телефоните со испраќач или внесете код."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa dalam perjalanan ke anda. Goncang telefon dengan pengirim, atau masukkan kod."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Xejn fit-triq lejk. Ħawwad it-telefowns ma' min jibgħat, jew daħħal kodiċi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting på vei til deg. Rist telefoner med en avsender, eller skriv inn en kode."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets onderweg naar jou. Schud telefoons met een afzender of voer een code in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic po drodze do ciebie. Potrząśnij telefonem z nadawcą lub wprowadź kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada no caminho para você. Agite os telefones com um remetente ou digite um código."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada no caminho para você. Agite os telefones com um remetente ou digite um código."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic în drum spre tine. Scuturați telefoanele cu un expeditor sau introduceți un cod."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing on the way to you. Shake phones with a sender, or enter a code."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič na poti do vas. Povežite se s pošiljateljem ali vnesite kodo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Asgjë në rrugën drejt jush. Shkundni telefonat me një dërgues ose futni një kod."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ништа на путу до тебе. Протресите телефоне са пошиљаоцем или унесите код."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอะไรระหว่างทางไปหาคุณ เขย่าโทรศัพท์กับผู้ส่งหรือป้อนรหัส"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget på vägen till dig. Skaka telefoner med en avsändare eller ange en kod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana giden yolda hiçbir şey yok. Telefonları gönderenle sallayın veya bir kod girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有任何东西在给你的路上。与发件人摇晃手机，或输入代码。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì trên đường đến với bạn. Lắc điện thoại với người gửi hoặc nhập mã."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有任何東西在給你的路上。與寄件者搖晃手機，或輸入代碼。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有任何東西在給你的路上。與寄件者搖晃手機，或輸入代碼。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing on the way to you. Shake phones with a sender, or enter a code."
          }
        }
      }
