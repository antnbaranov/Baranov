    "Five rams, every wax. Thank you for keeping a slow post alive.": {
      "comment": "A description of the benefits of owning a ram.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وخمسة كباش كل شمع. شكرا لك على الحفاظ على وظيفة بطيئة على قيد الحياة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пет овена, всеки восък. Благодаря ви, че поддържате бавен пост жив."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pet ovnova, svaki vosak. Hvala vam što održavate spori post živim."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinc ariets, cada cera. Gràcies per mantenir viva una publicació lenta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pět beranů, každý vosk. Děkuji za udržení pomalého příspěvku naživu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fem væddere, hver voks. Tak fordi du holder et langsomt indlæg i live."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Widder, jeder Wachs. Vielen Dank, dass Sie einen langsamen Beitrag am Leben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πέντε κριάρια, κάθε κερί. Σας ευχαριστούμε που κρατήσατε ζωντανή μια αργή ανάρτηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five rams, every wax. Thank you for keeping a slow post alive."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Five rams, every wax. Thank you for keeping a slow post alive."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Five rams, every wax. Thank you for keeping a slow post alive."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Five rams, every wax. Thank you for keeping a slow post alive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco carneros, cada cera. Gracias por mantener viva una publicación lenta."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco carneros, cada cera. Gracias por mantener viva una publicación lenta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Viis jäära, iga vaha. Täname teid aeglase postituse elushoidmise eest."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bost ahari, argizaria bakoitza. Eskerrik asko mezu motela bizirik mantentzeagatik."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viisi pässiä, jokainen vaha. Kiitos, että pidät hitaan postauksen hengissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq béliers, chaque cire. Merci d'avoir gardé un message lent en vie."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq béliers, chaque cire. Merci d'avoir gardé un message lent en vie."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cúig reithe, gach céir. Go raibh maith agat as post mall a choinneáil beo."
