        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est sous Entrant. Il atterrit dans ton sac postal lorsque le bélier atteint la porte."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est sous Entrant. Il atterrit dans ton sac postal lorsque le bélier atteint la porte."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá sé faoi Isteach. Tuirlingíonn sé i do mhála poist nuair a shroicheann an reithe an geata."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está en Entrante. Aterra na túa bolsa de correo cando o carneiro chega á porta."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה תחת 'נכנס'. זה נוחת בשקית הדואר שלך כשהאיל מגיע לשער."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह इनकमिंग के अंतर्गत है। जब रैम गेट पर पहुंचता है तो यह आपके मेलबैग में आ जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nalazi se pod Incoming. Slijeće u vašu poštansku torbu kada ovan stigne do vrata."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Bejövő alatt van. A postatáskádban landol, amikor a kos eléri a kaput."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itu ada di bawah Masuk. Itu mendarat di tas surat Anda ketika domba jantan itu mencapai gerbang."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Það er undir Innkomandi. Það lendir í póstpokanum þínum þegar hrúturinn kemur að hliðinu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È sotto In arrivo. Atterrerà nel tuo sacco della posta quando l'ariete raggiunge il cancello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「受信」の下にあります。ラムがゲートに到着すると、郵便物は郵便袋に入ります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ეს არის შემომავალი. ის ხვდება თქვენს საფოსტო ჩანთაში, როდესაც ვერძი ჭიშკარს მიაღწევს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ол Кіріс астында. Қошқар қақпаға жеткенде ол сіздің пошта сөмкеңізге түседі."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수신 아래에 있습니다. 숫양이 게이트에 도착하면 우편 가방에 들어갑니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jis yra skiltyje „Incoming“. Jis patenka į jūsų pašto dėžutę, kai avinas pasiekia vartus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas atrodas sadaļā Ienākošie. Tas iekrīt jūsu pasta somā, kad auns sasniedz vārtus."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тоа е под Дојдовни. Слетува во вашата поштенска торба кога овенот ќе стигне до портата."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia berada di bawah Masuk. Ia mendarat di dalam beg mel anda apabila ram itu sampai ke pintu pagar."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huwa taħt Incoming. Tinżel fil-mailbag tiegħek meta l-muntun jilħaq il-bieb."
