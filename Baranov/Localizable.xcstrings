        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mhux se tara %@ aktar bħala kurrier salvat. In-nota tal-vjaġġ tagħhom u d-dettalji tal-ewwel iltaqgħu magħhom imorru magħhom."
