          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค้นหาจดหมายประจำเมืองถึงคุณควรเดินไป มีเพียงเมืองเท่านั้นที่แบ่งปัน"
