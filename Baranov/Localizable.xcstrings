    "They'll see it the next time Baranov is open. There's nothing to send them.": {
      "comment": "A description of the result of sending a letter by code.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще го видят следващия път, когато Баранов е отворен. Няма какво да им пратя."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho veuran la propera vegada que Baranov estigui obert. No hi ha res per enviar-los."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف يرون ذلك في المرة القادمة التي يفتح فيها بارانوف أبوابه. لا يوجد شيء لإرسالهم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Videće to sledeći put kada Baranov bude otvoren. Nemate šta da im pošaljete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De vil se det næste gang Baranov er åben. Der er ikke noget at sende dem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvidí to, až bude Baranov příště otevřený. Není co jim poslat."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "They'll see it the next time Baranov is open. There's nothing to send them."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "They'll see it the next time Baranov is open. There's nothing to send them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "They'll see it the next time Baranov is open. There's nothing to send them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden es sehen, wenn Baranov das nächste Mal geöffnet ist. Es gibt nichts, was man ihnen schicken könnte."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo verán la próxima vez que abra Baranov. No hay nada que enviarles."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα το δουν την επόμενη φορά που θα ανοίξει ο Baranov. Δεν υπάρχει τίποτα να τους στείλεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo verán la próxima vez que abra Baranov. No hay nada que enviarles."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov zabalik dagoen hurrengoan ikusiko dute. Ez dago ezer bidaltzeko."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad näevad seda järgmisel korral, kui Baranov on avatud. Neile pole midagi saata."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils le verront la prochaine fois que Baranov ouvrira. Il n'y a rien à leur envoyer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils le verront la prochaine fois que Baranov ouvrira. Il n'y a rien à leur envoyer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "He näkevät sen seuraavan kerran, kun Baranov on auki. Niille ei ole mitään lähetettävää."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Feicfidh siad é an chéad uair eile a bheidh Baranov oscailte. Níl aon rud chun iad a sheoladh."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verano a próxima vez que Baranov estea aberta. Non hai nada que mandalos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הם יראו את זה בפעם הבאה שברנוב יהיה פתוח. אין מה לשלוח להם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली बार जब बारानोव खुलेगा तो वे इसे देखेंगे। उन्हें भेजने के लिए कुछ भी नहीं है."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidjet će kad sljedeći put Baranov bude otvoren. Nema im što poslati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Majd meglátják, amikor Baranov legközelebb nyitva lesz. Nincs mit küldeni nekik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mereka akan melihatnya saat Baranov buka lagi. Tidak ada yang perlu dikirim kepada mereka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo vedranno la prossima volta che Baranov aprirà. Non c'è niente da inviare loro."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þeir sjá það næst þegar Baranov er opinn. Það er ekkert að senda þeim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回バラノフがオープンしたときに彼らはそれを見るでしょう。彼らに送るものは何もありません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ისინი ამას ნახავენ შემდეგ ჯერზე, როდესაც ბარანოვი ღია იქნება. მათ გასაგზავნად არაფერია."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 Baranov가 열릴 때 보게 될 것입니다. 보낼 것이 없습니다."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Олар оны келесі жолы Баранов ашқанда көреді. Оларды жіберетін ештеңе жоқ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jie tai pamatys kitą kartą, kai Baranovas bus atidarytas. Nėra ko jų siųsti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Viņi to redzēs nākamreiz, kad Baranovs būs atvērts. Nav ko viņus sūtīt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ќе го видат следниот пат кога Баранов ќе биде отворен. Нема што да им се испрати."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mereka akan melihatnya apabila Baranov dibuka seterusnya. Tiada apa-apa untuk menghantar mereka."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarawha d-darba li jmiss Baranov ikun miftuħ. M'hemm xejn li tibgħathom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De får se det neste gang Baranov er åpen. Det er ingenting å sende dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze zullen het zien de volgende keer dat Baranov open is. Er is niets om ze te sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobaczą to następnym razem, gdy Baranov będzie otwarty. Nie ma co ich wysyłać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles verão isso na próxima vez que Baranov abrir. Não há nada para enviá-los."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles verão isso na próxima vez que Baranov abrir. Não há nada para enviá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они увидят это, когда в следующий раз откроется Баранов. Им нечего отправлять."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O vor vedea data viitoare când Baranov va fi deschis. Nu e nimic de trimis."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvidia to najbližšie, keď bude Baranov otvorený. Niet im čo poslať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Videli bodo naslednjič, ko bo Baranov odprt. Nič jim ni za poslati."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ata do ta shohin herën tjetër që Baranov të jetë i hapur. Nuk ka asgjë për t'i dërguar."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Видеће то следећи пут када Баранов буде отворен. Нема шта да им се пошаље."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พวกเขาจะเห็นมันในครั้งต่อไปที่ Baranov เปิด ไม่มีอะไรจะส่งให้พวกเขา"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De kommer att se det nästa gång Baranov är öppen. Det finns inget att skicka dem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov'un bir sonraki açılışında bunu görecekler. Onlara gönderecek hiçbir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вони це побачать наступного разу, коли Баранов відкриється. Нема чого їх посилати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
