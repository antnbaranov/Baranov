    "Apple Maps text and system prompts switch to the new language after you restart Baranov." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطالب نظام ونص خرائط Apple بالتبديل إلى اللغة الجديدة بعد إعادة تشغيل Baranov."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текстът на Apple Maps и системните подкани превключват на новия език, след като рестартирате Baranov."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst i sistemska uputstva Apple Maps prelaze na novi jezik nakon što ponovo pokrenete Baranov."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El text d'Apple Maps i les indicacions del sistema canvien al nou idioma després de reiniciar Baranov."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text a systémové výzvy Apple Maps se po restartu Baranov přepnou do nového jazyka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Maps-tekst og systemmeddelelser skifter til det nye sprog, når du genstarter Baranov."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte in Apple Karten und Systemabfragen wechseln nach einem Neustart von Baranov die Sprache."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα μηνύματα κειμένου και συστήματος των Χαρτών Apple αλλάζουν στη νέα γλώσσα μετά την επανεκκίνηση του Baranov."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Maps text and system prompts switch to the new language after you restart Baranov."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Maps text and system prompts switch to the new language after you restart Baranov."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Maps text and system prompts switch to the new language after you restart Baranov."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Maps text and system prompts switch to the new language after you restart Baranov."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes de texto y del sistema de Apple Maps cambian al nuevo idioma después de reiniciar Baranov."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes de texto y del sistema de Apple Maps cambian al nuevo idioma después de reiniciar Baranov."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Mapsi teksti- ja süsteemiviibad lülituvad pärast Baranovi taaskäivitamist uuele keelele."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baranov berrabiarazi ondoren Apple Maps-en testua eta sistemaren abisuak hizkuntza berrira aldatzen dira."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Maps -teksti- ja järjestelmäkehotteet vaihtavat uuteen kieleen, kun käynnistät Baranovin uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte et les invites du système Apple Maps passent à la nouvelle langue après le redémarrage de Baranov."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte et les invites du système Apple Maps passent à la nouvelle langue après le redémarrage de Baranov."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aistríonn leideanna téacs agus córais Apple Maps go dtí an teanga nua tar éis duit Baranov a atosú."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O texto de Apple Maps e as indicacións do sistema cambian ao novo idioma despois de reiniciar Baranov."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הטקסט של מפות Apple והנחיות המערכת עוברות לשפה החדשה לאחר הפעלה מחדש של Baranov."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बारानोव को पुनरारंभ करने के बाद ऐप्पल मैप्स टेक्स्ट और सिस्टम संकेत नई भाषा पर स्विच करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst i upiti sustava Apple Maps prebacuju se na novi jezik nakon ponovnog pokretanja Baranova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Baranov újraindítása után az Apple Maps szöveges és rendszerüzenetei átváltanak az új nyelvre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks Apple Maps dan perintah sistem beralih ke bahasa baru setelah Anda memulai ulang Baranov."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Maps texti og kerfistilkynningar skipta yfir í nýja tungumálið eftir að þú endurræsir Baranov."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo di Apple Maps e le istruzioni di sistema passano alla nuova lingua dopo aver riavviato Baranov."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baranov を再起動すると、Apple マップのテキストとシステム プロンプトが新しい言語に切り替わります。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Maps-ის ტექსტი და სისტემური მოთხოვნილებები გადართეთ ახალ ენაზე Baranov-ის გადატვირთვის შემდეგ."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baranov қайта іске қосылғаннан кейін Apple Maps мәтіні мен жүйелік шақырулары жаңа тілге ауысады."
