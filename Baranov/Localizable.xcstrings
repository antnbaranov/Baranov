    "Do not hurry; the letter will arrive when it arrives." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتعجل؛ سوف تصل الرسالة عندما تصل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не бързайте; писмото ще пристигне, когато пристигне."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne žurite; pismo će stići kada stigne."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tinguis pressa; la carta arribarà quan arribi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nespěchejte; dopis dorazí, až dorazí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skynd dig ikke; brevet kommer når det kommer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eile nicht; der Brief kommt an, wenn er ankommt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μην βιάζεστε. το γράμμα θα φτάσει όταν φτάσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not hurry; the letter will arrive when it arrives."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not hurry; the letter will arrive when it arrives."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not hurry; the letter will arrive when it arrives."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not hurry; the letter will arrive when it arrives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No te apresures; la carta llegará cuando llegue."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No te apresures; la carta llegará cuando llegue."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ärge kiirustage; kiri tuleb siis, kui saabub."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez presarik egin; gutuna iristen denean iritsiko da."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älä kiirehdi; kirje tulee kun se saapuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne te presse pas ; la lettre arrivera quand elle arrivera."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne te presse pas ; la lettre arrivera quand elle arrivera."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ná déan deifir; tiocfaidh an litir nuair a thiocfaidh sí."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non teñas présa; a carta chegará cando chegue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אל תמהר; המכתב יגיע כשהוא יגיע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जल्दी न करो; पत्र आने पर आ जायेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne žurite; pismo će stići kad stigne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne siess; a levél megérkezik, amikor megérkezik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan terburu-buru; surat itu akan sampai ketika sudah tiba."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki flýta þér; bréfið kemur þegar það kemur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non avere fretta; la lettera arriverà quando arriverà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "急がないでください。手紙は届く頃に届くでしょう。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "არ იჩქარო; წერილი ჩამოვა, როცა მოვა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Асықпаңыз; хат келген кезде келеді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서두르지 마십시오. 편지가 도착하면 도착할 거예요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neskubėkite; laiškas ateis, kai gausis."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesteidzieties; vēstule atnāks, kad tā pienāks."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не брзајте; писмото ќе пристигне кога ќе пристигне."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jangan tergesa-gesa; surat akan sampai bila sampai."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tgħaġġelx; l-ittra tasal meta tasal."
          }
        },
        "nb" : {
          "stringUnit" : {
