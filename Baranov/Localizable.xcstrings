            "value": "Kindly keep trotting. Best regards."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte traben Sie weiter. Beste grüße."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακαλώ, συνεχίστε να τρέχετε. Με εκτίμηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, sigue trotando. Atentamente."
