        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Surat yang menunggu serah terima dapat dikirimkan melalui AirDropp langsung ke siapa pun di sini yang tujuannya cocok, atau berada dalam jarak 800 km dari tujuan sebenarnya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bréf sem bíður eftir sendingu er hægt að senda beint til allra hér sem er áfangastaður sem samsvarar, eða er innan við 800 km frá, þangað sem það er í raun að fara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lettera in attesa può essere inviata via AirDrop a chiunque qui la cui destinazione corrisponda o sia entro 800 km."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受け渡しを待っている手紙は、目的地が一致するか、実際の目的地から 800 km 以内にいる人であれば誰にでも直接 AirDrop することができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전달을 기다리는 편지는 목적지가 일치하거나 실제로 가는 곳에서 800km 이내에 있는 사람에게 바로 AirDrop될 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laiškas, laukiantis perdavimo, gali būti „AirDropped“ tiesiai visiems čia esantiems, kurių kelionės tikslas sutampa arba yra 800 km atstumu nuo to, kur jis iš tikrųjų eina."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēstuli, kas gaida nodošanu, AirDropped var nosūtīt tieši ikvienam šeit esošajam, kura galamērķis sakrīt vai atrodas 800 km attālumā no tā, kur tā faktiski nonāk."
