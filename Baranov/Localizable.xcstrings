        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подайте овен на някого на крайбрежие или граница."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predajte ovna nekome na obali ili granici."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lliurar un ariet a algú en una costa o frontera."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podej berana někomu na pobřeží nebo na hranici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv en vædder til nogen ved en kyst eller grænse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übergib einen Widder an der Küste oder Grenze an jemanden."
