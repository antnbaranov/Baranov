          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los carneros que ya estén caminando terminarán su viaje de todos modos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los carneros que ya estén caminando terminarán su viaje de todos modos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juba kõndivad jäärad lõpetavad oma teekonna mõlemal viisil."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagoeneko oinez dabiltzan ahariek bidaia edo ala biak amaitzen dute."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jo kävelevät pässit päättävät matkansa kumpaankin suuntaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les béliers déjà en route termineront leur voyage dans tous les cas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les béliers déjà en route termineront leur voyage dans tous les cas."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Críochnaíonn reithí atá ag siúl cheana féin a dturas ceachtar slí."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os carneiros que xa andan rematan a súa viaxe de calquera xeito."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אילים שכבר הולכים מסיימים את מסעם לכל כיוון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "राम पहले से ही चल रहे हैं और किसी भी तरह से अपनी यात्रा समाप्त करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovnovi koji već hodaju završavaju svoje putovanje u bilo kojem smjeru."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A már sétáló kosok mindkét irányban befejezik útjukat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rams sudah berjalan menyelesaikan perjalanannya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hrútar sem þegar eru að ganga klára ferð sína á hvorn veginn sem er."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli arieti già in cammino completeranno comunque il loro viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに歩き始めている牡羊は、そのまま旅を完了します。"
