    "Your pasture is full. Free a slot or expand the pasture, then try again.": {
      "comment": "A warning when the user tries to send a letter but their pasture is full.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пасището ви е пълно. Освободете слот или разширете пасището, след което опитайте отново."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva pastura està plena. Allibera una ranura o amplia la pastura i torna-ho a provar."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš pašnjak je pun. Oslobodite mjesto ili proširite pašnjak, a zatim pokušajte ponovo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراعيك ممتلئة. قم بتحرير فتحة أو توسيع المرعى، ثم حاول مرة أخرى."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din græsgang er fuld. Frigør en plads, eller udvid græsmarken, og prøv derefter igen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše pastva je plná. Uvolněte místo nebo rozšiřte pastvinu a zkuste to znovu."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pasture is full. Free a slot or expand the pasture, then try again."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pasture is full. Free a slot or expand the pasture, then try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pasture is full. Free a slot or expand the pasture, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Weide ist voll. Machen Sie einen Platz frei oder erweitern Sie die Weide und versuchen Sie es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pasto está lleno. Libera un espacio o amplía el pasto y vuelve a intentarlo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pasto está lleno. Libera un espacio o amplía el pasto y vuelve a intentarlo."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το λιβάδι σου είναι γεμάτο. Ελευθερώστε μια υποδοχή ή επεκτείνετε το βοσκότοπο και, στη συνέχεια, δοκιμάστε ξανά."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teie karjamaa on täis. Vabastage pesa või laiendage karjamaad, seejärel proovige uuesti."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zure larrea beteta dago. Askatu zirrikitu bat edo zabaldu larrea, eta saiatu berriro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre pâturage est plein. Libérez un emplacement ou agrandissez le pâturage, puis réessayez."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre pâturage est plein. Libérez un emplacement ou agrandissez le pâturage, puis réessayez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitumesi on täynnä. Vapauta paikka tai laajenna laitumaa ja yritä sitten uudelleen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá do féarach lán. Saor sliotán nó leathnaigh an féarach, ansin bain triail eile as."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu pasto está cheo. Libera un espazo ou expande o pasto e téntao de novo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המרעה שלך מלא. שחרר משבצת או הרחב את המרעה, ואז נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हारा चारागाह भर गया है. एक स्लॉट खाली करें या चारागाह का विस्तार करें, फिर पुनः प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj je pašnjak pun. Oslobodite utor ili proširite pašnjak, a zatim pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tele a legelőd. Szabadítson fel egy rést, vagy bővítse ki a legelőt, majd próbálkozzon újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Padang rumputmu penuh. Kosongkan satu slot atau perluas padang rumputnya, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo pascolo è pieno. Libera uno slot o espandi il pascolo, quindi riprova."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagurinn þinn er fullur. Losaðu rifa eða stækkaðu hagann, reyndu svo aftur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの牧草地はいっぱいです。スロットを解放するか牧草地を拡張してから、もう一度お試しください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შენი საძოვარი სავსეა. გაათავისუფლეთ სლოტი ან გააფართოვეთ საძოვარი, შემდეგ სცადეთ ხელახლა."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 목초지가 가득 찼습니다. 슬롯을 비우거나 목초지를 확장한 후 다시 시도하세요."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жайылымыңыз толы. Слотты босатыңыз немесе жайылымды кеңейтіңіз, содан кейін әрекетті қайталаңыз."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavo ganykla pilna. Atlaisvinkite plyšį arba išplėskite ganyklą, tada bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu ganības ir pilnas. Atbrīvojiet vietu vai paplašiniet ganības, pēc tam mēģiniet vēlreiz."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашето пасиште е полно. Ослободете отвор или проширете го пасиштето, а потоа обидете се повторно."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padang rumput anda penuh. Kosongkan slot atau luaskan padang rumput, kemudian cuba lagi."
          }
