    "%@ left your mailbag. Thanks for carrying it this far." : {
      "comment" : "Notification body. The argument is the ram's name.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ترك حقيبة البريد الخاصة بك. شكرا لحملها إلى هذا الحد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ остави пощенската ви чанта. Благодаря, че го пренесохте дотук."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je napustio vašu poštansku torbu. Hvala što ste ga doveli ovako daleko."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha deixat la teva bossa de correu. Gràcies per portar-lo fins aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ opustil vaši poštovní tašku. Díky, že jste to dotáhli tak daleko."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ forlod din postpose. Tak fordi du tog det så langt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat deine Posttasche verlassen. Danke, dass du ihn so weit getragen hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο %@ έφυγε από την ταχυδρομική σας τσάντα. Ευχαριστώ που το μεταφέρατε ως εδώ."
          }
        },
        "en" : {
