          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošiljatelji u blizini vide vaše ime i prvo putovanje dok je ovaj ekran otvoren. Nikad tvoja pozicija."
          }
