        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su bolsa de correo ya contiene cartas %lld para otras personas. Entregue o entregue uno primero."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teie postikotis on juba teistele inimestele mõeldud %lld kirju. Esmalt tarnige või andke kätte."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zure posta-poltsak dagoeneko %lld letrak ditu beste pertsonentzat. Bat entregatu edo entregatu lehenengo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postilaukussasi on jo %lld kirjeitä muille ihmisille. Toimita tai luovuta yksi ensin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton sac postal contient déjà des lettres %lld pour d'autres personnes. Livrez ou remettez-en un en premier."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton sac postal contient déjà des lettres %lld pour d'autres personnes. Livrez ou remettez-en un en premier."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá litreacha %lld do dhaoine eile i do mhála poist cheana féin. Seachadadh nó tabhair ceann ar aghaidh ar dtús."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A túa bolsa de correo xa contén letras %lld para outras persoas. Entrega ou entrega un primeiro."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שקית הדואר שלך כבר מכילה אותיות %lld עבור אנשים אחרים. תחילה שלח או תמסור אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके मेलबैग में पहले से ही अन्य लोगों के लिए %lld अक्षर हैं। पहले एक को वितरित करें या सौंपें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša poštanska torba već sadrži %lld pisma za druge ljude. Prvo isporučite ili predajte jedan."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A postatáskája már tartalmaz %lld leveleket mások számára. Először szállítson vagy adjon át egyet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kantong surat Anda sudah berisi surat %lld untuk orang lain. Kirimkan atau serahkan terlebih dahulu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Póstpokinn þinn inniheldur nú þegar %lld stafi fyrir annað fólk. Afhenda eða afhenda einn fyrst."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo sacchetto della posta contiene già lettere %lld per altre persone. Consegnalo o consegnalo prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのメールバッグにはすでに他の人への %lld 手紙が入っています。まずは配達するか手渡してください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თქვენი საფოსტო ჩანთა უკვე შეიცავს %lld ასოებს სხვა ადამიანებისთვის. მიიტანეთ ან ჩააბარეთ ჯერ ერთი."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сіздің пошта сөмкеңізде басқа адамдар үшін %lld әріптері бар. Алдымен біреуін жеткізіңіз немесе тапсырыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "귀하의 우편함에 이미 다른 사람을 위한 %lld 편지가 들어 있습니다. 먼저 배달하거나 건네주세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsų pašto dėžutėje jau yra %lld laiškų, skirtų kitiems žmonėms. Pirmą kartą pristatykite arba pateikite vieną."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu pasta somā jau ir %lld vēstules citiem cilvēkiem. Vispirms piegādājiet vai nododiet vienu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашата поштенска торба веќе содржи %lld букви за други луѓе. Доставете го или предајте го прво."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beg mel anda sudah pun menyimpan surat %lld untuk orang lain. Hantar atau serahkan satu pada dahulu."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-borża tal-posta tiegħek diġà żżomm ittri %lld għal nies oħra. Ikkonsenja jew agħti waħda mill-ewwel."
