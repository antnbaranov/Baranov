    "Send it by Messages or AirDrop. %@ sees the whole journey, not what you read." : {
      "comment" : "Caption under the delivery receipt button. The argument is the sender's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسلها عبر الرسائل أو AirDrop.  يرى %@ الرحلة بأكملها، وليس ما تقرأه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изпратете го чрез Съобщения или AirDrop.  %@ вижда цялото пътуване, а не това, което четете."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošaljite ga putem poruka ili AirDropa.  %@ vidi cijelo putovanje, a ne ono što čitate."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envieu-lo per Missatges o AirDrop.  %@ veu tot el viatge, no el que llegeixes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošlete to pomocí zpráv nebo AirDrop.  %@ vidí celou cestu, ne to, co čtete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send det med beskeder eller AirDrop.  %@ ser hele rejsen, ikke hvad du læser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schick es per Nachrichten oder AirDrop. %@ sieht die ganze Reise, aber nicht, was du gelesen hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στείλτε το μέσω μηνυμάτων ή AirDrop.  Το %@ βλέπει όλο το ταξίδι, όχι αυτό που διαβάζετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send it by Messages or AirDrop. %@ sees the whole journey, not what you read."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send it by Messages or AirDrop. %@ sees the whole journey, not what you read."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send it by Messages or AirDrop. %@ sees the whole journey, not what you read."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send it by Messages or AirDrop. %@ sees the whole journey, not what you read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envíalo por Mensajes o AirDrop.  %@ ve todo el viaje, no lo que lees."
          }
        },
        "es-419" : {
