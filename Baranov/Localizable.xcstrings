    "It brought a postcard from %@. Hold to lift it out." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحضرت بطاقة بريدية من %@. عقد لرفعه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Донесе пощенска картичка от %@. Задръжте, за да го извадите."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donio je razglednicu sa %@. Zadržite da ga podignete."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va portar una postal de %@ . Mantingueu premut per aixecar-lo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přineslo to pohlednici od %@ . Podržením jej zvednete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det medbragte et postkort fra %@. Hold for at løfte den ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bringt eine Postkarte von %@. Halte gedrückt, um sie herauszunehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έφερε μια καρτ ποστάλ από την %@. Κρατήστε το για να το σηκώσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It brought a postcard from %@. Hold to lift it out."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It brought a postcard from %@. Hold to lift it out."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It brought a postcard from %@. Hold to lift it out."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It brought a postcard from %@. Hold to lift it out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traía una postal de %@. Manténgalo presionado para sacarlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traía una postal de %@. Manténgalo presionado para sacarlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See tõi %@-st postkaardi. Hoidke seda välja tõstmiseks."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-tik postal bat ekarri zuen. Eduki sakatuta altxatzeko."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se toi postikortin %@:lta. Pidä kiinni nostaaksesi sen ulos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a apporté une carte postale de %@. Maintiens pour le soulever."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a apporté une carte postale de %@. Maintiens pour le soulever."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thug sé cárta poist ó %@ . Coinnigh chun é a ardú."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traía unha postal de %@ . Mantén premido para levantalo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה הביא גלויה מ-%@. החזק כדי להרים אותו החוצה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह %@ से एक पोस्टकार्ड लाया। इसे बाहर निकालने के लिए पकड़ें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donijelo je razglednicu iz %@. Držite ga kako biste ga podigli."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Képeslapot hozott a %@-tól. Tartsa lenyomva, hogy kiemelje."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itu membawa kartu pos dari %@. Tahan untuk mengangkatnya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Það kom með póstkort frá %@. Haltu til að lyfta því út."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha portato una cartolina da %@. Tenere premuto per sollevarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@からポストカードを持ってきました。押して持ち上げて外します。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მას %@-დან საფოსტო ბარათი მოუტანა. გააჩერეთ, რომ ამოიღოთ იგი."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ол %@ сайтынан ашық хат әкелді. Оны көтеру үшін ұстап тұрыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 엽서를 가져왔습니다. 잡고 들어 올리세요."
          }
        },
        "lt" : {
