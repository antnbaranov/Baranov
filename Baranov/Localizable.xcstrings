    "%@ boards a packet there — or goes with anyone crossing sooner.": {
      "comment": "A message that appears in the \"hand off now\" section of the AirDrop suggestions card.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يصعد إلى هناك - أو يذهب مع أي شخص يعبر عاجلاً."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ качва пакет там — или отива с всеки, който пресича по-рано."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ukrcava paket tamo — ili ide sa bilo kim prije."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s'embarca en un paquet allà, o va amb qualsevol que creua abans."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tam vloží paket — nebo půjde s kýmkoli překročením dříve."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ går ombord på en pakke der - eller følger med nogen, der krydser tidligere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ steigt dort in ein Paket ein – oder geht mit jedem, der früher überquert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο %@ επιβιβάζεται σε ένα πακέτο εκεί — ή πηγαίνει με όποιον περνά νωρίτερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boards a packet there — or goes with anyone crossing sooner."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boards a packet there — or goes with anyone crossing sooner."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boards a packet there — or goes with anyone crossing sooner."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boards a packet there — or goes with anyone crossing sooner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aborda un paquete allí o acompaña a cualquiera que cruce antes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aborda un paquete allí o acompaña a cualquiera que cruce antes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ paneb sinna paki või läheb sellega, et keegi läheb varem üle."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pakete batera igotzen da bertan — edo lehenago zeharkatzen duen edonorrekin joaten da."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ astuu paketille siellä - tai lähtee kenen tahansa ylittävän aikaisemmin."
