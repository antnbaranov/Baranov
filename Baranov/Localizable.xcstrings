        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imtaten diġà mixi jispiċċaw il-vjaġġ tagħhom jew mod."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits wandernde Widder beenden ihre Reise in jedem Fall."
          }
