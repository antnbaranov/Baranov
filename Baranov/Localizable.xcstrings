            "value" : "מסעות חתומים, לצד המכתב. הם מגרדים אותו ברור לאחר פתיחת המכתב, לא לפני."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पत्र के साथ ट्रेवल्स को सील कर दिया गया। वे पत्र खोलने के बाद ही उसे कुरेदते हैं, पहले नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putovanje zapečaćeno, uz pismo. Zagrebu ga nakon otvaranja pisma, ne prije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utazások lepecsételve, a levél mellett. A levél felbontása után kaparják tisztára, előtte nem."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perjalanan disegel, di samping surat itu. Mereka menggaruknya dengan jelas setelah membuka surat itu, bukan sebelumnya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferðalög innsigluð, við hlið bréfsins. Þeir klóra það skýrt eftir að hafa opnað bréfið, ekki áður."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viaggio sigillato, insieme alla lettera. Lo cancellano dopo aver aperto la lettera, non prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手紙と一緒に封をして旅行します。彼らは手紙を開封する前ではなく、開封した後に傷をきれいに消します。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოგზაურობები დალუქული, წერილთან ერთად. წერილის გახსნის შემდეგ მკაფიოდ იჭრება და არა მანამდე."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хатпен бірге мөр басылған саяхаттар. Олар хатты алдында емес, ашқаннан кейін анық сызып тастайды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편지와 함께 봉인된 여행. 편지를 개봉하기 전이 아닌, 개봉 후 깨끗이 긁어줍니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelionės užantspauduotos, kartu su laišku. Jie aiškiai subraižo laišką atidarę, o ne anksčiau."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceļojumi aizzīmogoti, līdzās vēstulei. Viņi to noskrāpē pēc vēstules atvēršanas, nevis pirms tam."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Патувањата запечатени, покрај писмото. Јасно го гребат по отворањето на писмото, а не пред тоа."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perjalanan dimeterai, bersama surat itu. Mereka mencakarnya dengan jelas selepas membuka surat itu, bukan sebelum ini."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vjaġġi ssiġillati, flimkien mal-ittra. Huma scratch ċara wara li tiftaħ l-ittra, mhux qabel."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reiser forseglet, ved siden av brevet. De skraper det klart etter å ha åpnet brevet, ikke før."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reizen verzegeld, naast de brief. Ze krabben het duidelijk na het openen van de brief, niet eerder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podróże zapieczętowane, razem z listem. Zdrapują go wyraźnie po otwarciu listu, a nie przed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viagens seladas, junto com a carta. Eles riscam tudo depois de abrir a carta, não antes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viagens seladas, junto com a carta. Eles riscam tudo depois de abrir a carta, não antes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Călătorii sigilate, alături de scrisoare. O zgârie clar după deschiderea scrisorii, nu înainte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Путешествие запечатано вместе с письмом. Они царапают его после вскрытия письма, а не раньше."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cesty zapečatené spolu s listom. Po otvorení listu, nie skôr, ho poškriabu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potuje zapečatena, poleg pisma. Po odpiranju pisma ga jasno spraskajo, ne prej."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udhëtime të mbyllura, krahas letrës. E gërvishtin qartë pas hapjes së letrës, jo më parë."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Путовања запечаћена, уз писмо. Чисто га загребу након отварања писма, а не пре."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resor förseglade, bredvid brevet. De skrapar det klart efter att ha öppnat brevet, inte innan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดผนึกการเดินทางไว้ข้างจดหมาย พวกเขาเกาให้ชัดเจนหลังจากเปิดจดหมาย ไม่ใช่ก่อนหน้านี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mektubun yanında mühürlü seyahatler. Mektubu açtıktan sonra net bir şekilde çiziyorlar, önce değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подорожі запечатані, поруч із листом. Вони чітко дряпають його після відкриття листа, а не раніше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyến đi niêm phong, cùng với lá thư. Họ cào nó rõ ràng sau khi mở bức thư chứ không phải trước đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行密封，与信一起。他们在打开信之后而不是之前就把它擦干净了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行密封，與信一起。他們在打開信之後而不是之前就把它擦乾淨了。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行密封，與信一起。他們在打開信之後而不是之前就把它擦乾淨了。"
          }
        }
      }
    },
