    "%@ walks to %@'s gate on your steps. It lands in their mailbag when it gets there." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسير %@ إلى بوابة %@ على خطواتك. تهبط في حقيبة البريد الخاصة بهم عندما تصل إلى هناك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ отива до портата на %@ по вашите стъпала. Каца в пощенската им чанта, когато пристигне там."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hoda do kapije %@ na vašim stepenicama. Sleti u njihovu poštansku torbu kada stigne tamo."
