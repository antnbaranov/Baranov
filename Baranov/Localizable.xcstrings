    "Give it a name — it'll grow up carrying your letters, for as long as you keep Baranov.": {
      "comment": "Text describing the purpose of the onboarding page where the user can give their ram a name.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سمِّه اسماً — سينمو حاملاً رسائلك طالما تستخدم Baranov."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте му име — ще порасне, носейки писмата ви, докато държите Баранов."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dajte mu ime - odrastaće noseći vaša pisma, sve dok čuvate Baranova."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponle un nombre: crecerá llevando tus cartas mientras sigas usando Baranov."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojmenujte ho — vyroste při doručování vašich dopisů po celou dobu, co budete mít Baranov."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv den et navn — den vil vokse op med at bære dine breve, så længe du har Baranov."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ihm einen Namen — er wird wachsen und deine Briefe tragen, solange du Baranov nutzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δώστε του ένα όνομα — θα μεγαλώσει κουβαλώντας τα γράμματά σας για όσο καιρό έχετε το Baranov."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it a name — it'll grow up carrying your letters, for as long as you keep Baranov."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it a name — it'll grow up carrying your letters, for as long as you keep Baranov."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it a name — it'll grow up carrying your letters, for as long as you keep Baranov."
          }
        },
        "en-GB": {
