    "Opening the gate also asks to read your steps from Apple Health, so an Apple Watch counts too. Optional." : {
      "comment" : "A description of the app's health data usage.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب فتح البوابة أيضًا قراءة خطواتك من Apple Health، لذا فإن Apple Watch تحتسب أيضًا. خياري."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отварянето на вратата също изисква да се прочетат вашите стъпки от Apple Health, така че Apple Watch също се брои. Не е задължително."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvaranje kapije također traži da pročitate vaše korake iz Apple Healtha, tako da se računa i Apple Watch. Opciono."
          }
        },
        "ca" : {
          "stringUnit" : {
