    "Not one of your names? The ear tag code still opens it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس أحد أسماءك؟ لا يزال رمز علامة الأذن يفتحه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нито едно от вашите имена? Кодът на ушната марка все още го отваря."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni jedno od tvojih imena? Kod ušne markice ga i dalje otvara."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es diu cap dels teus? El codi de l'etiqueta de l'orella encara l'obre."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ani jedno z tvých jmen? Kód ušní značky jej stále otevírá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke et af dine navne? Øremærkekoden åbner den stadig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keiner deiner Namen? Der Ohrmarken-Code öffnet ihn trotzdem."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όχι ένα από τα ονόματά σας; Ο κωδικός του αυτιού εξακολουθεί να τον ανοίγει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not one of your names? The ear tag code still opens it."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not one of your names? The ear tag code still opens it."
          }
        },
