    "Opening the gate also asks to read your steps from Apple Health, so an Apple Watch counts too. Optional.": {
      "comment": "A description of the app's health data usage.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отварянето на вратата също изисква да се прочетат вашите стъпки от Apple Health, така че Apple Watch също се брои. Не е задължително."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrir la porta també demana llegir els vostres passos d'Apple Health, de manera que un Apple Watch també compta. Opcional."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvaranje kapije također traži da pročitate vaše korake iz Apple Healtha, tako da se računa i Apple Watch. Opciono."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب فتح البوابة أيضًا قراءة خطواتك من Apple Health، لذا فإن Apple Watch تحتسب أيضًا. خياري."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbning af lågen beder også om at læse dine trin fra Apple Health, så et Apple Watch tæller også. Valgfri."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevření brány také požádá o přečtení vašich kroků z Apple Health, takže se počítají i Apple Watch. Volitelný."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening the gate also asks to read your steps from Apple Health, so an Apple Watch counts too. Optional."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening the gate also asks to read your steps from Apple Health, so an Apple Watch counts too. Optional."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening the gate also asks to read your steps from Apple Health, so an Apple Watch counts too. Optional."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie das Tor öffnen, müssen Sie auch Ihre Schritte von Apple Health ablesen, daher zählt auch eine Apple Watch. Optional."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το άνοιγμα της πύλης ζητά επίσης να διαβάσετε τα βήματά σας από το Apple Health, επομένως ένα Apple Watch μετράει επίσης. Προαιρετικός."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir la puerta también se solicita leer tus pasos desde Apple Health, por lo que un Apple Watch también cuenta. Opcional."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Al abrir la puerta también se solicita leer tus pasos desde Apple Health, por lo que un Apple Watch también cuenta. Opcional."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Värava avamisel palutakse lugeda ka Apple Healthi samme, seega loeb ka Apple Watch. Valikuline."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Atea irekitzeak Apple Health-etik zure urratsak irakurtzea ere eskatzen du, beraz, Apple Watch batek ere balio du. Aukerakoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ouverture du portail demande également de lire vos pas auprès d'Apple Health, donc une Apple Watch compte également. Facultatif."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ouverture du portail demande également de lire vos pas auprès d'Apple Health, donc une Apple Watch compte également. Facultatif."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Portin avaaminen pyytää myös lukemaan askeleesi Apple Healthista, joten myös Apple Watchilla on merkitystä. Valinnainen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Má osclaíonn tú an geata iarrtar ort do chéimeanna ó Apple Health a léamh, mar sin tá Apple Watch san áireamh freisin. Roghnach."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao abrir a porta tamén se solicita que leas os teus pasos de Apple Health, polo que un Apple Watch tamén conta. Opcional."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחת השער גם מבקשת לקרוא את הצעדים שלך מ-Apple Health, כך שגם Apple Watch נחשב. אופציונלי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेट खोलने पर ऐप्पल हेल्थ से आपके कदमों को पढ़ने के लिए भी कहा जाता है, इसलिए ऐप्पल वॉच भी मायने रखती है। वैकल्पिक।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvaranje vrata također traži čitanje vaših koraka iz Apple Healtha, tako da se Apple Watch također računa. Neobavezno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kapu kinyitásakor a lépések beolvasását is kéri az Apple Health, így az Apple Watch is számít. Választható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka gerbang juga meminta untuk membaca langkah-langkah Anda dari Apple Health, jadi Apple Watch juga penting. Opsional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprendo il cancello ti viene chiesto anche di leggere i tuoi passi da Apple Health, quindi conta anche un Apple Watch. Opzionale."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Að opna hliðið biður líka um að lesa skrefin þín frá Apple Health, svo Apple Watch telur líka. Valfrjálst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲートを開けると Apple Health から歩数を読み取ることも求められるため、Apple Watch も重要です。オプション。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კარიბჭის გახსნა ასევე მოითხოვს თქვენი ნაბიჯების წაკითხვას Apple Health-დან, ასე რომ, Apple Watch ასევე ითვლება. სურვილისამებრ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қақпаны ашу Apple Health қолданбасынан қадамдарыңызды оқуды сұрайды, сондықтан Apple Watch да маңызды. Қосымша."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트를 열면 Apple Health에서 걸음 수를 읽어달라고 요청하므로 Apple Watch도 중요합니다. 선택 과목."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atidarius vartus taip pat prašoma perskaityti jūsų veiksmus iš „Apple Health“, todėl „Apple Watch“ taip pat yra svarbus. Neprivaloma."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atverot vārtus, tiek prasīts arī nolasīt jūsu veiktās darbības no Apple Health, tāpēc tiek ņemts vērā arī Apple Watch. Pēc izvēles."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворањето на портата бара и читање на вашите чекори од Apple Health, така што се брои и Apple Watch. Факултативно."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka pintu pagar juga meminta anda membaca langkah anda daripada Apple Health, jadi Apple Watch juga dikira. Pilihan."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-ftuħ tal-bieb jitlob ukoll li taqra l-passi tiegħek minn Apple Health, għalhekk Apple Watch jgħodd ukoll. Fakultattiv."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å åpne porten ber også om å lese trinnene dine fra Apple Health, så en Apple Watch teller også. Valgfri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je het hek opent, wordt er ook gevraagd om je stappen van Apple Health uit te lezen, dus een Apple Watch telt ook. Optioneel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwarcie bramki wymaga również odczytania kroków z Apple Health, więc Apple Watch też się liczy. Fakultatywny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir o portão também pede para ler seus passos no Apple Health, então um Apple Watch também conta. Opcional."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir o portão também pede para ler seus passos no Apple Health, então um Apple Watch também conta. Opcional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При открытии ворот также требуется считывать ваши шаги из Apple Health, поэтому Apple Watch тоже учитываются. Необязательный."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschiderea porții vă cere, de asemenea, să vă citiți pașii din Apple Health, așa că și un Apple Watch contează. Opțional."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorenie brány tiež vyžaduje, aby ste si prečítali vaše kroky z Apple Health, takže sa počítajú aj Apple Watch. Voliteľné."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpiranje vrat zahteva tudi branje vaših korakov iz Apple Health, zato šteje tudi Apple Watch. Neobvezno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapja e portës kërkon gjithashtu të lexoni hapat tuaj nga Apple Health, kështu që një Apple Watch gjithashtu ka rëndësi. Fakultative."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Отварање капије такође тражи да прочитате ваше кораке из Аппле Хеалтх-а, тако да се рачуна и Аппле Ватцх. Опционо."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปิดประตูจะขอให้คุณอ่านก้าวของคุณจาก Apple Health ดังนั้น Apple Watch ก็นับด้วยเช่นกัน ไม่จำเป็น."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att öppna porten ber också att läsa dina steg från Apple Health, så en Apple Watch räknas också. Frivillig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapıyı açtığınızda adımlarınızın Apple Health'ten okunması da istenir, bu nedenle bir Apple Watch da sayılır. İsteğe bağlı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриття воріт також вимагає зчитувати ваші кроки з Apple Health, тому Apple Watch також має значення. Додатково."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开大门还要求从 Apple Health 读取您的步数，因此 Apple Watch 也很重要。选修的。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở cổng cũng yêu cầu đọc số bước của bạn từ Apple Health, vì vậy Apple Watch cũng được tính. Không bắt buộc."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "打開大門也要求從 Apple Health 讀取您的步數，因此 Apple Watch 也很重要。選修的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開大門也要求從 Apple Health 讀取您的步數，因此 Apple Watch 也很重要。選修的。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening the gate also asks to read your steps from Apple Health, so an Apple Watch counts too. Optional."
          }
        }
      }
    },
    "Opens %@'s passport, ready for its first stamp": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отваря паспорта на %@, готов за първия си печат"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre el passaport de %@, preparat per al seu primer segell"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara %@ pasoš, spreman za prvi pečat"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح جواز سفر %@ جاهزًا لختمه الأول"
          }
