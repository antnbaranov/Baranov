    "%@'s whole route is on land — no carrier needed this time.": {
      "comment": "A message that appears when a ram is on land.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ مسار المسار بأكمله على الأرض — لا حاجة إلى شركة نقل هذه المرة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Целият маршрут на %@ е по суша — този път няма нужда от превозвач."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cijela ruta %@ je na kopnu — ovaj put nije potreban prijevoznik."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tota la ruta de %@ és per terra, aquesta vegada no cal cap transportista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celá trasa %@ je po zemi — tentokrát není potřeba žádný dopravce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele %@s rute er på land — ingen operatør nødvendig denne gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gesamte Route von %@ verläuft über Land — kein Träger nötig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολόκληρη η διαδρομή του %@ είναι στην ξηρά — αυτή τη φορά δεν απαιτείται αερομεταφορέας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s whole route is on land — no carrier needed this time."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s whole route is on land — no carrier needed this time."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s whole route is on land — no carrier needed this time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s whole route is on land — no carrier needed this time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la ruta de %@ es por tierra: no se necesita portador esta vez."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la ruta de %@ es por tierra; esta vez no se necesita ningún transportista."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kogu kasutaja %@ marsruut on maismaal – seekord pole vedajat vaja."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erabiltzailearen ibilbide osoa lehorrean dago — oraingoan ez da garraiolaririk behar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:n koko reitti on maalla – tällä kertaa lentoyhtiötä ei tarvita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le trajet de %@ est terrestre — aucun porteur requis."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ensemble de l'itinéraire de %@ est terrestre : aucun transporteur n'est nécessaire cette fois-ci."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá bealach iomlán %@ ar tír — níl aon ghá le hiompróir an uair seo."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda a ruta de %@ é terrestre; esta vez non se precisa ningún operador."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל המסלול של %@ הוא ביבשה - אין צורך במוביל הפעם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पूरा मार्ग ज़मीन पर है - इस बार किसी वाहक की आवश्यकता नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cijela ruta %@ je na kopnu — ovaj put nije potreban prijevoznik."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ teljes útvonala szárazföldön halad – ezúttal nincs szükség fuvarozóra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh rute %@ ada di darat — kali ini tidak diperlukan operator."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Öll leiðin sem %@ er á landi er ekki þörf á símafyrirtæki í þetta skiptið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intero percorso di %@ è via terra: nessun portatore necessario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のルート全体は陸上です。今回は運送業者は必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 의 전체 경로는 육지에 있습니다. 이번에는 캐리어가 필요하지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas %@ maršrutas yra sausumoje – šį kartą vežėjo nereikia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ viss maršruts ir uz sauszemes — šoreiz pārvadātājs nav vajadzīgs."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Целата рута на %@ е на копно - овој пат не е потребен превозник."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh laluan %@ adalah di darat — tiada pembawa diperlukan kali ini."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir-rotta kollha ta' %@ hija fuq l-art — din id-darba ma kien meħtieġ l-ebda trasportatur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele %@ sin rute er på land – ingen transportør er nødvendig denne gangen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hele route van %@ gaat over land; deze keer is er geen vervoerder nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cała trasa %@ odbywa się na lądzie — tym razem nie jest potrzebny żaden przewoźnik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda a rota de %@ é por terra - nenhuma transportadora necessária desta vez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda a rota de %@ é por terra - nenhuma transportadora necessária desta vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întreaga rută a lui %@ este pe uscat — de data aceasta nu este nevoie de niciun transportator."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь маршрут %@ проходит по суше — на этот раз попутчик не требуется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Celá trasa %@ je po súši – tentoraz nie je potrebný žiadny dopravca."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Celotna pot osebe %@ poteka po kopnem – tokrat prevoznik ni potreben."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "E gjithë itinerarja e %@ është në tokë — këtë herë nuk nevojitet asnjë transportues."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ цела рута је на копну — овај пут није потребан превозник."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hela %@s rutt är på land – ingen operatör behövs den här gången."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นทางทั้งหมดของ %@ อยู่บนบก คราวนี้ไม่จำเป็นต้องใช้เรือบรรทุกเครื่องบิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rotasının tamamı karadan geçiyor; bu sefer taşıyıcıya gerek yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь маршрут %@ проходить суходолом — цього разу попутник не потрібен."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn bộ tuyến đường của %@ đều diễn ra trên đất liền — lần này không cần người vận chuyển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的整个路线都是在陆地上——这次不需要承运人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的整個路線都是在陸地上－這次不需要承運人。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的整個路線都是在陸地上－這次不需要承運人。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ის მთელი მარშრუტი ხმელეთზეა — ამჯერად გადამზიდავი არ არის საჭირო."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ бүкіл маршруты құрлықта - бұл жолы ешқандай тасымалдаушы қажет емес."
          }
