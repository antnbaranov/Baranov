        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y embarque un paquet – ou accompagne toute personne traversant plus tôt."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bordáil paicéad ansin — nó téann sé le haon duine a thrasnaíonn níos luaithe."
