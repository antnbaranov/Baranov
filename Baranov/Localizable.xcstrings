        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Move o mapa: o alfinete permanece no medio. Só ti ves este lugar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזז את המפה - הסיכה נשארת באמצע. רק אתה רואה את המקום הזה."
