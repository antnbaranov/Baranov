    "It completes itself when the steps add up.": {
      "comment": "A description of how the distance-based goal works.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Завършва се, когато стъпките се съберат."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es completa quan els passos sumen."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Završava se kada se koraci zbroje."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتمل من تلقاء نفسه عندما تضيف الخطوات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det fuldender sig selv, når trinene tæller sammen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokončí se sám, když se kroky sečtou."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "It completes itself when the steps add up."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "It completes itself when the steps add up."
          }
        },
        "en-GB": {
