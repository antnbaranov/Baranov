        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өтінемін, жүгіруді жалғастырыңыз. Ең жақсы тілектер."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속해서 트로트해주세요. 감사합니다."
