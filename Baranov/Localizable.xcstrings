        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jirkeb fil-mailbag tiegħek u jiċċaqlaq bil-passi tiegħek, mingħajr ma jieħu pinna fil-mergħa tiegħek. Il-mittent jista’ jitlobha lura fi kwalunkwe ħin."
