    "By the time this reaches you, the weather will have changed. Describe today's." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بحلول الوقت الذي تصل فيه هذه الرسالة إليك، سيكون الطقس قد تغير. وصف اليوم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докато това стигне до вас, времето ще се е променило. Опишете днешния."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dok ovo stigne do vas, vrijeme će se promijeniti. Opišite današnje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan això arribi, el temps haurà canviat. Descriu el d'avui."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Než se k vám dostane, počasí se změní. Popište dnešní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette når dig, vil vejret have ændret sig. Beskriv dagens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis dich dies erreicht, hat sich das Wetter geändert. Beschreibe das von heute."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μέχρι να φτάσει σε εσάς, ο καιρός θα έχει αλλάξει. Περιγράψτε το σημερινό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By the time this reaches you, the weather will have changed. Describe today's."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By the time this reaches you, the weather will have changed. Describe today's."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
