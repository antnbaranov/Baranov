        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cifrado durante todo el viaje. %@ lo abrirá en la puerta con el código de recepción."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
