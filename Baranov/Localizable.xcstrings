    "Kindly keep trotting. Best regards.": {
      "comment": "A passive-aggressive HR email that is secretly very proud.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Моля, продължавайте да тръсате. Най-добри пожелания."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si us plau, seguiu trotant. Salutacions cordials."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Molim vas, nastavite sa kasom. Srdačan pozdrav."
          }
        },
