    "The post office couldn't accept that. Try again." : {
      "comment" : "Error message when the post office rejects a letter.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكتب البريد لا يمكن أن يقبل ذلك. حاول ثانية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
