        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još ni jedan korak. Trava je ovdje naizgled izvrsna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még egy lépést sem. A fű itt láthatóan kiváló."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum satu langkah pun. Rerumputan di sini rupanya bagus sekali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora un passo. L'erba qui è apparentemente eccellente."
