        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri ia nama — ia akan tumbuh membawa surat-suratmu selama kamu menggunakan Baranov."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefðu því nafn — það mun alast upp með bréfin þín, svo lengi sem þú heldur Baranov."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagli un nome: crescerà portando le tue lettere per tutto il tempo in cui userai Baranov."
