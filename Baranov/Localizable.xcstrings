        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ იძენს ბეჭედს ყველა დასახელებული ადგილისთვის, რომელიც გაიარა - მდინარე გადაკვეთა, ქალაქი გაიარა, კარიბჭემდე მიაღწია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ өткен әрбір аталған жер — өзеннен өткен, қала өткен, жеткен қақпа үшін мөр алады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은 강을 건너고, 마을을 통과하고, 문에 도달하는 등 이름이 지정된 모든 장소를 지나갈 때마다 스탬프를 얻습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uždirba antspaudą už kiekvieną įvardytą vietą, kurią praeisite – perplauktą upę, pervažiuotą miestelį, pasiektus vartus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
