        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Où tu as parlé, ce qu'ils transportent, tout ce qui mérite d'être rappelé"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Missä puhuit, mitä he kantavat, mitä tahansa muistamisen arvoista"
