        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laiškas vis tiek atkeliauja pėsčiomis, kaip įprasta. Jis tiesiog neiššifruos iki šios akimirkos, net ir su dešiniuoju ausų įsagu."
