            "state" : "translated",
            "value" : "Podať im %@? List ide ich cestou."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predajte jim %@? Pismo gre njuno pot."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T'u jepni atyre %@? Letra shkon në rrugën e tyre."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дајте им %@? Писмо иде њиховим путем."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge dem %@? Brevet går deras väg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มอบ %@ ให้พวกเขาเหรอ? จดหมายไปตามทางของพวกเขา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onlara %@'yi verir misiniz? Mektup kendi yolunda gidiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передай їм %@? Лист йде їхньою дорогою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đưa cho họ %@ ? Bức thư đi theo cách của họ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给他们 %@ 吗？这封信如愿以偿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "給他們 %@ 嗎？這封信如願以償。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "給他們 %@ 嗎？這封信如願以償。"
          }
        }
      }
