          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ сіздің қадамдарыңызбен %@ қақпасына дейін жүреді. Ол жерге жеткенде олардың пошта дорбасына түседі."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@는 당신의 계단을 따라 %@의 게이트로 걸어갑니다. 도착하면 우편함에 들어갑니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ eina prie %@ vartų jūsų laipteliais. Kai patenka, jis patenka į jų pašto dėžutę."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ iet uz %@ vārtiem pa jūsu kāpnēm. Nonākot tur, tas nonāk viņu pasta somā."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ оди до портата на %@ на вашите чекори. Слетува во нивната поштенска торба кога ќе стигне таму."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ berjalan ke pintu pagar %@ di tangga anda. Ia mendarat di dalam beg mel mereka apabila ia sampai di sana."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jimxi lejn il-bieb ta' %@ fuq il-passi tiegħek. Tinżel fil-mailbag tagħhom meta tasal hemm."
