        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא תראה יותר את %@ כשליח שמור. פתק הטיול ופרטי המפגש הראשון שלהם הולכים איתם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आप %@ को सहेजे गए कूरियर के रूप में नहीं देखेंगे। उनका यात्रा नोट और पहली मुलाकात का विवरण उनके साथ जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Više nećete vidjeti %@ kao spremljenog kurira. Njihova bilješka s putovanja i podaci o prvom susretu idu s njima."
