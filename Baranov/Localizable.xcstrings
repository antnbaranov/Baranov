        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қып-қызыл әр қойшыға тән. Басқа балауызды түртіңіз."
          }
        }
      }
    },
    "Crimson is yours. The other waxes come with Expand the Pasture — the colour is the only thing that changes; every seal locks the letter the same way.": {
      "comment": "A description of the waxes available to choose from.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرمزي هو لك. تأتي الشموع الأخرى مع Expand the Pasture - اللون هو الشيء الوحيد الذي يتغير؛ كل ختم يقفل الحرف بنفس الطريقة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пурпурно е твое. Другите восъци идват с Expand the Pasture — цветът е единственото нещо, което се променя; всеки печат заключва писмото по един и същи начин."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Grimizno je tvoje. Ostali voskovi dolaze sa Expand the Pasture — boja je jedina stvar koja se mijenja; svaki pečat zaključava pismo na isti način."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson és teu. Les altres ceres vénen amb Expand the Pasture: el color és l'únic que canvia; cada segell tanca la lletra de la mateixa manera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson je váš. Ostatní vosky jsou dodávány s Expand the Pasture — barva je jediná věc, která se mění; každá pečeť zamyká dopis stejným způsobem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson er din. De andre vokser kommer med Expand the Pasture - farven er det eneste, der ændrer sig; hvert segl låser brevet på samme måde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson gehört dir. Die anderen Wachse sind im Lieferumfang von Expand the Pasture enthalten – die Farbe ist das Einzige, was sich ändert; Jedes Siegel verschließt den Brief auf die gleiche Weise."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Crimson είναι δικό σου. Τα άλλα κεριά συνοδεύονται από Expand the Pasture — το χρώμα είναι το μόνο πράγμα που αλλάζει. κάθε σφραγίδα κλειδώνει το γράμμα με τον ίδιο τρόπο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson is yours. The other waxes come with Expand the Pasture — the colour is the only thing that changes; every seal locks the letter the same way."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson is yours. The other waxes come with Expand the Pasture — the colour is the only thing that changes; every seal locks the letter the same way."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson is yours. The other waxes come with Expand the Pasture — the colour is the only thing that changes; every seal locks the letter the same way."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson is yours. The other waxes come with Expand the Pasture — the colour is the only thing that changes; every seal locks the letter the same way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El carmesí es tuyo. Las otras ceras vienen con Expand the Pasture: el color es lo único que cambia; cada sello cierra la carta de la misma manera."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El carmesí es tuyo. Las otras ceras vienen con Expand the Pasture: el color es lo único que cambia; cada sello cierra la carta de la misma manera."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Karmiinpunane on sinu oma. Teised vahad on kaasas Expand the Pasture'iga – värv on ainus, mis muutub; iga pitsat lukustab kirja samamoodi."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson zurea da. Beste argizaria Zabaldu Larrearekin datoz —kolorea da aldatzen den gauza bakarra; zigilu bakoitzak letra berdinean ixten du."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson on sinun. Muiden vahojen mukana tulee Expand the Pasture – väri on ainoa asia, joka muuttuu; jokainen sinetti lukitsee kirjaimen samalla tavalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cramoisi est à toi. Les autres cires sont livrées avec Expand the Pasture – la couleur est la seule chose qui change ; chaque sceau verrouille la lettre de la même manière."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cramoisi est à toi. Les autres cires sont livrées avec Expand the Pasture – la couleur est la seule chose qui change ; chaque sceau verrouille la lettre de la même manière."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is leatsa Crimson. Tagann na céireacha eile le Leathnaigh an Féarach - is é an dath an t-aon rud a athraíonn; glasann gach séala an litir ar an mbealach céanna."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson é teu. As outras ceras veñen con Expand the Pasture: a cor é o único que cambia; cada selo bloquea a letra do mesmo xeito."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ארגמן הוא שלך. שאר השעווה מגיעות עם Expand the Pasture - הצבע הוא הדבר היחיד שמשתנה; כל חותם נועל את המכתב באותו אופן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रिमसन तुम्हारा है. अन्य वैक्स एक्सपैंड द पास्चर के साथ आते हैं - केवल रंग ही बदलता है; प्रत्येक मुहर पत्र को उसी प्रकार बंद करती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grimizna je tvoja. Ostali voskovi dolaze uz Expand the Pasture — boja je jedina stvar koja se mijenja; svaki pečat zaključava pismo na isti način."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bíbor a tiéd. A többi viasz az Expand the Pasture funkcióval érkezik – a szín az egyetlen, ami változik; minden pecsét ugyanúgy zárja a betűt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merah tua adalah milikmu. Lilin lainnya hadir dengan Expand the Pasture — hanya warnanya yang berubah; setiap segel mengunci surat itu dengan cara yang sama."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson er þitt. Hin vaxin koma með Expand the Pasture - liturinn er það eina sem breytist; hvert innsigli læsir bréfinu á sama hátt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cremisi è tuo. Le altre cere vengono fornite con Espandi il pascolo: il colore è l'unica cosa che cambia; ogni sigillo blocca la lettera allo stesso modo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリムゾンはあなたのものです。他のワックスは Expand the Pasture に付属しています。変わるのは色だけです。どの印鑑も同じ方法で文字をロックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크림슨은 당신의 것입니다. 다른 왁스에는 Expand the Pasture가 함께 제공됩니다. 변경되는 유일한 것은 색상입니다. 모든 인장은 같은 방식으로 편지를 잠급니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson yra tavo. Kiti vaškai pateikiami su „Expand the Pasture“ – keičiasi tik spalva; kiekvienas antspaudas užrakina raidę taip pat."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson ir jūsu. Pārējie vaski ir komplektā Expand the Pasture — krāsa ir vienīgā, kas mainās; katrs zīmogs burtu bloķē tāpat."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson е твое. Останатите восоци доаѓаат со Expand the Pasture - бојата е единственото нешто што се менува; секој печат ја заклучува буквата на ист начин."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson milik awak. Lilin lain datang dengan Expand the Pasture — warna adalah satu-satunya perkara yang berubah; setiap meterai mengunci huruf dengan cara yang sama."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson huwa tiegħek. Ix-xama’ l-oħra jiġu ma’ Expand the Pasture — il-kulur huwa l-unika ħaġa li tinbidel; kull siġill jissakkar l-ittra bl-istess mod."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson er din. De andre voksene kommer med Expand the Pasture — fargen er det eneste som endres; hvert segl låser bokstaven på samme måte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson is van jou. De andere wassen worden geleverd met Expand the Pasture – de kleur is het enige dat verandert; elk zegel vergrendelt de brief op dezelfde manier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karmazyn jest twój. Pozostałe woski są dostępne w zestawie Expand the Pasture — zmienia się jedynie kolor; każda pieczęć zamyka list w ten sam sposób."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carmesim é seu. As demais ceras vêm com Expand the Pasture - a única coisa que muda é a cor; cada selo fecha a carta da mesma maneira."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Carmesim é seu. As demais ceras vêm com Expand the Pasture - a única coisa que muda é a cor; cada selo fecha a carta da mesma maneira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson este al tău. Celelalte ceară vin cu Expand the Pasture — culoarea este singurul lucru care se schimbă; fiecare sigiliu blochează scrisoarea în același mod."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Багровый твой. Другие воски идут в комплекте с Expand the Pasture — единственное, что меняется, — это цвет; каждая печать запирает письмо одинаково."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson je tvoj. Ostatné vosky sú dodávané s Expand the Pasture — farba je jediná vec, ktorá sa mení; každá pečať zamyká list rovnakým spôsobom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson je tvoj. Drugi voski so priloženi Expand the Pasture — barva je edina stvar, ki se spremeni; vsak pečat zaklene pismo na enak način."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson është i juaji. Dyllët e tjerë vijnë me Expand the Pasture - ngjyra është e vetmja gjë që ndryshon; çdo vulë e mbyll letrën në të njëjtën mënyrë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Гримизно је твоје. Остали воскови долазе са Екпанд тхе Пастуре — боја је једина ствар која се мења; сваки печат закључава писмо на исти начин."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Crimson är din. De andra vaxerna kommer med Expand the Pasture — färgen är det enda som ändras; varje sigill låser brevet på samma sätt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สีแดงเข้มเป็นของคุณ แว็กซ์อื่นๆ มาพร้อมกับ Expand the Pasture — สีเป็นเพียงสิ่งเดียวที่เปลี่ยนแปลง ทุกผนึกจะล็อคตัวอักษรในลักษณะเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kızıl senindir. Diğer mumlar Expand the Mera ile birlikte gelir; değişen tek şey renktir; Her mühür mektubu aynı şekilde kilitler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Багряний твій. Інші воски постачаються з Expand the Pasture — змінюється лише колір; кожна печатка замикає лист однаково."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màu đỏ thẫm là của bạn. Các loại sáp khác đi kèm với Expand the Pasture - màu sắc là thứ duy nhất thay đổi; mọi con dấu đều khóa bức thư theo cùng một cách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "猩红是你的。其他蜡随 Expand the Pasture 一起提供 - 颜色是唯一改变的；每个封条都以相同的方式锁定信件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "猩紅是你的。其他蠟隨 Expand the Pasture 一起提供 - 顏色是唯一改變的；每個封條都以相同的方式鎖定信件。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "猩紅是你的。其他蠟隨 Expand the Pasture 一起提供 - 顏色是唯一改變的；每個封條都以相同的方式鎖定信件。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჟოლოსფერი შენია. სხვა ცვილებს მოყვება Expand the Pasture - ფერი ერთადერთია, რაც იცვლება; ყველა ბეჭედი ასოს ერთნაირად კეტავს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қып-қызыл сенікі. Басқа балауыздар Жайылымды кеңейтумен бірге келеді — түсі өзгеретін жалғыз нәрсе; әрбір мөр хатты дәл осылай құлыптайды."
          }
        }
      }
    },
    "Cross a bridge without looking down": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Creueu un pont sense mirar cap avall"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Преминете по мост, без да гледате надолу"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pređite most ne gledajući dole"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عبور الجسر دون النظر إلى الأسفل"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryds en bro uden at se ned"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejděte přes most, aniž byste se podívali dolů"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross a bridge without looking down"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross a bridge without looking down"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross a bridge without looking down"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überqueren Sie eine Brücke, ohne nach unten zu schauen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διασχίστε μια γέφυρα χωρίς να κοιτάξετε κάτω"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruzar un puente sin mirar hacia abajo"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruzar un puente sin mirar hacia abajo"
          }
        },
