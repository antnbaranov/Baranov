          "stringUnit": {
            "state": "translated",
            "value": "Pendobrak itu masih harus mencapai kota %@ — ini adalah kunci kedua yang lebih ketat, sampai ke tempat yang tepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ariete deve ancora raggiungere la città di %@: oltre a questo, c'è un secondo blocco più stretto, fino al punto esatto."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hrúturinn þarf enn að ná til borgarinnar %@ — þetta er annar, þéttari lás ofan á það, alveg niður á nákvæmlega stað."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "羊はまだ %@ の都市に到達する必要があります。これは、正確な位置まで、その上に 2 番目のより厳重なロックがかかっています。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ვერძს ჯერ კიდევ სჭირდება %@-ის ქალაქამდე მისვლა - ეს არის მეორე, უფრო მჭიდრო საკეტი მის თავზე, ზუსტად ადგილზე."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫양은 여전히 ​​%@ 의 도시에 도달해야 합니다. 이것은 정확한 지점까지 바로 아래에 있는 두 번째로 더 단단한 자물쇠입니다."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қошқар әлі %@ қаласына жетуі керек — бұл оның үстіне дәл нүктеге дейін екінші, қаттырақ құлып."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Avinas dar turi pasiekti %@ miestą – tai antras, tvirtesnis užraktas ant jo, iki tikslios vietos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aunam joprojām ir jāsasniedz %@ pilsēta — šī ir otra, stingrāka slēdzene virs tā, līdz pat precīzai vietai."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овенот сè уште треба да стигне до градот на %@ - ова е втора, поцврста брава над тоа, до точното место."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Domba jantan masih perlu sampai ke bandar %@ — ini adalah kunci kedua yang lebih ketat di atasnya, terus ke tempat yang tepat."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-muntun għad irid jilħaq il-belt ta' %@ — dan huwa t-tieni lock aktar strett fuq dan, eżatt sal-post eżatt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Væren trenger fortsatt å nå %@ sin by – dette er en andre, tettere lås på toppen av det, helt ned til det nøyaktige stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ram moet de stad van %@ nog bereiken – dit is een tweede, strakkere sluis daarbovenop, tot op de exacte plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taran nadal musi dotrzeć do miasta %@ — jest to druga, ściślejsza śluza, dokładnie w tym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O aríete ainda precisa chegar à cidade de %@ - este é um segundo bloqueio mais apertado, até o local exato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O aríete ainda precisa chegar à cidade de %@ - este é um segundo bloqueio mais apertado, até o local exato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарану еще нужно добраться до города %@ — это второй, более плотный шлюз, вплоть до точного места."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbecul încă mai trebuie să ajungă în orașul lui %@ — acesta este un al doilea blocaj mai strâns pe deasupra, chiar în locul exact."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oven mora še vedno priti do mesta %@ — to je drugi, strožji zaklep poleg tega, vse do natančnega mesta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Baran sa ešte musí dostať do mesta %@ — toto je druhá, tesnejšia zámka navrchu, až na presné miesto."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Dashi duhet ende të arrijë në qytetin e %@ - ky është një bllokim i dytë, më i ngushtë në krye të tij, deri në vendin e saktë."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ован још треба да стигне до града %@ — ово је друга, чвршћа брава на врху, тачно до тачног места."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แกะยังต้องไปให้ถึงเมืองของ %@ นี่เป็นการล็อคครั้งที่สองที่แน่นกว่าด้านบน ลงไปถึงจุดที่แน่นอน"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramen behöver fortfarande nå %@ s stad — det här är ett andra, stramare lås ovanpå det, ända ner till den exakta platsen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koçun hala %@ şehrine ulaşması gerekiyor; bu, tam noktasına kadar ikinci, daha sıkı bir kilitlenmedir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баран все ще має дістатися до міста %@ — це другий, щільніший замок на вершині, аж до точного місця."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公羊仍然需要到达 %@ 的城市 - 这是在此基础上的第二个更严格的锁定，一直到确切的位置。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ram vẫn cần đến được thành phố của %@ - đây là khóa thứ hai, chặt chẽ hơn, đến đúng vị trí chính xác."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "公羊仍然需要到达 %@ 的城市 - 这是在此基础上的第二个更严格的锁定，一直到确切的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公羊仍然需要到達 %@ 的城市 - 這是在此基礎上的第二個更嚴格的鎖定，一直到確切的位置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ram still needs to reach %@'s city — this is a second, tighter lock on top of that, right down to the exact spot."
          }
        }
      }
    },
    "The reel keeps rendering. Its card in the passport shows when it is ready.": {
