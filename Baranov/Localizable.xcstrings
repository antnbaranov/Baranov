        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siap berangkat. Izinkan lokasi sehingga ia tahu di mana gerbang Anda berada."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbúinn að leggja af stað. Leyfðu staðsetningu svo það viti hvar hliðið þitt er."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronti per partire. Consenti la posizione in modo che sappia dove si trova il tuo cancello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出発の準備ができました。ゲートの場所を認識できるように位置情報を許可します。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მზადაა გასამგზავრებლად. დაუშვით მდებარეობა, რათა მან იცოდეს სად არის თქვენი კარიბჭე."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жолға шығуға дайын. Сіздің қақпаңыздың қай жерде екенін білу үшін орынды анықтауға рұқсат беріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출발할 준비가 되었습니다. 게이트가 어디에 있는지 알 수 있도록 위치를 허용하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasiruošę keliauti. Leiskite vietą, kad ji žinotų, kur yra jūsų vartai."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatavs doties ceļā. Atļaujiet atrašanās vietu, lai tā zinātu, kur atrodas jūsu vārti."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подготвени за тргнување. Дозволете локација за да знае каде е вашата порта."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bersedia untuk berangkat. Benarkan lokasi supaya ia tahu di mana pintu masuk anda."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lest biex jitlaq. Ħalli l-post sabiex ikun jaf fejn hu l-bieb tiegħek."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klar til å sette i gang. Tillat plassering slik at den vet hvor porten din er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klaar om op pad te gaan. Sta de locatie toe, zodat deze weet waar uw poort is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gotowy do wyruszenia. Zezwól na lokalizację, aby wiedział, gdzie jest Twoja brama."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronto para partir. Permita a localização para que ele saiba onde fica o seu portão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronto para partir. Permita a localização para que ele saiba onde fica o seu portão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gata de plecare. Permiteți locația astfel încât să știe unde este poarta dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готов выйти в путь. Разреши доступ к геопозиции, чтобы он знал, где твои ворота."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripravený vyraziť. Povoľte polohu, aby vedel, kde je vaša brána."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripravljen na pot. Dovolite lokacijo, da ve, kje so vaša vrata."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gati për t'u nisur. Lejo vendndodhjen në mënyrë që të dijë se ku është porta jote."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спреман за полазак. Дозволите локацију тако да зна где се налази ваша капија."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redo att ge sig ut. Tillåt plats så att den vet var din grind är."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พร้อมออกเดินทางแล้ว. อนุญาตตำแหน่งเพื่อให้รู้ว่าประตูของคุณอยู่ที่ไหน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yola çıkmaya hazırız. Kapınızın nerede olduğunu bilmesi için konuma izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готовий вирушати. Дозволь розташування, щоб він знав, де твої ворота."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sẵn sàng khởi hành. Cho phép vị trí để nó biết cổng của bạn ở đâu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备出发了。允许定位，以便它知道您的登机口在哪里。"
