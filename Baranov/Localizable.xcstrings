    "Has not gone anywhere yet. Suspiciously relaxed.": {
      "comment": "A description of a Ram's Reel when the user has not gone anywhere.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още не е ходил никъде. Подозрително отпуснат."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no ha anat enlloc. Sospitosament relaxat."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nigdje nije otišao. Sumnjičavo opušteno."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يذهب إلى أي مكان بعد. استرخاء مريب."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ikke gået nogen steder endnu. Mistænkeligt afslappet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nikam neodešel. Podezřele uvolněný."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Has not gone anywhere yet. Suspiciously relaxed."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Has not gone anywhere yet. Suspiciously relaxed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Has not gone anywhere yet. Suspiciously relaxed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist noch nirgendwo hingegangen. Verdächtig entspannt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει πάει πουθενά ακόμα. Ύποπτα χαλαρός."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no ha ido a ninguna parte. Sospechosamente relajado."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no ha ido a ninguna parte. Sospechosamente relajado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pole veel kuhugi läinud. Kahtlaselt lõdvestunud."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraindik ez da inora joan. Susmagarri erlaxatuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'est encore allé nulle part. Étrangement détendu."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'est encore allé nulle part. Étrangement détendu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei ole mennyt vielä minnekään. Epäilyttävän rento."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach bhfuil imithe áit ar bith go fóill. Suaimhneas síoraí amhrasach."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aínda non foi a ningún lado. Sospeitosamente relaxado."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא הלך לשום מקום. נינוח באופן חשוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कहीं नहीं गया. संदेहास्पद रूप से शिथिल।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nikamo nije otišao. Sumnjičavo opušteno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nem ment sehova. Gyanúsan ellazult."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum pergi kemana pun. Dicurigai santai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora andato da nessuna parte. Sospettosamente rilassato."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hefur ekki farið neitt ennþá. Grunsamlega slakað á."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだどこにも行っていません。疑わしいほどリラックスしています。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ არსად წასულა. საეჭვოდ დამშვიდდა."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әлі ешқайда кеткен жоқ. Күдікті босаңсыған."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 아무데도 가지 않았습니다. 의심스럽게 편안했습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar niekur nedingo. Įtartinai atsipalaidavęs."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēl nekur nav aizgājis. Aizdomīgi atslābinājies."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сè уште не отишол никаде. Сомнително опуштено."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ke mana-mana lagi. Meragukan santai."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għadu ma marx imkien. Rilassat b'mod suspettuż."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Har ikke gått noe sted ennå. Mistenkelig avslappet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is nog nergens heen gegaan. Verdacht ontspannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nigdzie nie poszedł. Podejrzanie zrelaksowany."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foi a lugar nenhum. Suspeitamente relaxado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foi a lugar nenhum. Suspeitamente relaxado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё никуда не ходил. Подозрительно расслабился."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu a mers nicăieri. Suspect de relaxat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ nikam neodišiel. Podozrivo uvoľnený."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še ni šel nikamor. Sumljivo sproščeno."
          }
        },
        "sq": {
