        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvar þú talaðir, hvað þeir bera, allt sem vert er að muna"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこで話したか、何を持っているか、覚えておくべきことは何か"
