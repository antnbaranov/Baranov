    "Stats are counts tied to a random ID, never letter text, names or exact location. Logs stay on your phone until you send them.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистиката е преброяване, свързано с произволен идентификатор, никога буквен текст, имена или точно местоположение. Дневниците остават на телефона ви, докато не ги изпратите."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les estadístiques són recomptes lligats a una identificació aleatòria, mai text de lletres, noms o ubicació exacta. Els registres romanen al vostre telèfon fins que els envieu."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistike su brojanja vezana za slučajni ID, a nikada tekst slova, imena ili tačnu lokaciju. Zapisi ostaju na vašem telefonu dok ih ne pošaljete."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإحصائيات عبارة عن أعداد مرتبطة بمعرف عشوائي، ولا تحتوي على رسائل نصية أو أسماء أو موقع محدد. تبقى السجلات على هاتفك حتى تقوم بإرسالها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik er optælling knyttet til et tilfældigt ID, aldrig bogstavtekst, navne eller nøjagtige placering. Logfiler bliver på din telefon, indtil du sender dem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistiky jsou počty spojené s náhodným ID, nikdy textem písmen, jmény nebo přesnou polohou. Protokoly zůstanou v telefonu, dokud je neodešlete."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Stats are counts tied to a random ID, never letter text, names or exact location. Logs stay on your phone until you send them."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Stats are counts tied to a random ID, never letter text, names or exact location. Logs stay on your phone until you send them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stats are counts tied to a random ID, never letter text, names or exact location. Logs stay on your phone until you send them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Statistiken handelt es sich um Zählungen, die an eine zufällige ID gebunden sind, niemals an Buchstaben, Namen oder den genauen Standort. Protokolle bleiben auf Ihrem Telefon, bis Sie sie senden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στατιστικά στοιχεία είναι μετρήσεις που συνδέονται με ένα τυχαίο αναγνωριστικό, ποτέ κείμενο με γράμματα, ονόματα ή ακριβή τοποθεσία. Τα αρχεία καταγραφής παραμένουν στο τηλέφωνό σας μέχρι να τα στείλετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estadísticas son recuentos vinculados a una identificación aleatoria, nunca a letras de texto, nombres o ubicación exacta. Los registros permanecen en su teléfono hasta que los envíe."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estadísticas son recuentos vinculados a una identificación aleatoria, nunca a letras de texto, nombres o ubicación exacta. Los registros permanecen en su teléfono hasta que los envíe."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Estatistikak ausazko ID bati loturiko zenbaketak dira, inoiz ez letra-testua, izenak edo kokapen zehatza. Erregistroak zure telefonoan geratzen dira bidali arte."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistika on juhusliku ID-ga seotud loendused, mitte kunagi tähtteksti, nimede või täpse asukohaga. Logid jäävad teie telefoni seniks, kuni need saadate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les statistiques sont des décomptes liés à un identifiant aléatoire, sans jamais écrire de texte, de noms ou de lieu exact. Les journaux restent sur votre téléphone jusqu'à ce que vous les envoyiez."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les statistiques sont des décomptes liés à un identifiant aléatoire, sans jamais écrire de texte, de noms ou de lieu exact. Les journaux restent sur votre téléphone jusqu'à ce que vous les envoyiez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilastot ovat satunnaiseen tunnukseen sidottuja lukuja, ei koskaan kirjaintekstejä, nimiä tai tarkkaa sijaintia. Lokit pysyvät puhelimessasi, kunnes lähetät ne."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is éard is stats ann ná comhairimh a bhaineann le haitheantas randamach, gan téacs litreach, ainmneacha nó suíomh beacht riamh. Fanann logaí ar do ghuthán go dtí go seolann tú iad."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "As estatísticas son contas ligadas a unha identificación aleatoria, nunca texto de letras, nomes ou localización exacta. Os rexistros permanecen no teu teléfono ata que os envíes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סטטיסטיקות הן ספירות הקשורות למזהה אקראי, אף פעם לא טקסט אותיות, שמות או מיקום מדויק. יומנים נשארים בטלפון שלך עד שאתה שולח אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आँकड़े एक यादृच्छिक आईडी से जुड़े हुए हैं, कभी भी अक्षर पाठ, नाम या सटीक स्थान से नहीं जुड़े होते हैं। लॉग आपके फ़ोन पर तब तक रहते हैं जब तक आप उन्हें भेज नहीं देते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistika je izbrojavanje vezano za nasumični ID, nikad slovni tekst, imena ili točnu lokaciju. Zapisi ostaju na vašem telefonu dok ih ne pošaljete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A statisztika véletlenszerű azonosítóhoz kötött számlálás, soha nem betűszöveg, nevek vagy pontos hely. A naplók a telefonján maradnak, amíg el nem küldi őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik adalah penghitungan yang terikat pada ID acak, bukan teks huruf, nama, atau lokasi persisnya. Log tetap ada di ponsel Anda sampai Anda mengirimkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statistiche sono conteggi legati a un ID casuale, mai testo in lettere, nomi o posizione esatta. I registri rimangono sul telefono finché non li invii."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tölfræði er talning bundin við handahófskennd auðkenni, aldrei bókstafatexta, nöfn eða nákvæma staðsetningu. Skrár verða í símanum þínum þar til þú sendir þær."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "統計情報はランダムな ID に関連付けられたカウントであり、文字テキスト、名前、正確な場所は含まれません。ログは送信するまで携帯電話に残ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სტატისტიკა დაკავშირებულია შემთხვევით პირადობის მოწმობასთან, ასოების ტექსტთან, სახელებთან ან ზუსტ მდებარეობასთან. ჟურნალები რჩება თქვენს ტელეფონში, სანამ არ გამოგიგზავნით მათ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통계는 문자 텍스트, 이름 또는 정확한 위치가 아닌 임의의 ID에 연결된 개수입니다. 로그는 보낼 때까지 휴대폰에 남아 있습니다."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистика – кездейсоқ идентификаторға байланысты сандар, ешқашан әріптік мәтін, атаулар немесе нақты орын. Журналдар сіз оларды жібермейінше телефоныңызда қалады."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistika yra skaičiai, susieti su atsitiktiniu ID, niekada raidžių tekstu, vardais ar tikslia vieta. Žurnalai lieka jūsų telefone, kol juos išsiųsite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistika ir skaitļi, kas saistīti ar nejaušu ID, nekad nav burtu teksta, vārdiem vai precīzas atrašanās vietas. Žurnāli paliek tālrunī, līdz tos nosūtāt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистиката се брои поврзани со случајна лична карта, текст никогаш буква, имиња или точна локација. Дневниците остануваат на вашиот телефон додека не ги испратите."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik adalah kiraan terikat pada ID rawak, tidak sekali-kali menggunakan huruf teks, nama atau lokasi yang tepat. Log kekal pada telefon anda sehingga anda menghantarnya."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-istatistiċi huma għadd marbut ma' ID każwali, qatt ma' test ta' ittra, ismijiet jew post eżatt. Zkuk jibqgħu fuq it-telefon tiegħek sakemm tibgħathom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistikk er tellinger knyttet til en tilfeldig ID, aldri bokstavtekst, navn eller nøyaktig plassering. Logger blir liggende på telefonen til du sender dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistieken zijn tellingen die zijn gekoppeld aan een willekeurige ID, nooit lettertekst, namen of exacte locatie. Logboeken blijven op uw telefoon staan ​​totdat u ze verzendt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As estatísticas são contagens vinculadas a um ID aleatório, nunca a texto de letras, nomes ou localização exata. Os registros permanecem no seu telefone até você enviá-los."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statystyki są powiązane z losowym identyfikatorem, nigdy z tekstem litery, imieniem lub dokładną lokalizacją. Dzienniki pozostają w telefonie do czasu ich wysłania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As estatísticas são contagens vinculadas a um ID aleatório, nunca a texto de letras, nomes ou localização exata. Os registros permanecem no seu telefone até você enviá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистика — это подсчеты, привязанные к случайному идентификатору, а не к тексту буквы, имени или точному местоположению. Журналы остаются на вашем телефоне, пока вы их не отправите."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Statisticile sunt numărări legate de un ID aleatoriu, niciodată text cu litere, nume sau locație exactă. Jurnalele rămân pe telefon până când le trimiteți."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistika je štetje, vezano na naključni ID, nikoli črkovnega besedila, imen ali natančne lokacije. Dnevniki ostanejo v telefonu, dokler jih ne pošljete."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Štatistiky sú počty viazané na náhodné ID, nikdy nie na text písmen, mená alebo presnú polohu. Denníky zostanú v telefóne, kým ich neodošlete."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistikat janë numërime të lidhura me një ID të rastësishme, tekst asnjëherë me shkronja, emra ose vendndodhje të saktë. Regjistrat qëndrojnë në telefonin tuaj derisa t'i dërgoni ato."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистика је бројање везано за случајни ИД, а никада текст слова, имена или тачну локацију. Евиденције остају на вашем телефону док их не пошаљете."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถิติจะนับเชื่อมโยงกับ ID แบบสุ่ม ห้ามใช้ข้อความตัวอักษร ชื่อ หรือตำแหน่งที่แน่นอน บันทึกจะยังคงอยู่ในโทรศัพท์ของคุณจนกว่าคุณจะส่ง"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik är räkningar kopplade till ett slumpmässigt ID, aldrig bokstavstext, namn eller exakt plats. Loggar finns kvar på din telefon tills du skickar dem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstatistikler rastgele bir kimliğe bağlı sayımlardır; asla harfli metin, adlar veya tam konum değildir. Günlükler siz gönderene kadar telefonunuzda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистика – це підрахунки, прив’язані до випадкового ідентифікатора, але ніколи не до тексту букв, імен чи точного місцезнаходження. Журнали залишаються на вашому телефоні, доки ви їх не надішлете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统计数据是与随机 ID 相关的计数，而不是字母文本、名称或确切位置。日志会保留在您的手机上，直到您发送为止。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số liệu thống kê là số lượng được gắn với một ID ngẫu nhiên, không bao giờ là văn bản chữ cái, tên hoặc vị trí chính xác. Nhật ký vẫn còn trên điện thoại của bạn cho đến khi bạn gửi chúng."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "統計資料是與隨機 ID 相關的計數，而不是字母文字、名稱或確切位置。日誌會保留在您的手機上，直到您發送為止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "統計資料是與隨機 ID 相關的計數，而不是字母文字、名稱或確切位置。日誌會保留在您的手機上，直到您發送為止。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stats are counts tied to a random ID, never letter text, names or exact location. Logs stay on your phone until you send them."
          }
        }
      }
    },
