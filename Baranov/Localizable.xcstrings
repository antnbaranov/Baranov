    "Game Center will ask once before Baranov can see them.": {
      "comment": "A description of the Game Center friends feature.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ще попита веднъж, преди Baranov да ги види."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center preguntarà una vegada abans que Baranov els pugui veure."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center će pitati jednom prije nego što ih Baranov vidi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيسألك Game Center مرة واحدة قبل أن يتمكن بارانوف من رؤيتهم."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center vil spørge én gang, før Baranov kan se dem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center se jednou zeptá, než je Baranov uvidí."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center will ask once before Baranov can see them."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center will ask once before Baranov can see them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center will ask once before Baranov can see them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center wird einmal nachfragen, bevor Baranov sie sehen kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Game Center θα σας ρωτήσει μία φορά πριν προλάβει να τα δει ο Baranov."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center preguntará una vez antes de que Baranov pueda verlos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center preguntará una vez antes de que Baranov pueda verlos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mängukeskus küsib korra, enne kui Baranov neid näeb."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center-ek behin galdetuko du Baranov-ek ikusi aurretik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center demandera une fois avant que Baranov puisse les voir."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center demandera une fois avant que Baranov puisse les voir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center kysyy kerran ennen kuin Baranov näkee ne."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Iarrfaidh Game Center uair amháin sula bhféadfaidh Baranov iad a fheiceáil."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center preguntará unha vez antes de que Baranov poida velos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ישאל פעם אחת לפני שברנוב יוכל לראות אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बारानोव उन्हें देखने से पहले गेम सेंटर एक बार पूछेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center će pitati jednom prije nego što ih Baranov vidi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Game Center egyszer megkérdezi, mielőtt Baranov látná őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center akan bertanya satu kali sebelum Baranov dapat melihatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center chiederà una volta prima che Baranov possa vederli."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center mun spyrja einu sinni áður en Baranov getur séð þá."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center は Baranov が見る前に一度尋ねます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თამაშის ცენტრი ითხოვს ერთხელ, სანამ ბარანოვი მათ ნახავს."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов оларды көрмей тұрып ойын орталығы бір рет сұрайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov가 보기 전에 Game Center에서 한 번 물어볼 것입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Žaidimų centras paklaus vieną kartą, kol Baranovas juos pamatys."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spēļu centrs vienreiz jautās, pirms Baranovs tos ieraudzīs."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ќе праша еднаш пред Баранов да ги види."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusat Permainan akan bertanya sekali sebelum Baranov dapat melihatnya."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center se jistaqsi darba qabel Baranov ikun jista' jarahom."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center vil spørre én gang før Baranov kan se dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center zal het één keer vragen voordat Baranov ze kan zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center zapyta raz, zanim Baranov będzie mógł je zobaczyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Game Center perguntará uma vez antes que Baranov possa vê-los."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Game Center perguntará uma vez antes que Baranov possa vê-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center спросит один раз, прежде чем Баранов сможет их увидеть."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center va întreba o dată înainte ca Baranov să-i vadă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center sa raz opýta, kým ich Baranov uvidí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center bo enkrat vprašal, preden jih bo Baranov videl."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center do të pyesë një herë përpara se Baranov t'i shohë ato."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаме Центер ће питати једном пре него што их Баранов види."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center จะถามอีกครั้งก่อนที่ Baranov จะมองเห็นพวกเขา"
