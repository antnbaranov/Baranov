        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρήστε αυτήν την οθόνη ανοιχτή κοντά στον αποστολέα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga esta pantalla abierta cerca del remitente."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga esta pantalla abierta cerca del remitente."
