        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vēstule joprojām tiek saņemta kājām, kā parasti — tā vienkārši netiks atšifrēta pirms šī brīža, pat ar labo krotāli."
