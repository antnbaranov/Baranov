    "No journeys yet. Send a letter and %@'s route will be drawn here.": {
      "comment": "A message that appears when a user has not yet drawn any routes.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още няма пътувания. Изпратете писмо и маршрутът на %@ ще бъде начертан тук."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha viatges. Envieu una carta i aquí es dibuixarà la ruta de %@."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema putovanja. Pošaljite pismo i ruta %@ će biti nacrtana ovdje."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد رحلات بعد. أرسل خطابًا وسيتم رسم طريق %@ هنا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen rejser endnu. Send et brev og %@ 's rute vil blive tegnet her."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné cesty. Pošlete dopis a zde bude nakreslena trasa %@ ."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "No journeys yet. Send a letter and %@'s route will be drawn here."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "No journeys yet. Send a letter and %@'s route will be drawn here."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No journeys yet. Send a letter and %@'s route will be drawn here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Fahrten. Senden Sie einen Brief und die Route von %@ wird hier angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμη ταξίδια. Στείλτε ένα γράμμα και η διαδρομή του %@ θα σχεδιαστεί εδώ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay viajes. Envíe una carta y la ruta de %@ se dibujará aquí."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay viajes. Envíe una carta y la ruta de %@ se dibujará aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Reise veel pole. Saada kiri ja siia loositakse kasutaja %@ marsruut."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraindik ez dago bidaiarik. Bidali gutun bat eta %@-ren ibilbidea hemen marraztuko da."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun voyage pour l'instant. Envoyez une lettre et l'itinéraire de %@ sera dessiné ici."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun voyage pour l'instant. Envoyez une lettre et l'itinéraire de %@ sera dessiné ici."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä matkoja. Lähetä kirje ja käyttäjän %@ reitti piirretään tänne."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl aon turas fós. Seol litir agus beidh %@ 's bealach a tharraingt anseo."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aínda non hai viaxes. Envía unha carta e aquí debuxarase a ruta de %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין מסעות. שלח מכתב והמסלול של %@ יצויר כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई यात्रा नहीं. एक पत्र भेजें और %@ का मार्ग यहां तैयार किया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema putovanja. Pošaljite pismo i ruta korisnika %@ bit će nacrtana ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincsenek utazások. Küldj levelet és %@ útvonala itt lesz kisorolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada perjalanan. Kirim surat dan rute %@ akan digambarkan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun viaggio ancora. Invia una lettera e il percorso di %@ verrà tracciato qui."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engar ferðir ennþá. Sendu bréf og leið %@ verður dregin hér."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ旅行はありません。手紙を送ると、%@ のルートがここに描かれます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჯერ არ არის მოგზაურობა. გაგზავნეთ წერილი და %@-ის მარშრუტი აქ დახაზული იქნება."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге сапарлар жоқ. Хат жіберіңіз және %@ маршруты осы жерде сызылады."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 여행이 없습니다. 편지를 보내면 %@ 님의 경로가 여기에 그려집니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar nėra kelionių. Išsiųskite laišką ir čia bus nubraižytas %@ maršrutas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēl nav ceļojumu. Nosūtiet vēstuli, un šeit tiks izlozēts %@ maršruts."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сè уште нема патувања. Испратете писмо и маршрутата на %@ ќе биде нацртана овде."
          }
        },
        "ms": {
          "stringUnit": {
