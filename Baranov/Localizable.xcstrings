    "Sails %@ and lands %@. Hand %@ to someone crossing sooner and it skips the wait entirely." : {
      "comment" : "A description of a voyage, including the departure and arrival dates. The first argument is the departure date. The second argument is the arrival date.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أشرعة %@ وتهبط %@ . قم بتسليم %@ إلى شخص يعبر عاجلاً ويتخطى الانتظار تمامًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плава %@ и каца %@. Подайте %@ на някой, който пресича по-рано, и това напълно премахва чакането."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedri %@ i slijeće %@. Predajte %@ nekome tko prije prelazi i on će u potpunosti preskočiti čekanje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navega %@ i aterra %@. Entrega %@ a algú que creua abans i es saltarà l'espera per complet."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluje %@ a přistává %@. Předejte %@ někomu na přechodu dříve a čekání úplně přeskočí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sejler %@ og lander %@ . Giv %@ til en, der krydser hurtigere, og det springer ventetiden helt over."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt ab am %@ und landet am %@. Übergib %@ früher an jemanden, der übersetzt, und er überspringt die Wartezeit ganz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πλέει %@ και προσγειώνεται %@. Δώστε το %@ σε κάποιον που περνάει νωρίτερα και παραλείπει εντελώς την αναμονή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
