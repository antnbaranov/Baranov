          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponle un nombre: crecerá llevando tus cartas mientras sigas usando Baranov."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponle un nombre: crecerá llevando tus cartas mientras sigas usando Baranov."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Andke sellele nimi - see kasvab teie kirju kandes nii kaua, kuni te Baranovit hoiate."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponle un nombre: crecerá llevando tus cartas mientras sigas usando Baranov."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna sille nimi — se kasvaa kantaen kirjeitäsi niin kauan kuin käytät Baranovia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez-lui un nom — il grandira en portant vos lettres, aussi longtemps que vous garderez Baranov."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez-lui un nom — il grandira en portant vos lettres, aussi longtemps que vous garderez Baranov."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabhair ainm dó - beidh sé ag fás suas ag iompar do litreacha, chomh fada agus a choimeádann tú Baranov."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponle un nombre: crecerá llevando tus cartas mientras sigas usando Baranov."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תנו לו שם — הוא יגדל וישא את מכתביכם כל עוד אתם משתמשים ב-Baranov."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे एक नाम दें — जब तक आप Baranov का उपयोग करेंगे, यह आपके पत्र ले जाते हुए बड़ा होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dajte mu ime — odrastat će noseći vaša pisma, sve dok budete držali Baranova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj neki nevet – a te leveleidet fogja cipelni, amíg megtartod Baranovot."
