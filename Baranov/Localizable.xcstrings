    "All %@ of your rams are already out. Your letter is saved exactly as written. Send it again once a ram is free and it sets off then." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جميع %@ من الكباش الخاصة بك قد خرجت بالفعل. يتم حفظ رسالتك تمامًا كما هي مكتوبة. أرسله مرة أخرى عندما يصبح الكبش مجانيًا وينطلق بعد ذلك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всички %@ от вашите овни вече са излезли. Вашето писмо е запазено точно както е написано. Изпратете го отново, след като овенът е свободен и тогава тръгва."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svi %@ vaši ovnovi su već vani. Vaše pismo je sačuvano tačno onako kako je napisano. Pošaljite ga ponovo kada se ovan oslobodi i tada krene."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tots els %@ dels vostres ariets ja estan fora. La vostra carta es desa exactament tal com està escrita. Envieu-lo de nou quan un RAM estigui lliure i aleshores s'engega."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všichni %@ vaši berani jsou již venku. Váš dopis je uložen přesně tak, jak byl napsán. Pošlete to znovu, jakmile bude beran volný a pak se rozjede."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle %@ af dine væddere er allerede ude. Dit brev gemmes nøjagtigt som skrevet. Send den igen, når en vædder er fri, og den sætter så afsted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle deine %@ Widder sind bereits unterwegs. Dein Brief ist genau wie geschrieben gespeichert. Sende ihn erneut, sobald ein Widder frei ist, und er macht sich dann auf den Weg."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα τα %@ από τα κριάρια σας έχουν ήδη βγει. Το γράμμα σας αποθηκεύεται ακριβώς όπως γράφτηκε. Στείλτε το ξανά όταν ένα ram είναι ελεύθερο και ξεκινάει τότε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All %@ of your rams are already out. Your letter is saved exactly as written. Send it again once a ram is free and it sets off then."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All %@ of your rams are already out. Your letter is saved exactly as written. Send it again once a ram is free and it sets off then."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All %@ of your rams are already out. Your letter is saved exactly as written. Send it again once a ram is free and it sets off then."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All %@ of your rams are already out. Your letter is saved exactly as written. Send it again once a ram is free and it sets off then."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos tus carneros (%@) ya están en camino. Tu carta está guardada tal como la escribiste. Envíala de nuevo cuando un carnero esté libre y saldrá de inmediato."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos tus carneros (%@) ya están en camino. Tu carta está guardada tal como la escribiste. Envíala de nuevo cuando un carnero esté libre y saldrá de inmediato."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kõik %@ teie jäärad on juba väljas. Teie kiri salvestatakse täpselt nii, nagu see on kirjutatud. Saatke see uuesti, kui jäär on vaba ja see läheb siis teele."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zure %@ ahari guztiak atera dira dagoeneko. Zure gutuna idatzi bezala gordetzen da. Bidali berriro ahari bat libre dagoenean eta orduan abiarazten da."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki %@ päsisi ovat jo ulkona. Kirjeesi tallennetaan juuri sellaisena kuin se on kirjoitettu. Lähetä se uudelleen, kun pässi on vapaana ja se lähtee sitten liikkeelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous tes béliers (%@) sont déjà en route. Ta lettre est enregistrée telle qu'écrite. Renvoie-la dès qu'un bélier est libre et il partira alors."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous tes béliers (%@) sont déjà en route. Ta lettre est enregistrée telle qu'écrite. Renvoie-la dès qu'un bélier est libre et il partira alors."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá gach %@ de do reithí amuigh cheana féin. Déantar do litir a shábháil díreach mar atá scríofa. Seol arís é nuair a bhíonn reithe saor agus imíonn sé ansin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os teus %@ carneiros xa están fóra. A túa carta gárdase tal e como está escrita. Envíao de novo unha vez que un carneiro estea libre e entón arranca."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל %@ האילים שלך כבר בחוץ. המכתב שלך נשמר בדיוק כפי שנכתב. שלח אותו שוב ברגע שאיל פנוי ואז הוא יוצא לדרך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके सभी %@ मेढ़े पहले ही बाहर आ चुके हैं। आपका पत्र बिल्कुल वैसे ही सहेजा गया है जैसा लिखा गया है। एक बार राम मुक्त हो जाने पर इसे दोबारा भेजें और यह तब रवाना हो जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svi %@ tvoji ovnovi su već izašli. Vaše pismo je spremljeno točno onako kako je napisano. Pošalji ga ponovo kada je ovan slobodan i tada kreće."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az összes %@ kosod már kint van. Levelét a rendszer pontosan úgy menti, ahogy írta. Küldd el újra, ha egy ram szabadul, és akkor elindul."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua %@ domba jantan Anda sudah keluar. Surat Anda disimpan persis seperti yang tertulis. Kirim lagi setelah ram bebas dan kemudian berangkat."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allir %@ hrútarnir þínir eru þegar komnir út. Bréfið þitt er vistað nákvæmlega eins og það er skrifað. Sendu það aftur þegar hrútur er laus og þá fer hann af stað."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All  %@  of your rams are already out. Your letter is saved exactly as written. Inviatelo di nuovo una volta che un ariete sarà libero e poi partirà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 個の RAM はすべてすでに出ています。あなたの手紙は書かれたとおりに保存されます。ラムが解放されたら再度送信し、ラムが出発します。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თქვენი ყველა %@ ვერძი უკვე გამოსულია. Your letter is saved exactly as written. გააგზავნე ხელახლა, როგორც კი ვერძი თავისუფალი იქნება და შემდეგ გადის."
          }
