        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จดหมายที่ส่งถึง Shepherd ID ของคุณให้เดินมาที่นี่ตามขั้นบันไดของผู้ส่ง มีเพียงเมืองเท่านั้นที่แบ่งปัน"
