            "state": "translated",
            "value": "It completes itself when the steps add up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es vervollständigt sich, wenn sich die Schritte summieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολοκληρώνεται όταν αθροιστούν τα βήματα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se completa cuando los pasos se suman."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se completa cuando los pasos se suman."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See läheb ise lõpule, kui sammud liidetakse."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Urratsak batzen direnean osatzen da."
          }
        },
        "fr": {
