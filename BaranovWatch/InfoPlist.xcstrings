    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحسب بارانوف خطواتك أثناء المشي بالكبش."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов ти брои стъпките докато вървиш с овена си."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov broji tvoje korake dok hodaš sa tvojim ovnom."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov compta els teus passos mentre camina amb el teu ariet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov počítá vaše kroky při chůzi s vaším beranem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov tæller dine skridt, mens du går med din vædder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov zählt deine Schritte, während du mit deinem Widder unterwegs bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Μπαράνοφ μετράει τα βήματά σου περπατώντας με το κριάρι σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov counts your steps while walking with your ram."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov counts your steps while walking with your ram."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov counts your steps while walking with your ram."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov counts your steps while walking with your ram."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov cuenta tus pasos mientras caminas con tu carnero."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov cuenta tus pasos mientras caminas con tu carnero."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov loeb teie samme teie jääraga kõndides."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov-ek zure urratsak zenbatzen ditu zure ahariarekin ibiltzean."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov laskee askeleitasi kävellessään oinaasi kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov compte tes pas pendant que tu marches avec ton bélier."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov compte tes pas pendant que tu marches avec ton bélier."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Áireamh Baranov do chéimeanna agus tú ag siúl le do reithe."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov conta os teus pasos mentres camiña co teu carneiro."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברנוב סופר את צעדיך תוך כדי הליכה עם האיל שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बारानोव आपके राम के साथ चलते समय आपके कदम गिनता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov ti broji korake dok hodaš s ovnom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov számolja lépéseidet, miközben a kosoddal sétál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov menghitung langkahmu sambil berjalan dengan domba jantanmu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov telur skrefin þín meðan þú gengur með hrútinn þinn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov conta i tuoi passi mentre cammini con il tuo ariete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バラノフは羊を連れて歩きながら歩数を数えます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ბარანოვი ითვლის შენს ნაბიჯებს ვერძთან ერთად სიარულისას."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов қошқарыңмен жүргенде қадамыңды санайды."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov는 숫양과 함께 걷는 동안 걸음 수를 계산합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranovas skaičiuoja tavo žingsnius eidamas su avinu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranovs skaita tavus soļus, ejot ar tavu aunu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов ти ги брои чекорите додека оди со твојот овен."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov mengira langkah anda semasa berjalan dengan domba jantan anda."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov jgħodd il-passi tiegħek waqt li timxi bil-muntun tiegħek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov teller skrittene dine mens han går med væren din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov telt je stappen terwijl je met je ram loopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranow liczy twoje kroki, idąc z baranem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov conta seus passos enquanto caminha com seu carneiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov conta seus passos enquanto caminha com seu carneiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov îți numără pașii în timp ce mergi cu berbecul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov считает твои шаги, пока ты идёшь со своим бараном."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov pri chôdzi s baranom počíta vaše kroky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov šteje tvoje korake med hojo z ovnom."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Baranov i numëron hapat duke ecur me dashin tuaj."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Баранов броји твоје кораке док ходаш са твојим овном."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
