    "Double tap to pet your ram and hear a bleat": {
      "comment": "A hint for the user to pet their ram.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر نقرًا مزدوجًا لمداعبة كبشك وسماع صوت الثغاء"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете два пъти, за да погалите овена си и да чуете блеене"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite dvaput da mazite svog ovna i čujete blejanje"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes doble toc per acariciar el teu RAM i escoltar un bal"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojitým klepnutím pohladíte berana a uslyšíte zavrčení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk to gange for at klappe din vædder og høre et brægen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe zweimal, um deinen Widder zu streicheln und ein Blöken zu hören"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε δύο φορές για να χαϊδέψετε το κριάρι σας και να ακούσετε ένα βέλασμα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double tap to pet your ram and hear a bleat"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Double tap to pet your ram and hear a bleat"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Double tap to pet your ram and hear a bleat"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Double tap to pet your ram and hear a bleat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para acariciar a tu carnero y escuchar un balido"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para acariciar a tu carnero y escuchar un balido"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Topeltpuudutage oma jäära silitamiseks ja piiksu kuulmiseks"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakatu birritan zure aharia laztantzeko eta burrunba bat entzuteko"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksoisnapauta pässiä silittääksesi ja kuullaksesi huminan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche deux fois pour caresser ton bélier et entendre un bêlement"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche deux fois pour caresser ton bélier et entendre un bêlement"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapáil faoi dhó chun do reithe a pheata agus cloisfidh tú bleat"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dúas veces para acariciar o teu carneiro e escoitar un balido"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש פעמיים כדי ללטף את האיל שלך ולשמוע פעימה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने मेढ़े को सहलाने और मिमियाने की आवाज सुनने के लिए दो बार टैप करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite dvaput da pomazite svog ovna i čujete blejanje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson duplán, hogy megsimogatja a kosát, és halljon egy csapkodást"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dua kali untuk mengelus domba jantan Anda dan mendengar suara mengembik"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýttu tvisvar til að klappa hrútnum þínum og heyra hljóð"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte per accarezzare il tuo ariete e sentire un belato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップしてラムを撫でると鳴き声が聞こえます"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ორმაგად შეეხეთ ვერძს და მოისმინეთ ბზუილი"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қошқарыңызды еркелетіп, ысқырықты есту үшін екі рет түртіңіз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫양을 쓰다듬고 울음소리를 들으려면 두 번 탭하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dukart palieskite, kad paglostytumėte savo aviną ir išgirstumėte ūžesį"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
