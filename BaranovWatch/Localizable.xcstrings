          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomon követi a levélhordozó kost az óralapján."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacak ram pembawa surat Anda di tampilan jam Anda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
