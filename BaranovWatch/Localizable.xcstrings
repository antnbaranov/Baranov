            "value": "Tracks your letter-carrying ram on your watch face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue a tu carnero cartero en la carátula de tu reloj."
          }
        },
        "es-419": {
          "stringUnit": {
