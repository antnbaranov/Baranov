    "Tracks your letter-carrying ram on your watch face.": {
      "comment": "Description of the Baranov Watch widget.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتتبع ذاكرة الوصول العشوائي التي تحمل الحروف على وجه ساعتك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Проследява вашия овен с писма върху циферблата на часовника ви."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prati vašeg ovna koji nosi pismo na vašem satu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastreja el vostre ariet portacartes a la cara del rellotge."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduje beran s dopisy na ciferníku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sporer din brevbærende ram på din urskive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgt deinen Post-Widder auf dem Zifferblatt deiner Watch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολουθεί το κριάρι που μεταφέρει γράμματα στην οθόνη του ρολογιού σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
